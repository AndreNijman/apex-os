# APEX-OS — first-login provisioner (systemd USER service).
#
# APEX Shell is a LIVE git checkout the user updates in place (its own
# auto-updater pulls `~/.local/src/apex-shell`, and Quickshell hot-reloads
# from there). That rules out seeding it via /etc/skel — a skel copy would
# be a detached, non-git snapshot that the shell's updater and hot-reload
# could not drive. So instead every user gets their OWN clone + config the
# first time they log in, via this oneshot.
#
# The EXPENSIVE work (clone + matugen render) runs once per user: the script
# short-circuits on its own ~/.config/apex-shell/.provisioned marker, which it
# writes only on full success — a failed run (e.g. no network at first login)
# leaves the marker absent, so the next login retries.
#
# There is deliberately NO ConditionPathExists gate here (apex-logs 43). The
# script's step 0 re-seeds the Hyprland config on EVERY login, because greetd
# execs the compositor in parallel with this unit: if Hyprland wins the startup
# race it writes its own stock config, and the user is stuck with it forever
# once the marker exists. Letting the unit start each login — it costs a few ms
# and exits immediately when provisioned — is what makes that state repairable.
#
# Enabled image-wide with `systemctl --global enable` (see the flavor
# Containerfiles), which symlinks it into every user's default.target.wants.
[Unit]
Description=APEX-OS first-login provisioner (clone APEX Shell + seed user config)
Documentation=https://github.com/AndreNijman/apex-shell

[Service]
Type=oneshot
ExecStart=/usr/libexec/apex-shell-firstrun
# The script polls for network itself (see below); cap the whole attempt so a
# wedged clone can never hang the user session. A timeout is a failure, so the
# marker is not written and the next login retries.
TimeoutStartSec=300
# A first-run failure must never wedge login; the missing marker is the retry.
Restart=no

[Install]
# default.target is always reached when the user manager starts at login, so
# the unit runs on first login regardless of which compositor is chosen — it
# does NOT depend on graphical-session.target (which is not reached under a
# bare Hyprland/greetd session that has no uwsm/systemd handoff).
WantedBy=default.target
