# APEX-OS — per-login user provisioner (systemd USER service).
#
# Seeds each user's APEX Shell config. It does NOT install the shell: since
# apex-logs 56 the shell ships inside the image at /usr/share/apex-shell, so this
# unit does pure local file seeding — no network, no git, no marker.
#
# WHY THE SHELL IS NO LONGER CLONED PER-USER
# It used to be a live git checkout in ~/.local/src/apex-shell, updated in place by
# the shell's own in-app updater and hot-reloaded by Quickshell. That gave APEX-OS
# TWO independent update channels with no version coupling (bootc for the OS, an
# in-app `git pull` for the entire UI), made the desktop depend on the network at
# first login, and put the UI outside the image's signing and rollback story.
# It also created an unwinnable race: greetd execs the compositor in PARALLEL with
# this unit, so the compositor's autostart fired against a not-yet-cloned directory
# and the user got a bare session with no bar (apex-logs 51).
#
# Vendoring the shell into the image fixed all of it at once, and this unit shrank
# to seeding as a result.
#
# There is deliberately NO ConditionPathExists gate and NO .provisioned marker.
# The marker used to gate the expensive clone — and it is exactly what made every
# past silent defect permanent, because it short-circuited the retry-at-next-login
# design that was supposed to be the safety net (apex-logs 52). Everything the
# script does now is cheap and idempotent, so it runs every login and self-heals:
# a clobbered config, a stale legacy path, a missing seed all get repaired.
#
# Enabled image-wide with `systemctl --global enable` (see the flavor
# Containerfiles), which symlinks it into every user's default.target.wants.
[Unit]
Description=APEX-OS per-login user provisioner (seed APEX Shell user config)
Documentation=https://github.com/AndreNijman/apex-shell

[Service]
Type=oneshot
ExecStart=/usr/libexec/apex-shell-firstrun
# Nothing here touches the network any more, so this no longer needs to cover a
# cold clone. Kept as a low bound purely so a pathological hang can never wedge a
# login; normal runs finish in well under a second.
TimeoutStartSec=60
# A failure must never wedge login. The unit simply runs again next login.
Restart=no

[Install]
# default.target is always reached when the user manager starts at login, so
# the unit runs on first login regardless of which compositor is chosen — it
# does NOT depend on graphical-session.target (which is not reached under a
# bare Hyprland/greetd session that has no uwsm/systemd handoff).
WantedBy=default.target
