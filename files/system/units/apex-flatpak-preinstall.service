# APEX-OS — install the Flatpak applications every image should ship with.
#
# Right now that is Zen Browser, and only Zen Browser.
#
# ── Why first boot and not the Containerfile ─────────────────────────────────
# `flatpak install` needs a running system: it writes to /var/lib/flatpak, and
# bootc treats /var as machine-local state that is seeded once and never
# updated. The same reasoning already governs the Flathub remote itself — see
# apex-flathub-setup.service, which this unit runs after, because there is
# nothing to install from until the remote exists.
#
# ── Why Zen is a Flatpak and not an RPM ──────────────────────────────────────
# Zen is not in Fedora's repositories and ships no Fedora RPM. The alternatives
# are a tarball in /opt or an AppImage, and both would need APEX to write its own
# updater to keep "always the latest stable" true. `apex update` already runs
# `flatpak update --system` (see cmd_flatpak_upgrade in apex-pkg), so as a
# Flatpak Zen tracks latest stable with no new machinery at all.
#
# ── Firefox stays the default browser ────────────────────────────────────────
# Deliberate. Zen is a Firefox fork with an opinionated interface, and someone
# who dislikes it should not have to undo a decision the image made for them.
# So Zen is installed and discoverable, Firefox keeps the http/https handler in
# files/desktop/xdg/mimeapps.list, and the image build asserts that — a Flatpak's
# exported .desktop can otherwise win the handler race depending on XDG data
# directory ordering.
#
# Idempotent: `flatpak install` is a no-op when the app is present, and the
# stamp keeps the unit quiet after the first success. The stamp is written ONLY
# on success, so a boot with no network retries on the next one.
[Unit]
StartLimitIntervalSec=20min
StartLimitBurst=10
Description=APEX-OS: install the shipped Flatpak applications (first boot)
Documentation=https://zen-browser.app
After=network-online.target apex-flathub-setup.service
Wants=network-online.target
Requires=apex-flathub-setup.service
ConditionPathExists=!/var/lib/flatpak/.apex-flatpaks-installed
ConditionPathExists=/var/lib/flatpak/repo

# ── Boot never waits for this ────────────────────────────────────────────────
# A target orders itself After= every unit it Wants, so with default
# dependencies multi-user.target (and graphical.target behind it) waited for
# this oneshot: every attempt, and every 60 s RestartSec pause in between. On a
# first boot with no network that was ten failed attempts a minute apart, and
# the console showed "A start job is running … (9min / no limit)", because a
# Type=oneshot's TimeoutStartSec defaults to infinity. DefaultDependencies=no
# removes that implicit ordering; the four lines below put back what the
# defaults provided, so the unit still starts after basic system setup and
# still stops cleanly at shutdown. It keeps running and retrying in the
# background; boot just stops waiting for it.
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target basic.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/flatpak install --system --assumeyes --noninteractive flathub app.zen_browser.zen
ExecStartPost=/usr/bin/touch /var/lib/flatpak/.apex-flatpaks-installed
# Retry inside this boot rather than only on the next one.
#
# `SuccessExitStatus=0` used to sit here, with a comment claiming it stopped a
# networkless boot from wedging. It never did anything: 0 is already success by
# definition, so the line was a no-op and the unit simply entered `failed` the
# moment the download did. A laptop that associates with Wi-Fi a few
# seconds after network-online.target fires — which that target permits, since
# it means "a network is configured", not "the internet answers" — therefore
# showed `Failed Units: 1` in every login greeting until the next reboot, for a
# background download of an optional application.
#
# Type=oneshot accepts Restart=on-failure (only always/on-success are refused),
# so the transient case now resolves itself. The burst is bounded: ten tries a
# minute apart, then stop. The stamp is still written only on success, so a
# genuinely offline machine installs on a later boot exactly as before.
Restart=on-failure
RestartSec=60s
# One attempt may not hang. This one downloads Zen, so a slow
# connection legitimately takes minutes; twenty is generous for that and still
# ends a download that has stopped moving, which is then retried like any
# other failure.
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
