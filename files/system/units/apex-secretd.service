# APEX-OS — protected secret service (systemd SYSTEM service, roadmap §11).
#
# Holds the credentials a managed agent may USE but must never HOLD, and
# performs provider operations on request. One instance for the machine, under
# its own system account.
#
# WHY THIS IS A SYSTEM SERVICE, UNLIKE apex-agentd AND apex-aid
# Those two are per-user because the kernel's uid boundary is what keeps one
# account's sessions and prompts out of another's, and neither needs to be
# beyond the reach of the user it serves. This one is the opposite case. The
# threat it exists for is a managed agent running as the user, which can read
# everything the user can read — so a store the user's own daemon could open is
# a store the agent can open. Protecting it requires a uid no human user has,
# and that means a system account.
#
# It is still not privileged. It runs as `apex-secret`, an account with no
# shell, no login and no capabilities. What it has that nobody else has is one
# directory: /var/lib/apex-secretd, 0700, its own.
#
# WHY IT IS NOT PART OF apexd
# apexd is root, owns system policy, and has a frozen D-Bus interface with
# polkit actions behind it. Credentials there would mean every credential
# operation crossing a privileged interface, and a polkit prompt in the path of
# an agent nobody is watching. AGENTS.md forbids agent-adjacent daemons
# acquiring a system-bus name or a setuid helper; this one has neither.
#
# TWO SOCKETS
#   /run/apex-secretd/broker.sock  0666  metadata and performing operations
#   /run/apex-secretd/admin.sock   0600  store, rotate, grant, revoke
# The broker socket is open because every uid has its own namespace behind it,
# keyed on SO_PEERCRED, and connecting as yourself reaches only your own. The
# admin socket is 0600 and owned by apex-secret, so in practice only root can
# open it — which is what makes a grant mean something, because an agent runs
# under the owner's uid and could otherwise grant itself a capability.
#
# WHY IT IS NOT SOCKET-ACTIVATED
# It could be, and there is one reason not to: an agent's first credential
# operation would then pay for a process start plus a TPM probe, in the path of
# something a human is waiting on. The daemon is a few hundred kilobytes of
# resident memory and does nothing between requests.
#
# ENABLED BY DEFAULT, unlike apex-agentd and apex-aid. Those hold PTYs and
# gigabytes of VRAM for people who may never use them. This holds nothing until
# a credential is stored, and it has to be listening before the first one can
# be — a service you must start before you can store anything is a service
# people work around.
#
# TPM SEALING
# `apex capability store --seal` encrypts a credential to this machine's TPM
# through systemd-creds. It is off by default and, on a stock host, unavailable:
# measured on Fedora 43, systemd-creds refuses for a non-root account with
# io.systemd.InteractiveAuthenticationRequired, and this service must never
# raise a prompt nobody is watching. SupplementaryGroups=tss is set so the
# device is reachable if a deployment grants the rest. Sealing protects a copy
# of the disk taken elsewhere; it does not put the store beyond root, which can
# read any file on the machine.

[Unit]
Description=APEX-OS protected secret service (capability broker, sealed store, audit)
Documentation=man:apex(1)
# No network dependency: it makes outbound requests when asked, and being up
# before the network is up is correct — the failure is then the operation's,
# with an explanation, rather than the service's.
After=local-fs.target

# A crash loop must not spin: five restarts in a minute and it stays down,
# where `systemctl status apex-secretd` reports it plainly. These are [Unit]
# directives, not [Service] ones (systemd.unit(5)) — under [Service] systemd
# parses them and they do nothing, which reads as configured while being inert.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/apex-secretd
User=apex-secret
Group=apex-secret
Restart=on-failure
RestartSec=2

# The store and the sockets. systemd creates both with the right owner before
# ExecStart, so the daemon never runs as root to set them up.
StateDirectory=apex-secretd
StateDirectoryMode=0700
RuntimeDirectory=apex-secretd
RuntimeDirectoryMode=0755

# The TPM, for `--seal`. Group membership only; the device is not opened unless
# a credential is stored sealed.
SupplementaryGroups=tss

# Hardening. Far tighter than apex-agentd's, and it can be: this daemon runs no
# user programs. It spawns exactly two things — curl, to make a request, and
# systemd-creds, to seal — so NoNewPrivileges and a locked-down filesystem cost
# it nothing.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=no
DeviceAllow=/dev/tpmrm0 rw
ProtectSystem=strict
# The one thing this service exists to keep away from the agent is the agent's
# own home directory, so it must not be able to read one.
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Unix for the sockets, INET for the provider requests curl makes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# It holds no capabilities at all. Stated rather than left to the default,
# because the default for a User= unit is already empty and a later edit adding
# one should have to delete this line.
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
