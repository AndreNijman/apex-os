# APEX-OS — protected secret service (systemd SYSTEM service, roadmap §11).
#
# Holds every brokered credential, performs the operations that need one, and
# has no verb that returns one.
#
# WHY THIS IS A SYSTEM SERVICE AND NOT PART OF apex-agentd
# apex-agentd is unprivileged and per-user, and must stay that way: it handles
# untrusted model output and spawns arbitrary user programs. That is exactly
# what makes it the wrong place for a credential. Anything it can read, a
# managed agent running as the same user can read too — an unrestricted session
# has the whole home — so the old 0600-in-$XDG_STATE_HOME store kept out another
# account and nothing else. P0-002's first acceptance criterion is that
# credentials are no longer in agent-readable home paths, and the only way to
# mean it is a store the user's uid cannot open.
#
# WHY IT IS NOT PART OF apexd EITHER
# apexd owns system policy behind a frozen D-Bus surface and polkit. Credentials
# are a different concern with a different audience, and folding them in would
# put every capability decision behind an interface that cannot change. §11 asks
# for a dedicated service; this is it.
#
# WHY IT RUNS AS ROOT
# Two requirements that no unprivileged arrangement satisfies at once:
#
#   1. the store must be unreadable by the user's uid — otherwise criterion 1
#      is not met, and a dedicated system account would satisfy this alone;
#   2. the git operation must run AS the user, because it works inside the
#      user's own repository and git executes that repository's configuration.
#      Running it as root would hand a local root escalation to anyone who can
#      write a .git/config.
#
# So the daemon starts privileged, keeps the store to itself, and drops to the
# owner's uid for every child it forks. It never gains anything; it only gives
# up. What it does NOT protect against is written down in the crate note of
# apex-secret-core — read that before trusting this with more than it claims.
#
# WHY IT IS ENABLED AND apex-agentd IS NOT
# apex-agentd holds PTYs for people who run agents. This holds credentials for
# anything on the machine that asks — git through a credential helper, the CLI,
# the agent runtime — and a service that is only running when somebody remembered
# to start it is a service every one of those has to have a fallback for. It is
# idle until asked: one socket and one thread per connection.

[Unit]
Description=APEX-OS protected secret service (credential broker)
Documentation=man:apex(1)
# No network dependency. The daemon binds a local socket and does nothing else
# at startup; the operations it brokers reach the network when they are asked
# for, not when it starts.
After=local-fs.target

# A crash loop must not spin: five restarts in a minute and it stays down,
# where `systemctl status apex-secretd` reports it plainly.
#
# These are [Unit] directives, not [Service] ones (systemd.unit(5)). Under
# [Service] systemd parses them but they do not apply — the same trap
# apex-agentd.service documents.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/apex-secretd
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10

# The store: /var/lib/apex-secretd, created 0700 and owned by root. This is the
# line that makes the credential unreadable by the account it belongs to.
StateDirectory=apex-secretd
StateDirectoryMode=0700

# The socket's directory: /run/apex-secretd, 0755. The socket itself is 0666,
# set by the daemon after bind — every local account must be able to reach it,
# and who they are is decided from SO_PEERCRED. A mode bit cannot tell one
# user's agent from another's shell; peer credentials can.
RuntimeDirectory=apex-secretd
RuntimeDirectoryMode=0755

# ── hardening ───────────────────────────────────────────────────────────────
#
# Everything here is chosen against one question: does the git child still work?
# It runs in the user's repository, as the user, and inherits this unit's
# namespace and filters.

NoNewPrivileges=yes
# Safe despite the setuid: NoNewPrivileges blocks privilege *gain* through
# execve, and this daemon only ever drops. What it buys is that the git child,
# now running as the user, cannot pick anything back up from a setuid binary.

# `full` and not `strict`: strict makes the whole hierarchy read-only, and the
# operations this exists to perform write to the user's repository — a fetch
# updates remote-tracking refs, a push writes the reflog. `full` keeps /usr,
# /boot, /efi and /etc read-only, which is the part that matters here.
ProtectSystem=full
# NOT set, and it cannot be: working inside the user's repository is the job.
ProtectHome=no
# NOT set: a project may be a git worktree under /tmp, and a private /tmp would
# make it invisible to the child with no error worth reading.
PrivateTmp=no

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# CAP_SETUID and CAP_SETGID are what the drop to the owner needs.
# CAP_SYS_PTRACE is what reading /proc/<pid>/exe of another account's process
# needs, and that read is how a mutating request from inside an agent session
# is recognised. The daemon never attaches to anything.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SYS_PTRACE

# NO SystemCallFilter. Deliberate, and this is the reason: the filter would
# apply to the git child as well, git's syscall use varies with version,
# transport and repository, and a filter that is wrong kills a credential
# operation with SIGSYS and no message anybody can act on. An unverifiable
# allow-list is worse than none. Add one when there is a way to test it against
# a real push on real hardware.

[Install]
WantedBy=multi-user.target
