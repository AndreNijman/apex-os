#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# apex-pkg — the APEX-OS package engine.
#
# WHY THIS EXISTS
# APEX is a bootc image. The supported way to add software to such a system used
# to be `rpm-ostree install`, and that has one fatal property for a daily driver:
# ANY layered package puts the deployment into "local modifications" state, and
# from that moment `bootc upgrade` refuses to run:
#
#   error: Deployment contains local rpm-ostree modifications; cannot upgrade
#
# So the moment a user installed one CLI tool, their OS stopped updating —
# silently, until someone read the error. Telling users "use Flatpak for apps,
# Homebrew for CLI, Distrobox for dev, and never rpm-ostree" is not a product;
# it is a list of excuses.
#
# WHAT THIS DOES INSTEAD
# Packages are installed into a systemd SYSTEM EXTENSION: a squashfs image in
# /var/lib/extensions that systemd overlays onto /usr at boot. That means:
#
#   * the bootc deployment is never modified          -> `bootc upgrade` keeps working
#   * binaries land in the real /usr/bin              -> no PATH games, no wrappers
#   * .desktop files, icons, systemd units, udev rules and man pages all work,
#     because they are at the paths the rest of the OS already looks in
#   * removal is deleting one file                    -> no dependency rot in /usr
#   * an OS upgrade cannot half-apply: the extension declares the OS version it
#     was built for, and systemd simply refuses to merge a mismatched one, which
#     this tool then rebuilds (apex-sysext-rebuild.service)
#
# ONE IMAGE, NOT ONE PER PACKAGE
# Everything the user asked for is resolved and built into a SINGLE extension
# (apex-user.raw), rebuilt from the requested-package list on every change. Two
# overlapping extensions would fight over shared dependency files and removing
# one could delete files the other still needs; one image makes dnf's own
# dependency resolution the single source of truth and makes removal exact.
#
# WHAT IT DELIBERATELY REFUSES
#   * anything already provided by the image (that is an image update, not a
#     package install)
#   * anything that would SHADOW an image package with a different version —
#     overlaying a second glibc/systemd onto a running system is how you brick it
#   * kernels, kernel modules and akmods — those need an initramfs and a real
#     deployment, so they belong in the image
#
# WHERE PACKAGES COME FROM
# Fedora, RPM Fusion, and explicitly enabled COPRs are the repository sources;
# there is no APEX registry to trust, run or keep online. In addition, a path to
# a local .rpm file installs THAT file through the same pipeline — vendor RPMs
# (the ones downloaded from a website) are the reason this exists. Such a file is
# copied into ${PKG_ROOT}/local at install time and every later rebuild reads the
# COPY, because `apex update` and the post-OS-upgrade rebuild must still work
# when the USB stick the file came from is long gone. Its dependencies still come
# from the repositories.
#
# Every RPM is signature-checked before extraction and an unverifiable one is
# refused. A local file that no trusted key covers can be installed only by
# repeating the command with --allow-unsigned, which records the decision against
# that file's exact bytes so `apex pkg list` and `apex pkg verify` keep telling
# the truth about where the software came from.
#
# AND A LOCAL .deb FILE, FOR THE SOFTWARE THAT SHIPS AS NOTHING ELSE
# Anthropic publishes Claude Desktop for Linux only as a .deb — five rpm/yum
# prefixes under downloads.claude.ai all answer 404 — and it is not alone:
# Electron applications are packaged for apt and for nothing else all the time.
# Until now the answer on this machine was to hand-unpack it into /usr/local and
# run a per-app update timer, which this repository's own CLAUDE.md calls the
# wrong model in as many words. So `apex install ./thing.deb` goes through the
# SAME extension, the same cache, the same requested list and the same rollback
# as everything else.
#
# What a .deb does NOT get is a second package manager. Specifically:
#
#   * its maintainer scripts are NEVER executed. They assume dpkg, apt and a
#     Debian filesystem; Claude Desktop's postinst writes an apt source, which
#     on this machine would be a second update channel the product decision
#     explicitly forbids. A package whose entry point exists only because its
#     postinst creates it is REFUSED rather than half-installed — the same
#     lesson `apex install wine` taught with rpm scriptlets, where twelve
#     /usr/bin entries shipped as dangling symlinks and the install reported
#     success.
#   * its Debian dependencies are NEVER resolved. `libgtk-3-0` is not a Fedora
#     package name and no mapping between the two is honest. They are printed,
#     recorded in state.json, and left to the user.
#   * its payload may only land in /usr and /opt, and a shared library that
#     would sit in a linker search path or a Debian multiarch directory is
#     refused. See deb_layout_ok for why translating /usr/lib/x86_64-linux-gnu
#     to /usr/lib64 is the worst of the three options.
#   * it is never verified. Debian signs the apt INDEX, not the package file,
#     so a .deb on disk is only as trustworthy as where it came from, and every
#     one of them needs --allow-unsigned.
#
# There is no apt-repository client here: APEX fetches no .deb, resolves no
# Debian dependency graph and tracks no Debian release. A .deb is installed
# from a file the user already has, and that is the whole of it.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

readonly PKG_ROOT=/var/lib/apex/pkg
readonly EXT_DIR=/var/lib/extensions
readonly EXT_NAME=apex-user
# systemd accepts a system extension as either a squashfs image or a plain
# directory. Squashfs is preferred (compact, read-only, one file to checksum),
# but mksquashfs reaches the image only as a weak dependency of dracut-squash —
# so the directory form is a first-class fallback rather than a hard failure.
readonly EXT_IMAGE="${EXT_DIR}/${EXT_NAME}.raw"
readonly EXT_TREE="${EXT_DIR}/${EXT_NAME}"
readonly REQUESTED="${PKG_ROOT}/requested"
readonly STATE="${PKG_ROOT}/state.json"
# Local .rpm files the user installed by path, kept as <NAME>.rpm so the
# requested-list entry `local:<NAME>` round-trips to exactly one file and
# `apex remove <NAME>` can find it. The EVR is deliberately NOT in the file name:
# NEVRA cannot be split back into a name unambiguously (is `foo-bar-1.0-1` the
# package `foo-bar` or `foo`?), and the EVR is in the RPM header anyway.
readonly LOCAL_DIR="${PKG_ROOT}/local"
# Local .deb files, cached by package NAME under a directory of their own.
# NOT merged into LOCAL_DIR: every function that touches that directory globs
# `*.rpm`, reads an RPM header out of what it finds, and stores the result as
# `local:<NAME>`. A second archive format sharing that namespace would make
# `local:chrome` ambiguous the first time someone had both.
readonly DEB_DIR="${PKG_ROOT}/deb"
readonly ETC_SAVE="${PKG_ROOT}/etc"
readonly ETC_LIST="${PKG_ROOT}/etc.list"
readonly VAR_LIST="${PKG_ROOT}/var.list"
readonly ROLLBACK_DIR="${PKG_ROOT}/rollback"
readonly COPR_KEY_DB="${PKG_ROOT}/copr-keyring"
readonly COPR_KEYS="${PKG_ROOT}/copr-keys"
# Staging lives under /var/lib, NOT /var/tmp: rpm cannot take its transaction
# lock inside a tmp-labelled tree under SELinux, and the resulting "can't create
# transaction lock" error would be printed on every single install.
readonly WORK_ROOT="${PKG_ROOT}/work"
readonly LOCK="${PKG_ROOT}/.lock"
# Increment whenever a newly baked image package may overlap existing user
# extensions, or whenever the on-disk layout under PKG_ROOT changes. A mismatch
# triggers one rebuild even within the same VERSION_ID — which is the whole
# point, because VERSION_ID is `43` before and after an APEX image build and
# nothing else in an extension's state notices that the image moved.
#
# BOTH guards read this, and until 2026-09-19 only one of them did:
# cmd_rebuild --if-needed compares it before downloading anything, and
# ext_up_to_date compares it again after the download, on the path every
# install, remove, upgrade and rebuild funnels through. A bump is only as good
# as the second one; see the comment on ext_up_to_date for what a bump without
# it does.
#   1 -> 2: added ${PKG_ROOT}/local (cached local .rpm files) and the
#           `local:<NAME>` requested-list form. A level-1 state.json has neither,
#           so its requested list rebuilds unchanged; the only effect is one
#           extra rebuild on the first boot after the update.
#   2 -> 3: pkg-share (merge 5de97037) changed what the 32-bit pass carries: a
#           path now arrives only when neither the running image nor this
#           transaction's own native pass already provides it. Every extension
#           built before it therefore holds files the image owns. Measured on
#           katana on 2026-09-19 against one built at level 2: 177 image paths
#           shadowed, 14 of them a 32-bit binary over a 64-bit one, and zero
#           i686 Vulkan ICDs where the fixed engine produces 13 — including
#           nvidia_icd.i686.json, which a live recovery had to hand-write in
#           September. Nothing else in that state.json moves across the image
#           build that carries the fix, so this number is what makes the
#           machine rebuild.
#   3 -> NOT BUMPED for .deb support, deliberately. The level exists to force a
#           rebuild when an existing extension's CONTENTS would come out
#           different, and a machine running level 3 has no `deb:` entry in its
#           requested list — there is no such thing as an extension built
#           before this that holds a .deb. Bumping would re-download every rpm
#           on every machine in the fleet to rebuild a byte-identical image.
readonly PKG_COMPAT_LEVEL=3

# Packages that must never come from an extension. The first group needs an
# initramfs/deployment; the second is the running userspace ABI floor — shadowing
# any of it with a second copy on an overlay is unrecoverable without a rollback.
readonly REFUSE_RE='^(kernel|kernel-core|kernel-modules(-.*)?|kernel-devel(-.*)?|kernel-cachyos.*|kmod-.*|akmod-.*|.*-kmod|glibc|glibc-common|systemd|systemd-libs|systemd-udev|rpm|rpm-libs|librpm.*|dnf5?|libdnf5.*|bootc|ostree|libostree.*|rpm-ostree|filesystem|setup|shadow-utils|bash|coreutils|selinux-policy.*|grub2-.*|shim.*|dracut.*|plymouth.*)$'

# The account a package scriptlet is dropped to before it is allowed to run, and
# how long it may run for. See alternatives_record() for what is executed and
# why. root is not an option here: nothing in this engine runs package code with
# privileges.
readonly ALT_SCRIPTLET_USER=nobody
readonly ALT_SCRIPTLET_TIMEOUT=30

# Progress goes to stderr, never stdout: stdout is reserved for data (paths,
# listings) and functions like build_payload return their result through it.
# ── argument routing ────────────────────────────────────────────────────────
# Each argument is one of three things, decided in this order:
#
#   1. a local .rpm FILE   — a path, or a name ending in .rpm
#   2. a Flatpak ID        — reverse-DNS, three or more segments
#   3. a repository package name
#
# The order is not cosmetic: the Flatpak regex also matches `org.foo.Bar.rpm`,
# so testing it first would route a file the user pointed at straight to Flathub.
#
# A reverse-DNS application ID (org.gimp.GIMP, io.github.foo.Bar) is routed to
# Flatpak. The rule is unambiguous rather than clever: Flathub IDs are always
# three or more dot-separated segments each starting with a letter, and no RPM is
# named that way — `python3.12` has two segments and `java-1.8.0-openjdk` has
# segments starting with digits, so neither matches.
is_flatpak_id() {
    [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z][A-Za-z0-9_-]*){2,}$ ]]
}

# The four bytes every RPM starts with (the lead magic, 0xedabeedb). Checked
# before rpm is asked to read the header so "you gave me a .zip" is reported as
# that, not as an unexplained rpm error.
rpm_magic_ok() {
    local magic
    magic="$(head -c4 -- "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    [ "$magic" = edabeedb ]
}

# Is this argument meant to be a local RPM file rather than a package name?
#
# Deliberately three narrow rules instead of a bare `[ -e "$1" ]`: a plain
# `apex install htop` run in a directory that happens to contain a file called
# `htop` must still install the repository package, so a bare name only counts as
# a file when it really is an RPM.
is_local_rpm_arg() {
    case "$1" in
        *.rpm) return 0 ;;   # named as a file, whether or not it exists yet
        */*)   return 0 ;;   # a path is never a package name
    esac
    [ -f "$1" ] && rpm_magic_ok "$1"
}

# RPM package names, restricted to what rpm itself allows. This is a security
# check, not a nicety: the NAME out of an untrusted file's header is used to
# build a path under LOCAL_DIR, and this engine runs as root.
valid_pkg_name() {
    [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.+-]*$ ]]
}

# ── local-file identifiers ──────────────────────────────────────────────────
# One package installed from a local file is one line `local:<NAME>` in the
# requested list, one cached RPM, and (only if the user opted into an
# unverifiable file) one trust marker. Everything else derives from those.
local_id()     { printf 'local:%s' "$1"; }
is_local_id()  { case "$1" in local:?*) return 0 ;; esac; return 1; }
local_name()   { printf '%s' "${1#local:}"; }
local_cache()  { printf '%s/%s.rpm'   "$LOCAL_DIR" "$(local_name "$1")"; }
local_marker() { printf '%s/%s.trust' "$LOCAL_DIR" "$(local_name "$1")"; }

# Does requested-list entry $1 name the same package the user typed as $2?
# `apex remove chrome` has to match the entry `local:chrome` (a local .rpm) or
# `deb:chrome` (a local .deb), because the user installed it by path and a path
# is not what ends up in the list.
requested_matches() {
    [ "$1" = "$2" ] || [ "$1" = "local:${2}" ] || [ "$1" = "deb:${2}" ]
}

# ── local .deb files ─────────────────────────────────────────────────────────
# A .deb is an `ar` archive of three members: `debian-binary` (the format
# version, "2.0"), `control.tar.*` (metadata and the maintainer scripts) and
# `data.tar.*` (the payload). Some vendors append a fourth, `_gpgorigin` — a
# debsigs signature. Cisco's Packet Tracer .deb on this developer's machine
# carries one; see deb_trust_refusal for why APEX does not treat it as
# verification.
#
# `dpkg-deb` is not in the image and is not wanted: it would bring dpkg's
# database with it, and there is no world in which APEX maintains a second
# package database. `ar` and `tar` are enough, and `ar` is already in the image
# — Containerfile.core's 5a-aiapps stage unpacks the Claude Desktop .deb with it
# and FATALs if binutils is absent, which is the same assertion made here.
deb_magic_ok() {
    local magic
    magic="$(head -c8 -- "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
    [ "$magic" = 213c617263683e0a ]   # !<arch>\n
}

# Is this argument meant to be a local .deb file? Same three narrow rules as
# is_local_rpm_arg, and it MUST be asked first: is_local_rpm_arg answers true
# for any argument containing a slash, so `apex install ./claude.deb` would
# otherwise be refused as "not an RPM package".
is_local_deb_arg() {
    case "$1" in
        *.deb) return 0 ;;   # named as a file, whether or not it exists yet
        */*)   [ -f "$1" ] && deb_magic_ok "$1" ;;
        *)     return 1 ;;
    esac
}

# Debian policy says a package name is lowercase. Real vendor .debs are not:
# Cisco ships `Package: PacketTracer`. Refusing those would be pedantry, so the
# rule enforced here is the one that matters — the name out of an untrusted
# archive becomes a path under DEB_DIR in a script running as root, so no
# slash, no traversal, no leading dash, nothing a shell would reinterpret.
valid_deb_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9+._-]*$ ]]
}

deb_id()         { printf 'deb:%s' "$1"; }
is_deb_id()      { case "$1" in deb:?*) return 0 ;; esac; return 1; }
deb_name()       { printf '%s' "${1#deb:}"; }
deb_cache()      { printf '%s/%s.deb'   "$DEB_DIR" "$(deb_name "$1")"; }
deb_marker()     { printf '%s/%s.trust' "$DEB_DIR" "$(deb_name "$1")"; }
deb_entry_file() { printf '%s/%s.entry' "$DEB_DIR" "$(deb_name "$1")"; }
deb_manifest()   { printf '%s/%s.files' "$DEB_DIR" "$(deb_name "$1")"; }

have_flatpak() { command -v flatpak >/dev/null 2>&1; }

msg()  { printf 'apex-pkg: %s\n' "$*" >&2; }
warn() { printf 'apex-pkg: warning: %s\n' "$*" >&2; }
die()  { printf 'apex-pkg: error: %s\n' "$*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" = 0 ] || die "this needs root; try: sudo apex ${1:-install} ..."
}

# Serialise every mutation. A second `apex install` racing a rebuild would
# publish an image built from a half-written requested list.
take_lock() {
    mkdir -p "$PKG_ROOT"
    exec 9>"$LOCK"
    flock -n 9 || die "another apex package operation is in progress"
}

os_id()      { . /usr/lib/os-release; printf '%s' "$ID"; }
os_version() { . /usr/lib/os-release; printf '%s' "$VERSION_ID"; }

json_string_array() {
    # stdin: one item per line -> compact JSON array
    jq -R -s 'split("\n") | map(select(length > 0))'
}

# ── requested-package list ───────────────────────────────────────────────────
load_requested() {
    [ -f "$REQUESTED" ] || return 0
    grep -vE '^\s*(#|$)' "$REQUESTED" || true
}

save_requested() {
    mkdir -p "$PKG_ROOT"
    printf '%s\n' "$@" | awk 'NF' | sort -u > "${REQUESTED}.tmp"
    mv -f "${REQUESTED}.tmp" "$REQUESTED"
}

# ── local .rpm files ─────────────────────────────────────────────────────────

# Everything that can be wrong with a file the user pointed at is decided here,
# once, BEFORE anything is copied, downloaded or built. Sets LR_PATH, LR_NAME,
# LR_EVR and LR_ARCH; dies otherwise.
#
# It sets globals rather than printing them because `die` inside a command
# substitution only kills the subshell — the caller would carry on with an empty
# value, which is exactly the fail-open shape this file must not have.
inspect_local_rpm() {
    local arg="$1" hdr installed
    [ -e "$arg" ] || die "no such file: ${arg}"
    [ -f "$arg" ] || die "not a regular file: ${arg}"
    [ -r "$arg" ] || die "cannot read ${arg} (permission denied)"
    # The user may well have typed a relative path, and nothing after this point
    # can rely on the working directory: the rebuild that runs at boot has none.
    LR_PATH="$(readlink -f -- "$arg")" || die "cannot resolve the path ${arg}"
    [ -f "$LR_PATH" ] || die "not a regular file: ${arg}"
    rpm_magic_ok "$LR_PATH" || die "${arg} is not an RPM package (no RPM header)"

    hdr="$(rpm -qp --nosignature --qf '%{NAME}|%{EVR}|%{ARCH}' -- "$LR_PATH" 2>/dev/null)" \
        || die "cannot read the RPM header of ${arg}"
    LR_NAME="${hdr%%|*}"
    LR_ARCH="${hdr##*|}"
    LR_EVR="${hdr#*|}"; LR_EVR="${LR_EVR%|*}"

    [ -n "$LR_NAME" ] && [ -n "$LR_EVR" ] && [ -n "$LR_ARCH" ] \
        || die "the RPM header of ${arg} has no name/version/architecture"
    valid_pkg_name "$LR_NAME" \
        || die "refusing ${arg}: its package name '${LR_NAME}' is not a valid RPM name"

    case "$LR_ARCH" in
        noarch|"$(uname -m)") ;;
        *) die "refusing ${arg}: it is built for ${LR_ARCH}, this machine is $(uname -m)" ;;
    esac

    if [[ "$LR_NAME" =~ $REFUSE_RE ]]; then
        die "refusing ${arg}: '${LR_NAME}' is a kernel or core-system package, which must ship in the APEX image, not an extension"
    fi
    if installed="$(rpm -q --qf '%{EVR}' -- "$LR_NAME" 2>/dev/null)"; then
        die "refusing ${arg}: APEX-OS already ships ${LR_NAME}-${installed}. Replacing an image package from an extension is an OS update, not a package install"
    fi
}

# True when the RPM verifies against a keyring APEX already trusts: the immutable
# system rpmdb (Fedora, RPM Fusion) or the writable COPR keyring under /var.
# Leaves rpmkeys' own words in RPM_SIGSTATUS so the refusal can quote them.
rpm_signature_ok() {
    local rpmfile="$1"
    if RPM_SIGSTATUS="$(rpmkeys --checksig -- "$rpmfile" 2>&1)" \
       && [[ "$RPM_SIGSTATUS" = *"digests signatures OK"* ]]; then
        return 0
    fi
    if [ -d "$COPR_KEY_DB" ]; then
        local copr
        if copr="$(rpmkeys --dbpath "$COPR_KEY_DB" --checksig -- "$rpmfile" 2>&1)" \
           && [[ "$copr" = *"digests signatures OK"* ]]; then
            RPM_SIGSTATUS="$copr"
            return 0
        fi
    fi
    return 1
}

# Has the user explicitly accepted THIS package as unverifiable, and are these
# still the exact bytes they accepted? The marker holds the checksum of the
# cached file, so swapping the cache for different content revokes the decision
# instead of inheriting it.
trusted_unsigned() {
    local marker; marker="$(local_marker "$1")"
    [ -f "$marker" ] || return 1
    [ "$(cat "$marker" 2>/dev/null)" = "$(sha "$2")" ]
}

# The refusal a user sees for a file no trusted key covers. It has to name the
# file, quote rpmkeys, and give the exact command that would proceed — a bare
# "unsigned package" leaves them with nothing to do but give up or find a worse
# tool. It is never a prompt: this runs from `apex update` and from a boot-time
# unit, where there is no terminal to answer one.
refuse_unsigned() {
    local file="$1"
    printf 'apex-pkg: error: %s\n' \
        "cannot verify ${file}" \
        "rpmkeys says: ${RPM_SIGSTATUS:-no signature}" \
        "" \
        "APEX checks every RPM against a trusted key before extracting it. This" \
        "file is signed by a key APEX does not have (typical for vendor RPMs" \
        "downloaded from a website) or is not signed at all, so installing it" \
        "means trusting whoever gave it to you and nothing else." \
        "" \
        "If the vendor's own site is where it came from and you accept that:" \
        "  sudo apex install --allow-unsigned ${file}" \
        "" \
        "If it is meant to come from a COPR, add the repository instead — that" \
        "keeps signature checking on:" \
        "  sudo apex repo enable-copr OWNER/PROJECT" >&2
    exit 1
}

# Copy the file into PKG_ROOT so every later rebuild has it. This is what makes
# `apex update` and the post-OS-upgrade rebuild work after the original file (a
# download, a USB stick, a network share) is gone.
cache_local_rpm() {
    local src="$1" name="$2" unsigned="$3" dest marker
    install -d -m0700 "$LOCAL_DIR"
    dest="$(local_cache "$name")"
    marker="$(local_marker "$name")"
    # Written aside and renamed: an interrupted copy must never leave a truncated
    # RPM that the next rebuild would try to extract.
    cp -f -- "$src" "${dest}.tmp"
    mv -f "${dest}.tmp" "$dest"
    if [ "$unsigned" = 1 ]; then
        sha "$dest" > "${marker}.tmp"
        mv -f "${marker}.tmp" "$marker"
    else
        # A file that verifies now must not inherit an old trust decision.
        rm -f "$marker"
    fi
}

# ── .deb: reading the archive ────────────────────────────────────────────────

# The member names, one per line. `ar` is asserted rather than probed for
# because a missing one has to be a refusal, not a silent non-unpack.
deb_members() {
    command -v ar >/dev/null 2>&1 \
        || die "installing a .deb needs 'ar' (from binutils), which this system does not have"
    ar t -- "$1" 2>/dev/null
}

# Print one member on stdout. `ar p` exits 0 and prints NOTHING for a member
# that is not in the archive (measured), so every caller checks the name
# against deb_members first — otherwise a .deb with no control.tar would read
# as one whose control file is empty, and every field would come back blank
# instead of the file being refused.
deb_member() {
    ar p -- "$1" "$2" 2>/dev/null
}

# Run tar over a compressed member, streamed straight out of the ar archive.
#
# The decompressor is chosen from the member's NAME rather than left to tar,
# because `tar -xf -` does not autodetect compression on a pipe: measured on
# GNU tar 1.35, `ar p x.deb control.tar.xz | tar -tf -` answers "Archive is
# compressed. Use -J option" and exits 2. dpkg names the member after the
# compression it used, so the suffix is the declaration; a .deb whose suffix
# lies simply fails to unpack, which is a refusal either way.
deb_tar() {
    local deb="$1" member="$2"; shift 2
    local -a pre=()
    case "$member" in
        *.tar)      ;;
        *.tar.gz)   pre=(-z) ;;
        *.tar.xz)   pre=(-J) ;;
        *.tar.bz2)  pre=(-j) ;;
        *.tar.zst)  pre=(--zstd) ;;
        *.tar.lzma) pre=(--lzma) ;;
        *) die "the .deb member '${member}' uses a compression APEX cannot read" ;;
    esac
    ar p -- "$deb" "$member" | tar ${pre[@]+"${pre[@]}"} "$@"
}

# One field out of a Debian control file, with RFC822 continuation lines folded
# onto it. `Depends:coreutils,libc-bin` — no space after the colon — is what
# Cisco's Packet Tracer .deb actually ships, so the split is on the colon, not
# on whitespace.
deb_control_field() {
    awk -v want="$2" '
        BEGIN { want = tolower(want) ":"; out = ""; on = 0 }
        /^[ \t]/ { if (on) { line = $0; sub(/^[ \t]+/, "", line); out = out " " line } ; next }
        {
            i = index($0, ":")
            if (i > 0 && tolower(substr($0, 1, i)) == want) {
                on = 1
                out = substr($0, i + 1)
                sub(/^[ \t]+/, "", out)
            } else { on = 0 }
        }
        END { sub(/[ \t]+$/, "", out); print out }
    ' "$1"
}

# Just the package name, for `apex remove ./thing.deb`. Deliberately NOT
# inspect_local_deb: remove must work for a package the image has since started
# shipping, and inspect_local_deb refuses exactly that case.
deb_name_of() {
    local deb="$1" members ctl name
    members="$(deb_members "$deb")" || return 1
    local cm
    cm="$(grep -m1 -E '^control\.tar(\.[a-z0-9]+)?$' <<<"$members")" || return 1
    ctl="$(mktemp -d "${TMPDIR:-/tmp}/apex-deb.XXXXXX")" || return 1
    if deb_tar "$deb" "$cm" -xf - -C "$ctl" >/dev/null 2>&1 && [ -f "${ctl}/control" ]; then
        name="$(deb_control_field "${ctl}/control" Package)"
    fi
    rm -rf "$ctl"
    [ -n "${name:-}" ] || return 1
    printf '%s' "$name"
}

# `<name>-<version>.<arch>`, the .deb answer to an rpm's NEVRA. Used for the
# resolved set, so a state file says what is installed in one readable line.
deb_identity() {
    local deb="$1" members cm ctl out=""
    members="$(deb_members "$deb")" || return 1
    cm="$(grep -m1 -E '^control\.tar(\.[a-z0-9]+)?$' <<<"$members")" || return 1
    ctl="$(mktemp -d "${TMPDIR:-/tmp}/apex-deb.XXXXXX")" || return 1
    if deb_tar "$deb" "$cm" -xf - -C "$ctl" >/dev/null 2>&1 && [ -f "${ctl}/control" ]; then
        out="$(deb_control_field "${ctl}/control" Package)"
        out="${out}-$(deb_control_field "${ctl}/control" Version)"
        out="${out}.$(deb_control_field "${ctl}/control" Architecture)"
    fi
    rm -rf "$ctl"
    case "$out" in ''|-.) return 1 ;; esac
    printf '%s' "$out"
}

# The exact package set this transaction would install: one NEVRA per rpm, one
# identity per .deb, sorted. ext_up_to_date compares it and write_state records
# it, so the decision to skip a rebuild and the record of what was built can
# never disagree about the same machine.
#
# A .deb's line carries twelve hex of its sha256 as well as its version, and
# that is not decoration: a vendor reissuing a download without moving the
# version string is ordinary, and on the version alone `apex update` would
# compare two different files and conclude nothing had changed.
resolved_set() {
    local destdir="$1"; shift
    {
        local f d id sum
        for f in "$destdir"/*.rpm; do
            [ -e "$f" ] || continue
            rpm -qp --nosignature --qf '%{NAME}-%{EVR}.%{ARCH}\n' "$f" 2>/dev/null
        done
        for d in "$@"; do
            [ -e "$d" ] || continue
            id="$(deb_identity "$d")" || id="${d##*/}"
            sum="$(sha "$d")"
            printf 'deb:%s+%s\n' "$id" "${sum:0:12}"
        done
    } | LC_ALL=C sort
}

# Does a Debian architecture describe this machine? `all` is Debian's noarch.
# i386 is deliberately NOT accepted on x86_64: the multilib machinery in this
# engine is rpm's, a 32-bit Debian application would need a 32-bit Debian
# userspace, and half-installing one is worse than refusing it.
deb_arch_matches() {
    local a="$1" host; host="$(uname -m)"
    case "$a" in
        all)     return 0 ;;
        amd64)   [ "$host" = x86_64 ] ;;
        arm64)   [ "$host" = aarch64 ] ;;
        armhf)   [ "$host" = armv7l ] ;;
        ppc64el) [ "$host" = ppc64le ] ;;
        s390x|riscv64) [ "$host" = "$a" ] ;;
        *) return 1 ;;
    esac
}

# Everything that can be wrong with a .deb the user pointed at, decided here,
# once, BEFORE anything is copied or extracted. Sets LD_PATH, LD_NAME,
# LD_VERSION, LD_ARCH, LD_DEPENDS, LD_SCRIPTS and LD_DATA_MEMBER; dies
# otherwise. Globals rather than a printed value for the same reason
# inspect_local_rpm uses them: `die` inside a command substitution kills only
# the subshell, and the caller would carry on with an empty value.
inspect_local_deb() {
    local arg="$1" members cm ctl fmt installed
    [ -e "$arg" ] || die "no such file: ${arg}"
    [ -f "$arg" ] || die "not a regular file: ${arg}"
    [ -r "$arg" ] || die "cannot read ${arg} (permission denied)"
    LD_PATH="$(readlink -f -- "$arg")" || die "cannot resolve the path ${arg}"
    [ -f "$LD_PATH" ] || die "not a regular file: ${arg}"
    deb_magic_ok "$LD_PATH" \
        || die "${arg} is not a Debian package (it does not begin with the ar archive magic '!<arch>')"

    members="$(deb_members "$LD_PATH")"
    grep -qx 'debian-binary' <<<"$members" \
        || die "${arg} has no debian-binary member — it is an ar archive, but not a .deb"
    fmt="$(deb_member "$LD_PATH" debian-binary)"
    fmt="${fmt%%$'\n'*}"
    [ "$fmt" = "2.0" ] \
        || die "${arg} declares .deb format '${fmt:-(empty)}'; APEX reads format 2.0"

    cm="$(grep -m1 -E '^control\.tar(\.[a-z0-9]+)?$' <<<"$members")" \
        || die "${arg} has no control archive"
    LD_DATA_MEMBER="$(grep -m1 -E '^data\.tar(\.[a-z0-9]+)?$' <<<"$members")" \
        || die "${arg} has no data archive — there is nothing in it to install"

    ctl="$(mktemp -d "${TMPDIR:-/tmp}/apex-deb.XXXXXX")" || die "cannot create a temporary directory"
    deb_tar "$LD_PATH" "$cm" -xf - -C "$ctl" >/dev/null 2>&1 \
        || { rm -rf "$ctl"; die "cannot read the control archive of ${arg}"; }
    if [ ! -f "${ctl}/control" ]; then
        rm -rf "$ctl"
        die "${arg} has no control file, so nothing states what package it is"
    fi
    LD_NAME="$(deb_control_field "${ctl}/control" Package)"
    LD_VERSION="$(deb_control_field "${ctl}/control" Version)"
    LD_ARCH="$(deb_control_field "${ctl}/control" Architecture)"
    LD_DEPENDS="$(deb_control_field "${ctl}/control" Depends)"
    local pre; pre="$(deb_control_field "${ctl}/control" Pre-Depends)"
    if [ -n "$pre" ]; then
        LD_DEPENDS="${pre}${LD_DEPENDS:+, }${LD_DEPENDS}"
    fi
    # Which maintainer scripts exist. Recorded so the refusal and the warning
    # can NAME them; not one of them is ever executed.
    LD_SCRIPTS=""
    local s
    for s in preinst postinst prerm postrm config; do
        [ -f "${ctl}/${s}" ] && LD_SCRIPTS="${LD_SCRIPTS}${LD_SCRIPTS:+ }${s}"
    done
    rm -rf "$ctl"

    [ -n "$LD_NAME" ] && [ -n "$LD_VERSION" ] && [ -n "$LD_ARCH" ] \
        || die "the control file of ${arg} has no name/version/architecture"
    valid_deb_name "$LD_NAME" \
        || die "refusing ${arg}: its package name '${LD_NAME}' is not a name APEX will turn into a path"
    deb_arch_matches "$LD_ARCH" \
        || die "refusing ${arg}: it is built for Debian architecture '${LD_ARCH}', this machine is $(uname -m)"

    if [[ "$LD_NAME" =~ $REFUSE_RE ]]; then
        die "refusing ${arg}: '${LD_NAME}' is a kernel or core-system package, which must ship in the APEX image, not an extension"
    fi
    if installed="$(rpm -q --qf '%{EVR}' -- "$LD_NAME" 2>/dev/null)"; then
        die "refusing ${arg}: APEX-OS already ships ${LD_NAME}-${installed}. Replacing an image package from an extension is an OS update, not a package install"
    fi
}

# ── .deb: trust ──────────────────────────────────────────────────────────────
# There is no such thing as a verified local .deb, and pretending otherwise
# would be a weaker rule than the RPM path's rather than the same one.
#
# Debian's trust model signs the apt INDEX a package is fetched through, not
# the package file: `Release`/`InRelease` is signed, it names the `Packages`
# index by hash, and `Packages` names each .deb by sha256. Detach the file from
# that chain — download it from a website, copy it off a USB stick — and every
# link is gone. Containerfile.core's 5a-aiapps stage reconstructs the whole
# chain for the image build, key fingerprint pinned in this repository, and it
# takes twenty lines and a network fetch to do it.
#
# `_gpgorigin` (debsigs) is not treated as verification either. APEX carries no
# deb keyring and no policy file saying which keys may sign what, and a
# signature checked against a key taken from the thing it signs proves nothing
# — the same reasoning that made the image PIN both vendors' fingerprints.
#
# So every local .deb needs --allow-unsigned, and the acceptance is recorded
# against that file's exact bytes under DEB_DIR, exactly as it is for an RPM.
deb_trust_refusal() {
    local file="$1" name="$2" depends="$3"
    {
        printf 'apex-pkg: error: %s\n' \
            "cannot verify ${file}" \
            "" \
            "A .deb carries no signature APEX can check. Debian signs the apt" \
            "INDEX a package is downloaded through, not the package file, so a" \
            ".deb sitting on disk is worth exactly as much as wherever you got" \
            "it from. APEX has no deb keyring and does not accept a '_gpgorigin'" \
            "member as proof of anything." \
            ""
        if [ -n "$depends" ]; then
            printf 'apex-pkg: error: %s\n' \
                "APEX also resolves NONE of its dependencies. Debian package" \
                "names do not exist on Fedora, and '${name}' declares these:"
            printf '%s\n' "$depends" | tr ',' '\n' | sed 's/^[[:space:]]*/apex-pkg: error:     /'
            printf 'apex-pkg: error: %s\n' \
                "Anything in that list APEX-OS does not already provide under" \
                "some other name is yours to install." \
                ""
        fi
        printf 'apex-pkg: error: %s\n' \
            "If the vendor's own site is where it came from and you accept both:" \
            "  sudo apex install --allow-unsigned ${file}"
    } >&2
    exit 1
}

# Has the user accepted THIS .deb, and are these still the bytes they accepted?
trusted_deb() {
    local marker; marker="$(deb_marker "$1")"
    [ -f "$marker" ] || return 1
    [ "$(cat "$marker" 2>/dev/null)" = "$(sha "$2")" ]
}

# Copy the .deb into PKG_ROOT so every later rebuild has it, the same contract
# cache_local_rpm keeps: `apex update` and the post-OS-upgrade rebuild must
# still work when the download is long deleted.
cache_local_deb() {
    local src="$1" name="$2" dest marker
    install -d -m0700 "$DEB_DIR"
    dest="$(deb_cache "$name")"
    marker="$(deb_marker "$name")"
    cp -f -- "$src" "${dest}.tmp"
    mv -f "${dest}.tmp" "$dest"
    sha "$dest" > "${marker}.tmp"
    mv -f "${marker}.tmp" "$marker"
}

# ── build ────────────────────────────────────────────────────────────────────

# Download the requested packages plus every dependency the IMAGE does not
# already provide. `--resolve` without `--alldeps` is the whole trick: dnf
# resolves against the host rpmdb, so an extension carries only the delta.
download_rpms() {
    local destdir="$1"; shift
    local -a args=(-y --setopt=keepcache=True download --resolve \
        --arch="$(uname -m)" --arch=noarch --destdir "$destdir")
    # Resolve the 32-bit closure too. RPM Fusion's steam (and every other
    # multilib application) declares its 32-bit libraries as requires, and
    # dnf will not fetch a provider outside the declared arch set — without
    # i686 here the extension ships a client that cannot load its own UI
    # modules ("Could not load module 'vgui2_s.so'"). The guard already
    # treats a protected name in this architecture as purely additive.
    [ "$(uname -m)" = x86_64 ] && args+=(--arch=i686)
    [ "${NO_WEAK_DEPS:-0}" = 1 ] && args+=(--setopt=install_weak_deps=False)
    local repo
    for repo in ${ENABLE_REPOS:-}; do args+=(--enable-repo "$repo"); done
    msg "resolving against the installed image (only missing dependencies are fetched)"
    # Only names and capabilities ever reach this function. A filesystem path is
    # not a package spec — `dnf5 download --resolve /path/to.rpm` answers
    # `No package "/path/to.rpm" available` (measured) — so local files are
    # staged separately, by stage_local_rpms, after this has run.
    dnf5 "${args[@]}" "$@" >&2 || die "dependency resolution failed for: $*"
    compgen -G "${destdir}/*.rpm" >/dev/null || die "nothing to download — is the package name right?"
}

# Does the machine, as it is right now, satisfy this requirement? Asked of
# libdnf5 because it honours version ranges and rich ("(a or b)") dependencies,
# which `rpm -q --whatprovides` does not: on rpm 6.0.2 that reports
# "no package provides python3 >= 3.9" with python3-3.14.6 installed (measured).
# --installed keeps it on the rpmdb, so it costs no network.
installed_provides() {
    dnf5 repoquery --installed --whatprovides "$1" --qf '%{name}\n' 2>/dev/null | grep -q .
}

# Write, one per line into $1, the dependencies of the local RPM files $2.. that
# this machine cannot already satisfy.
#
# WHY THIS IS NOT `dnf5 install /path/to.rpm`: the resolver needs repository
# metadata for the file, and building that needs createrepo_c, which is not in
# the image. Adding it to Containerfile.core would rebuild the slow tier and cost
# the whole fleet a multi-gigabyte update for one command.
#
# So the file's own Requires are filtered against what the image provides and
# what the other files in the same request provide, and the remainder is handed
# to the ordinary repository path as capabilities. `dnf5 download --resolve`
# resolves a capability to its provider and pulls that provider's own missing
# dependencies, so one pass covers the whole transitive closure.
#
# Weak dependencies of the local file are NOT pulled in: `rpm -qpR` lists hard
# Requires only. That is the honest reading of "this file must work", and it is
# what keeps a vendor RPM from dragging in a desktop's worth of Recommends.
local_missing_requires() {
    local out="$1"; shift
    local f req cap provides pkgname
    : > "$out"

    # What this request itself provides: explicit Provides plus every file it
    # ships, because a Requires may name either.
    provides="$( { for f in "$@"; do
                       rpm -qp --nosignature --provides -- "$f" 2>/dev/null | awk 'NF{print $1}'
                       rpm -qp --nosignature -l -- "$f" 2>/dev/null
                   done; } | sort -u )"

    for f in "$@"; do
        pkgname="$(rpm -qp --nosignature --qf '%{NAME}' -- "$f" 2>/dev/null)" || pkgname="$f"
        # Read through a process substitution, NOT a pipe: the loop must stay in
        # this shell so that `die` below ends the run instead of ending a
        # subshell and letting a half-resolved package set continue.
        while IFS= read -r req; do
            [ -n "$req" ] || continue
            # rpmlib(...) describes the archive format, not a package; nothing
            # provides it and the rpm doing the extraction already implements it.
            case "$req" in rpmlib\(*) continue ;; esac

            cap="${req%% *}"
            if printf '%s\n' "$provides" | grep -qxF -- "$cap"; then
                continue
            fi

            case "$req" in
                '('*)
                    # A rich dependency. libdnf5 can evaluate one against the
                    # installed set, but `dnf5 download` cannot accept one as a
                    # package spec, so an unsatisfied one stops the install
                    # rather than producing an extension that is missing a
                    # library the moment it is launched.
                    installed_provides "$req" && continue
                    die "'${pkgname}' needs '${req}', which APEX cannot resolve for a local file. Install something that satisfies it from the repositories first (apex search …), then retry"
                    ;;
            esac

            if rpm -q --whatprovides -- "$cap" >/dev/null 2>&1; then
                # The capability NAME is present. An unversioned requirement is
                # therefore satisfied; a versioned one still has to be checked
                # by something that understands the range.
                [ "$req" = "$cap" ] && continue
                installed_provides "$req" && continue
            fi
            printf '%s\n' "$req" >> "$out"
        done < <(rpm -qpR --nosignature -- "$f" 2>/dev/null)
    done
    sort -u -o "$out" "$out"
}

# Put the cached local files into the download directory, so that from here on
# the pipeline cannot tell them apart from repository packages — which is the
# whole point: guard_rpms, extract_rpms, fix_caches, split_out_of_image,
# label_tree and build_payload then give a local RPM the same PATH binaries,
# .desktop entry, icons, MIME associations and SELinux labels as any other.
stage_local_rpms() {
    local destdir="$1"; shift
    local f n other oname
    for f in "$@"; do
        n="$(rpm -qp --nosignature --qf '%{NAME}' -- "$f" 2>/dev/null)" \
            || die "cannot read the cached RPM ${f}"
        valid_pkg_name "$n" || die "cached RPM ${f} has an invalid package name '${n}'"
        # A dependency chain can pull the repository's build of the same package.
        # The file the user handed us is the one they asked for, so it wins — and
        # says so, because the two versions need not match.
        for other in "$destdir"/*.rpm; do
            [ -e "$other" ] || continue
            oname="$(rpm -qp --nosignature --qf '%{NAME}' -- "$other" 2>/dev/null)" || continue
            if [ "$oname" = "$n" ]; then
                warn "'${n}' also came from a repository; using your local file instead"
                rm -f -- "$other"
            fi
        done
        cp -f -- "$f" "${destdir}/${n}.rpm"
    done
}

# Everything that must be true BEFORE we extract a single file.
# True when every requirement, across every other RPM in the set, that names
# the package $2 is already satisfied by what the image ships. Asked of libdnf5
# because it honours version ranges, exactly like installed_provides.
newer_satisfied_by_image() {
    local destdir="$1" name="$2" other req cap
    for other in "$destdir"/*.rpm; do
        while IFS= read -r req; do
            [ -n "$req" ] || continue
            case "$req" in rpmlib\(*) continue ;; esac
            cap="${req%% *}"
            [ "$cap" = "$name" ] || continue
            # An unversioned requirement of the package name is satisfied by the
            # installed build by definition; only ranges can demand newer.
            [ "$req" = "$cap" ] && continue
            # No `--`: dnf5 repoquery refuses it and prints nothing, so this
            # test answered "not satisfied" for every versioned requirement
            # ever asked about, and guard_rpms refused packages it was written
            # to omit. Same defect as probe_rpm's, same file, found with it.
            # installed_provides() above has always been spelled correctly;
            # this line is why they now look the same.
            dnf5 repoquery --installed --whatprovides "$req" --qf '%{name}\n' 2>/dev/null | grep -q . || return 1
        done < <(rpm -qp --nosignature --requires -- "$other" 2>/dev/null)
    done
    return 0
}

guard_rpms() {
    local destdir="$1"
    local rpmfile name evr arch installed bad=0
    local -A host_evr=()
    for rpmfile in "$destdir"/*.rpm; do
        arch="$(rpm -qp --nosignature --qf '%{ARCH}' "$rpmfile" 2>/dev/null)" || continue
        [ "$arch" = "$(uname -m)" ] || continue
        name="$(rpm -qp --nosignature --qf '%{NAME}' "$rpmfile" 2>/dev/null)" || continue
        host_evr["$name"]="$(rpm -qp --nosignature --qf '%{EVR}' "$rpmfile" 2>/dev/null)"
    done

    for rpmfile in "$destdir"/*.rpm; do
        name="$(rpm -qp --nosignature --qf '%{NAME}' "$rpmfile" 2>/dev/null)" \
            || die "cannot read $rpmfile"
        evr="$(rpm -qp --nosignature --qf '%{EVR}' "$rpmfile" 2>/dev/null)"
        arch="$(rpm -qp --nosignature --qf '%{ARCH}' "$rpmfile" 2>/dev/null)"

        # Already in the image — of the SAME architecture? Then this is either a
        # no-op (same EVR: the overlay would carry a byte-identical copy, so it
        # is skipped) or a REPLACEMENT (different EVR: exactly the class of
        # change that breaks a running system). The check MUST be
        # architecture-qualified: on a multilib system `rpm -q "$name"` returns
        # the x86_64 build, and its EVR says nothing about whether the i686
        # build is present. Judged by name alone, every 32-bit library a 32-bit
        # client needs is silently dropped here as "already provided" and the
        # application then fails to launch with a missing library.
        if [ "$arch" = noarch ]; then
            installed="$(rpm -q --qf '%{EVR}' -- "$name" 2>/dev/null)" || installed=""
        else
            installed="$(rpm -q --qf '%{EVR}' -- "${name}.${arch}" 2>/dev/null)" || installed=""
        fi
        if [ -n "$installed" ]; then
            if [ "$installed" = "$evr" ]; then
                warn "skipping '${name}-${evr}.${arch}': already provided by APEX-OS"
                rm -f "$rpmfile"
                continue
            fi
            # The repositories carry a NEWER build of an installed package. The
            # overlay must never shadow the image's copy, but core is frozen at
            # image build time while resolution always sees current repos — so
            # dnf routinely pulls a newer provider for a capability the
            # installed build already satisfies. Overlaying is then also
            # UNNECESSARY: omit the package and keep the image's copy, but only
            # when every requirement that names it is already satisfied by the
            # image. Something that genuinely needs the newer build is refused —
            # that is an OS update, not a package install.
            if newer_satisfied_by_image "$destdir" "$name"; then
                warn "omitting '${name}-${evr}.${arch}': newer than the image's build, but every requirement naming it is already satisfied — keeping the image's copy"
                rm -f "$rpmfile"
                continue
            fi
            warn "refusing '${name}': needs ${evr} but the image ships ${installed} — that requires an OS update, not a package install"
            bad=1
            rm -f "$rpmfile"
            continue
        fi

        # Not installed at all. A protected name on the host architecture (or
        # noarch) belongs in the image and is refused: kernels and akmods need a
        # real deployment, and a core package the image does not ship is one the
        # image wants absent. But a 32-bit MULTILIB sibling (i686 on x86_64)
        # shadows nothing — the image ships none of that architecture — and
        # refusing it made every 32-bit application, Steam included,
        # uninstallable through the documented `apex install` path.
        # A 32-bit twin whose 64-bit sibling is in this set with a DIFFERENT
        # EVR is an application fork, not a multilib library: rpm cannot
        # install both (the older one reads as a downgrade, and the shared
        # launcher/data files collide). The 32-bit LIBRARIES the machine needs
        # are separate packages that share the EVR across arches — those are
        # kept; this copy is dropped.
        if [ "$arch" != "$(uname -m)" ] && [ "$arch" != noarch ] \
            && [ -n "${host_evr[$name]:-}" ] && [ "${host_evr[$name]}" != "$evr" ]; then
            warn "dropping '${name}-${evr}.${arch}': a 32-bit copy of the application (the set has ${name}-${host_evr[$name]}.$(uname -m)); a 32-bit package is libraries, not a second copy of the program"
            rm -f "$rpmfile"
            continue
        fi

        if [[ "$name" =~ $REFUSE_RE ]]; then
            if [ "$arch" = "$(uname -m)" ] || [ "$arch" = noarch ]; then
                warn "refusing '${name}': kernel- or core-system packages must ship in the APEX image, not an extension"
                bad=1
                continue
            fi
            warn "allowing '${name}-${evr}.${arch}': multilib sibling of a core package; the image ships none of this architecture"
        fi
    done

    [ "$bad" = 0 ] || die "refused one or more packages (see above); nothing was changed"
    compgen -G "${destdir}/*.rpm" >/dev/null \
        || die "every requested package is already part of APEX-OS — nothing to install"

    # Signature check. Image repositories use the immutable system rpmdb. COPRs
    # opted into with `apex repo enable-copr` use APEX's writable keyring under
    # /var because a bootc deployment's /usr/lib/sysimage/rpm cannot be modified.
    # An unsigned or unknown-key package is a hard stop, never a prompt.
    #
    # The ONE exception is a local file the user explicitly accepted with
    # --allow-unsigned, and it is not a bypass: the acceptance is a marker under
    # LOCAL_DIR holding that file's checksum, so it covers those exact bytes and
    # nothing else. Repository packages can never reach it, because nothing ever
    # writes a marker for them.
    local verified=0 trusted=0
    for rpmfile in "$destdir"/*.rpm; do
        if rpm_signature_ok "$rpmfile"; then
            verified=$((verified + 1))
            continue
        fi
        name="$(rpm -qp --nosignature --qf '%{NAME}' -- "$rpmfile" 2>/dev/null)" || name=""
        if [ -n "$name" ] && trusted_unsigned "$name" "$rpmfile"; then
            warn "'${name}': installed from a local file you accepted with --allow-unsigned — its signature is NOT verified"
            trusted=$((trusted + 1))
            continue
        fi
        die "unsigned or untrusted package: ${RPM_SIGSTATUS:-no signature}"
    done
    if [ "$trusted" -gt 0 ]; then
        msg "${verified} package(s) verified against trusted keys, ${trusted} accepted unverified by you"
    else
        msg "${verified} package(s) verified against the repository keys"
    fi
}

# Merge the non-host-architecture tree into the payload, carrying only what
# nothing else already provides.
#
# ONE RULE: a file from the 32-bit pass is carried if, and only if, neither the
# running image nor this transaction's own native pass already provides that
# exact path.
#
# That single sentence replaces the list of --excludepath directories this
# function used to carry, and it replaces it because the list was wrong twice
# over, in OPPOSITE directions, on the same machine on the same day
# (ROADMAP/evidence/katana-qualification-20260919.md, §3 and §6.5):
#
#   TOO NARROW. /usr/bin, /usr/sbin, /usr/share and /etc were excluded and
#   nothing else, so i686 helper EXECUTABLES under /usr/libexec walked straight
#   in. A plain `apex install steam` shadowed 14 image binaries, because
#   at-spi2-core.i686, dconf.i686, glib2.i686, glib-networking.i686,
#   glycin-loaders.i686, gstreamer1.i686 and p11-kit.i686 are all in
#   steam.i686's dependency closure. gst-plugin-scanner is the one that bites:
#   GStreamer probes every plugin through it out of process, so a 32-bit scanner
#   loads no 64-bit plugin and the registry fell from 1344 usable features to 2.
#   The greeter was left running a 32-bit accessibility bus by the same route.
#
#   TOO BLUNT. --excludepath /usr/share threw away every *_icd.i686.json while
#   keeping the .so files those manifests name, so /usr/share/vulkan/icd.d held
#   13 x86_64 ICDs and zero i686 ones. Steam's client is ubuntu12_32/steam, so
#   it needs 32-bit Vulkan, and it died with VK_ERROR_INCOMPATIBLE_DRIVER. A
#   manifest called nvidia_icd.i686.json cannot shadow anything — nothing else
#   on the system has that name — and the rule above keeps it for that reason,
#   while still dropping the /usr/share/doc, /usr/share/man, icon and locale
#   copies the exclusion was written for, because the image owns those paths.
#
# Adding /usr/libexec to the old list would have fixed seven packages and
# nothing about the eighth directory nobody had thought of yet. The list was the
# defect, not its contents.
#
# `--excludepath` is prefix-based and all-or-nothing, so "keep only what is
# unclaimed" cannot be expressed to rpm at all. The foreign set is therefore
# unpacked into a scratch root of its own and merged from here.
#
# The image half of the test is the same question install_etc's removal pass
# asks before it deletes anything, and for the same reason: the rpmdb is the
# only thing on this machine that knows which paths belong to the OS.
#
# FAILING CLOSED HERE IS THE OPPOSITE OF image_owns(). There, "cannot tell who
# owns it" must mean KEEP the file — a wrongly deleted /etc/fonts/fonts.conf is
# unrecoverable. Here it must mean REFUSE THE WHOLE MERGE, because an empty
# owner list reads as "the image owns nothing" and would carry every 32-bit copy
# of every image path into the extension: precisely the disaster this pass
# exists to prevent. So an rpm that cannot answer, or answers with nothing, is a
# hard stop.
merge_multilib() {
    local scratch="$1" root="$2"
    local idx="${scratch}.image-paths"
    local all="${scratch}.all" unowned="${scratch}.unowned"
    local keep="${scratch}.keep" drop="${scratch}.drop"

    rpm -qal > "$idx" 2>/dev/null \
        || die "cannot ask the rpmdb which files the image owns — refusing to merge the 32-bit set blind"
    [ -s "$idx" ] \
        || die "the system rpmdb listed no files at all — refusing to merge the 32-bit set blind"
    LC_ALL=C sort -u -o "$idx" "$idx"

    ( cd "$scratch" && find . -mindepth 1 \( -type f -o -type l \) -printf '/%P\n' ) \
        | LC_ALL=C sort > "$all"

    # Not owned by any package installed in the image …
    LC_ALL=C awk 'NR==FNR { own[$0]; next } !($0 in own)' "$idx" "$all" > "$unowned"

    # … and not already placed by this transaction's native pass. That second
    # clause is what keeps fontconfig.i686's /usr/bin/fc-list out when the set
    # carries fontconfig.x86_64 too: the image-owner test cannot see a package
    # that is not installed yet.
    : > "$keep"
    local rel
    while IFS= read -r rel; do
        if [ -e "${root}${rel}" ] || [ -L "${root}${rel}" ]; then
            continue
        fi
        printf '%s\n' "$rel" >> "$keep"
    done < "$unowned"

    local n_all n_unowned n_keep
    n_all=$(wc -l < "$all"); n_unowned=$(wc -l < "$unowned"); n_keep=$(wc -l < "$keep")
    msg "multilib: carrying ${n_keep} of ${n_all} file(s) from the 32-bit set ($((n_all - n_unowned)) already owned by the image, $((n_unowned - n_keep)) already placed by this set's native packages)"

    LC_ALL=C comm -23 "$all" "$keep" > "$drop"
    if [ -s "$drop" ]; then
        sed "s|^|${scratch}|" "$drop" | tr '\n' '\0' | xargs -0 -r rm -f
    fi
    # Directories emptied by that must not be carried either: every
    # /usr/share/doc/<pkg>, /usr/share/licenses/<pkg> and
    # /usr/share/locale/*/LC_MESSAGES the image already owns would otherwise
    # reach the extension as an empty directory.
    find "$scratch" -mindepth 1 -depth -type d -empty -delete 2>/dev/null || true

    if [ -n "$(ls -A "$scratch" 2>/dev/null)" ]; then
        # || die rather than || true: the only way this fails is a path that is
        # a directory in one tree and a file in the other, and silently half
        # merging a payload is how you ship an extension nobody can explain.
        cp -a "${scratch}/." "${root}/" \
            || die "merging the 32-bit set into the payload failed"
    fi
    rm -f "$idx" "$all" "$unowned" "$keep" "$drop"
}

extract_rpms() {
    local destdir="$1" root="$2"
    mkdir -p "$root"
    # --noscripts: scriptlets assume a live system and a writable /usr. The ones
    #   that matter (ldconfig, sysusers, tmpfiles, schema/desktop/mime caches) are
    #   emulated below against the union of image + extension.
    # --noplugins: the selinux/systemd-inhibit plugins target the running system;
    #   labelling is done explicitly with setfiles once the tree is complete.
    # --nosignature: every package was already checked against the SYSTEM keyring
    # in guard_rpms. This throwaway root has an empty keyring, so leaving it on
    # would print a NOKEY warning per package that means nothing.
    rpm --root "$root" --initdb

    # Multilib is extracted in a SECOND pass, and merged rather than unpacked
    # straight onto the first.
    #
    # A 32-bit package is not a 32-bit version of an application; it is the
    # libraries a 32-bit application needs. `fontconfig.i686` still carries
    # /usr/bin/fc-list, /usr/share and /etc, byte-for-byte the same paths as the
    # x86_64 build. One `rpm -Uvh --replacefiles` over both arches lets whichever
    # lands last win, and on this machine i686 won: /usr/bin/fc-list became an
    # ELF 32-bit i386 binary shadowing the image's own, `fc-list` then returned
    # zero fonts, and Steam drew its interface with no text at all. dnf never
    # hits this because multilib packages are filtered to libraries before they
    # are ever unpacked together.
    #
    # So: native and noarch into the payload root, then everything else into a
    # scratch root of its own, and merge_multilib decides file by file what may
    # cross. /boot is the one thing still excluded outright in both passes — a
    # system extension merges /usr and /opt, and a kernel or bootloader file has
    # no way to reach the running system from here even in principle.
    local -a native=() foreign=() host
    host="$(uname -m)"
    local f arch
    for f in "$destdir"/*.rpm; do
        arch="$(rpm -qp --nosignature --qf '%{ARCH}' -- "$f" 2>/dev/null)"
        if [ "$arch" = "$host" ] || [ "$arch" = noarch ]; then
            native+=("$f")
        else
            foreign+=("$f")
        fi
    done

    if [ ${#native[@]} -gt 0 ]; then
        rpm --root "$root" -Uvh --nodeps --noscripts --notriggers --noplugins \
            --nosignature --replacefiles --replacepkgs --excludepath /boot \
            "${native[@]}" >&2 || die "extraction failed"
    fi
    if [ ${#foreign[@]} -gt 0 ]; then
        # Next to $root, which under build_extension means inside $WORK, so the
        # existing RETURN trap removes it on every `die` path too.
        local scratch="${root}.multilib"
        rm -rf "$scratch"
        mkdir -p "$scratch"
        rpm --root "$scratch" --initdb
        rpm --root "$scratch" -Uvh --nodeps --noscripts --notriggers --noplugins \
            --nosignature --replacefiles --replacepkgs --excludepath /boot \
            "${foreign[@]}" >&2 || die "extraction of the multilib set failed"
        rm -rf "${scratch}/usr/share/rpm" "${scratch}/var/lib/rpm" \
               "${scratch}/usr/lib/sysimage/rpm"
        merge_multilib "$scratch" "$root"
        rm -rf "$scratch"
    fi
    rm -rf "${root}/usr/share/rpm" "${root}/var/lib/rpm" "${root}/usr/lib/sysimage/rpm"
}

# ── .deb: where the image really is ──────────────────────────────────────────
# NOT `/usr`. While an extension is merged, /usr is an overlay whose upper
# layers ARE the extension this function is deciding about, so asking the
# running /usr would report every path the previous build placed as belonging
# to the image, and `apex update` would then refuse to rebuild what it built
# itself. Measured on this machine: /usr is mounted `overlay sysext ...
# lowerdir=/run/systemd/sysext/meta/usr:/run/systemd/sysext/extensions/apex-user/usr:/usr`.
#
# NOT the rpmdb either, which is what image_owns() asks for RPM paths. The
# rpmdb is BLIND to the one application this whole route exists for:
# Containerfile.core's 5a-aiapps stage puts Claude Desktop into
# /usr/lib/claude-desktop with `cp -a` (Anthropic publishes no rpm — five
# rpm/yum prefixes under downloads.claude.ai all 404), so no package owns a
# single one of its 1,190 files and `rpm -qf` answers "not owned" for every
# one. A guard built on the rpmdb would wave a .deb straight over the image's
# own copy of the app.
#
# The booted ostree deployment is the pristine image, files and all, and the
# kernel command line says which one it is. Failing CLOSED here is the same
# choice merge_multilib makes and the opposite of image_owns(): "I cannot tell
# what the image has" must stop a .deb from shadowing /usr, because an empty
# answer reads as "the image owns nothing".
image_hierarchy_root() {
    if [ ! -e /run/ostree-booted ]; then
        # Not an image-based system at all — a container, a CI runner, a test
        # fixture. There is no extension overlaying anything there, so the live
        # root IS the image.
        printf '/'
        return 0
    fi
    local param dir
    param="$(awk '{for (i = 1; i <= NF; i++) if ($i ~ /^ostree=/) { print substr($i, 8); exit }}' /proc/cmdline)"
    [ -n "$param" ] \
        || die "cannot tell which deployment is booted (no ostree= on the kernel command line) — refusing to decide what the image owns"
    dir="$(readlink -f -- "$param" 2>/dev/null)" || dir=""
    { [ -n "$dir" ] && [ -d "${dir}/usr" ]; } \
        || die "the booted deployment '${param}' has no /usr — refusing to decide what the image owns blind"
    printf '%s' "$dir"
}

# ── .deb: the payload ────────────────────────────────────────────────────────

# Collapse `.` and `..` out of a path without touching the filesystem. Used on
# symlink targets, which may legitimately be relative: claude-desktop's own
# /usr/bin/claude-desktop is `../lib/claude-desktop/claude-desktop`, so a blunt
# "no .. in a link target" rule would refuse the driver package for this route.
deb_norm_path() {
    local rest="${1}/" out="" seg
    while [ -n "$rest" ]; do
        seg="${rest%%/*}"
        rest="${rest#*/}"
        case "$seg" in
            ''|.) ;;
            ..)   out="${out%/*}" ;;
            *)    out="${out}/${seg}" ;;
        esac
    done
    printf '%s' "${out:-/}"
}

# Every member name in the data archive, checked BEFORE a byte is written.
#
# GNU tar 1.35 does defend itself against the classic symlink escape — measured
# here with an archive holding `usr/evil -> ../../outside` followed by
# `usr/evil/victim`: it refuses with "Cannot open: Not a directory", exits 2,
# and the file outside the extraction root is untouched. This pass is the layer
# that does not depend on that: an absolute member name or a `..` component is
# refused outright, and so is a name carrying an escape sequence, because the
# walk that judges the extracted tree reads one path per line and a name
# containing a newline would split into two.
deb_names_ok() {
    local deb="$1" member="$2" name="$3"
    local names n bad=0
    names="$(deb_tar "$deb" "$member" --quoting-style=escape -tf -)" \
        || die "cannot list the contents of ${name}'s data archive"
    [ -n "$names" ] || die "refusing '${name}': its data archive is empty"
    while IFS= read -r n; do
        [ -n "$n" ] || continue
        case "$n" in
            /*)   warn "refusing '${name}': it ships an absolute path '${n}'"; bad=1 ;;
            *\\*) warn "refusing '${name}': the member name '${n}' contains an escape sequence"; bad=1 ;;
        esac
        case "/${n}/" in
            */../*) warn "refusing '${name}': the member name '${n}' climbs out of the package"; bad=1 ;;
        esac
    done <<<"$names"
    [ "$bad" = 0 ] || die "refusing '${name}': its data archive names paths outside itself"
}

# type, path and (for a symlink) its target, one entry per line, for a tree the
# .deb has been unpacked into.
deb_walk() {
    ( cd "$1" && find . -mindepth 1 -printf '%y\t/%P\t%l\n' )
}

# Is this the Debian multiarch directory (x86_64-linux-gnu, arm-linux-gnueabihf)?
deb_is_multiarch_dir() {
    [[ "$1" =~ ^[a-z0-9_]+-linux-(gnu|musl)[a-z0-9]*$ ]]
}

# WHAT A .deb IS ALLOWED TO PLACE, and the three reasons the list is this short.
#
# 1. A system extension merges /usr and /opt, and NOTHING else. rpm's own
#    extractions get /etc and /var lifted out by split_out_of_image and folded
#    from /lib and /bin by the same function, because measured cases demanded
#    it. There is no such case for a .deb and there are two reasons not to
#    invent one: /etc holds Debian CONFFILES whose whole lifecycle is dpkg's
#    (and install_etc's removal pass is the one that ate 26 image-owned /etc
#    files in September), and a Debian package has been merged-usr since
#    bookworm, so a payload outside /usr and /opt is a package APEX does not
#    understand rather than one it should silently reshape. All three real
#    .debs measured while writing this — claude-desktop, opencode, Cisco Packet
#    Tracer — ship only ./usr and ./opt.
#
# 2. DEBIAN LIBRARIES GO WHERE FEDORA DOES NOT LOOK, AND WHERE THEY DO GET
#    LOOKED AT THEY ARE THE WRONG ONES. Debian puts shared libraries in
#    /usr/lib/x86_64-linux-gnu; Fedora's dynamic linker searches /usr/lib64.
#    Translating between them is not an option: a Debian libfoo.so.1 dropped
#    into /usr/lib64 is found by EVERY program on the machine, and it was built
#    against a different glibc and a different soname set. That is the
#    fontconfig.i686 defect over again — /usr/bin/fc-list became a 32-bit
#    binary, fc-list returned zero fonts and Steam drew no text — except an
#    extension cannot be un-merged by rebooting. Symlinking the multiarch
#    directory has the same effect by another route. Leaving it verbatim is
#    honest but useless: nothing on Fedora reads that path, so the package
#    installs and then does not work. So a .deb that ships a shared library
#    into a search path or a multiarch directory is REFUSED, and says why.
#
#    A library under the package's OWN directory is a different thing and is
#    carried: /usr/lib/claude-desktop/libEGL.so is found by claude-desktop's
#    own RPATH and by nothing else. That is the Electron case, which is most of
#    what ships as a .deb and nothing else.
#
# 3. Kernel modules need an initramfs and a real deployment, which is the same
#    refusal split_out_of_image makes for an rpm.
deb_layout_ok() {
    local scratch="$1" name="$2"
    local t p l bad=0 tgt d comp rest files=0
    while IFS=$'\t' read -r t p l; do
        case "$p" in
            /usr|/opt|/usr/*|/opt/*) ;;
            *)
                warn "refusing '${name}': it ships '${p}', and a system extension merges only /usr and /opt"
                bad=1; continue ;;
        esac
        if [ "$t" = l ]; then
            case "$l" in
                /*) tgt="$(deb_norm_path "$l")" ;;
                *)  tgt="$(deb_norm_path "${p%/*}/${l}")" ;;
            esac
            case "$tgt" in
                /usr|/opt|/usr/*|/opt/*) ;;
                *)
                    warn "refusing '${name}': the symlink '${p}' points at '${tgt}', outside the hierarchies an extension can merge"
                    bad=1; continue ;;
            esac
        fi
        case "$p" in
            /usr/lib/modules/*|/usr/lib/firmware/*)
                warn "refusing '${name}': it ships '${p}' — kernel modules and firmware need an image build, not an extension"
                bad=1; continue ;;
        esac
        # Directories carry no code; only a file or a link can shadow a library.
        [ "$t" = d ] && continue
        files=$((files + 1))
        d="${p%/*}"
        # Every path component, without word splitting: a component holding a
        # glob character would otherwise be expanded against the real
        # filesystem by `for comp in ${p//\// }`.
        rest="${p#/}"
        while [ -n "$rest" ]; do
            comp="${rest%%/*}"
            if [ "$rest" = "$comp" ]; then rest=""; else rest="${rest#*/}"; fi
            if deb_is_multiarch_dir "$comp"; then
                warn "refusing '${name}': it ships '${p}' into a Debian multiarch directory. Fedora's dynamic linker never looks there, and moving it to /usr/lib64 would put a Debian build of a library in front of the one APEX-OS runs on"
                bad=1
                continue 2
            fi
        done
        case "${p##*/}" in
            *.so|*.so.*)
                case "$d" in
                    /lib|/lib64|/usr/lib|/usr/lib64)
                        warn "refusing '${name}': it ships the shared library '${p}' where the system linker looks. An extension putting a Debian build of a library in front of the image's own is not recoverable without a rollback"
                        bad=1; continue ;;
                esac ;;
        esac
    done < <(deb_walk "$scratch")
    # A data archive of nothing but directories installs nothing and reports
    # success, which is the shape of every defect this engine has had.
    [ "$files" -gt 0 ] \
        || die "refusing '${name}': its payload contains no files at all, only directories"
    [ "$bad" = 0 ] \
        || die "refusing '${name}': see above. A .deb whose payload cannot be placed is refused rather than half-installed"
}

# THE PACKAGE MUST BRING ITS OWN WAY IN.
#
# A .deb's maintainer scripts are never run, and for a whole class of packages
# the maintainer script is what creates the program's entry point. This engine
# already learned that shape from rpm: `apex install wine` extracted with
# --noscripts produced /usr/bin/wine32 and wine64 as real files, /usr/bin/wine
# ABSENT, and twelve dangling symlinks pointing at it — and reported success.
#
# The rule here is read off the PAYLOAD rather than off the scripts, because a
# script grep gets this wrong in both directions. opencode's postinst runs
# `update-alternatives --install /usr/bin/ai.opencode.desktop ...`, which looks
# exactly like the wine case; but its .desktop entry already says
# `Exec=/opt/OpenCode/ai.opencode.desktop`, a path the package ships, so it
# launches from a menu with no script run at all. Cisco's Packet Tracer ships
# /opt/pt and NOTHING else — no binary on PATH, no .desktop — and is refused,
# correctly, because without its postinst there is no way to start it.
#
# Prints the entry point it found; returns non-zero when there is none.
deb_entry_point() {
    local scratch="$1"
    local p desktop line first
    for p in "${scratch}/usr/bin"/* "${scratch}/usr/sbin"/*; do
        { [ -e "$p" ] || [ -L "$p" ]; } || continue
        [ -d "$p" ] && continue
        printf '%s' "/${p#"${scratch}/"}"
        return 0
    done
    for desktop in "${scratch}/usr/share/applications"/*.desktop; do
        [ -f "$desktop" ] || continue
        line="$(grep -m1 '^Exec=' "$desktop" 2>/dev/null)" || continue
        first="${line#Exec=}"
        first="${first%% *}"
        [ -n "$first" ] || continue
        case "$first" in
            /*) { [ -e "${scratch}${first}" ] || [ -L "${scratch}${first}" ]; } || continue
                printf '%s' "$first"; return 0 ;;
            *)  { [ -e "${scratch}/usr/bin/${first}" ] || [ -L "${scratch}/usr/bin/${first}" ]; } || continue
                printf '%s' "/usr/bin/${first}"; return 0 ;;
        esac
    done
    return 1
}

# Nothing a .deb ships may sit on top of something the image already provides,
# or on top of a path this same transaction's RPMs have already placed.
#
# $3 is the image hierarchy root rather than a constant so the suite can drive
# this over a fixture tree — the same reason state_kind() takes the state path
# as a parameter instead of reading an environment override in a script that
# runs as root.
deb_shadow_ok() {
    local scratch="$1" root="$2" imgroot="$3" name="$4"
    local t p l bad=0 img
    img="${imgroot%/}"
    while IFS=$'\t' read -r t p l; do
        if [ "$t" = d ]; then
            # Two packages sharing /usr/bin is not a conflict; a package whose
            # directory lands where the image keeps a file is.
            if { [ -e "${img}${p}" ] || [ -L "${img}${p}" ]; } && [ ! -d "${img}${p}" ]; then
                warn "refusing '${name}': it needs '${p}' to be a directory and APEX-OS has a file there"
                bad=1
            fi
            continue
        fi
        # -e is false for a dangling symlink, which is a file that exists.
        if [ -e "${img}${p}" ] || [ -L "${img}${p}" ]; then
            warn "refusing '${name}': APEX-OS already provides '${p}'. An extension may not shadow the image — that is an OS update, not a package install"
            bad=1
            continue
        fi
        if [ -e "${root}${p}" ] || [ -L "${root}${p}" ]; then
            warn "refusing '${name}': '${p}' is also shipped by a package already in this transaction"
            bad=1
        fi
    done < <(deb_walk "$scratch")
    [ "$bad" = 0 ] || die "refusing '${name}': see above; nothing was changed"
}

# Has an image update started shipping what this .deb provides? Then the .deb
# must leave, exactly as rebuild_extension drops an rpm the image has adopted.
#
# Fails OPEN — "cannot tell" means keep — which is the opposite direction from
# deb_shadow_ok above and the same asymmetry image_owns() documents: a package
# wrongly kept is refused loudly by the shadow guard a moment later, while a
# package wrongly dropped is software that silently disappears.
deb_superseded_by_image() {
    local id="$1" entry imgroot
    entry="$(cat "$(deb_entry_file "$id")" 2>/dev/null)" || return 1
    [ -n "$entry" ] || return 1
    # image_hierarchy_root dies on a machine whose deployment it cannot find;
    # inside this substitution that ends the subshell and returns non-zero,
    # which is the fail-open answer this caller wants.
    imgroot="$(image_hierarchy_root 2>/dev/null)" || return 1
    [ -n "$imgroot" ] || return 1
    imgroot="${imgroot%/}"
    [ -e "${imgroot}${entry}" ] || [ -L "${imgroot}${entry}" ]
}

# Unpack the cached .deb files into the payload the RPM passes have already
# built.
#
# It runs AFTER extract_rpms and BEFORE fix_caches, and neither is arbitrary.
# After, so the shadow guard can see every path this transaction's RPMs placed
# and refuse a collision instead of letting `cp -a` decide it. Before, so the
# desktop, MIME and GSettings caches are rebuilt over the union of image,
# RPMs and .debs — which is precisely the `update-desktop-database` and
# `update-mime-database` work the maintainer script would have done, done by
# the engine over a tree it understands instead of by vendor code running as
# root.
extract_debs() {
    local root="$1"; shift
    local imgroot
    imgroot="$(image_hierarchy_root)" || die "cannot locate the image hierarchy"
    [ -n "$imgroot" ] || die "cannot locate the image hierarchy"

    local deb name scratch entry
    for deb in "$@"; do
        inspect_local_deb "$deb"
        name="$LD_NAME"
        msg "unpacking ${name}-${LD_VERSION} (.deb)"
        scratch="${root}.deb-${name}"
        rm -rf "$scratch"
        mkdir -p "$scratch"

        deb_names_ok "$deb" "$LD_DATA_MEMBER" "$name"
        # --no-same-owner: a .deb records numeric ids, and a member owned by
        # uid 1000 would otherwise land in /usr owned by whoever happens to
        # hold that id. -p keeps the modes, which matters for exactly one
        # thing in practice: claude-desktop ships chrome-sandbox as 4755 and
        # Chromium refuses to start when it finds that helper present but not
        # setuid.
        deb_tar "$deb" "$LD_DATA_MEMBER" -xf - -C "$scratch" --no-same-owner -p \
            || die "unpacking ${name}'s data archive failed"

        deb_layout_ok "$scratch" "$name"
        deb_shadow_ok "$scratch" "$root" "$imgroot" "$name"
        entry="$(deb_entry_point "$scratch")" \
            || die "refusing '${name}': it ships no program APEX can start — no executable in /usr/bin and no desktop entry whose Exec is a path the package ships. Its entry point is created by a maintainer script${LD_SCRIPTS:+ (${LD_SCRIPTS})}, and APEX never runs those: they assume dpkg, apt and a Debian filesystem, and on this machine they write an apt source that would become a second update channel"

        if [ -n "$LD_SCRIPTS" ]; then
            warn "'${name}': its maintainer script(s) — ${LD_SCRIPTS} — were NOT run. They assume dpkg and a Debian layout; APEX extracts the payload only"
        fi
        if [ -n "$LD_DEPENDS" ]; then
            warn "'${name}': APEX resolved none of its Debian dependencies (${LD_DEPENDS}). Debian package names do not exist on Fedora; anything APEX-OS does not already provide under another name is yours to install"
        fi

        cp -a "${scratch}/." "${root}/" \
            || die "merging ${name} into the payload failed"

        # The record of what this .deb contributed. `rpm -qf` can never answer
        # for these paths, so this file is the equivalent: it is what
        # `apex pkg verify` reads, and it is what a future pass over /usr has
        # to consult before deciding a path is unowned.
        install -d -m0700 "$DEB_DIR"
        deb_walk "$scratch" | awk -F'\t' '$1 != "d" { print $2 }' | LC_ALL=C sort \
            > "$(deb_manifest "$name")"
        printf '%s\n' "$entry" > "$(deb_entry_file "$name")"
        printf '%s\n' "$LD_DEPENDS" > "${DEB_DIR}/${name}.depends"
        msg "${name}: $(wc -l < "$(deb_manifest "$name")") file(s), entry point ${entry}"
        rm -rf "$scratch"
    done
}

# ── alternatives ─────────────────────────────────────────────────────────────
# extract_rpms runs rpm with --noscripts, and a package that publishes its
# binaries through `alternatives` creates them IN ITS SCRIPTLETS. Nothing else
# in the payload creates them, so they are simply absent, and every symlink the
# package ships that points at one of them dangles.
#
# Measured on katana on 2026-09-22 (ROADMAP/evidence/katana-p1038-apps-20260922.md):
# `apex install wine` produced a payload with /usr/bin/wine32, wine64,
# wineserver32 and wineserver64 as real files, /usr/bin/wine and
# /usr/bin/wineserver ABSENT, and twelve /usr/bin entries — msidb, msiexec,
# notepad, regedit, regsvr32, wineboot, winecfg, wineconsole, winedbg, winefile,
# winemine, winepath — as dangling symlinks to `wine`. The install reported
# success. `command -v` answered, `wine64 --version` printed a version, and only
# actually running a program failed. Wine is the example, not the bug: java,
# the iptables/nftables compatibility wrappers, `nc`, editors and compilers all
# publish through the same mechanism.
#
# ── Why the scriptlet is EXECUTED rather than read ──────────────────────────
# The declaration we need is the argv of `alternatives --install`, and the
# scriptlet is the only place the package states it. Three ways to get it were
# on the table; the other two are rejected on measurements, not taste.
#
#   * PARSE the scriptlet text. Dies on the real corpus. iptables-nft builds
#     every one of its three invocations out of shell variables —
#     `pfx=/usr/bin/iptables … update-alternatives --install $pfx iptables
#     $pfx-nft 10 --follower $pfx6 …` — so the tokens a parser would read are
#     `$pfx`, not paths. A text parser cannot resolve them without being a
#     shell.
#
#   * RUN the real `alternatives` against the payload. It cannot be relocated.
#     `alternatives --altdir "$root"/etc/alternatives --install "$root"/usr/bin/wine
#     wine /usr/bin/wine64 20` writes `"$root"/usr/bin/wine -> "$root"/etc/alternatives/wine`
#     and records the prefixed link path in the admin file: the build-time root
#     baked into a runtime symlink. Measured, not assumed.
#
#   * REPRODUCE the full alternatives triangle by hand — link -> /etc/alternatives/<name>
#     -> target, plus a state file in /etc/alternatives-admindir. That state
#     file is a candidate LIST the image may already have an entry in, in an
#     undocumented format, and it would have to reach the real /etc through
#     install_etc — the pass that once deleted 26 image-owned /etc files. The
#     cost of not doing it is that `alternatives --display`/`--config` do not
#     know about extension-provided links and the user cannot switch them. That
#     is stated in docs rather than hidden; it is not worse than a link that
#     does not exist.
#
# So: the scriptlet's own shell is executed, and the ONLY thing that can come
# back out of it is the argv of `alternatives`.
#
# ── What we are willing to run, exactly ─────────────────────────────────────
# The scriptlet body, with `/bin/sh -c`, and nothing else:
#
#   * as `nobody`, never as root, via setpriv with --no-new-privs, an empty
#     inheritable set and an empty bounding set — so `/usr/bin/su` or a setuid
#     binary invoked by absolute path cannot climb back. If privileges cannot be
#     dropped, THE SCRIPTLET IS NOT RUN AT ALL and the pass says so. There is no
#     path through this function that executes package code as root.
#   * with PATH containing one directory that holds one program: the recorder.
#     `rm`, `systemctl`, `useradd`, `ldconfig` are not found. An absolute path
#     to a real binary still resolves, which is why the privilege drop above is
#     the load-bearing half and the PATH is only the cheap half.
#   * with the environment emptied (`env -i`), stdin on /dev/null so nothing can
#     block on a read, and a hard timeout.
#   * WITHOUT `-e`. rpm does not run scriptlets with errexit either, and the
#     first `rm: not found` must not abort the shell before the alternatives
#     line is reached.
#
# Interception is by two means together, because one is not enough: PATH gets
# the bare `alternatives` / `update-alternatives` form that iptables-nft uses,
# and a rewrite of `(/usr)?/s?bin/(update-)?alternatives` inside the body gets
# the absolute form that wine-core, nmap-ncat and java-latest-openjdk-headless
# use. The rewrite points at the recorder's own absolute path rather than at a
# bare word, so a scriptlet that guards itself with `[ -x /usr/bin/alternatives ]`
# still finds something executable there.
#
# Only `%post` and `%posttrans` are read. wine-core's are in `%posttrans`;
# nmap-ncat's and iptables-nft's in `%post`. A `<lua>` scriptlet is skipped —
# wine-core has one, and all it does is `--remove`.
alternatives_record() {
    local destdir="$1" out="$2"
    : > "$out"

    local setpriv timeout_bin
    setpriv="$(command -v setpriv 2>/dev/null)" || setpriv=""
    timeout_bin="$(command -v timeout 2>/dev/null)" || timeout_bin=""
    if [ -z "$setpriv" ] || [ -z "$timeout_bin" ]; then
        warn "setpriv or timeout is missing, so package scriptlets cannot be confined — not reading any 'alternatives' declaration. Packages that publish binaries through alternatives will install with those binaries absent"
        return 0
    fi
    if ! id -u "$ALT_SCRIPTLET_USER" >/dev/null 2>&1; then
        warn "the '${ALT_SCRIPTLET_USER}' account does not exist, so package scriptlets cannot be dropped to it — not reading any 'alternatives' declaration"
        return 0
    fi

    # 0755 on the sandbox and 0666 on the record: the scriptlet runs as nobody
    # and has to traverse into one and append to the other. mktemp -d makes 0700.
    local sandbox rec
    sandbox="$(mktemp -d)" || { warn "cannot make a scriptlet sandbox"; return 0; }
    chmod 0755 "$sandbox"
    rec="${sandbox}/record"
    : > "$rec"; chmod 0666 "$rec"

    # The record path is baked into the recorder rather than passed in the
    # environment, so a scriptlet that unsets or rewrites variables cannot make
    # the recorder silently write nowhere. Arguments are NUL-separated and an
    # empty field ends an invocation, because an argument may contain anything
    # except NUL.
    local prog
    for prog in alternatives update-alternatives; do
        cat > "${sandbox}/${prog}" <<EOF
#!/bin/sh
for a in "\$@"; do printf '%s\0' "\$a"; done >> '${rec}'
printf '\0' >> '${rec}'
exit 0
EOF
        chmod 0755 "${sandbox}/${prog}"
    done

    local rpmfile name tag prog_tag body
    for rpmfile in "$destdir"/*.rpm; do
        [ -e "$rpmfile" ] || continue
        name="$(rpm -qp --nosignature --qf '%{NAME}' -- "$rpmfile" 2>/dev/null)" || continue
        for tag in POSTIN POSTTRANS; do
            body="$(rpm -qp --nosignature --qf "%{${tag}}" -- "$rpmfile" 2>/dev/null)"
            [ -n "$body" ] && [ "$body" != "(none)" ] || continue
            case "$body" in *alternatives*) ;; *) continue ;; esac
            prog_tag="$(rpm -qp --nosignature --qf "%{${tag}PROG}" -- "$rpmfile" 2>/dev/null)"
            case "$prog_tag" in
                */sh|*/sh\ *|*/bash|*/bash\ *) ;;
                *)  warn "'${name}' declares alternatives in a ${tag} scriptlet run by '${prog_tag}', which is not a shell — not read"
                    continue ;;
            esac
            body="$(printf '%s' "$body" \
                | sed -E "s#(/usr)?/s?bin/(update-)?alternatives#${sandbox}/\2alternatives#g")"
            env -i PATH="$sandbox" HOME=/nonexistent SHELL=/bin/sh \
                "$setpriv" --reuid="$ALT_SCRIPTLET_USER" --regid="$ALT_SCRIPTLET_USER" \
                    --clear-groups --no-new-privs --inh-caps=-all --bounding-set=-all \
                "$timeout_bin" "$ALT_SCRIPTLET_TIMEOUT" /bin/sh -c "$body" "$name" 1 \
                </dev/null >/dev/null 2>&1 || true
        done
    done

    cp -f "$rec" "$out" 2>/dev/null || : > "$out"
    rm -rf "$sandbox"
    return 0
}

# Follow a symlink the way the MERGED system will see it, which is neither what
# `find -xtype l` nor `readlink -e` does. A system extension's /usr is overlaid
# on the image's, so an absolute target may be satisfied by the payload OR by
# the image, and during the build the payload is not mounted anywhere — an
# absolute target has to be tried against $root first and the live filesystem
# second. `find -xtype l` resolves it against the live root only, and calls
# every correct link in a payload built inside a container dangling.
payload_link_resolves() {
    local root="$1" cur="$2" hops=0 t dir
    while [ -L "$cur" ] && [ "$hops" -lt 16 ]; do
        t="$(readlink "$cur")" || return 1
        case "$t" in
            /*) if [ -e "${root}${t}" ] || [ -L "${root}${t}" ]; then
                    cur="${root}${t}"
                elif [ -e "$t" ] || [ -L "$t" ]; then
                    cur="$t"
                else
                    return 1
                fi ;;
            *)  dir="${cur%/*}"; cur="${dir}/${t}" ;;
        esac
        hops=$((hops + 1))
    done
    [ -e "$cur" ]
}

# Every symlink in the payload that will still be dangling once the extension is
# merged, printed as the path it will have at runtime. Used by the pass below to
# warn, and by tests/test-apex-pkg-alternatives.sh to measure — deliberately the
# same code, so the suite cannot pass against a checker production does not use.
dangling_links() {
    local root="$1" l
    while IFS= read -r l; do
        payload_link_resolves "$root" "$l" || printf '%s\n' "${l#"$root"}"
    done < <(find "$root" -type l 2>/dev/null)
}

# Replay the recorded declarations into the payload.
#
# `alternatives --install <link> <name> <path> <priority>` is turned into
# `<link> -> <path>`, a direct symlink in the payload's own /usr, and each
# `--slave`/`--follower <link> <name> <path>` into another one at the parent's
# priority. The option walk is driven by each flag's real arity — --slave and
# --follower take three arguments, --initscript, --family, --altdir and
# --admindir take one, the rest take none — because counting positionals
# happens to work on wine's invocations and would silently mis-read the next
# package's.
#
# Three refusals, and each one is a defect this engine has already shipped once
# in some other form:
#
#   * a link the IMAGE owns is never created. Asked of the rpmdb with
#     `rpm -qf`, not of the filesystem: after this fix ships, /usr/bin/wine
#     exists on a live machine BECAUSE the extension put it there, and a
#     filesystem test would refuse to build it again on the next rebuild. The
#     rpmdb is the only thing that knows what belongs to the OS — same oracle
#     merge_multilib and install_etc's removal pass use.
#   * a target that is in neither the payload nor the image is not linked to.
#     That is what keeps a scriptlet's conditional branch, taken for a
#     situation that does not apply here, from creating a NEW dangling link.
#   * nothing outside /usr and /opt is touched. A system extension merges those
#     two and nothing else, and an alternatives link under /etc would have to go
#     through install_etc to reach the machine at all.
#
# When two packages in the set claim the same link, the higher priority wins,
# which is what alternatives itself would do. It falls out of applying the
# candidates in descending priority order and never replacing a link that
# already resolves.
alternatives_replay() {
    local rec="$1" root="$2"
    [ -s "$rec" ] || { msg "alternatives: no package in this set declares one"; return 0; }

    local cand="${rec}.candidates"
    : > "$cand"

    local -a argv=()
    local tok
    while IFS= read -r -d '' tok; do
        if [ -z "$tok" ]; then
            alternatives_candidates "$cand" "${argv[@]}"
            argv=()
        else
            argv+=("$tok")
        fi
    done < "$rec"
    [ ${#argv[@]} -eq 0 ] || alternatives_candidates "$cand" "${argv[@]}"

    local declared placed=0 skipped=0
    declared=$(wc -l < "$cand")
    [ "$declared" -gt 0 ] || { msg "alternatives: no --install declaration in this set"; rm -f "$cand"; return 0; }

    local prio link target
    while IFS=$'\t' read -r prio link target; do
        if alternatives_place "$root" "$link" "$target"; then
            placed=$((placed + 1))
        else
            skipped=$((skipped + 1))
        fi
    done < <(LC_ALL=C sort -t"$(printf '\t')" -k1,1nr -s "$cand")

    msg "alternatives: ${placed} of ${declared} declared link(s) created, ${skipped} skipped"
    rm -f "$cand"

    local still
    still="$(dangling_links "$root" | wc -l)"
    [ "$still" -eq 0 ] \
        || warn "${still} symlink(s) in this payload still point at something neither it nor the image provides; 'apex verify' lists them"
    return 0
}

# One recorded invocation -> zero or more "priority<TAB>link<TAB>target" lines.
alternatives_candidates() {
    local out="$1"; shift
    local -a a=("$@")
    local n=${#a[@]} i=0
    [ "$n" -gt 0 ] || return 0

    # --test asks alternatives to decide and change nothing. Honour it by
    # dropping the whole invocation rather than by half-applying it.
    for ((i = 0; i < n; i++)); do
        [ "${a[i]}" = "--test" ] && return 0
    done

    local prio="" have=0
    i=0
    while [ "$i" -lt "$n" ]; do
        case "${a[i]}" in
            --install)
                [ $((i + 4)) -lt "$n" ] || return 0
                prio="${a[i+4]}"
                case "$prio" in ''|*[!0-9]*) return 0 ;; esac
                printf '%s\t%s\t%s\n' "$prio" "${a[i+1]}" "${a[i+3]}" >> "$out"
                have=1
                i=$((i + 5)) ;;
            --slave|--follower)
                [ "$have" = 1 ] || { i=$((i + 4)); continue; }
                [ $((i + 3)) -lt "$n" ] || return 0
                printf '%s\t%s\t%s\n' "$prio" "${a[i+1]}" "${a[i+3]}" >> "$out"
                i=$((i + 4)) ;;
            --initscript|--family|--altdir|--admindir)
                i=$((i + 2)) ;;
            *)
                i=$((i + 1)) ;;
        esac
    done
    return 0
}

alternatives_place() {
    local root="$1" link="$2" target="$3"

    case "$link" in /usr/*|/opt/*) ;; *) warn "alternatives: refusing '${link}' — a system extension merges /usr and /opt only"; return 1 ;; esac
    case "$target" in /usr/*|/opt/*) ;; *) warn "alternatives: refusing '${link}' — its target '${target}' is outside /usr and /opt"; return 1 ;; esac
    case "$link$target" in *..*) warn "alternatives: refusing '${link}' — '..' in a path"; return 1 ;; esac

    if image_owns "$link"; then
        warn "alternatives: not creating '${link}' — APEX-OS already owns it, and the overlay must never shadow the image's copy"
        return 1
    fi
    if [ ! -e "${root}${target}" ] && [ ! -L "${root}${target}" ] && ! image_owns "$target"; then
        warn "alternatives: not creating '${link}' — '${target}' is in neither this package set nor the image"
        return 1
    fi
    if [ -e "${root}${link}" ] && [ ! -L "${root}${link}" ]; then
        warn "alternatives: not creating '${link}' — this package set ships a real file there"
        return 1
    fi
    # Already satisfied: either a higher-priority candidate got here first, or
    # the package shipped a link that works. Leave it.
    if [ -L "${root}${link}" ] && payload_link_resolves "$root" "${root}${link}"; then
        return 1
    fi

    mkdir -p "${root}${link%/*}" || return 1
    ln -sfn "$target" "${root}${link}" || return 1
    return 0
}

# The pass itself.
apply_alternatives() {
    local destdir="$1" root="$2"
    local rec="${root}.alternatives"
    alternatives_record "$destdir" "$rec"
    alternatives_replay "$rec" "$root"
    rm -f "$rec"
}

# Caches that are a SINGLE file describing a whole directory are the one real
# hazard of overlaying /usr: the extension's copy hides the image's copy, so a
# cache built only from extension content makes the image's own applications
# disappear. Each one is therefore rebuilt from the UNION of image + extension,
# or deleted when the consumer can safely fall back to scanning.
fix_caches() {
    local root="$1" tmp

    if compgen -G "${root}/usr/share/glib-2.0/schemas/*.xml" >/dev/null; then
        tmp="$(mktemp -d)"
        cp -a /usr/share/glib-2.0/schemas/. "$tmp"/ 2>/dev/null || true
        rm -f "${tmp}/gschemas.compiled"
        cp -a "${root}"/usr/share/glib-2.0/schemas/. "$tmp"/
        if glib-compile-schemas --targetdir "$tmp" "$tmp" >/dev/null 2>&1; then
            install -Dm0644 "${tmp}/gschemas.compiled" \
                "${root}/usr/share/glib-2.0/schemas/gschemas.compiled"
            msg "rebuilt GSettings schema cache (image + extension)"
        fi
        rm -rf "$tmp"
    fi

    if compgen -G "${root}/usr/share/applications/*.desktop" >/dev/null; then
        tmp="$(mktemp -d)"
        cp -a /usr/share/applications/. "$tmp"/ 2>/dev/null || true
        cp -a "${root}"/usr/share/applications/. "$tmp"/
        if update-desktop-database "$tmp" >/dev/null 2>&1; then
            install -Dm0644 "${tmp}/mimeinfo.cache" \
                "${root}/usr/share/applications/mimeinfo.cache"
        fi
        rm -rf "$tmp"
    fi

    if compgen -G "${root}/usr/share/mime/packages/*.xml" >/dev/null; then
        tmp="$(mktemp -d)"
        cp -a /usr/share/mime/. "${tmp}/" 2>/dev/null || true
        cp -a "${root}"/usr/share/mime/. "${tmp}/"
        if update-mime-database "$tmp" >/dev/null 2>&1; then
            rm -rf "${root}/usr/share/mime"
            mkdir -p "${root}/usr/share/mime"
            cp -a "${tmp}/." "${root}/usr/share/mime/"
        fi
        rm -rf "$tmp"
    fi

    local libdir
    for libdir in lib64 lib; do
        if compgen -G "${root}/usr/${libdir}/gio/modules/*.so" >/dev/null \
           && command -v gio-querymodules >/dev/null; then
            tmp="$(mktemp -d)"
            cp -a "/usr/${libdir}/gio/modules/." "$tmp"/ 2>/dev/null || true
            cp -a "${root}/usr/${libdir}/gio/modules/." "$tmp"/
            rm -f "${tmp}/giomodule.cache"
            gio-querymodules "$tmp" >/dev/null 2>&1 || true
            if [ -f "${tmp}/giomodule.cache" ]; then
                install -Dm0644 "${tmp}/giomodule.cache" \
                    "${root}/usr/${libdir}/gio/modules/giomodule.cache"
            fi
            rm -rf "$tmp"
        fi
    done

    # Consumers of these re-scan when the directory is newer than the cache, so
    # shipping no cache is correct and strictly safer than shipping a partial one.
    find "$root" -name 'icon-theme.cache' -delete 2>/dev/null || true
    rm -rf "${root}/usr/lib/fontconfig/cache"
    rm -f  "${root}/usr/share/info/dir"
}

# A sysext may only carry /usr and /opt. Configuration and state are machine-
# local and must land on the real, writable filesystem.
split_out_of_image() {
    local root="$1" etcroot="$2"
    if [ -d "${root}/etc" ]; then
        mkdir -p "$etcroot"
        cp -a "${root}/etc/." "${etcroot}/"
        # ${root:?} on every recursive delete in this function: an empty $root
        # would make these `rm -rf /etc` and `rm -rf /var` on the live system.
        rm -rf "${root:?}/etc"
    fi
    if [ -d "${root}/var" ]; then
        ( cd "${root}/var" && find . -mindepth 1 -type d -printf '/var/%P\n' ) \
            > "${WORK}/var.dirs" || true
        rm -rf "${root:?}/var"
    fi
    : > "${WORK}/refused.paths"
    local d
    for d in boot srv run root home; do
        [ -d "${root}/${d}" ] && find "${root}/${d}" -mindepth 1 -print >> "${WORK}/refused.paths" 2>/dev/null || true
        rm -rf "${root:?}/${d}"
    done
    # Legacy top-level paths: rpm still ships 32-bit libraries in /lib even on
    # merged-usr Fedora (libgcc.i686 carries /lib/libgcc_s.so.1). A sysext
    # merges /usr and /opt ONLY, so a file left at the tree root silently
    # never reaches the running system. Fold these into their canonical /usr
    # location — exactly what the merged-/usr filesystem does at boot.
    local legacy dst
    for legacy in lib:usr/lib lib64:usr/lib64 bin:usr/bin sbin:usr/bin; do
        d="${legacy%%:*}"; dst="${legacy##*:}"
        if [ -d "${root:?}/${d}" ]; then
            mkdir -p "${root:?}/${dst}"
            cp -a "${root:?}/${d}/." "${root:?}/${dst}/" \
                || die "cannot fold /${d} into /${dst}"
            rm -rf "${root:?}/${d}"
        fi
    done
    if [ -s "${WORK}/refused.paths" ]; then
        warn "ignored files outside /usr, /opt, /etc and /var:"
        sed 's/^/  /' "${WORK}/refused.paths" >&2
    fi
    if [ -d "${root}/usr/lib/modules" ]; then
        die "package ships kernel modules — that needs an image build, not an extension"
    fi
}

write_extension_release() {
    local root="$1"
    mkdir -p "${root}/usr/lib/extension-release.d"
    # systemd refuses to merge unless ID and VERSION_ID match the running OS.
    # That refusal is a FEATURE: it is what stops a Fedora 43 extension from
    # being overlaid onto a Fedora 44 deployment after an OS upgrade.
    cat > "${root}/usr/lib/extension-release.d/extension-release.${EXT_NAME}" <<EOF
ID=$(os_id)
VERSION_ID=$(os_version)
ARCHITECTURE=$(uname -m | sed 's/^x86_64$/x86-64/')
SYSEXT_SCOPE=system
APEX_EXTENSION=user-packages
APEX_BUILT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
}

label_tree() {
    local root="$1"
    local fc=/etc/selinux/targeted/contexts/files/file_contexts
    [ -f "$fc" ] || { warn "no SELinux file_contexts — extension will be unlabelled"; return 0; }
    command -v setfiles >/dev/null || return 0
    # Labels must be baked into the image: overlayfs serves the xattrs it finds,
    # and an unlabelled binary is denied execution under enforcing SELinux.
    setfiles -m -r "$root" "$fc" "${root}/usr" >/dev/null 2>&1 || \
        warn "SELinux labelling reported problems"
    if [ -d "${root}/opt" ]; then
        setfiles -m -r "$root" "$fc" "${root}/opt" >/dev/null 2>&1 || true
    fi
    return 0
}

# Emit the extension payload and print its path. Squashfs when the tools are
# there, the staging tree itself when they are not — systemd merges either.
build_payload() {
    local root="$1" outdir="$2"
    if [ "${APEX_PKG_FORMAT:-auto}" != tree ] && command -v mksquashfs >/dev/null 2>&1; then
        msg "building the extension image (squashfs)"
        if mksquashfs "$root" "${outdir}/${EXT_NAME}.raw" -noappend -no-progress -quiet \
               -comp zstd -Xcompression-level 8 -xattrs -processors "$(nproc)" >&2; then
            printf '%s' "${outdir}/${EXT_NAME}.raw"
            return 0
        fi
        warn "mksquashfs failed — falling back to a directory extension"
    fi
    msg "building the extension tree"
    mv "$root" "${outdir}/${EXT_NAME}"
    printf '%s' "${outdir}/${EXT_NAME}"
}

# Whichever form is currently installed, if any.
current_payload() {
    if [ -f "$EXT_IMAGE" ]; then
        printf '%s' "$EXT_IMAGE"
    elif [ -d "$EXT_TREE" ]; then
        printf '%s' "$EXT_TREE"
    fi
}

payload_bytes() {
    local p="$1"
    [ -n "$p" ] || { printf '0'; return 0; }
    if [ -f "$p" ]; then
        stat -c %s "$p"
    else
        du -sb "$p" 2>/dev/null | cut -f1
    fi
}

# ── /etc and /var placement ──────────────────────────────────────────────────
sha() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }

# Does a package in the system rpmdb own this path?
#
# `rpm -qf` answers with the owning package and exits 0, or exits non-zero for
# an unowned path. Failing CLOSED here is deliberate: if the query cannot run at
# all, treat the path as owned and keep the file. A wrongly kept file is a stale
# config; a wrongly deleted one is /etc/fonts/fonts.conf.
image_owns() {
    local path="$1"
    command -v rpm >/dev/null 2>&1 || return 0
    rpm -qf --quiet -- "$path" 2>/dev/null
}

# Hand every path install_etc wrote to restorecon, which asks the LOADED POLICY
# what each one's context should be.
#
# Deriving it from the policy is the whole point. `cp -a` preserves the SOURCE
# label and the source is an rpm extraction tree under /var/lib, so without this
# every file `apex install` puts in /etc arrives carrying the extraction tree's
# type. Measured on katana on 2026-09-20 (ROADMAP/evidence/katana-pwd-lock-selinux-20260920.md):
# 7 of the 11 tracked paths were rpm_var_lib_t, among them /etc/.pwd.lock, which
# policy wants as passwd_file_t. systemd takes that lock before it will allocate
# a dynamic UID, so EVERY DynamicUser=yes unit on the machine broke at once —
# capsule@.service, rpm-ostreed.service, fwupd-refresh.service and three more,
# each failing at step USER with 217/USER. Nothing logged an AVC: the denial is
# in PID 1 before any domain transition, and the only line naming the file
# exists at debug level. It cost four rounds of probing to find.
#
# A hardcoded map of filenames here would be the same mistake as the
# --excludepath list the multilib pass had to abandon, and it would have missed
# .pwd.lock — a transaction artefact no package owns and nobody would have
# thought to list.
relabel_etc() {
    local list="$1"
    [ -s "$list" ] || return 0
    if ! command -v restorecon >/dev/null 2>&1; then
        warn "restorecon is absent — files installed into /etc keep the label they were copied with"
        return 0
    fi
    # A machine with SELinux off has no labels to get wrong, and restorecon
    # there relabels nothing while still exiting 0 — so the warning below could
    # never fire and would mean nothing if it did.
    if command -v selinuxenabled >/dev/null 2>&1 && ! selinuxenabled; then
        return 0
    fi
    # -F is not tidiness. A bare `restorecon` silently declines to touch any
    # file whose current type is in the policy's customizable_types list —
    # "not reset as customized by admin", one line per file, and then exit 0.
    # That exemption is for labels an ADMIN chose; a file this function has
    # just written is not one of those, and inheriting the exemption would make
    # this pass run, report success and change nothing. -i makes a path that
    # has since been removed a no-op rather than an error.
    #
    # Stderr is deliberately NOT swallowed: this defect reported nothing at all
    # for months, and restorecon's own message is the only thing that would
    # name a path it could not set.
    restorecon -F -i -f "$list" >&2 \
        || warn "relabelling /etc reported problems — see above, then: restorecon -nv -f ${list}"
    # The saved copies are engine-owned from the top of the tree down, so -R is
    # unambiguous here in a way it could never be under /etc. They are written
    # by the same `cp -a` and arrive with the same wrong label.
    if [ -d "$ETC_SAVE" ]; then
        restorecon -F -R "$ETC_SAVE" >&2 \
            || warn "relabelling ${ETC_SAVE} reported problems"
    fi
}

install_etc() {
    local etcroot="$1"
    local -a kept=()
    # Every path this function creates or overwrites, collected AS IT GOES for
    # the relabel pass at the end. Built here rather than derived afterwards
    # because only the branch that ran knows which path it actually wrote: the
    # two `.apexnew` branches leave $target alone, and a directory that already
    # existed was not created by us.
    local relist
    relist="$(mktemp)" || die "cannot create a temporary file"
    if [ -d "$etcroot" ]; then
        local rel target saved
        while IFS= read -r rel; do
            target="/etc/${rel}"
            saved="${ETC_SAVE}/${rel}"
            if [ -d "${etcroot}/${rel}" ]; then
                # A directory we create inherits its parent's type by
                # transition, which is wrong wherever policy has an opinion —
                # /etc/cron.d is system_cron_spool_t, not etc_t. One that was
                # already there is not ours to relabel.
                if [ ! -d "$target" ]; then
                    mkdir -p "$target"
                    printf '%s\n' "$target" >> "$relist"
                fi
                continue
            fi
            # cp -a, NEVER install: rpm ships /etc symlinks that point back into
            # /usr RELATIVE (fontconfig's conf.d -> ../../../usr/share/...), and
            # split_out_of_image has already moved this tree out of the payload
            # root, so here the link is dangling at its current location. `install`
            # dereferences and dies on it; cp -a copies the link as a link, and it
            # resolves again the moment it reaches its real place in /etc.
            if [ -e "$target" ] && [ -f "$saved" ] && [ "$(sha "$target")" != "$(sha "$saved")" ]; then
                # The user edited it. Their file wins; the new one is left beside it.
                mkdir -p "$(dirname "${target}.apexnew")"
                cp -a -- "${etcroot}/${rel}" "${target}.apexnew"
                warn "kept your edited ${target}; new version saved as ${target}.apexnew"
                # The edited file is still one this engine put there, so its
                # label stays ours to keep right even though its content is not.
                printf '%s\n%s\n' "${target}.apexnew" "$target" >> "$relist"
            elif [ -e "$target" ] && [ ! -f "$saved" ]; then
                mkdir -p "$(dirname "${target}.apexnew")"
                cp -a -- "${etcroot}/${rel}" "${target}.apexnew"
                warn "${target} already exists and is not ours; new version saved as ${target}.apexnew"
                # Only the file we wrote. $target predates this engine, and its
                # label belongs to whoever put it there.
                printf '%s\n' "${target}.apexnew" >> "$relist"
            else
                mkdir -p "$(dirname "$target")"
                cp -a "${etcroot}/${rel}" "$target"
                printf '%s\n' "$target" >> "$relist"
            fi
            mkdir -p "$(dirname "$saved")"
            cp -a "${etcroot}/${rel}" "$saved"
            kept+=("$rel")
        done < <( cd "$etcroot" && find . -mindepth 1 -printf '%P\n' | sort )
    fi

    # Anything we installed last time and no longer ship is removed, but only if
    # the user has not touched it AND the image does not own it.
    #
    # The image clause is not belt-and-braces; without it this loop deletes the
    # operating system's own configuration. A 32-bit rpm ships the same /etc
    # paths as its 64-bit sibling, byte for byte — fontconfig.i686 carries
    # /etc/fonts/fonts.conf exactly as the image's fontconfig.x86_64 does. So a
    # run that installed the i686 set recorded those paths as "ours", the next
    # run stopped shipping them (the multilib pass excluded /etc outright then,
    # and merge_multilib drops them by image ownership now — either way they
    # stop arriving), and the user-has-not-touched-it test passed precisely
    # BECAUSE the file was pristine. It ate 26 image-owned files on the author's machine in one
    # rebuild, among them /etc/fonts/fonts.conf, /etc/ld.so.conf, /etc/krb5.conf,
    # /etc/pki/tls/openssl.cnf and both /etc/pki/nssdb databases.
    #
    # Ask the system rpmdb who owns the path. If any installed package claims
    # it, the file is the image's and this loop has no business removing it —
    # forget the bookkeeping and leave the file alone.
    if [ -f "$ETC_LIST" ]; then
        local old
        while IFS= read -r old; do
            [ -n "$old" ] || continue
            if printf '%s\n' "${kept[@]:-}" | grep -qxF "$old"; then
                continue
            fi
            local t="/etc/${old}" s="${ETC_SAVE}/${old}"
            if [ -f "$t" ] && [ -f "$s" ] && [ "$(sha "$t")" = "$(sha "$s")" ] \
                && ! image_owns "$t"; then
                rm -f "$t"
            elif [ -e "$t" ] && ! image_owns "$t"; then
                # Kept because the user edited it: a file this engine installed
                # and no longer ships. The content is theirs; the label is still
                # ours. /etc/security/limits.d/10-gamemode.conf on katana was
                # exactly this — tracked, no longer shipped, owned by no
                # package, still mislabelled, and the same defect rather than a
                # separate accident.
                #
                # An image-owned survivor is deliberately NOT here. It reaches
                # $ETC_LIST because a 32-bit rpm shipped the same path, but this
                # function never wrote it, and its label is the image's.
                printf '%s\n' "$t" >> "$relist"
            fi
            rm -f "$s"
        done < "$ETC_LIST"
    fi
    printf '%s\n' "${kept[@]:-}" | awk 'NF' > "$ETC_LIST"
    relabel_etc "$relist"
    rm -f "$relist"
}

install_var_dirs() {
    local list="$1"
    : > "${VAR_LIST}.new"
    [ -f "$list" ] || { mv -f "${VAR_LIST}.new" "$VAR_LIST"; return 0; }
    local d
    while IFS= read -r d; do
        [ -n "$d" ] || continue
        mkdir -p "$d"
        printf '%s\n' "$d" >> "${VAR_LIST}.new"
    done < "$list"
    mv -f "${VAR_LIST}.new" "$VAR_LIST"
}

# ── activation ───────────────────────────────────────────────────────────────
post_merge() {
    # Everything here writes OUTSIDE the extension, on the real filesystem, and
    # is what turns "files are present" into "the system knows about them".
    ldconfig 2>/dev/null || true
    systemd-sysusers 2>/dev/null || true
    systemd-tmpfiles --create 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
    if command -v udevadm >/dev/null; then
        udevadm control --reload 2>/dev/null || true
        udevadm trigger --subsystem-match=usb 2>/dev/null || true
    fi
}

# The extension-release file exists ONLY inside the image, so seeing it at its
# merged path in /usr is proof the overlay is live — no parsing, no version skew.
merged() {
    [ -f "/usr/lib/extension-release.d/extension-release.${EXT_NAME}" ]
}

# Cached local RPMs whose package is no longer requested are MOVED into the
# rollback slot, not deleted. `apex pkg rollback` restores the previous requested
# list, and a restored `local:<NAME>` that points at a file someone deleted would
# be a package the machine can never rebuild again. One generation kept, exactly
# like the extension image itself.
#
# Runs only after save_requested has committed a successful build, so a failed
# install can never take a user's cached RPM with it.
# One cache directory's worth of retirement: everything under $1 whose package
# name the requested list no longer carries is moved into the spool $2, so
# `apex pkg rollback` can put it back. $3 is the requested-list prefix that
# owns the directory — `local:` for .rpm files, `deb:` for .deb files.
#
# The name is the basename minus its LAST extension, which is what lets one
# package own several side files: chrome.rpm and chrome.trust, or
# claude-desktop.deb, .trust, .entry and .files.
gc_cache_dir() {
    local dir="$1" spool="$2" prefix="$3"
    [ -d "$dir" ] || return 0
    local -a keep=()
    mapfile -t keep < <(load_requested | sed -n "s/^${prefix}//p")
    install -d -m0700 "$spool"
    find "$spool" -mindepth 1 -maxdepth 1 -delete 2>/dev/null || true
    local f base name k found
    for f in "$dir"/*; do
        [ -e "$f" ] || continue
        base="${f##*/}"
        name="${base%.*}"
        found=0
        for k in "${keep[@]:-}"; do
            [ "$k" = "$name" ] && found=1
        done
        [ "$found" = 1 ] && continue
        mv -f "$f" "${spool}/${base}"
    done
}

gc_local_cache() {
    gc_cache_dir "$LOCAL_DIR" "${ROLLBACK_DIR}/local" 'local:'
    gc_cache_dir "$DEB_DIR"   "${ROLLBACK_DIR}/deb"   'deb:'
}

# The other half of gc_local_cache, and deliberately NOT part of
# restore_previous: a failed merge undoes the extension while the requested list
# and the cache are still untouched, so putting the previous generation back
# there would resurrect packages nobody asked for.
restore_cache_dir() {
    local spool="$1" dir="$2"
    [ -d "$spool" ] || return 0
    install -d -m0700 "$dir"
    local f
    for f in "$spool"/*; do
        [ -e "$f" ] || continue
        mv -f "$f" "${dir}/${f##*/}"
    done
}

restore_local_cache() {
    restore_cache_dir "${ROLLBACK_DIR}/local" "$LOCAL_DIR"
    restore_cache_dir "${ROLLBACK_DIR}/deb"   "$DEB_DIR"
}

restore_previous() {
    rm -rf "$EXT_IMAGE" "$EXT_TREE"
    if [ -e "${ROLLBACK_DIR}/${EXT_NAME}.raw" ]; then
        mv -f "${ROLLBACK_DIR}/${EXT_NAME}.raw" "$EXT_IMAGE"
    elif [ -e "${ROLLBACK_DIR}/${EXT_NAME}" ]; then
        mv -f "${ROLLBACK_DIR}/${EXT_NAME}" "$EXT_TREE"
    fi
}

activate_payload() {
    local new="$1"
    # Refuse before touching the installed extension: everything below is
    # destructive, and a bad path here would uninstall a working system's
    # packages to install nothing.
    [ -n "$new" ] && [ -e "$new" ] || die "internal error: no extension payload at '${new}'"
    mkdir -p "$EXT_DIR" "$ROLLBACK_DIR"
    rm -rf "${ROLLBACK_DIR:?}/${EXT_NAME}.raw" "${ROLLBACK_DIR:?}/${EXT_NAME}"
    if [ -f "$EXT_IMAGE" ]; then
        mv -f "$EXT_IMAGE" "${ROLLBACK_DIR}/${EXT_NAME}.raw"
    elif [ -d "$EXT_TREE" ]; then
        mv -f "$EXT_TREE" "${ROLLBACK_DIR}/${EXT_NAME}"
    fi
    if [ -f "$STATE" ]; then
        cp -a "$STATE" "${ROLLBACK_DIR}/state.json"
    fi

    case "$new" in
        *.raw) mv -f "$new" "$EXT_IMAGE" ;;
        *)     mv -f "$new" "$EXT_TREE" ;;
    esac

    msg "activating"
    if ! systemd-sysext refresh >&2; then
        warn "merge failed — restoring the previous extension"
        restore_previous
        systemd-sysext refresh >&2 || true
        die "the new extension could not be merged; nothing changed"
    fi
    post_merge
}

write_state() {
    local destdir="$1"; shift
    mkdir -p "$PKG_ROOT"
    local resolved requested
    resolved="$(resolved_set "$destdir" "$@" | json_string_array)"
    requested="$(load_requested | json_string_array)"
    # Provenance, recorded so `apex pkg list` and `apex pkg verify` can say where
    # each package came from instead of presenting a vendor RPM as if a Fedora
    # mirror had signed it.
    local locals unsigned n debfiles debdeps
    locals="$(load_requested | sed -n 's/^local://p' | sort | json_string_array)"
    debfiles="$(load_requested | sed -n 's/^deb://p' | sort | json_string_array)"
    # Every .deb is in this list by construction, not by a marker: there is no
    # such thing as a verified local .deb, so `apex pkg verify` must say so
    # about all of them. See deb_trust_refusal.
    unsigned="$( { load_requested | sed -n 's/^local://p' | while IFS= read -r n; do
                       [ -n "$n" ] || continue
                       [ -f "$(local_marker "$n")" ] && printf '%s\n' "$n"
                       true
                   done
                   load_requested | sed -n 's/^deb://p'
                 } | sort | json_string_array)"
    # What each .deb says it needs, recorded verbatim because APEX resolves none
    # of it: Debian dependency names are not Fedora package names and guessing a
    # mapping would be worse than printing the truth.
    debdeps="$(load_requested | sed -n 's/^deb://p' | sort | while IFS= read -r n; do
                   [ -n "$n" ] || continue
                   printf '%s\t%s\n' "$n" "$(cat "${DEB_DIR}/${n}.depends" 2>/dev/null || true)"
               done | jq -R -s 'split("\n") | map(select(length > 0)) | map(split("\t"))
                                | map({(.[0]): (.[1] // "")}) | add // {}')"
    local payload; payload="$(current_payload)"
    jq -n \
        --argjson requested "$requested" \
        --argjson resolved "$resolved" \
        --argjson local_files "$locals" \
        --argjson deb_files "$debfiles" \
        --argjson deb_depends "$debdeps" \
        --argjson unsigned "$unsigned" \
        --arg os_id "$(os_id)" \
        --arg os_version "$(os_version)" \
        --arg built "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg image "$payload" \
        --arg sha "$([ -f "$payload" ] && sha "$payload" || echo '')" \
        --arg size "$(payload_bytes "$payload")" \
        --argjson compat_level "$PKG_COMPAT_LEVEL" \
        '{requested:$requested, resolved:$resolved, local_files:$local_files,
          deb_files:$deb_files, deb_depends:$deb_depends,
          unsigned_accepted:$unsigned, os_id:$os_id,
          os_version_id:$os_version, built:$built, image:$image,
          image_sha256:$sha, image_bytes:($size|tonumber),
          pkg_compat_level:$compat_level}' > "${STATE}.tmp"
    mv -f "${STATE}.tmp" "$STATE"
}

# Is the extension on disk already exactly what this transaction would build?
# $1 = the state file to judge, $2 = the resolved NEVRA set this run produced,
# already sorted. Returns 0 only when every one of five things agrees, and a
# caller that gets 0 skips the whole build.
#
# The state path is a PARAMETER rather than $STATE so this decision can be run
# against a file in a temp directory — tests/test-apex-pkg-update.sh holds the
# resolved set constant and varies one field at a time, which is the only way to
# tell a rebuild caused by the compat level from one caused by a package update.
#
# THE COMPAT-LEVEL CLAUSE IS LOAD-BEARING, and its absence was a shipped defect
# (ROADMAP/evidence/katana-image-qual-20260919.md §0.2 and §1.2). `os_version`
# is VERSION_ID out of /usr/lib/os-release, which is `43` before and after an
# APEX image build, and the resolved set comes from Fedora's repositories, which
# have nothing to do with what APEX baked. So when an image update changes what
# the IMAGE provides — which is exactly what the extension's contents are
# computed against, since extract_rpms carries a 32-bit path only when the
# running image does not already own it — neither of the other two signals
# moves, and PKG_COMPAT_LEVEL is the only thing left that can say so.
#
# Measured on katana on 2026-09-19: an existing machine took the image that
# carried the pkg-share fix, apex-sysext-rebuild.service started and finished in
# the same second reporting success, and re-merged a byte-identical extension
# with 177 image paths shadowed and zero i686 Vulkan ICDs. Bumping the level
# WITHOUT this clause is worse than doing nothing: `cmd_rebuild --if-needed`
# checks the level, so it would announce a rebuild, re-download every rpm, stop
# here on the unchanged set, and then write_state would stamp the new level into
# state.json — consuming the marker without building anything, so the next boot
# sees a match and no-ops for ever.
ext_up_to_date() {
    local state=$1 new_set=$2
    [ -f "$state" ] || return 1
    merged || return 1
    [ -n "$(current_payload)" ] || return 1
    [ "$(jq -r '.os_version_id // empty' "$state")" = "$(os_version)" ] || return 1
    # `// 0` on purpose: a state.json written before the field existed must read
    # as "older than anything this engine ships" and rebuild, not as a match.
    [ "$(jq -r '.pkg_compat_level // 0' "$state")" = "$PKG_COMPAT_LEVEL" ] || return 1
    local old_set
    old_set="$(jq -r '.resolved[]?' "$state" | sort)"
    [ "$new_set" = "$old_set" ]
}

# Build the one extension from the requested list. Every mutation funnels here,
# so install, remove, upgrade and rebuild can never drift apart.
# Takes the desired package set as arguments. The on-disk requested list is
# written only once the build has actually succeeded, so a failed install (a
# typo, a refused package, no network) cannot leave the machine permanently
# asking for something that can never be built. This matters because `die`
# exits the process outright — a caller cannot "catch" it and undo the list.
rebuild_extension() {
    local -a want=()
    local a
    for a in "$@"; do
        if [ -n "$a" ]; then
            want+=("$a")
        fi
    done

    # An image update may bake something that used to live in the user
    # extension. Drop it before resolving so an older extension copy can never
    # shadow the image's package. A local file is checked by its package NAME,
    # which is exactly why the requested list stores the name and not a path.
    local -a missing=()
    local probe
    for a in "${want[@]}"; do
        probe="$a"
        is_local_id "$a" && probe="$(local_name "$a")"
        is_deb_id "$a"   && probe="$(deb_name "$a")"
        if rpm -q -- "$probe" >/dev/null 2>&1; then
            msg "dropping '$probe' from the extension: now provided by APEX-OS"
        elif is_deb_id "$a" && deb_superseded_by_image "$a"; then
            # A .deb's files have no rpm owner, so the query above cannot see an
            # image that has STARTED shipping the same application — and that is
            # not hypothetical: Claude Desktop reaches the image as a `cp -a` of
            # exactly this .deb. Without this arm the next `apex update` would
            # reach the shadow guard and refuse to rebuild anything at all.
            msg "dropping '$probe' from the extension: now provided by APEX-OS"
        else
            missing+=("$a")
        fi
    done
    want=("${missing[@]}")

    if [ "${#want[@]}" -eq 0 ]; then
        msg "no packages requested — removing the extension"
        rm -rf "$EXT_IMAGE" "$EXT_TREE"
        systemd-sysext refresh >&2 || true
        install_etc ""
        install_var_dirs /dev/null
        rm -f "$STATE"
        save_requested
        gc_local_cache
        post_merge
        return 0
    fi

    WORK="$(mktemp -d "${WORK_ROOT}.XXXXXX")"
    trap 'rm -rf "$WORK"' RETURN
    local rpms="${WORK}/rpms" root="${WORK}/root" etcroot="${WORK}/etc"
    mkdir -p "$rpms" "$root"

    # Split the desired set into repository specs and cached local files. The
    # cache is the ONLY source for a local package here: the path the user
    # originally typed may have been a USB stick, and this same function runs
    # from `apex update` and from apex-sysext-rebuild.service after an OS
    # upgrade, long after that path stopped existing.
    local -a specs=() cached=() debcached=()
    local cachefile
    for a in "${want[@]}"; do
        if is_local_id "$a"; then
            cachefile="$(local_cache "$a")"
            [ -f "$cachefile" ] || die "the cached copy of local package '$(local_name "$a")' is missing (${cachefile}); reinstall it from the .rpm file, or drop it with: sudo apex remove $(local_name "$a")"
            cached+=("$cachefile")
        elif is_deb_id "$a"; then
            cachefile="$(deb_cache "$a")"
            [ -f "$cachefile" ] || die "the cached copy of local package '$(deb_name "$a")' is missing (${cachefile}); reinstall it from the .deb file, or drop it with: sudo apex remove $(deb_name "$a")"
            debcached+=("$cachefile")
        else
            specs+=("$a")
        fi
    done

    if [ "${#cached[@]}" -gt 0 ]; then
        local -a deps=()
        local_missing_requires "${WORK}/local.deps" "${cached[@]}"
        mapfile -t deps < "${WORK}/local.deps"
        if [ "${#deps[@]}" -gt 0 ]; then
            msg "local file(s) need ${#deps[@]} dependenc(y|ies) from the repositories"
            specs+=("${deps[@]}")
        fi
    fi

    # Skipped entirely when everything requested is a local file whose
    # dependencies the image already satisfies — there is then nothing to fetch,
    # and download_rpms would refuse an empty argument list.
    if [ "${#specs[@]}" -gt 0 ]; then
        download_rpms "$rpms" "${specs[@]}"
    fi
    if [ "${#cached[@]}" -gt 0 ]; then
        stage_local_rpms "$rpms" "${cached[@]}"
    fi
    # A request made entirely of .deb files leaves this directory empty, and
    # then every `for f in "$destdir"/*.rpm` below iterates over the UNMATCHED
    # glob and asks rpm to read a header out of a path that does not exist —
    # guard_rpms dies on it and extract_rpms treats it as a foreign-arch
    # package. So the rpm half of the pipeline runs only when there is one.
    local have_rpms=0
    compgen -G "${rpms}/*.rpm" >/dev/null && have_rpms=1
    if [ "$have_rpms" = 1 ]; then
        guard_rpms "$rpms"
    elif [ "${#debcached[@]}" -eq 0 ]; then
        die "every requested package is already part of APEX-OS — nothing to install"
    fi

    # `apex update` calls this on every run. Rebuilding an identical extension
    # would burn minutes and, worse, re-merge /usr underneath a running desktop
    # for no reason — so an unchanged package set stops here.
    local new_set
    new_set="$(resolved_set "$rpms" ${debcached[@]+"${debcached[@]}"})"
    if ext_up_to_date "$STATE" "$new_set"; then
        msg "already up to date"
        save_requested "${want[@]}"
        gc_local_cache
        write_state "$rpms" ${debcached[@]+"${debcached[@]}"}
        return 0
    fi

    if [ "$have_rpms" = 1 ]; then
        extract_rpms "$rpms" "$root"
        apply_alternatives "$rpms" "$root"
    else
        mkdir -p "$root"
    fi
    if [ "${#debcached[@]}" -gt 0 ]; then
        extract_debs "$root" "${debcached[@]}"
    fi
    fix_caches "$root"
    split_out_of_image "$root" "$etcroot"
    write_extension_release "$root"
    label_tree "$root"
    local payload
    payload="$(build_payload "$root" "$WORK")"

    install_etc "$etcroot"
    install_var_dirs "${WORK}/var.dirs"
    activate_payload "$payload"
    # Only now is this set the truth about the machine.
    save_requested "${want[@]}"
    gc_local_cache
    write_state "$rpms" ${debcached[@]+"${debcached[@]}"}

    msg "done — $(jq -r '.resolved | length' "$STATE") package(s), $(numfmt --to=iec "$(jq -r .image_bytes "$STATE")")B extension"
}

# ── flatpak verbs ────────────────────────────────────────────────────────────
# Flatpak keeps its own database, so there is no state to mirror here: flatpak
# itself is the source of truth for what is installed.
flatpak_install() {
    have_flatpak || die "flatpak is not installed"
    local remote=""
    if flatpak remotes --system --columns=name 2>/dev/null | grep -qx flathub; then
        remote=flathub
    fi
    msg "installing ${#} Flatpak app(s)"
    # shellcheck disable=SC2086
    flatpak install --system -y --noninteractive ${remote} "$@" >&2
}

flatpak_remove() {
    have_flatpak || die "flatpak is not installed"
    msg "removing ${#} Flatpak app(s)"
    flatpak uninstall --system -y --noninteractive "$@" >&2
}

# Updates the system installation, then the invoking user's own installation.
# Both matter: `flatpak install --user` is what a desktop store does by default
# on many systems, and updating only one silently leaves the other stale.
cmd_flatpak_upgrade() {
    have_flatpak || return 0
    need_root "pkg flatpak-upgrade"
    msg "updating Flatpak applications"
    flatpak update --system -y --noninteractive >&2 || warn "system Flatpak update failed"
    local u="${SUDO_USER:-}"
    if [ -n "$u" ] && [ "$u" != root ]; then
        if runuser -u "$u" -- flatpak --user remotes --columns=name 2>/dev/null | grep -q .; then
            runuser -u "$u" -- flatpak update --user -y --noninteractive >&2 \
                || warn "user Flatpak update failed for ${u}"
        fi
    fi
}

# ── verbs ────────────────────────────────────────────────────────────────────
cmd_install() {
    [ "$#" -gt 0 ] || die "usage: apex install <package|/path/to/file.rpm>..."

    # Route first, then validate every named file — both BEFORE the root check.
    # A mistyped path is not a privileged question, and answering it after a sudo
    # round trip instead of before one costs the user a second attempt for
    # nothing. Nothing here writes; the root gate still comes before every
    # mutation below.
    local -a files=() debs=() flatpaks=() names=() p
    for p in "$@"; do
        if is_local_deb_arg "$p"; then
            # BEFORE the RPM test, never after: is_local_rpm_arg answers true
            # for any argument containing a slash, so `apex install ./x.deb`
            # would otherwise be refused with "is not an RPM package".
            debs+=("$p")
        elif is_local_rpm_arg "$p"; then
            files+=("$p")
        elif is_flatpak_id "$p"; then
            flatpaks+=("$p")
        else
            names+=("$p")
        fi
    done

    # ── §9: which source serves the BARE names ──────────────────────────────
    # A path and an application id have already decided themselves; `--source`
    # would either agree with them or contradict them, and a contradiction is
    # refused rather than silently resolved one way. Everything below therefore
    # concerns `names` only.
    if [ -n "$SOURCE" ]; then
        if [ "${#files[@]}" -gt 0 ] && [ "$SOURCE" != rpm ]; then
            die "--source ${SOURCE} contradicts the local .rpm file you named; a file is always installed as an RPM"
        fi
        if [ "${#debs[@]}" -gt 0 ] && [ "$SOURCE" != rpm ]; then
            die "--source ${SOURCE} contradicts the local .deb file you named; a local package file always goes into the system extension"
        fi
        if [ "${#flatpaks[@]}" -gt 0 ] && [ "$SOURCE" != flatpak ]; then
            die "--source ${SOURCE} contradicts the Flatpak id you named; an application id is always installed as a Flatpak"
        fi
    fi

    if [ "${#names[@]}" -gt 0 ]; then
        # Declared out here, not inside the arms. `local` in a case arm only
        # takes effect if that arm runs, so `id` assigned in the "" arm below
        # would otherwise leak into the global scope of a script running as
        # root.
        local n id curated forced route
        case "$SOURCE" in
            capsule)
                # Returns; a capsule install touches neither the extension nor
                # Flatpak, and needs no root.
                install_into_capsule "${names[@]}"
                return $?
                ;;
            flatpak)
                local -a resolved=()
                for n in "${names[@]}"; do
                    id="$(first_flatpak_id "$n")" \
                        || die "no Flatpak application matches '${n}' (apex search ${n})"
                    msg "'${n}' resolves to the Flatpak ${id}"
                    resolved+=("$id")
                done
                flatpaks+=("${resolved[@]}")
                names=()
                ;;
            rpm) ;;   # today's behaviour, explicitly requested
            "")
                # No source named: the ranking applies, and the ONLY thing that
                # can move a bare name off the repository route is the curated
                # table — which then has to say why, on the spot.
                local -a kept=()
                for n in "${names[@]}"; do
                    if curated="$(curated_source "$n")"; then
                        forced="${curated%%|*}"
                        if [ "$forced" = flatpak ] && id="$(first_flatpak_id "$n")"; then
                            warn "installing ${n} as a Flatpak instead of the RPM: ${curated#*|}"
                            msg "to override: sudo apex install --source rpm ${n}"
                            flatpaks+=("$id")
                            continue
                        fi
                    fi
                    # No curated opinion. Ask the same question resolve
                    # asks: is there an rpm at all? A flatpak-only name in the
                    # dnf set fails the whole transaction.
                    route="$(bare_name_route "$n")"
                    if [ "${route%% *}" = flatpak ]; then
                        id="${route#* }"
                        msg "'${n}' has no RPM in any enabled repository; installing the Flatpak ${id}"
                        msg "to see why: apex resolve ${n}"
                        flatpaks+=("$id")
                        continue
                    fi
                    kept+=("$n")
                done
                names=("${kept[@]:-}")
                # An all-empty array from the loop above must not leave a stray
                # empty string that dnf would then try to resolve.
                [ -n "${names[0]:-}" ] || names=()
                ;;
        esac
    fi

    local -a lpath=() lname=()
    for p in "${files[@]:-}"; do
        [ -n "$p" ] || continue
        inspect_local_rpm "$p"
        lpath+=("$LR_PATH")
        lname+=("$LR_NAME")
        msg "local file: ${LR_NAME}-${LR_EVR}.${LR_ARCH} (${LR_PATH})"
    done

    local -a dpath=() dname=() ddeps=()
    for p in "${debs[@]:-}"; do
        [ -n "$p" ] || continue
        inspect_local_deb "$p"
        dpath+=("$LD_PATH")
        dname+=("$LD_NAME")
        ddeps+=("$LD_DEPENDS")
        msg "local file: ${LD_NAME}-${LD_VERSION}.${LD_ARCH} (.deb, ${LD_PATH})"
    done

    need_root install

    if [ "${#flatpaks[@]}" -gt 0 ]; then
        flatpak_install "${flatpaks[@]}"
        # §9 asks for provenance in the UI. One line, stating who vouched for
        # what was just installed and what it can reach — the question a user
        # cannot answer from the install log otherwise.
        msg "provenance: $(provenance flatpak)"
    fi
    # A Flatpak-only request must not rebuild the extension: that would cost
    # minutes and re-merge /usr to change nothing.
    [ "${#names[@]}" -gt 0 ] || [ "${#lpath[@]}" -gt 0 ] || [ "${#dpath[@]}" -gt 0 ] || return 0

    take_lock

    # The signature decision happens here, under the lock and as root, because
    # the COPR keyring lives in a 0700 directory an ordinary user cannot read —
    # deciding it earlier would report a COPR-signed file as untrusted.
    #
    # Decided for EVERY file before ANY file is copied: refusing the second of
    # two files must not leave the first one cached, because the requested list
    # is not updated on a refusal and the cache would then hold a package nothing
    # asks for until the next successful operation retires it.
    local -a want=() unsigned=()
    local i f n
    for i in "${!lpath[@]}"; do
        f="${lpath[$i]}"
        if rpm_signature_ok "$f"; then
            unsigned+=(0)
        else
            [ "${ALLOW_UNSIGNED:-0}" = 1 ] || refuse_unsigned "$f"
            warn "accepting ${f} unverified because you passed --allow-unsigned"
            unsigned+=(1)
        fi
    done
    # A .deb has nothing to check. Debian signs the apt index, not the file, so
    # the answer is the same for every one of them and the opt-in is the same
    # per-file, byte-exact marker the RPM path uses.
    for i in "${!dpath[@]}"; do
        [ "${ALLOW_UNSIGNED:-0}" = 1 ] \
            || deb_trust_refusal "${dpath[$i]}" "${dname[$i]}" "${ddeps[$i]}"
        warn "accepting ${dpath[$i]} unverified because you passed --allow-unsigned: a .deb carries no signature APEX can check"
    done
    for i in "${!lpath[@]}"; do
        f="${lpath[$i]}"; n="${lname[$i]}"
        cache_local_rpm "$f" "$n" "${unsigned[$i]}"
        want+=("$(local_id "$n")")
    done
    for i in "${!dpath[@]}"; do
        cache_local_deb "${dpath[$i]}" "${dname[$i]}"
        want+=("$(deb_id "${dname[$i]}")")
    done

    if [ "${#names[@]}" -gt 0 ]; then
        want+=("${names[@]}")
    fi

    # Carry the existing list forward, minus anything this request supersedes.
    # `apex install ./foo.rpm` after `apex install foo` must REPLACE the
    # repository request, not sit beside it — otherwise the next rebuild resolves
    # both and stage_local_rpms has to throw one away on every single build.
    local -a existing=()
    mapfile -t existing < <(load_requested)
    local e t superseded
    for e in "${existing[@]:-}"; do
        [ -n "$e" ] || continue
        superseded=0
        for t in "${lname[@]:-}" "${dname[@]:-}" "${names[@]:-}"; do
            [ -n "$t" ] || continue
            if requested_matches "$e" "$t"; then
                superseded=1
            fi
        done
        if [ "$superseded" = 0 ]; then
            want+=("$e")
        fi
    done
    msg "provenance: $(provenance rpm)"
    rebuild_extension "${want[@]}"
}

cmd_remove() {
    [ "$#" -gt 0 ] || die "usage: apex remove <package>..."
    need_root remove

    # A package installed from a local file is removed by its package NAME.
    # `apex remove ./chrome.rpm` is accepted too and means the same thing — the
    # name is read back out of the file — so that re-running the install line
    # with `remove` does what it looks like it does.
    local -a rpms=() flatpaks=() q n
    for q in "$@"; do
        if is_local_deb_arg "$q" && [ -f "$q" ] && deb_magic_ok "$q"; then
            n="$(deb_name_of "$q")" || n=""
            if [ -n "$n" ] && valid_deb_name "$n"; then
                rpms+=("$n")
                continue
            fi
        fi
        if is_local_rpm_arg "$q" && [ -f "$q" ] && rpm_magic_ok "$q"; then
            n="$(rpm -qp --nosignature --qf '%{NAME}' -- "$q" 2>/dev/null)" || n=""
            if [ -n "$n" ] && valid_pkg_name "$n"; then
                rpms+=("$n")
                continue
            fi
        fi
        if is_flatpak_id "$q"; then flatpaks+=("$q"); else rpms+=("$q"); fi
    done
    if [ "${#flatpaks[@]}" -gt 0 ]; then
        flatpak_remove "${flatpaks[@]}"
    fi
    [ "${#rpms[@]}" -gt 0 ] || return 0
    set -- "${rpms[@]}"

    take_lock
    local -a current=() keep=()
    mapfile -t current < <(load_requested)
    local c p found
    for c in "${current[@]:-}"; do
        [ -n "$c" ] || continue
        found=0
        for p in "$@"; do
            if requested_matches "$c" "$p"; then
                found=1
            fi
        done
        if [ "$found" = 0 ]; then
            keep+=("$c")
        fi
    done
    if [ "${#keep[@]}" -eq "${#current[@]}" ]; then
        die "not installed by apex: $*"
    fi
    # rebuild_extension calls gc_local_cache once the new set is committed, which
    # is what actually retires the cached .rpm and its trust marker.
    rebuild_extension "${keep[@]:-}"
}

cmd_upgrade() {
    need_root upgrade
    take_lock
    local -a want=()
    mapfile -t want < <(load_requested)
    if [ "${#want[@]}" -eq 0 ]; then
        msg "no packages installed"
        return 0
    fi
    msg "refreshing extension packages from the repositories"
    rebuild_extension "${want[@]}"
}

cmd_rebuild() {
    local if_needed=0
    if [ "${1:-}" = "--if-needed" ]; then
        if_needed=1
    fi
    need_root pkg
    take_lock
    if [ ! -f "$STATE" ]; then
        if [ "$if_needed" = 0 ]; then
            msg "no packages installed"
        fi
        return 0
    fi
    if [ "$if_needed" = 1 ]; then
        local built_for built_level
        built_for="$(jq -r '.os_version_id // empty' "$STATE")"
        built_level="$(jq -r '.pkg_compat_level // 0' "$STATE")"
        if [ "$built_for" = "$(os_version)" ] \
           && [ "$built_level" = "$PKG_COMPAT_LEVEL" ] && merged; then
            return 0
        fi
        msg "extension compatibility changed (OS ${built_for}, level ${built_level} -> OS $(os_version), level ${PKG_COMPAT_LEVEL}) — rebuilding"
    fi

    local -a want=()
    mapfile -t want < <(load_requested)
    if [ "${#want[@]}" -eq 0 ]; then
        return 0
    fi

    # In a SUBSHELL on purpose: this runs from apex-sysext-rebuild.service at
    # boot, and `die` would otherwise exit straight out of the script and mark
    # the unit failed. An unreachable mirror is not a boot failure — the
    # packages simply get rebuilt on the next attempt.
    if [ "$if_needed" = 1 ]; then
        if ! ( rebuild_extension "${want[@]}" ); then
            warn "rebuild failed (offline?); run 'sudo apex pkg rebuild' when convenient"
        fi
        return 0
    fi
    rebuild_extension "${want[@]}"
}

cmd_list() {
    local kind; kind="$(state_kind)"
    if [ "$kind" = ok ]; then
        echo "packages (system extension):"
        # Provenance is shown, not hidden: a package that came from a file the
        # user vouched for personally must not read like one Fedora signed.
        jq -r '
            ((.unsigned_accepted // []) | map({(.): true}) | add // {}) as $u
            | .requested[]
            | if startswith("local:") then
                  ltrimstr("local:") as $n
                  | "  \($n)  [local file" + (if $u[$n] then ", signature not verified]" else "]" end)
              elif startswith("deb:") then
                  ltrimstr("deb:") as $n
                  | "  \($n)  [.deb file, signature not verified, Debian dependencies unresolved]"
              else "  \(.)"
              end' "$STATE"
        printf '  (+%s pulled in as dependencies)\n' \
            "$(( $(jq -r '.resolved | length' "$STATE") - $(jq -r '.requested | length' "$STATE") ))"
    elif [ "$kind" = unreadable ]; then
        printf 'packages (system extension): '
        state_unreadable_notice list
    else
        echo "packages (system extension): none"
    fi
    if have_flatpak; then
        local apps
        apps="$(flatpak list --app --columns=application 2>/dev/null || true)"
        if [ -n "$apps" ]; then
            echo
            echo "flatpak applications:"
            printf '%s\n' "$apps" | sed 's/^/  /'
        fi
    fi
}

# Whether `$STATE` can be read, and if not, whether we are entitled to say so.
#
# Prints `ok`, `absent` or `unreadable`.
#
# `[ -f "$STATE" ]` answers false for a missing file, a directory we may not
# search, a symlink cycle and a non-directory parent alike. `$PKG_ROOT` is 0700
# root:root while `list`, `info`, `status` and `verify` all run unprivileged, so
# every one of them certified "no packages installed" on machines that had them.
# In `verify` that also returned 0, which reads as "checked, and fine".
#
# So: read it. Absence is only a safe conclusion when the read failed AND every
# directory on the way to the file was one we could actually look inside.
# Takes the path as an argument, defaulting to $STATE, so the suite can drive
# it over a fixture tree. $PKG_ROOT is a hardcoded readonly and giving it an
# environment override would put a redirectable path into a script that runs as
# root, which is a worse trade than one parameter.
# shellcheck disable=SC2120  # the caller that passes $1 is tests/test-apex-pkg.sh,
# which sources this file and calls `state_kind "$SK/..."` eight times over a
# fixture tree. shellcheck only sees the callers in THIS file, all of which take
# the $STATE default, so it reads the parameter as dead. It is not: dropping it
# would take the suite's only way to drive this function over anything but the
# real /var/lib/apex. Flagged by shellcheck 0.9.0, which is what ubuntu-24.04
# runners ship, and NOT by 0.11.0 — this file was clean on the machine it was
# written on and red in CI.
state_kind() {
    # Not named STATE: that is a readonly global, and `local STATE=` is an error
    # in bash rather than a shadow. The suite found this the first time it ran.
    local target="${1:-$STATE}"
    if cat -- "$target" >/dev/null 2>&1; then
        printf 'ok\n'
        return
    fi
    # A symlink whose target is missing or loops still exists as a name.
    if [ -L "$target" ]; then
        printf 'unreadable\n'
        return
    fi
    # Walk up to the first ancestor that exists. If it is not a searchable,
    # readable directory then the read failed because we could not look, not
    # because there was nothing there.
    local d="$target" prev=
    while :; do
        d="$(dirname -- "$d")"
        [ "$d" = "$prev" ] && break
        prev="$d"
        if [ -e "$d" ]; then
            if [ -d "$d" ] && [ -r "$d" ] && [ -x "$d" ]; then
                break
            fi
            printf 'unreadable\n'
            return
        fi
        [ "$d" = "/" ] && break
    done
    if [ -e "$target" ]; then
        printf 'unreadable\n'
    else
        printf 'absent\n'
    fi
}

# What every caller prints when it could not look. Kept in one place so the
# four commands cannot drift into disagreeing about the same machine.
state_unreadable_notice() {
    echo "cannot read ${STATE}"
    echo "  reading it needs root; try: sudo apex pkg ${1}"
}

cmd_info() {
    case "$(state_kind)" in
        absent) echo "no packages installed"; return 0 ;;
        unreadable) state_unreadable_notice info; return 1 ;;
    esac
    jq . "$STATE"
}

cmd_status() {
    local payload; payload="$(current_payload)"
    printf 'extension       : %s\n' "${payload:-(none)}"
    local kind; kind="$(state_kind)"
    if [ "$kind" = unreadable ]; then
        printf 'packages        : cannot read %s (needs root)\n' "$STATE"
    fi
    if [ "$kind" = ok ]; then
        printf 'built for       : %s %s\n' "$(jq -r .os_id "$STATE")" "$(jq -r .os_version_id "$STATE")"
        printf 'running         : %s %s\n' "$(os_id)" "$(os_version)"
        printf 'packages        : %s requested, %s total\n' \
            "$(jq -r '.requested|length' "$STATE")" "$(jq -r '.resolved|length' "$STATE")"
        printf 'size            : %sB\n' "$(numfmt --to=iec "$(jq -r .image_bytes "$STATE")")"
    fi
    printf 'merged now      : %s\n' "$(merged && echo yes || echo no)"
    systemd-sysext status 2>/dev/null || true
}

cmd_verify() {
    # A refused read must not exit 0 here. `verify` answers "is this what APEX
    # built", and exiting 0 without looking answers "yes" to a question nobody
    # checked.
    case "$(state_kind)" in
        absent) echo "no packages installed"; return 0 ;;
        unreadable) state_unreadable_notice verify; return 1 ;;
    esac
    local payload want have
    payload="$(current_payload)"
    [ -n "$payload" ] || die "the extension recorded in state.json is missing"
    if [ -f "$payload" ]; then
        want="$(jq -r .image_sha256 "$STATE")"
        have="$(sha "$payload")"
        [ "$want" = "$have" ] || die "extension image checksum mismatch"
    fi
    merged || warn "extension is not currently merged"
    # `verify` answers "is this what APEX built", so it also has to answer "and
    # how much of it did APEX actually vouch for".
    local unverified
    unverified="$(jq -r '(.unsigned_accepted // [])[]' "$STATE" 2>/dev/null || true)"
    if [ -n "$unverified" ]; then
        warn "contains package(s) you accepted with --allow-unsigned; their signatures were never verified:"
        printf '%s\n' "$unverified" | sed 's/^/  /' >&2
    fi
    msg "extension intact"
}

cmd_rollback() {
    need_root pkg
    take_lock
    if [ ! -e "${ROLLBACK_DIR}/${EXT_NAME}.raw" ] && [ ! -e "${ROLLBACK_DIR}/${EXT_NAME}" ]; then
        die "no previous extension to roll back to"
    fi
    restore_previous
    # The previous requested list is about to come back, so the cached local
    # RPMs it names have to come back with it.
    restore_local_cache
    if [ -f "${ROLLBACK_DIR}/state.json" ]; then
        mv -f "${ROLLBACK_DIR}/state.json" "$STATE"
    fi
    jq -r '.requested[]' "$STATE" > "$REQUESTED" 2>/dev/null || true
    systemd-sysext refresh >&2 || die "could not merge the previous extension"
    post_merge
    msg "rolled back"
}

# Convert an existing rpm-ostree layered deployment into extension packages and
# hand the OS back its ability to update. This is the migration path for every
# machine that layered something before this tool existed.
cmd_adopt() {
    need_root pkg
    command -v rpm-ostree >/dev/null || die "rpm-ostree is not available"
    local -a layered=()
    mapfile -t layered < <(rpm-ostree status --json 2>/dev/null \
        | jq -r '.deployments[0]["requested-packages"][]?' | sort -u)
    if [ "${#layered[@]}" -eq 0 ]; then
        msg "no rpm-ostree layered packages to adopt"
        return 0
    fi
    msg "adopting layered packages: ${layered[*]}"
    take_lock
    local -a want=()
    mapfile -t want < <(load_requested)
    want+=("${layered[@]}")
    rebuild_extension "${want[@]}"
    flock -u 9
    msg "removing the rpm-ostree layer that blocks OS updates"
    rpm-ostree reset >&2 || die "rpm-ostree reset failed"
    msg "adopted. Reboot to drop the layered deployment, after which 'apex update' works again."
}

# ─────────────────────────────────────────────────────────────────────────────
# ── the universal resolver (§9) ──────────────────────────────────────────────
#
# WHAT PROBLEM THIS SOLVES
# A user who wants Discord should type `apex install discord`. They should not
# first have to know that APEX is image-based, that an RPM goes into a system
# extension while a Flatpak does not, that a vendor RPM which self-updates is a
# trap on a read-only /usr, or that some software only exists as a package for
# a distribution this is not. §9: "a normal user does not have to understand
# RPM vs Flatpak vs AppImage vs containerized distro packages unless they want
# to."
#
# WHAT IT DELIBERATELY DOES NOT DO
# It does not change what `apex install <name>` already does. That command
# ships, runs from `apex update` and from a boot-time unit, and is covered by
# the assertions above; a resolver that silently re-routed a name which
# installs an RPM today would be a behaviour change on a non-interactive
# command, which is exactly the shape this repository refuses. So the ranking
# below puts an exact-name repository package first and everything else after
# it, and the resolver's job is to SAY what it chose, name the alternative, and
# take `--source` when the user disagrees.
#
# The one exception is the curated table, and it is deliberately tiny: a
# handful of packages whose RPM exists and is a known trap on an atomic host.
# Every entry carries its reason in the file, so the table is auditable rather
# than clever.
#
# WHY THE ORDER IS WHAT IT IS
#   1. an exact-name repository package — it puts the command on $PATH where a
#      script expects it, its signature is checked against a keyring APEX
#      already trusts, it is rebuilt automatically after an OS upgrade, and it
#      rolls back with the rest of the extension;
#   2. a Flatpak — sandboxed and never touching /usr, which is better than
#      nothing but cannot provide a command-line tool a script can call;
#   3. a capsule — anything a distribution APEX is not still packages. The
#      software works, and it works inside the capsule, not on the host.
# ─────────────────────────────────────────────────────────────────────────────

# Where the capsule engine lives. A CONSTANT, not an environment variable:
# `apex install` runs as root, and letting a caller-controlled variable choose
# a program a root process executes is a privilege-escalation hole for the sake
# of test convenience. The capsule route refuses root anyway (see below), so
# nothing here ever execs it with privileges.
readonly ENV_ENGINE=/usr/libexec/apex-env

# Packages whose repository build is a trap on an image-based system.
#
# The bar for an entry is high: the RPM must exist, must install, and must then
# behave badly in a way the user cannot fix — not merely "the Flatpak is nicer".
# Format: `name|source|reason`. The reason is printed verbatim, because a
# re-route the user did not ask for has to justify itself on the spot.
#
#   discord  The RPM Fusion package is the vendor's own tarball repackaged, and
#            Discord refuses to start once it considers itself out of date. On
#            a normal distribution the next `dnf update` fixes that; here the
#            update has to wait for RPM Fusion to rebuild AND for the extension
#            to be rebuilt, so the client spends days telling the user to
#            update and offering them no way to do it. The Flathub build
#            updates itself on its own schedule.
curated_source() {
    case "$1" in
        discord)
            printf 'flatpak|the RPM is the vendor tarball repackaged and refuses to start once it considers itself out of date, which on an image-based system it regularly does'
            ;;
        *) return 1 ;;
    esac
}

# Does a Flathub result actually answer what was asked?
#
# `flatpak search` matches descriptions too, so searching for "code" returns
# fifty applications that merely mention it. A candidate counts only when the
# application id's last segment or the application's name equals the term,
# case-insensitively — that is the difference between "there is a Flatpak for
# this" and "Flathub contains the word".
flatpak_match() {
    local term appid name last
    term="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    appid="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
    name="$(printf '%s' "$3" | tr '[:upper:]' '[:lower:]')"
    [ -n "$term" ] || return 1
    last="${appid##*.}"
    [ "$last" = "$term" ] && return 0
    [ "$name" = "$term" ] && return 0
    [ "$appid" = "$term" ] && return 0
    return 1
}

# The order the sources are offered in, given which ones have a candidate.
# Pure, and separated from the probes for exactly that reason: the ranking is
# the policy, and a policy that can only be exercised with a network and a
# populated dnf cache is a policy nobody checks.
# Where a BARE name goes when no --source was given. `apex resolve` and
# `apex install` must not disagree about this, and they have before: the suite
# records a round where resolve told a user to install the Chromium flatpak
# while install fetched the Fedora rpm. This is the same disagreement in the
# other direction, found 2026-09-22 by `apex install obs-studio discord code
# libreoffice blender wine chromium` on katana.
#
# `code` has NO rpm anywhere — only a flatpak — and the old routing kept every
# non-curated name for dnf. dnf then failed the WHOLE transaction with
# `No package "code" available`, so obs-studio, libreoffice, blender, wine and
# chromium did not install either. One unavailable name took five good ones
# with it, and `apex resolve code` had already said "APEX would use: flatpak".
#
# Prints `flatpak <appid>` or `rpm`. The rpm probe is the same one resolve
# uses, so the two answers are the same answer by construction rather than by
# two functions agreeing today.
#
# The caveat, stated because it is a real one: probe_rpm matches a package NAME
# exactly, so a name that dnf could only satisfy through a `Provides:` reads as
# having no rpm. Such a name is rerouted only when a Flatpak actually exists
# for it, and resolve would have said flatpak too — so the tools still agree,
# which is the property being defended here.
bare_name_route() {
    local n="$1" id
    if [ -n "$(probe_rpm "$n")" ]; then printf 'rpm\n'; return 0; fi
    if id="$(first_flatpak_id "$n")" && [ -n "$id" ]; then
        printf 'flatpak %s\n' "$id"; return 0
    fi
    # No rpm and no flatpak: keep it on the rpm route so dnf produces the error
    # naming it, rather than this function inventing one.
    printf 'rpm\n'
}

rank_sources() {
    local have_rpm="$1" have_flatpak="$2" have_capsule="$3"
    [ "$have_rpm" = 1 ]     && printf 'rpm\n'
    [ "$have_flatpak" = 1 ] && printf 'flatpak\n'
    [ "$have_capsule" = 1 ] && printf 'capsule\n'
    return 0
}

# How software from each source is vouched for. §9 asks for provenance in the
# UI, and "where did this come from" is answered by who signed it, not by which
# command installed it.
provenance() {
    case "$1" in
        rpm)     printf 'signature checked against the Fedora/RPM Fusion/COPR keys APEX trusts; installed into the system extension, rolls back with it' ;;
        flatpak) printf 'signed by its Flatpak remote and sandboxed; never touches /usr and updates independently of the OS' ;;
        capsule) printf "signed by the capsule distribution's own keys; installed inside the container, invisible to the host" ;;
        *) return 1 ;;
    esac
}

valid_source() { case "$1" in rpm|flatpak|capsule) return 0 ;; esac; return 1; }

# ── source probes ───────────────────────────────────────────────────────────
# Each prints one line per candidate and nothing on no match. Kept separate
# from the ranking so a fake `dnf5`/`flatpak` on $PATH exercises the whole
# resolver with no network.

# `name|evr|repo|summary` for an exact-name repository package.
#
# repoquery, not search: `dnf5 search htop` matches summaries and would report
# a candidate for every package that mentions the word. A bare name is an exact
# name match to repoquery, which is the question being asked.
#
# NO `--` BEFORE THE NAME, and that is not a style choice. `dnf5 repoquery`
# rejects `--` outright:
#
#   $ dnf5 repoquery --quiet --queryformat '%{name}\n' -- chromium
#   Unknown argument "--" for command "repoquery".
#
# It writes that to stderr, which this function discards, and prints nothing to
# stdout — so `probe_rpm` returned NOTHING FOR EVERY PACKAGE IN THE WORLD, and
# `apex resolve <anything>` silently lost its entire rpm leg. Measured on katana
# 2026-09-19 (evidence §11.1): `apex resolve chromium` offered only the Flathub
# build and printed "APEX would use: flatpak", while `apex install chromium`
# installed chromium-152.0.7977.82-1.fc43.x86_64 from Fedora. A predictor that
# disagrees with the thing it predicts is worse than no predictor.
#
# The suite faked dnf5 and the fake ignored its arguments, so 50+ assertions
# passed over this. tests/test-apex-resolve.sh's fake now refuses `--` with the
# real error text, and tests/test-apex-multilib-extract.sh calls probe_rpm
# against a REAL dnf5 inside the container.
probe_rpm() {
    command -v dnf5 >/dev/null 2>&1 || return 0
    dnf5 repoquery --quiet --latest-limit 1 \
         --queryformat '%{name}|%{evr}|%{repoid}|%{summary}\n' "$1" 2>/dev/null \
        | awk -F'|' -v n="$1" '$1 == n' \
        | awk -F'|' '!seen[$1"|"$2]++' \
        | head -3
}

# `appid|name|remote` for Flatpak applications that really answer the term.
probe_flatpak() {
    have_flatpak || return 0
    local appid name remote
    while IFS=$'\t' read -r appid name remote _; do
        [ -n "$appid" ] || continue
        if flatpak_match "$1" "$appid" "$name"; then
            printf '%s|%s|%s\n' "$appid" "$name" "${remote:-flathub}"
        fi
    done < <(flatpak search --columns=application,name,remotes -- "$1" 2>/dev/null) \
        | head -3
    return 0
}

# The capsule that would receive the package, or nothing.
#
# Runs the capsule engine as the INVOKING user, never as root: capsules are
# per-user, and root's list is empty on every machine. Under sudo that means
# $SUDO_USER; with no sudo it is simply this user.
probe_capsule() {
    # The one knob here, and it only ever turns the probe OFF — it cannot name
    # a program, a path or a source, so nothing it can be set to changes what a
    # root process executes. It exists because the suite has to get the same
    # answer on a machine that has capsules and one that does not; without it,
    # "nothing provides this name" would depend on whether the developer
    # running the tests happens to have made a capsule.
    [ "${APEX_PKG_NO_CAPSULE:-0}" = 1 ] && return 0
    [ -x "$ENV_ENGINE" ] || return 0
    local out
    if [ "$(id -u)" = 0 ]; then
        local u="${SUDO_USER:-}"
        [ -n "$u" ] && [ "$u" != root ] || return 0
        out="$(runuser -u "$u" -- "$ENV_ENGINE" list --json 2>/dev/null)" || return 0
    else
        out="$("$ENV_ENGINE" list --json 2>/dev/null)" || return 0
    fi
    printf '%s' "$out" | jq -r '.[0] | select(.) | "\(.name)|\(.image)|\(.package_manager)"' 2>/dev/null
    return 0
}

# The application id a bare name resolves to on Flathub, or nothing.
# Used by `--source flatpak` and by the curated re-route, both of which have to
# turn a word the user typed into an id they have never seen.
first_flatpak_id() {
    local hit
    hit="$(probe_flatpak "$1" | head -1)"
    [ -n "$hit" ] || return 1
    printf '%s' "${hit%%|*}"
}

# `apex install --source capsule <pkg>...` — §9's third source.
#
# Refuses root, and that refusal is the point rather than an inconvenience:
# capsules are per-user rootless containers, so root has none, and `sudo apex
# install --source capsule` would report an empty capsule list on every machine
# in the world. Told with the command that works, because a user who reached
# here typed `sudo` for a reason.
install_into_capsule() {
    local box="$ENV_NAME"
    if [ "$(id -u)" = 0 ]; then
        local u="${SUDO_USER:-}"
        printf 'apex-pkg: error: %s\n' \
            "a capsule belongs to a user, and root has none" \
            "" \
            "Run it without sudo:" \
            "  apex install --source capsule $*" >&2
        [ -n "$u" ] && [ "$u" != root ] \
            && printf 'apex-pkg: error: %s\n' "  (as ${u}, the account that ran sudo)" >&2
        exit 1
    fi
    [ -x "$ENV_ENGINE" ] \
        || die "no capsule engine on this system — it predates 'apex env'; run: sudo apex update"
    if [ -z "$box" ]; then
        local hit
        hit="$(probe_capsule)"
        box="${hit%%|*}"
        [ -n "$box" ] \
            || die "no capsule to install into. Make one first:  apex env create fedora"
        msg "using capsule '${box}' (name another with --env)"
    fi
    "$ENV_ENGINE" install "$box" "$@"
}

# ── resolve ─────────────────────────────────────────────────────────────────
# Read-only and unprivileged on purpose: "what would this install, and from
# where" is a question a user should be able to ask without a password.
cmd_resolve() {
    [ "$#" -ge 1 ] || die "usage: apex resolve <name>"
    local name="$1"

    # The two syntactic forms decide themselves and there is nothing to rank.
    if is_local_rpm_arg "$name"; then
        printf 'apex: %s\n' \
            "'${name}' is a local RPM file, so there is nothing to choose." \
            "  sudo apex install ${name}" \
            "  provenance: $(provenance rpm)"
        return 0
    fi
    if is_flatpak_id "$name"; then
        printf 'apex: %s\n' \
            "'${name}' is a Flatpak application id, so there is nothing to choose." \
            "  sudo apex install ${name}" \
            "  provenance: $(provenance flatpak)"
        return 0
    fi

    if [[ "$name" =~ $REFUSE_RE ]]; then
        printf 'apex: %s\n' \
            "'${name}' is a kernel or core-system package." \
            "No source can provide it: overlaying a second copy of the running" \
            "userspace ABI onto /usr is unrecoverable without a rollback, and a" \
            "kernel needs an initramfs and a real deployment." \
            "If APEX should ship it, that is an image change, not an install." >&2
        return 1
    fi

    local -a rpm_hits=() flatpak_hits=() capsule_hits=()
    mapfile -t rpm_hits < <(probe_rpm "$name")
    mapfile -t flatpak_hits < <(probe_flatpak "$name")
    mapfile -t capsule_hits < <(probe_capsule)

    local have_rpm=0 have_flatpak=0 have_capsule=0
    [ -n "${rpm_hits[0]:-}" ] && have_rpm=1
    [ -n "${flatpak_hits[0]:-}" ] && have_flatpak=1
    [ -n "${capsule_hits[0]:-}" ] && have_capsule=1

    if [ "$have_rpm$have_flatpak$have_capsule" = 000 ]; then
        printf 'apex: %s\n' \
            "nothing called '${name}' in the repositories or on Flathub." \
            "" \
            "  apex search ${name}          look for a near match" \
            "  apex repo enable-copr O/P    add a COPR that has it" \
            "  apex env create fedora       then: apex env install fedora ${name}" >&2
        return 1
    fi

    local -a order=()
    mapfile -t order < <(rank_sources "$have_rpm" "$have_flatpak" "$have_capsule")
    local chosen="${order[0]}" reason="ranked first for this system"

    local curated
    if curated="$(curated_source "$name")"; then
        local forced="${curated%%|*}"
        case " ${order[*]} " in
            *" $forced "*)
                chosen="$forced"
                reason="APEX prefers this source for ${name}: ${curated#*|}"
                ;;
        esac
    fi

    echo "candidates for '${name}':"
    local h
    for h in "${rpm_hits[@]:-}"; do
        [ -n "$h" ] || continue
        printf '  %-8s %s-%s  (repo %s)  %s\n' rpm \
            "$(cut -d'|' -f1 <<<"$h")" "$(cut -d'|' -f2 <<<"$h")" \
            "$(cut -d'|' -f3 <<<"$h")" "$(cut -d'|' -f4- <<<"$h")"
    done
    for h in "${flatpak_hits[@]:-}"; do
        [ -n "$h" ] || continue
        printf '  %-8s %s  (%s on %s)\n' flatpak \
            "$(cut -d'|' -f1 <<<"$h")" "$(cut -d'|' -f2 <<<"$h")" \
            "$(cut -d'|' -f3 <<<"$h")"
    done
    for h in "${capsule_hits[@]:-}"; do
        [ -n "$h" ] || continue
        printf '  %-8s capsule %s  (%s, %s)\n' capsule \
            "$(cut -d'|' -f1 <<<"$h")" "$(cut -d'|' -f2 <<<"$h")" \
            "$(cut -d'|' -f3 <<<"$h")"
    done

    echo
    echo "APEX would use: ${chosen} — ${reason}"
    echo "provenance:     $(provenance "$chosen")"
    echo "install:        $(install_command "$name" "$chosen" "${flatpak_hits[0]:-}" "${capsule_hits[0]:-}")"

    local alt
    for alt in "${order[@]}"; do
        [ "$alt" = "$chosen" ] && continue
        echo "or:             $(install_command "$name" "$alt" "${flatpak_hits[0]:-}" "${capsule_hits[0]:-}")"
    done
    return 0
}

# The exact command that installs `name` from `source`. Printed rather than
# described, because "you could use a Flatpak instead" leaves the user to guess
# an application id they have never seen.
install_command() {
    local name="$1" source="$2" flatpak_hit="$3" capsule_hit="$4"
    case "$source" in
        rpm)     printf 'sudo apex install --source rpm %s' "$name" ;;
        flatpak)
            local id="${flatpak_hit%%|*}"
            printf 'sudo apex install %s' "${id:-$name}"
            ;;
        capsule)
            local box="${capsule_hit%%|*}"
            printf 'apex env install %s %s' "${box:-<capsule>}" "$name"
            ;;
    esac
}

cmd_search() {
    [ "$#" -gt 0 ] || die "usage: apex search <term>..."
    # Repository packages first: they are the source `apex install` uses for a
    # bare name, so putting anything above them would misrepresent what typing
    # the name does.
    echo "── repository packages ─────────────────────────────────────────────"
    dnf5 search "$@"
    # §9's "search multiple supported package sources". Flatpak's own search
    # reads the local AppStream cache, so this costs nothing and works offline.
    if have_flatpak; then
        echo
        echo "── Flatpak applications ────────────────────────────────────────────"
        flatpak search --columns=application,name,description "$@" 2>/dev/null \
            || echo "(no Flatpak remote is configured)"
    fi
    echo
    echo "apex resolve <name>  shows which source APEX would use, and why"
}

valid_copr_project() {
    [[ "$1" =~ ^@?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
}

refresh_copr_keyring() {
    rm -rf "$COPR_KEY_DB"
    install -d -m0700 "$COPR_KEY_DB"
    rpm --dbpath "$COPR_KEY_DB" --initdb
    [ -d "$COPR_KEYS" ] || return 0

    local -a keys=()
    local key
    mapfile -d '' -t keys < <(find "$COPR_KEYS" -type f -name '*.gpg' -print0 | sort -z)
    for key in "${keys[@]}"; do
        rpm --dbpath "$COPR_KEY_DB" --import "$key"
    done
}

cmd_repo_list() {
    dnf5 repolist --all
}

cmd_repo_enable_copr() {
    [ "$#" = 1 ] || die "usage: apex repo enable-copr OWNER/PROJECT"
    need_root repo
    valid_copr_project "$1" || die "COPR project must be OWNER/PROJECT"
    dnf5 -y copr enable "$1" >&2 || die "could not enable COPR '$1'"
    local owner="${1%%/*}" project="${1#*/}" keyfile
    local key="https://download.copr.fedorainfracloud.org/results/${owner}/${project}/pubkey.gpg"
    keyfile="$(mktemp)"
    if ! curl --fail --silent --show-error --location \
              --proto '=https' --tlsv1.2 "$key" -o "$keyfile"; then
        dnf5 -y copr disable "$1" >&2 || true
        rm -f "$keyfile"
        die "could not download the signing key for COPR '$1'; repository disabled"
    fi
    install -Dm0600 "$keyfile" "${COPR_KEYS}/${owner}/${project}.gpg"
    if ! refresh_copr_keyring; then
        dnf5 -y copr disable "$1" >&2 || true
        rm -f "${COPR_KEYS}/${owner}/${project}.gpg"
        refresh_copr_keyring || true
        rm -f "$keyfile"
        die "could not import the signing key for COPR '$1'; repository disabled"
    fi
    rm -f "$keyfile"
    msg "enabled COPR '$1'; apex search/install will now use it"
}

cmd_repo_disable_copr() {
    [ "$#" = 1 ] || die "usage: apex repo disable-copr OWNER/PROJECT"
    need_root repo
    valid_copr_project "$1" || die "COPR project must be OWNER/PROJECT"
    dnf5 -y copr disable "$1" >&2 || die "could not disable COPR '$1'"
    local owner="${1%%/*}" project="${1#*/}"
    rm -f "${COPR_KEYS}/${owner}/${project}.gpg"
    find "$COPR_KEYS" -depth -type d -empty -delete 2>/dev/null || true
    refresh_copr_keyring || die "repository disabled, but its key could not be removed from the APEX keyring"
    msg "disabled COPR '$1'"
}

usage() {
    cat <<'EOF'
usage: apex-pkg <command> [args]

  install <pkg|file.rpm|file.deb>...
                       add packages. A reverse-DNS id (org.gimp.GIMP) is a
                       Flatpak; a path or a name ending in .rpm is a local RPM
                       file, which is copied into /var/lib/apex/pkg/local so
                       later rebuilds no longer need the original file. Its
                       dependencies still come from the repositories.
                       A path or a name ending in .deb is a local Debian
                       package, cached the same way under
                       /var/lib/apex/pkg/deb. Its payload is unpacked; its
                       maintainer scripts are NEVER run and its Debian
                       dependencies are NEVER resolved, both of which are
                       reported. APEX does not fetch from apt repositories —
                       a .deb is installed from a file you already have.
                       --allow-unsigned accepts one local file that no trusted
                       key covers; the decision is recorded per file. Every
                       .deb needs it: Debian signs the apt index, not the
                       package.
                       --source rpm|flatpak|capsule picks the source for a bare
                       name instead of letting APEX rank them; --env NAME says
                       which capsule --source capsule installs into.
  resolve <name>       which source APEX would use for that name, why, what
                       vouches for it, and the exact command for each
                       alternative. Read-only; needs no root.
  remove  <pkg>...     remove packages or Flatpak apps (a local file is removed
                       by its package name)
  upgrade              refresh all extension packages from the repositories
  flatpak-upgrade      update Flatpak apps (system + invoking user)
  rebuild [--if-needed] rebuild for the running OS version
  rollback             restore the previous extension
  adopt                convert rpm-ostree layered packages into the extension
  repo-list            list enabled and disabled package repositories
  repo-enable-copr OWNER/PROJECT
                       enable a COPR for search, install, and upgrades
  repo-disable-copr OWNER/PROJECT
                       disable a previously enabled COPR
  list | info | status | verify | search <term>...
EOF
}

main() {
    local cmd="${1:-}"; shift || true
    NO_WEAK_DEPS=0
    ENABLE_REPOS=""
    # Off unless asked for, every run: an unverifiable package is never the
    # default and the opt-in is never remembered as a global setting. What IS
    # remembered is the per-file decision, in LOCAL_DIR.
    ALLOW_UNSIGNED=0
    # §9's escape hatch. Empty means "let APEX decide", which is the only
    # setting that ever changes behaviour based on the curated table below;
    # naming a source explicitly always wins and is never overridden.
    SOURCE=""
    ENV_NAME=""
    local -a rest=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-weak-deps) NO_WEAK_DEPS=1 ;;
            --allow-unsigned) ALLOW_UNSIGNED=1 ;;
            --enable-repo=*) ENABLE_REPOS="${ENABLE_REPOS} ${1#*=}" ;;
            --enable-repo) shift || true; ENABLE_REPOS="${ENABLE_REPOS} ${1:-}" ;;
            --source=*) SOURCE="${1#*=}" ;;
            --source) shift || true; SOURCE="${1:-}" ;;
            --env=*) ENV_NAME="${1#*=}" ;;
            --env) shift || true; ENV_NAME="${1:-}" ;;
            *) rest+=("$1") ;;
        esac
        shift || true
    done
    if [ -n "$SOURCE" ]; then
        valid_source "$SOURCE" \
            || die "unknown source '${SOURCE}' (rpm, flatpak, capsule)"
    fi
    if [ "${#rest[@]}" -gt 0 ]; then
        set -- "${rest[@]}"
    else
        set --
    fi

    case "$cmd" in
        install)  cmd_install "$@" ;;
        remove)   cmd_remove "$@" ;;
        upgrade)  cmd_upgrade ;;
        flatpak-upgrade) cmd_flatpak_upgrade ;;
        rebuild)  cmd_rebuild "${1:-}" ;;
        rollback) cmd_rollback ;;
        adopt)    cmd_adopt ;;
        list)     cmd_list ;;
        info)     cmd_info ;;
        status)   cmd_status ;;
        verify)   cmd_verify ;;
        search)   cmd_search "$@" ;;
        resolve)  cmd_resolve "$@" ;;
        repo-list) cmd_repo_list ;;
        repo-enable-copr) cmd_repo_enable_copr "$@" ;;
        repo-disable-copr) cmd_repo_disable_copr "$@" ;;
        ""|-h|--help|help) usage ;;
        *) die "unknown command '$cmd' (try --help)" ;;
    esac
}

main "$@"
