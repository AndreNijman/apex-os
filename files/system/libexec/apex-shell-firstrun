#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  APEX-OS — first-login provisioner
#  Installed to /usr/libexec/apex-shell-firstrun; driven by the per-user
#  systemd unit apex-shell-firstrun.service (see files/system/units/).
#
#  Runs ONCE per user, at first login. It clones the public APEX Shell repo
#  into the user's home and seeds the per-user config the shell expects.
#
#  Why not just run the shell's own install.sh?
#    install.sh (github.com/AndreNijman/apex-shell) is an ARCH installer:
#      * it hard-`die`s on any non-Arch distro (APEX-OS is fedora-bootc), and
#      * step 4 runs `dots-extra/install-arch.sh`, which does `sudo pacman`/AUR
#        package installs — impossible from an unprivileged user service, and
#        unnecessary here because every dependency is baked into the image, and
#      * it requires a pre-existing ~/.config/hypr config (else it `die`s).
#    So this script REPLICATES install.sh's per-user *seeding* (the parts that
#    are not package installation): the shallow clone, the portable matugen
#    render (install.sh step 5), and the config-dir seeding + Hyprland autostart
#    wiring (dots-extra/install-arch.sh steps 5-6). The seeding is kept faithful
#    so the shell's auto-updater and hot-reload keep working off the live clone.
#
#  Idempotent + network-failure-tolerant: writes the marker ONLY on full
#  success; any failure leaves it absent so the next login retries.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO_URL="https://github.com/AndreNijman/apex-shell"
SRC_DIR="${HOME}/.local/src/apex-shell"
CFG_DIR="${HOME}/.config/apex-shell"
MARKER="${CFG_DIR}/.provisioned"
SYS_WALLPAPER="/usr/share/backgrounds/apex/default.jpg"

log() { printf '[apex-shell-firstrun] %s\n' "$*"; }

# Human users only. System/service accounts (greetd at ~uid 970, etc.) can get a
# transient systemd --user manager and would otherwise clone the shell into their
# state dir. Gate on the regular-user UID range so this only ever provisions real
# logins (uid >= 1000). See apex-logs/18-greetd-provisioner-scope.md.
if [ "$(id -u)" -lt 1000 ]; then
    log "system user (uid $(id -u)) — not a human login; skipping."
    exit 0
fi

# ── 0. Seed the compositor config FIRST — before ANYTHING that can block ─────
# CRITICAL ORDERING (apex-logs 43). greetd execs Hyprland in parallel with this
# user unit, and Hyprland writes its OWN stock config to ~/.config/hypr/
# hyprland.conf within ~1s of starting if none exists. Step 1 below can burn 30s
# in the network poll, so when the seeding lived down in step 5 Hyprland ALWAYS
# won: the `[ ! -f ]` guard then saw a file and skipped the APEX template, and
# the user landed in stock Hyprland with only the autostart block appended.
# Measured on the first p5 install — Hyprland wrote the file at 14:35:05, the
# provisioner did not reach step 5 until 14:35:38.
#
# Two changes make that unwinnable race harmless:
#   a) seed here, before the network poll, so we normally win outright; and
#   b) treat a Hyprland-autogenerated file as "no config at all", so even a lost
#      race self-heals instead of persisting forever.
# This block also sits ABOVE the marker check on purpose: config seeding is
# cheap and idempotent, so an ALREADY-provisioned user whose config got
# clobbered still gets repaired at the next login. Only the expensive clone
# stays gated behind the marker.
APEX_HYPR_TMPL="/usr/share/apex/hypr/hyprland.conf"
HYPR_CONF="${HOME}/.config/hypr/hyprland.conf"

# ── Keyboard layout: take the SYSTEM keymap, never a hardcoded one ───────────
# The template ships @KB_LAYOUT@/@KB_VARIANT@ instead of a literal `us` so a
# non-US user does not silently get a US layout in their session (and then have
# to type their password on it). Hyprland does NOT read
# /etc/X11/xorg.conf.d/00-keyboard.conf itself — it only knows what its config
# says — so the value has to be substituted in here, at seed time.
#
# That file is what `localectl set-x11-keymap` and Anaconda-class installers
# write. If nothing has set a keymap, it will not exist and we fall back to
# `us`, which is exactly the old behaviour — so this can only ever improve on
# what shipped before, never regress it.
XKB_CONF="/etc/X11/xorg.conf.d/00-keyboard.conf"
read_xkb_option() {
    # $1 = XkbLayout | XkbVariant. Prints the value, or nothing.
    [ -r "${XKB_CONF}" ] || return 0
    sed -n "s/.*Option[[:space:]]\+\"$1\"[[:space:]]\+\"\([^\"]*\)\".*/\1/p" \
        "${XKB_CONF}" | head -n1
}
# NOTE: every substitution below is `|| true`-guarded on purpose. This script
# runs under `set -euo pipefail`, so an unguarded failing command substitution
# in an assignment aborts the whole provisioner — and with pipefail, a
# `localectl | sed` pipeline fails whenever localectl cannot reach dbus, which
# is a perfectly normal thing to happen this early in a first login.
KB_LAYOUT="$(read_xkb_option XkbLayout || true)"
KB_VARIANT="$(read_xkb_option XkbVariant || true)"
# localectl is the fallback source (it answers from systemd-localed even when
# the xorg.conf.d snippet is absent). Best-effort: no dbus, no answer, no harm.
if [ -z "${KB_LAYOUT}" ] && command -v localectl >/dev/null 2>&1; then
    KB_LAYOUT="$( { localectl status 2>/dev/null \
        | sed -n 's/^[[:space:]]*X11 Layout:[[:space:]]*//p' | head -n1; } || true)"
    KB_VARIANT="$( { localectl status 2>/dev/null \
        | sed -n 's/^[[:space:]]*X11 Variant:[[:space:]]*//p' | head -n1; } || true)"
fi
[ -n "${KB_LAYOUT}" ] || KB_LAYOUT="us"
log "keyboard layout for the seeded session: '${KB_LAYOUT}' variant '${KB_VARIANT}'"

# Hyprland stamps every config it generates with `autogenerated = 1`; the APEX
# template never carries that marker. So its presence is a reliable "this is a
# placeholder, not the user's own work" signal, and we may replace it.
is_stock_hypr_conf() {
    [ -f "$1" ] && grep -q '^autogenerated[[:space:]]*=[[:space:]]*1' "$1"
}

# The template is self-contained: it already carries the APEX Shell autostarts
# and `source`s ApexShellKeybinds.conf, so step 5's append-guard (grep apex-shell)
# correctly skips re-appending them once this has run.
# Single place that turns the shipped template into a real config, so @HOME@
# and the keymap placeholders can never drift apart between the two call sites.
render_hypr_tmpl() {
    sed -e "s|@HOME@|${HOME}|g" \
        -e "s|@KB_LAYOUT@|${KB_LAYOUT}|g" \
        -e "s|@KB_VARIANT@|${KB_VARIANT}|g" \
        "$1"
}

seed_hypr_conf() {
    [ -f "${APEX_HYPR_TMPL}" ] || return 1
    mkdir -p "${HOME}/.config/hypr/shaders"
    render_hypr_tmpl "${APEX_HYPR_TMPL}" > "${HYPR_CONF}"
    log "seeded APEX Hyprland config -> ${HYPR_CONF}"
}

if [ ! -f "${HYPR_CONF}" ]; then
    seed_hypr_conf || log "WARN: no APEX Hyprland template; step 5 will fall back."
elif is_stock_hypr_conf "${HYPR_CONF}"; then
    log "found a Hyprland-autogenerated config — lost the startup race; replacing."
    cp -a "${HYPR_CONF}" "${HYPR_CONF}.stock.bak" 2>/dev/null || true
    seed_hypr_conf || log "WARN: no APEX Hyprland template; leaving stock config."
    # Best-effort live repair: if Hyprland is already up it has the stock config
    # loaded, so ask it to re-read. Silently a no-op when the instance signature
    # is not in this unit's environment — the next login picks it up regardless.
    hyprctl reload >/dev/null 2>&1 || true
fi

# ── zsh + starship, themed to the running edition ───────────────────────────
# Seeded here rather than /etc/skel because the starship theme carries an
# @ACCENT@ placeholder that has to become chartreuse on Daily and gold on
# Gaming — skel is a straight copy and cannot substitute anything.
#
# Both are seeded ONLY if absent. These are the user's dotfiles from the moment
# they first log in; APEX writes a good starting point and then never touches
# them again, so nothing anyone customises is at risk on a later boot.
ZSHRC_TMPL="/usr/share/apex/zsh/zshrc"
STARSHIP_TMPL="/usr/share/apex/starship/starship.toml"

# Accent follows VARIANT_ID (docs/branding.md): the prompt should match the
# greeter and the boot splash of the edition actually running.
APEX_VARIANT="$(sed -n 's/^VARIANT_ID=//p' /etc/os-release 2>/dev/null | tr -d '"' | head -1)"
case "${APEX_VARIANT}" in
    gaming*) APEX_ACCENT="#FDE047" ;;   # gold
    *)       APEX_ACCENT="#D9F99D" ;;   # chartreuse
esac

if [ -f "${ZSHRC_TMPL}" ] && [ ! -f "${HOME}/.zshrc" ]; then
    cp "${ZSHRC_TMPL}" "${HOME}/.zshrc"
    log "seeded ~/.zshrc"
fi
if [ -f "${STARSHIP_TMPL}" ] && [ ! -f "${HOME}/.config/starship.toml" ]; then
    mkdir -p "${HOME}/.config"
    sed "s|@ACCENT@|${APEX_ACCENT}|g" "${STARSHIP_TMPL}" > "${HOME}/.config/starship.toml"
    log "seeded ~/.config/starship.toml (accent ${APEX_ACCENT} for '${APEX_VARIANT:-daily}')"
fi

# Belt-and-suspenders: the unit's own gate covers this, but a manual invocation
# should also no-op once provisioned. Everything BELOW here is the one-time,
# network-dependent work; the config seeding above deliberately runs every login.
if [ -e "${MARKER}" ]; then
    log "already provisioned (${MARKER} present) — nothing further to do."
    exit 0
fi

# ── 1. Wait (briefly) for network ────────────────────────────────────────────
# A first login can beat NetworkManager reaching online; poll the remote a few
# times. If still offline we exit non-zero WITHOUT the marker, so the unit
# retries at the next login (network-failure-tolerant, per the design).
online() { git ls-remote --exit-code "${REPO_URL}" HEAD >/dev/null 2>&1; }
if ! online; then
    for i in $(seq 1 15); do
        log "waiting for network (${i}/15)..."
        sleep 2
        online && break
    done
fi
if ! online; then
    log "network still unavailable — leaving marker unset; will retry next login."
    exit 1
fi

# ── 2. Clone (shallow) or refresh the shell checkout ─────────────────────────
mkdir -p "$(dirname "${SRC_DIR}")"
if [ -d "${SRC_DIR}/.git" ]; then
    log "existing checkout found — fetching latest main."
    git -C "${SRC_DIR}" fetch --depth 1 origin main
    git -C "${SRC_DIR}" reset --hard origin/main
else
    # Scrub any partial/non-git dir left by a failed earlier run, then clone.
    [ -e "${SRC_DIR}" ] && rm -rf "${SRC_DIR}"
    log "cloning ${REPO_URL} (shallow) -> ${SRC_DIR}"
    git clone --depth 1 "${REPO_URL}" "${SRC_DIR}"
fi

# ── 3. Render matugen.toml (install.sh step 5) ───────────────────────────────
# matugen does NOT expand ~ or env vars in template paths, so the shipped
# matugen.toml.in carries @SRCDIR@/@HOME@ placeholders we substitute here into
# an absolute-path config. Matugen is REQUIRED for the shell's theming.
mkdir -p "${CFG_DIR}"
MATUGEN_TMPL="${SRC_DIR}/src/config/matugen.toml.in"
if [ -f "${MATUGEN_TMPL}" ]; then
    sed -e "s|@SRCDIR@|${SRC_DIR}|g" -e "s|@HOME@|${HOME}|g" \
        "${MATUGEN_TMPL}" > "${CFG_DIR}/matugen.toml"
    log "rendered ${CFG_DIR}/matugen.toml"
else
    log "WARN: matugen template not found at ${MATUGEN_TMPL}"
fi

# ── 4. Seed config dirs + defaults (install-arch.sh step 6) ──────────────────
USER_DATA="${CFG_DIR}/src/user_data"
mkdir -p "${USER_DATA}" \
         "${HOME}/.config/hypr/shaders" \
         "${HOME}/.config/matugen/templates" \
         "${HOME}/.cache/apex-shell" \
         "${HOME}/Pictures/Wallpapers"

# configProvider=conf: this provisioner seeds a hyprland.conf (not a .lua), so
# the shell writes keybind edits back to the .conf. keybinds.json defaults empty.
[ -f "${USER_DATA}/config_Provider.json" ] || \
    printf '{"configProvider": "conf"}\n' > "${USER_DATA}/config_Provider.json"
[ -f "${USER_DATA}/keybinds.json" ] || \
    printf '{}\n' > "${USER_DATA}/keybinds.json"
[ -f "${HOME}/.cache/apex-shell/colors.json" ] || \
    : > "${HOME}/.cache/apex-shell/colors.json"

# hypridle config (don't clobber a user-customised one).
cp -n "${SRC_DIR}/src/config/hypridle.conf" "${HOME}/.config/hypr/" 2>/dev/null || true

# Seed the shell's shipped wallpapers, plus the system APEX wallpaper the
# greeter uses (/usr/share/backgrounds/apex/default.jpg) so shell + greeter
# share one default look.
cp -n -r "${SRC_DIR}/src/assets/wallpapers/." "${HOME}/Pictures/Wallpapers/" 2>/dev/null || true
[ -f "${SYS_WALLPAPER}" ] && \
    cp -n "${SYS_WALLPAPER}" "${HOME}/Pictures/Wallpapers/apex-os-default.jpg" 2>/dev/null || true

# ── 5. Hyprland autostart (install-arch.sh step 5, self-seeding) ─────────────
# install-arch.sh appends the autostart block to a PRE-EXISTING hyprland.conf.
# A fresh APEX-OS user has none, so seed a usable base first (distro default if
# present, else a minimal one), THEN append the APEX Shell autostart block
# (guarded by a marker so re-runs never duplicate it).
HYPR_CONF="${HOME}/.config/hypr/hyprland.conf"
if [ ! -f "${HYPR_CONF}" ]; then
    if [ -f /usr/share/apex/hypr/hyprland.conf ]; then
        # APEX default config (APEX keybinds + $terminal=alacritty/$fileManager=
        # thunar/$browser=firefox + autostart + shell-keybind source). Substitute
        # @HOME@ and the keymap placeholders. It already carries the APEX Shell
        # autostart, so the append-guard below (grep apex-shell) skips
        # re-appending.
        render_hypr_tmpl /usr/share/apex/hypr/hyprland.conf > "${HYPR_CONF}"
    elif [ -f /usr/share/hypr/hyprland.conf ]; then
        cp /usr/share/hypr/hyprland.conf "${HYPR_CONF}"
    elif [ -f /usr/share/hyprland/hyprland.conf ]; then
        cp /usr/share/hyprland/hyprland.conf "${HYPR_CONF}"
    else
        cat > "${HYPR_CONF}" <<'HYPRDEF'
# Minimal APEX-OS Hyprland base (seeded by apex-shell-firstrun).
# Extend freely — this only guarantees a usable session with a terminal;
# the APEX Shell autostart block below is appended after it.
$mainMod = SUPER
monitor = , preferred, auto, 1
env = XCURSOR_SIZE,24
bind = $mainMod, Return, exec, alacritty
bind = $mainMod, Q, killactive,
bind = $mainMod SHIFT, E, exit,
bind = $mainMod, Space, exec, alacritty
HYPRDEF
    fi
fi
if ! grep -q 'apex-shell' "${HYPR_CONF}" 2>/dev/null; then
    cat >> "${HYPR_CONF}" <<HYPRAPEX

# ── APEX Shell autostarts (seeded by apex-shell-firstrun) ──
exec-once = awww-daemon
exec-once = hypridle -c ${SRC_DIR}/src/config/hypridle.conf
exec-once = quickshell -c ${SRC_DIR}
exec-once = /usr/libexec/polkit-mate-authentication-agent-1
exec-once = wl-paste --type text  --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store
HYPRAPEX
    log "seeded Hyprland autostart -> ${HYPR_CONF}"
fi

# ── 6. niri autostart (APEX-OS addition; the shell supports niri) ────────────
# The shell's own installer only covers Hyprland, but APEX Shell auto-detects
# niri (NiriService.qml) and the greeter offers a niri session, so seed a niri
# config that launches the shell too. Only if niri is actually installed.
if command -v niri >/dev/null 2>&1 || [ -x /usr/bin/niri ]; then
    NIRI_CONF="${HOME}/.config/niri/config.kdl"
    mkdir -p "${HOME}/.config/niri"
    if [ ! -f "${NIRI_CONF}" ]; then
        if [ -f /usr/share/doc/niri/default-config.kdl ]; then
            cp /usr/share/doc/niri/default-config.kdl "${NIRI_CONF}"
        elif [ -f /usr/share/niri/default-config.kdl ]; then
            cp /usr/share/niri/default-config.kdl "${NIRI_CONF}"
        else
            : > "${NIRI_CONF}"
        fi
    fi
    if ! grep -q 'apex-shell' "${NIRI_CONF}" 2>/dev/null; then
        cat >> "${NIRI_CONF}" <<NIRIAPEX

// ── APEX Shell autostarts (seeded by apex-shell-firstrun) ──
spawn-at-startup "awww-daemon"
spawn-at-startup "quickshell" "-c" "${SRC_DIR}"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
NIRIAPEX
        log "seeded niri autostart -> ${NIRI_CONF}"
    fi
fi

# ── 7. Mark provisioned (ONLY on full success) ───────────────────────────────
# Reached only if every step above succeeded (set -e). The marker lives inside
# ~/.config/apex-shell, which step 3/4 created; its presence disables the unit
# on every future login.
touch "${MARKER}"
log "provisioning complete — marker written to ${MARKER}"
