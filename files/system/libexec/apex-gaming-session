#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  APEX-OS Gaming Mode — Steam Big Picture inside gamescope
#
#  This is the session greetd runs when "APEX Gaming Mode" is picked at the
#  greeter, or when the shell's power menu switches to it. Hyprland and APEX
#  Shell are NOT running: gamescope owns the display directly.
#
#  WHY A GAMESCOPE SESSION AT ALL (the performance argument)
#  In the desktop session the bar and the three border strips are layer-shell
#  surfaces on layer `top`, which the compositor draws ABOVE a fullscreen window
#  — so a game paid to composite four extra surfaces every frame. The shell now
#  unmaps them for a fullscreen window, which helps, but Hyprland is still a
#  full compositor in the path.
#
#  The obvious next step looks like Hyprland's `render:direct_scanout`, and it is
#  the wrong one. It is off by default upstream for good reason: black screens on
#  native-Wayland games, HDR colours blowing out, cursor and VRR regressions, and
#  crashes on `=2`. Not something to enable for everyone.
#
#  gamescope sidesteps the question. It is a tiny compositor that presents
#  directly to KMS, so there is no desktop, no bar, no shell, and nothing to
#  composite over the game — plus Steam Big Picture, controller-first, and
#  per-game scaling for free.
#
#  FAIL-SAFE, BY DESIGN
#  If anything essential is missing this exits NON-ZERO and immediately. greetd
#  then re-displays the greeter, so a broken Gaming Mode is a bounce back to the
#  login screen — never a black screen with no way out. That matters more than
#  usual here: this session cannot be verified on the author's hardware yet.
#
#  Env overrides (for debugging, not for normal use):
#    APEX_GAMESCOPE_ARGS   extra gamescope arguments, appended LAST so they
#                          override the device selection below
#    APEX_STEAM_ARGS       replace the Steam argument list
#    APEX_GAMING_NO_APEXD  set to 1 to skip `apex game start`
#    APEX_GAMING_NO_DEVICE_SELECT
#                          set to 1 to let gamescope pick its own GPU, which is
#                          the behaviour this script had before 2026-09-19 and
#                          the one that put Gaming Mode on the wrong screen
#    APEX_ROOT, VRR_SYS    fixture roots, for the tests. APEX_ROOT is the one
#                          `apex gaming` already honours; VRR_SYS stands in for
#                          /sys. Neither is set in a real session.
# ─────────────────────────────────────────────────────────────────────────────
# Deliberately NOT `set -e`: every optimisation below is best-effort, and none of
# them may prevent the session from starting. The hard requirements are checked
# explicitly instead.
set -uo pipefail

log() { printf '[apex-gaming-session] %s\n' "$*" >&2; }

# ── Hard requirements ───────────────────────────────────────────────────────
# The message matters: this is the ONE moment a user meets this failure, from a
# log they usually cannot see, after picking Gaming Mode at the greeter. It used
# to guess — "this is not the Gaming edition?" — which was a fair guess while
# there were editions. There is one image now, this session script ships on
# every machine, and gamescope/steam install on demand, so the cause is never
# the edition and the remedy is always the same command. Say it.
missing=""
for bin in gamescope steam; do
    command -v "$bin" >/dev/null 2>&1 || missing="$missing $bin"
done
if [ -n "$missing" ]; then
    log "FATAL: not installed:$missing"
    log "install the gaming userspace with: sudo apex install$missing"
    log "returning to the greeter rather than starting a broken session"
    exit 1
fi

# ── APEX game mode: cpuset, IRQ steering, GPU clocks, tier, sched-ext ───────
# One call does all of it. `apex game start` goes through apexd's D-Bus API,
# whose polkit action (manage-power) is allow_active=yes, so the session user
# authorises without a prompt. The profile's `scx` field is what loads
# scx_lavd — see config/sysprofiles/msi-katana-gf76.toml.
#
# Best-effort: on a machine whose profile disables game mode, or with apexd
# down, gaming still works — it is just not tuned.
if [ "${APEX_GAMING_NO_APEXD:-0}" != "1" ] && command -v apex >/dev/null 2>&1; then
    if apex game start >/dev/null 2>&1; then
        log "apexd game mode engaged (cpuset/IRQ/clocks/tier/sched-ext)"
    else
        log "apexd game mode unavailable — continuing untuned"
    fi
fi

# Leaving Gaming Mode must always undo it, however the session ends.
cleanup() {
    if [ "${APEX_GAMING_NO_APEXD:-0}" != "1" ] && command -v apex >/dev/null 2>&1; then
        apex game stop >/dev/null 2>&1 && log "apexd game mode released"
    fi
}
trap cleanup EXIT HUP INT TERM

# ── Capabilities, logged before anything uses them ──────────────────────────
# Two separate questions turn on this one reading, and both were open after the
# 2026-09-19 katana run, so it is printed unconditionally rather than derived
# twice in silence.
#
#  1. `--rt` (below) needs CAP_SYS_NICE in the EFFECTIVE set.
#  2. Steam's own bwrap refuses to start with ANY capability in the PERMITTED
#     set of a non-setuid process — "Unexpected capabilities but not setuid,
#     old file caps config?", which is what §6.3 recorded and did not root
#     cause. If CapPrm below is non-zero, that message is explained and the
#     session is the thing to fix, not Steam.
#
# Those two pull in opposite directions, and that is the finding: granting the
# session CAP_SYS_NICE so gamescope gets realtime is the same act that stops
# Steam's runtime from starting inside it. Do not "fix" §6.2 by granting
# capabilities at login without measuring §6.3 again afterwards.
# `APEX_ROOT` is the fixture root `apex gaming` already honours, and the same
# one is honoured here so the capability branches can be exercised on a machine
# whose real capability set is whatever it is. Unset — which is every real
# session — this is exactly /proc/self/status.
CAP_STATUS="/proc/self/status"
[ -n "${APEX_ROOT:-}" ] && CAP_STATUS="${APEX_ROOT%/}/proc/self/status"
cap_hex() { awk -v f="$1" '$1 == f":" { print $2; exit }' "${CAP_STATUS}" 2>/dev/null; }
cap_has() {
    # bit 23 is CAP_SYS_NICE (include/uapi/linux/capability.h). The kernel
    # prints these bitmaps most-significant-nibble-first as one 16-digit hex
    # number, so this is plain arithmetic — NOT the word-reversed format
    # /sys/class/input/*/capabilities/key uses.
    local hex="$1" bit="$2"
    case "${hex}" in ''|*[!0-9a-fA-F]*) return 2 ;; esac
    (( ( 16#${hex} >> bit ) & 1 ))
}
CAP_EFF="$(cap_hex CapEff)"
CAP_PRM="$(cap_hex CapPrm)"
CAP_AMB="$(cap_hex CapAmb)"
log "capabilities: CapEff=${CAP_EFF:-?} CapPrm=${CAP_PRM:-?} CapAmb=${CAP_AMB:-?}"
# A permitted set of all zeroes is the healthy case. Anything else — and an
# unreadable one is NOT "anything else", it is a third answer — gets said out
# loud, because it explains a Steam that dies before it draws anything.
case "${CAP_PRM}" in
    '')            log "could not read CapPrm; §6.3's bwrap failure cannot be ruled in or out" ;;
    *[!0]*)
        log "WARNING: this session holds capabilities in its permitted set (CapPrm=${CAP_PRM})."
        log "         Steam's own bwrap refuses to start with any of them: 'Unexpected"
        log "         capabilities but not setuid, old file caps config?' — evidence §6.3." ;;
esac

# ── Realtime scheduling ─────────────────────────────────────────────────────
# MEASURED ON KATANA 2026-09-19 (§6.2), and the reason this block no longer
# keys off the rlimit alone: the drop-in was installed, the soft RLIMIT_RTPRIO
# really was 20, this script said "requesting realtime scheduling", passed
# `--rt`, and gamescope answered
#
#     No CAP_SYS_NICE, falling back to regular-priority compute and threads.
#
# on all three attempts. gamescope gates its realtime path on the CAPABILITY,
# not on the rlimit, so the old check was careful about the wrong thing and the
# log line was a false claim. A flag that is passed and silently dropped is
# worse than one that is not passed: it makes a status output say `yes`.
#
# The rlimit is still read and still logged, because it is the thing that would
# ALSO have to be there, and a reader chasing frame pacing needs both numbers.
#
# WHY NOTHING HERE GRANTS THE CAPABILITY
#   * `setcap cap_sys_nice+ep /usr/bin/gamescope` cannot work: APEX's /usr is a
#     read-only composefs, and gamescope arrives through a systemd-sysext
#     overlay whose lower layers are equally read-only. There is no writable
#     inode to hang the xattr on. (If a future gamescope RPM ships the file
#     capability itself, the `getcap` probe below finds it and `--rt` comes
#     back on with no change here.)
#   * pam_cap at login would work mechanically and is NOT done, because it puts
#     capabilities into the permitted set of every process in the session —
#     including Steam's bwrap, which then refuses to start. See the block above.
RT_ARGS=()
rtprio="$(ulimit -Sr 2>/dev/null || echo 0)"
rt_cap="no"
if cap_has "${CAP_EFF}" 23; then
    rt_cap="yes (effective set)"
elif command -v getcap >/dev/null 2>&1; then
    gs_caps="$(getcap "$(command -v gamescope)" 2>/dev/null)"
    # `[[ == * ]]` and not `grep -q`: under `pipefail` a matching `grep -q`
    # closes the pipe and the writer dies of SIGPIPE, so the pipeline returns
    # 141 on a MATCH. That trap has already cost this program five suites.
    if [[ "${gs_caps}" == *cap_sys_nice* ]]; then
        rt_cap="yes (file capability on gamescope)"
    fi
fi
if [ "${rt_cap}" != "no" ]; then
    RT_ARGS=(--rt)
    log "CAP_SYS_NICE: ${rt_cap}; soft RLIMIT_RTPRIO is ${rtprio} — requesting realtime"
else
    log "CAP_SYS_NICE: absent; soft RLIMIT_RTPRIO is ${rtprio}."
    log "  NOT passing --rt: gamescope needs the capability, not the rlimit, and would"
    log "  log 'No CAP_SYS_NICE' and run at ordinary priority anyway. Frame pacing under"
    log "  load is worse; nothing else is affected. See evidence §6.2."
fi

# ── HDR ─────────────────────────────────────────────────────────────────────
# Left OFF on purpose. gamescope's HDR path needs the WSI layer and a display
# that genuinely supports it, and getting it wrong washes out every colour on
# screen. Opt in per-machine with APEX_GAMESCOPE_ARGS="--hdr-enabled".

# ── Steam ───────────────────────────────────────────────────────────────────
# -gamepadui is Big Picture, the controller-first UI. NOT -steamdeck: that
# switches Steam into Deck mode, which expects SteamOS-specific integration
# (the steamos-* helpers, Deck hardware quirks) that APEX-OS does not ship.
# ONLY -gamepadui. That is the documented flag for Big Picture and the only one
# confirmed to exist; anything else added from memory would be an unrecognised
# argument at session start, on the one path that cannot be tested from here.
# Extra flags belong in APEX_STEAM_ARGS once tried on real hardware.
STEAM_ARGS=(-gamepadui)
if [ -n "${APEX_STEAM_ARGS:-}" ]; then
    # shellcheck disable=SC2206 # intentional word-splitting of an override
    STEAM_ARGS=(${APEX_STEAM_ARGS})
fi

# ── Which GPU, and which screen ─────────────────────────────────────────────
# THE DEFECT THIS FIXES, measured on katana 2026-09-19 (§6.1). With no device
# preference, gamescope took its default — the first DRM node — which on a
# hybrid laptop is the integrated GPU:
#
#   vulkan: selecting physical device 'Intel(R) Iris(R) Xe Graphics (ADL GT2)'
#   drm:    opening DRM node '/dev/dri/card1'
#   drm:      eDP-1 (connected)          <- the laptop panel, and nothing else
#   Error drm: drmModeAddFB2WithModifiers failed: Invalid argument
#
# The RTX 3070 driving the user's only monitor is card2, and gamescope never
# looked at it. With `--prefer-vk-device 10de:249d` the same script selected
# the NVIDIA device, opened card2, found HDMI-A-1 and ran it at 240 Hz.
#
# `WLR_DRM_DEVICES` is NOT the lever — also measured: gamescope's DRM backend
# is its own, not wlroots', and it ignored the variable completely.
#
# The card id is NOT hardcoded. `apex gaming --gamescope-device-args` derives
# it from sysfs with one rule — the output decides the card — which needs no
# special case for a single-GPU machine or an all-AMD one. The rule and the
# argument for it live in apexd-core's `gpu::choose_display`; the tests that
# hold it live in apexd-core/tests/gpu_parity.rs.
#
# FAILING LOUDLY, because a silent fallback to the iGPU is the defect: every
# line the selector prints goes into this log, and a selector that cannot
# answer says so here before gamescope starts. It is not fatal — refusing to
# start would regress every single-GPU machine over a probe that hiccupped —
# but it is never quiet.
DEVICE_ARGS=()
if [ "${APEX_GAMING_NO_DEVICE_SELECT:-0}" = "1" ]; then
    log "device selection disabled by APEX_GAMING_NO_DEVICE_SELECT — gamescope will"
    log "  take its own default, which on a hybrid laptop is the integrated GPU"
elif ! command -v apex >/dev/null 2>&1; then
    log "ERROR: \`apex\` is not on PATH, so the GPU/output selection could not be made."
    log "  gamescope will take its own default (the first DRM node). On a hybrid"
    log "  laptop that is the iGPU, and the external monitor will stay dark."
else
    _sel_err="$(mktemp)" || _sel_err=/dev/null
    _sel_out="$(apex gaming --gamescope-device-args 2>"${_sel_err}")"
    _sel_rc=$?
    # Read the reasoning back BEFORE acting on the status: the selector always
    # explains itself, and the explanation is the part that would have made
    # §6.1 visible in the first session log rather than after a hardware run.
    if [ -s "${_sel_err}" ]; then
        while IFS= read -r _line; do
            [ -n "${_line}" ] && log "gpu-select: ${_line}"
        done < "${_sel_err}"
    fi
    [ "${_sel_err}" = /dev/null ] || rm -f "${_sel_err}"
    if [ "${_sel_rc}" -eq 0 ] && [ -n "${_sel_out}" ]; then
        _prev=""
        while IFS= read -r _line; do
            [ -n "${_line}" ] || continue
            DEVICE_ARGS+=("${_line}")
            # The VRR probe below needs the connector by name, and the card it
            # is on, so it can ask about THIS screen rather than any screen.
            # Taken from the flags themselves rather than parsed a second time
            # out of the selector's prose, so the two cannot disagree.
            [ "${_prev}" = "--prefer-output" ] && DEVICE_OUTPUT="${_line}"
            _prev="${_line}"
        done <<< "${_sel_out}"
        if [ -n "${DEVICE_OUTPUT:-}" ]; then
            for _n in "${VRR_SYS:-/sys}"/class/drm/card*-"${DEVICE_OUTPUT}"; do
                [ -d "${_n}" ] || continue
                _n="${_n##*/}"
                DEVICE_CARD="${_n%%-*}"
                break
            done
        fi
        log "GPU/output: ${DEVICE_ARGS[*]}"
    else
        log "ERROR: no complete GPU/output selection (apex exited ${_sel_rc})."
        log "  gamescope will take its own default (the first DRM node). On a hybrid"
        log "  laptop that is the iGPU, and the external monitor will stay dark."
        log "  Override with APEX_GAMESCOPE_ARGS=\"--prefer-vk-device <vendor>:<device>\"."
    fi
fi

# ── VRR ─────────────────────────────────────────────────────────────────────
# Only ask for adaptive sync if the output this session is actually going to
# use advertises it. This runs AFTER the selection above for that reason: the
# old version globbed every connector on the machine and would have enabled
# adaptive sync for the panel's sake on a session running on the monitor.
#
# MEASURED ON KATANA 2026-09-19 (§7.2) and the reason the silent case now
# speaks: `vrr_capable` does not exist anywhere on that machine. The NVIDIA
# connector publishes seven sysfs attributes and that is not one of them; the
# Intel connector publishes fifteen and also lacks it. So the loop matched
# nothing, `--adaptive-sync` was never passed, and NOTHING SAID SO — on a
# 240 Hz monitor, the reading "this machine has no VRR" and the reading "this
# driver does not publish the property" produce exactly the same silence.
# They are different answers and only one of them is about the hardware.
VRR_ARGS=()
vrr_any="no"
for p in "${VRR_SYS:-/sys}"/class/drm/card*-*/vrr_capable; do
    [ -e "$p" ] && vrr_any="yes" && break
done
vrr_path=""
if [ -n "${DEVICE_OUTPUT:-}" ] && [ -n "${DEVICE_CARD:-}" ]; then
    vrr_path="${VRR_SYS:-/sys}/class/drm/${DEVICE_CARD}-${DEVICE_OUTPUT}/vrr_capable"
fi
if [ -n "${vrr_path}" ] && [ -r "${vrr_path}" ]; then
    if [ "$(cat "${vrr_path}" 2>/dev/null)" = "1" ]; then
        VRR_ARGS=(--adaptive-sync)
        log "VRR: ${DEVICE_OUTPUT} advertises vrr_capable=1 — enabling adaptive sync"
    else
        log "VRR: ${DEVICE_OUTPUT} publishes vrr_capable=0 — not enabling adaptive sync"
    fi
elif [ "${vrr_any}" = "no" ]; then
    log "VRR: no connector on this machine publishes vrr_capable at all, so this is"
    log "  'the driver does not say', NOT 'the display has no VRR'. On NVIDIA that is"
    log "  expected — the property has to come from somewhere else. Evidence §7.2."
else
    log "VRR: ${DEVICE_OUTPUT:-the chosen output} publishes no vrr_capable, though other"
    log "  connectors on this machine do — not enabling adaptive sync for a different screen"
fi

# ── gamescope ───────────────────────────────────────────────────────────────
#   -e/--steam        Steam integration (Big Picture keyboard/controller glue)
#   -f                fullscreen; the output's native mode is used
#   --expose-wayland  let native Wayland (xdg-shell) games in, not just X11
#   --mangoapp        MangoHud via gamescope's own overlay, which upstream says
#                     to use INSTEAD of wrapping the game in mangohud
#
# DEVICE_ARGS comes before APEX_GAMESCOPE_ARGS so a hand-set override still
# wins: gamescope takes the last occurrence of a repeated option.
GS_ARGS=(-e -f --expose-wayland "${RT_ARGS[@]}" "${VRR_ARGS[@]}" "${DEVICE_ARGS[@]}")
command -v mangoapp >/dev/null 2>&1 && GS_ARGS+=(--mangoapp)
if [ -n "${APEX_GAMESCOPE_ARGS:-}" ]; then
    # shellcheck disable=SC2206
    GS_ARGS+=(${APEX_GAMESCOPE_ARGS})
fi

log "starting: gamescope ${GS_ARGS[*]} -- steam ${STEAM_ARGS[*]}"

# Not exec'd: the EXIT trap has to run so game mode is released when Steam
# quits. gamescope exiting is the signal that Gaming Mode is over, and greetd
# then brings the greeter back.
gamescope "${GS_ARGS[@]}" -- steam "${STEAM_ARGS[@]}"
rc=$?
log "gamescope exited with ${rc}"
exit "${rc}"
