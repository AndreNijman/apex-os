#!/usr/bin/env python3
"""Move one account's APEX-era files to their Rime OS names, once, losing nothing.

Release B is the first Rime OS image an APEX machine boots, and everything in
the account was written under the APEX names. This runs as the USER, before the
compositor reads its config and before any per-user service reads its state,
and leaves the account shaped the way this image expects:

    directories (renamed, the old name left as a relative symlink to the new)
      $XDG_STATE_HOME/apex        -> rime        agent state, the Remote identity
                                                 key and paired devices, push
      $XDG_CONFIG_HOME/apex       -> rime        agent.json, lid.toml, ai.toml, ...
      $XDG_DATA_HOME/apex         -> rime        capsule records (rime env)
      $XDG_CACHE_HOME/apex        -> rime
      ~/.config/hypr/apex         -> rime        the Hyprland modules
      ~/.config/apex-shell, ~/.cache/apex-shell, ~/.local/state/apex-shell,
      ~/.local/share/apex-shell   -> rime-shell  directory level ONLY: what is
                                                 inside belongs to Rime Shell

    files the image seeded into the account and then gave to the user
      hyprland.lua, hypr/rime/*.lua, hypridle.conf, niri config.kdl, labwc
      rc.xml/menu.xml/autostart, ~/.zshrc (two seeded lines), starship.toml
      -> image paths that moved (/usr/libexec/apex-*, /usr/share/apex-shell,
         /usr/share/apex/...) point at the new ones, but only where the new
         path exists in this image; generated markers get their new spelling

    per-user systemd units
      <target>.wants/apex-X -> image unit  gains rime-X beside it (the old link
      stays, for a rollback); masks and drop-in directories follow

WHY THE ORDER IS WHAT IT IS
The Remote identity key is the one file here that cannot be regenerated: every
paired phone knows this machine by it. rime-remoted creates a fresh key when it
finds none, so if it ever started before this ran, the phone pairing would be
gone and a second key would stand in the way of the first. That is why this is
meant to run from rime-session-migrate.service (ordered before basic.target, so
before every normal user unit and before the user manager reports ready, which
is what the login waits for). rime-shell-firstrun calls it too, first thing, as
a fallback. A lock makes the two calls safe to overlap.

WHAT IT NEVER DOES
  * overwrite anything. If both the old and the new name hold data, both are
    left exactly as they are, the run exits 1 and says how to finish by hand.
    (The one exception is the Hyprland module directory, where firstrun may
    legitimately have seeded the new one: entries are merged, and a name that
    exists in both keeps the new copy, with the old one kept beside it as
    NAME.from-apex.)
  * rewrite a module name in the user's hyprland.lua. `require("apex.X")` keeps
    resolving through the symlink, and the one line that has to change (the
    cache clear) is rewritten to clear both prefixes. A rollback to an APEX
    image still boots.
  * touch a unit the user wrote. Only links whose target is an IMAGE unit are
    followed; ~/.config/systemd/user/apex-wip-snapshot.service is somebody's.
  * run systemctl unless asked to (--start-units), and then only to start a
    unit it has just enabled, never a daemon-reload.

usage:
  rime-session-migrate [--home DIR] [--root DIR] [--dry-run] [--start-units]
"""
import argparse
import fcntl
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile

PROG = "rime-session-migrate"

# The names below are the APEX ones on purpose: they are what is on disk.
OLD = "apex"  # rime-rename: keep — the APEX-era name this migrates from
NEW = "rime"
OLD_SHELL = "apex-shell"  # rime-rename: keep — the APEX-era shell directory name
NEW_SHELL = "rime-shell"

# Markers an APEX image wrote into files that now belong to the user.
OLD_KB_BEGIN = ("<!-- APEX-KEYBINDS-BEGIN — generated by apex-labwc-keybinds. "  # rime-rename: keep — marker in rc.xml on disk
                "Do not edit. -->")
OLD_KB_END = "<!-- APEX-KEYBINDS-END -->"  # rime-rename: keep — marker in rc.xml on disk
NEW_KB_BEGIN = "<!-- RIME-KEYBINDS-BEGIN — generated by rime-labwc-keybinds. Do not edit. -->"
NEW_KB_END = "<!-- RIME-KEYBINDS-END -->"
OLD_NIRI_INC = "// ── APEX generated configs (apex-shell-firstrun) ──"  # rime-rename: keep — marker in config.kdl on disk
NEW_NIRI_INC = "// ── Rime generated configs (rime-shell-firstrun) ──"

# The cache-clear line of the loader every APEX image seeded into hyprland.lua.
OLD_CACHE_CLEAR = '    if name:sub(1, 5) == "apex." then package.loaded[name] = nil end'  # rime-rename: keep — line in hyprland.lua on disk
NEW_CACHE_CLEAR = ('    if name:sub(1, 5) == "apex." or name:sub(1, 5) == "rime." then '  # rime-rename: keep — clears both prefixes
                   'package.loaded[name] = nil end')

# Where a link has to point for it to be an image unit rather than the user's.
IMAGE_UNIT_DIRS = ("/usr/lib/systemd/user", "/lib/systemd/user")
# Targets whose units may be started now. A graphical-session unit must wait for
# its session; these are the ones a login starts regardless.
STARTABLE_TARGETS = ("default.target.wants", "timers.target.wants", "sockets.target.wants")

failures = []
notes = []
dry_run = False


acted = [False]


def say(msg):
    acted[0] = True
    print(f"{PROG}: {msg}", file=sys.stderr, flush=True)


def note(msg):
    """Said only on a run that also did something, so a login is quiet."""
    notes.append(msg)


def fail(msg):
    failures.append(msg)
    say("PROBLEM: " + msg)


def xdg(var, fallback):
    val = os.environ.get(var, "")
    return val if val.startswith("/") else fallback


# ── path mapping ─────────────────────────────────────────────────────────────

def map_component(c):
    """The rename's own path map (rime-rename.py `map_path_component`)."""
    return c.replace("APEX", "RIME").replace("Apex", "Rime").replace("apex", "rime")  # rime-rename: keep — the old spellings are the input


IMAGE_TOKEN = re.compile(
    r"(?<![\w/.~$-])/usr/(?:libexec|share|bin|sbin|lib|lib64)/[A-Za-z0-9._@+/-]*")


class Image:
    """Lookups against the image being booted, relocatable for tests."""

    def __init__(self, root):
        self.root = root

    def path(self, p):
        return os.path.join(self.root, p.lstrip("/"))

    def exists(self, p):
        return os.path.lexists(self.path(p))

    def moved(self, token):
        """The new spelling of an image path, when the image has it; else None."""
        if not re.search(OLD, token, re.I):
            return None
        mapped = "/".join(map_component(c) for c in token.split("/"))
        if mapped == token:
            return None
        return mapped if self.exists(mapped.rstrip("/") or "/") else None


def rewrite_tokens(line, image):
    def one(m):
        tok = m.group(0)
        # A path ending in a dot or slash is prose or a directory spelling; test
        # the path without it and put it back.
        tail = ""
        while tok and tok[-1] in "./" and tok not in ("/",):
            tail = tok[-1] + tail
            tok = tok[:-1]
        new = image.moved(tok)
        return (new if new else tok) + tail
    return IMAGE_TOKEN.sub(one, line)


CLI_FORMS = (
    re.compile(r'(command=")apex(?=[\s"])'),          # labwc  # rime-rename: keep — APEX-era CLI name
    re.compile(r'(exec_cmd\(\s*["\'])apex(?=[\s"\'])'),  # Lua  # rime-rename: keep — APEX-era CLI name
    re.compile(r'(spawn(?:-at-startup)?\s+")apex(?=")'),  # niri  # rime-rename: keep — APEX-era CLI name
)


def rewrite_cli(line, image):
    if not image.exists("/usr/bin/rime"):
        return line
    for rx in CLI_FORMS:
        line = rx.sub(r"\1rime", line)
    return line


def rewrite_text(text, image, comment=None, cli=False, only=None):
    """Rewrite moved image paths on every line that is not a comment."""
    out = []
    for line in text.split("\n"):
        if comment and re.match(r"\s*" + re.escape(comment), line):
            out.append(line)
            continue
        if only and not only(line):
            out.append(line)
            continue
        new = rewrite_tokens(line, image)
        if cli:
            new = rewrite_cli(new, image)
        out.append(new)
    return "\n".join(out)


# ── file helpers ─────────────────────────────────────────────────────────────

def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read()
    except (OSError, UnicodeDecodeError):
        return None


def write_in_place(path, text, backup_suffix=".pre-rime.bak"):
    """Rewrite a user's file without replacing it.

    In place, not temp-and-rename: the file keeps its inode, mode and ACLs, and
    a ~/.zshrc that is a symlink into a dotfiles repository stays a symlink. The
    first rewrite leaves a backup beside it; a later one never replaces it.
    """
    if dry_run:
        say(f"would rewrite {path}")
        return True
    try:
        bak = path + backup_suffix
        if not os.path.lexists(bak):
            shutil.copy2(path, bak)
        with open(path, "r+", encoding="utf-8") as fh:
            fh.write(text)
            fh.truncate()
        say(f"rewrote {path} (backup: {os.path.basename(bak)})")
        return True
    except OSError as e:
        fail(f"cannot rewrite {path}: {e}")
        return False


def is_empty_tree(path):
    for _, dirs, files in os.walk(path):
        if files:
            return False
        # os.walk lists symlinks to directories under dirs; they are content.
        for d in dirs:
            if os.path.islink(os.path.join(_, d)):
                return False
    return True


def unique(path):
    if not os.path.lexists(path):
        return path
    n = 1
    while os.path.lexists(f"{path}.{n}"):
        n += 1
    return f"{path}.{n}"


def merge_tree(src, dst):
    """Move every entry of src into dst. Nothing in dst is replaced."""
    for entry in sorted(os.listdir(src)):
        s, d = os.path.join(src, entry), os.path.join(dst, entry)
        if not os.path.lexists(d):
            os.rename(s, d)
        elif (os.path.isdir(s) and not os.path.islink(s)
              and os.path.isdir(d) and not os.path.islink(d)):
            merge_tree(s, d)
            if not os.listdir(s):
                os.rmdir(s)
        else:
            keep = unique(d + ".from-apex")  # rime-rename: keep — names the origin
            os.rename(s, keep)
            say(f"{d} exists in both; kept the new one, the old one is {os.path.basename(keep)}")


def move_dir(parent, old_name, new_name, merge=False):
    """Rename parent/old_name to parent/new_name and leave old_name -> new_name.

    Returns True when this call moved something.
    """
    old = os.path.join(parent, old_name)
    new = os.path.join(parent, new_name)

    if os.path.islink(old):
        if os.path.isdir(new) and os.path.realpath(old) == os.path.realpath(new):
            return False                                  # done on an earlier run
        if not os.path.lexists(new) and os.path.isdir(old):
            # The user keeps this directory elsewhere (a dotfiles repository)
            # and linked it in. Give the new name the same link.
            target = os.readlink(old)
            if dry_run:
                say(f"would link {new} -> {target}, as {old} is")
                return True
            os.symlink(target, new)
            say(f"{old} is a link to {target}; {new} now links there too")
            return True
        return False
    if not os.path.lexists(old) or not os.path.isdir(old):
        return False

    if not os.path.lexists(new):
        if dry_run:
            say(f"would move {old} -> {new}")
            return True
        os.rename(old, new)
    elif os.path.isdir(new) and not os.path.islink(new) and (merge or is_empty_tree(new)):
        if dry_run:
            say(f"would merge {old} into {new}")
            return True
        merge_tree(old, new)
        if os.listdir(old):
            fail(f"{old} could not be emptied into {new}; left both")
            return False
        os.rmdir(old)
    else:
        fail(f"both {old} and {new} exist and hold data; nothing was moved. "
             f"Stop whatever uses them, compare, move what you want to keep into "
             f"{new}, then replace {old} with a link: ln -sfn {new_name} {old}")
        return False

    os.symlink(new_name, old)
    say(f"moved {old} -> {new} (the old name links to it)")
    return True


# ── the steps ────────────────────────────────────────────────────────────────

def step_dirs(ctx):
    state, config, data, cache = ctx["state"], ctx["config"], ctx["data"], ctx["cache"]
    # State first: it holds the Remote identity key.
    for base in (state, config, data, cache):
        if os.path.isdir(base):
            move_dir(base, OLD, NEW)
    for base in (config, cache, state, data):
        if os.path.isdir(base):
            move_dir(base, OLD_SHELL, NEW_SHELL)


def step_hypr(ctx, image):
    hypr = os.path.join(ctx["config"], "hypr")
    if not os.path.isdir(hypr):
        return
    moved = move_dir(hypr, OLD, NEW, merge=True)
    mods = os.path.join(hypr, NEW)
    if dry_run and moved:
        return

    # The first compositor start after the move must not load APEX-image
    # modules: firstrun refreshes them, but it runs beside the compositor, not
    # before it. Every module without a seed-time keymap placeholder is copied
    # from the image now (input-defaults.lua keeps the rendered copy it has).
    img_mods = image.path("/usr/share/rime/hypr/rime")
    if moved and os.path.isdir(img_mods) and os.path.isdir(mods):
        for name in sorted(os.listdir(img_mods)):
            src = os.path.join(img_mods, name)
            body = read(src)
            if not name.endswith(".lua") or body is None or "@KB_" in body:
                continue
            body = body.replace("@HOME@", ctx["home"])
            dst = os.path.join(mods, name)
            try:
                fd, tmp = tempfile.mkstemp(dir=mods, prefix=f".{name}.")
                with os.fdopen(fd, "w", encoding="utf-8") as fh:
                    fh.write(body)
                os.chmod(tmp, 0o644)
                os.replace(tmp, dst)
            except OSError as e:
                fail(f"cannot refresh {dst}: {e}")
        say(f"refreshed the image modules in {mods}")

    conf = os.path.join(hypr, "hyprland.lua")
    text = read(conf)
    if text is not None:
        new = text.replace("\n" + OLD_CACHE_CLEAR + "\n", "\n" + NEW_CACHE_CLEAR + "\n")
        new = rewrite_text(new, image, comment="--", cli=True)
        if new != text:
            write_in_place(conf, new)

    if os.path.isdir(mods):
        for name in sorted(os.listdir(mods)):
            p = os.path.join(mods, name)
            if not name.endswith(".lua") or os.path.islink(p) or not os.path.isfile(p):
                continue
            text = read(p)
            if text is None:
                continue
            new = rewrite_text(text, image, comment="--", cli=True)
            if new != text:
                write_in_place(p, new)


def sha256(path):
    try:
        with open(path, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return None


def step_hypridle(ctx, image):
    conf = os.path.join(ctx["home"], ".config/hypr/hypridle.conf")
    if os.path.islink(conf) or not os.path.isfile(conf):
        return
    text = read(conf)
    if text is None:
        return
    new = rewrite_text(text, image, comment="#")
    if new == text:
        return
    # A copy firstrun manages (it still matches the checksum firstrun recorded
    # when it wrote it) is refreshed from the image, which is what firstrun
    # would do: rewriting it in place would make it differ from its stamp and
    # read as the user's own from then on, frozen at today's content.
    stamp = os.path.join(ctx["state"], NEW, "hypridle.conf.sha256")
    img = image.path("/usr/share/rime-shell/src/config/hypridle.conf")
    was = (read(stamp) or "").strip()
    if was and was == sha256(conf) and os.path.isfile(img):
        if dry_run:
            say(f"would refresh {conf} from the image")
            return
        try:
            shutil.copyfile(img, conf)
            with open(stamp, "w", encoding="utf-8") as fh:
                fh.write(sha256(conf) + "\n")
            say(f"refreshed {conf} from the image (you had not modified it)")
        except OSError as e:
            fail(f"cannot refresh {conf}: {e}")
        return
    # Customised: the user's lines stay, the lock command follows the shell.
    write_in_place(conf, new)


def niri_validates(path):
    niri = shutil.which("niri")
    if not niri:
        return None
    try:
        r = subprocess.run([niri, "validate", "--config", path],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
        return r.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return None


NIRI_OLD_INCLUDE = re.compile(
    r'^(\s*include\s+")[^"]*/\.config/apex-shell/ApexShell(Input|Keybinds)\.kdl(".*)$')  # rime-rename: keep — include lines on disk


def step_niri(ctx, image):
    conf = os.path.join(ctx["config"], "niri", "config.kdl")
    if os.path.islink(conf) and not os.path.exists(conf):
        return
    text = read(conf)
    if text is None:
        return
    shell_cfg = os.path.join(ctx["home"], ".config", NEW_SHELL)
    lines = text.split("\n")
    out, rewrote_include, left_old = [], False, False
    for line in lines:
        m = NIRI_OLD_INCLUDE.match(line)
        if m and not line.lstrip().startswith("//"):
            new_target = os.path.join(shell_cfg, f"RimeShell{m.group(2)}.kdl")
            old_target = line[len(m.group(1)):line.index('"', len(m.group(1)))]
            # A missing include target is a hard parse error that takes the
            # whole niri config with it, so the new file has to exist before the
            # line names it. It gets the old file's content: those are the
            # user's input settings and keybinds until the generators rewrite it.
            if not os.path.isdir(shell_cfg):
                left_old = True
                out.append(line)
                continue
            if not os.path.lexists(new_target) and not dry_run:
                try:
                    if os.path.isfile(old_target):
                        shutil.copyfile(old_target, new_target)
                    else:
                        open(new_target, "a").close()
                except OSError as e:
                    fail(f"cannot create {new_target}: {e}")
                    left_old = True
                    out.append(line)
                    continue
            out.append(f"{m.group(1)}{new_target}{m.group(3)}")
            rewrote_include = True
            continue
        out.append(line)
    new = "\n".join(out)
    if rewrote_include and not left_old:
        new = new.replace("\n" + OLD_NIRI_INC + "\n", "\n" + NEW_NIRI_INC + "\n")
    new = rewrite_text(new, image, comment="//", cli=True)
    if new == text:
        return
    if dry_run:
        say(f"would rewrite {conf}")
        return
    before = niri_validates(conf)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(conf), prefix=".config.kdl.rime.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(new)
    after = niri_validates(tmp)
    os.unlink(tmp)
    if after is False and before is not False:
        fail(f"niri rejects {conf} with the new names; left it unchanged")
        return
    write_in_place(conf, new)


def step_labwc(ctx, image):
    d = os.path.join(ctx["config"], "labwc")
    if not os.path.isdir(d):
        return
    for name, comment in (("rc.xml", None), ("menu.xml", None), ("autostart", "#")):
        p = os.path.join(d, name)
        if os.path.islink(p) and not os.path.exists(p):
            continue
        text = read(p)
        if text is None:
            continue
        new = text
        if name == "rc.xml" and OLD_KB_BEGIN in new and NEW_KB_BEGIN not in new:
            new = new.replace(OLD_KB_BEGIN, NEW_KB_BEGIN).replace(OLD_KB_END, NEW_KB_END)
        new = rewrite_text(new, image, comment=comment, cli=name.endswith(".xml"))
        if new != text:
            write_in_place(p, new)


def step_zshrc(ctx, image):
    p = os.path.join(ctx["home"], ".zshrc")
    text = read(p)
    if text is None:
        return
    # Exactly the two lines the seeded zshrc carries; the rest is the user's.
    new = rewrite_text(text, image, comment="#",
                       only=lambda l: "/usr/share/apex/shell/" in l)  # rime-rename: keep — the seeded path on disk
    if new != text:
        write_in_place(p, new)


def step_starship(ctx):
    link = os.path.join(ctx["config"], "starship.toml")
    if not os.path.islink(link):
        return
    target = os.readlink(link)
    if not target.endswith("/" + OLD_SHELL + "/starship.toml"):
        return
    new_target = os.path.join(ctx["cache"], NEW_SHELL, "starship.toml")
    if not os.path.exists(new_target):
        return
    if dry_run:
        say(f"would point {link} at {new_target}")
        return
    tmp = link + ".rime-new"
    if os.path.lexists(tmp):
        os.unlink(tmp)
    os.symlink(new_target, tmp)
    os.replace(tmp, link)
    say(f"{link} -> {new_target}")


def step_units(ctx, image, start):
    cfg = os.path.join(ctx["config"], "systemd", "user")
    if not os.path.isdir(cfg):
        return
    img_dir = "/usr/lib/systemd/user"

    def image_unit(name):
        if image.exists(f"{img_dir}/{name}"):
            return name
        m = re.match(r"^([^@]+@)[^.]*(\.[a-z]+)$", name)
        if m and image.exists(f"{img_dir}/{m.group(1)}{m.group(2)}"):
            return m.group(1) + m.group(2)
        return None

    started = []
    for entry in sorted(os.listdir(cfg)):
        p = os.path.join(cfg, entry)
        if entry.startswith(OLD + "-"):
            new = NEW + entry[len(OLD):]
            if os.path.islink(p) and os.readlink(p) == "/dev/null":
                if image_unit(new) and not os.path.lexists(os.path.join(cfg, new)):
                    if dry_run:
                        say(f"would mask {new}, as {entry} is")
                    else:
                        os.symlink("/dev/null", os.path.join(cfg, new))
                        say(f"{entry} is masked; so is {new} now")
                continue
            if entry.endswith(".d") and os.path.isdir(p):
                if image_unit(new[:-2]):
                    move_dir(cfg, entry, new)
                continue
            if os.path.isfile(p) and not os.path.islink(p) and image_unit(new):
                note(f"NOTE: {p} is your own copy of an image unit; it was left alone. "
                     f"The image now ships it as {new}.")
            continue
        if not re.search(r"\.(wants|requires|upholds)$", entry) or \
                os.path.islink(p) or not os.path.isdir(p):
            continue
        for link in sorted(os.listdir(p)):
            lp = os.path.join(p, link)
            if not link.startswith(OLD + "-") or not os.path.islink(lp):
                continue
            target = os.readlink(lp)
            if os.path.dirname(target) not in IMAGE_UNIT_DIRS:
                continue                                   # the user's own unit
            new = NEW + link[len(OLD):]
            unit_file = image_unit(new)
            if not unit_file:
                continue
            new_lp = os.path.join(p, new)
            if os.path.lexists(new_lp):
                continue
            if dry_run:
                say(f"would enable {new} in {entry} (as {link} was)")
                continue
            os.symlink(f"{img_dir}/{unit_file}", new_lp)
            say(f"{link} was enabled in {entry}; {new} is now enabled there too")
            if entry in STARTABLE_TARGETS and not os.path.lexists(os.path.join(cfg, new)):
                started.append(new)
    if start and started and not dry_run:
        systemctl = os.environ.get("RIME_MIGRATE_SYSTEMCTL", "systemctl")
        for unit in started:
            try:
                subprocess.run([systemctl, "--user", "--no-block", "start", unit],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=15)
                say(f"asked the user manager to start {unit}")
            except (OSError, subprocess.TimeoutExpired) as e:
                say(f"could not start {unit} now ({e}); it starts at the next login")


# ── main ─────────────────────────────────────────────────────────────────────

def lock(ctx):
    run = os.environ.get("XDG_RUNTIME_DIR", "")
    if not run.startswith("/"):
        run = f"/run/user/{os.getuid()}"
    if not os.path.isdir(run):
        return None
    try:
        fh = open(os.path.join(run, f"{PROG}.lock"), "w")
        fcntl.flock(fh, fcntl.LOCK_EX)
        return fh
    except OSError:
        return None


def main(argv=None):
    global dry_run
    ap = argparse.ArgumentParser(prog=PROG, description=__doc__.split("\n")[0])
    ap.add_argument("--home", help="the account's home (default: $HOME)")
    ap.add_argument("--root", default="/", help="the image to look paths up in (tests)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--start-units", action="store_true",
                    help="start the per-user units this run enables (systemctl --user --no-block)")
    args = ap.parse_args(argv)
    dry_run = args.dry_run

    uid = os.getuid()
    if 0 < uid < 1000 and not args.home:
        return 0                                  # greetd and other system accounts

    home = args.home or os.environ.get("HOME", "")
    if not home.startswith("/") or not os.path.isdir(home):
        say(f"no usable home directory ({home!r}); nothing to do")
        return 0
    home = home.rstrip("/") or "/"
    ctx = {
        "home": home,
        "state": xdg("XDG_STATE_HOME", os.path.join(home, ".local/state")),
        "config": xdg("XDG_CONFIG_HOME", os.path.join(home, ".config")),
        "data": xdg("XDG_DATA_HOME", os.path.join(home, ".local/share")),
        "cache": xdg("XDG_CACHE_HOME", os.path.join(home, ".cache")),
    }
    image = Image(args.root)
    held = lock(ctx)

    steps = (
        ("directories", lambda: step_dirs(ctx)),
        ("hyprland", lambda: step_hypr(ctx, image)),
        ("hypridle", lambda: step_hypridle(ctx, image)),
        ("niri", lambda: step_niri(ctx, image)),
        ("labwc", lambda: step_labwc(ctx, image)),
        ("zshrc", lambda: step_zshrc(ctx, image)),
        ("starship", lambda: step_starship(ctx)),
        ("units", lambda: step_units(ctx, image, args.start_units)),
    )
    for name, fn in steps:
        try:
            fn()
        except OSError as e:
            # One step failing must not stop the others: a labwc file that
            # cannot be read is no reason to leave the identity key unmoved.
            fail(f"{name}: {e}")
    if held:
        held.close()
    if failures or acted[0]:
        for msg in notes:
            say(msg)
    if failures:
        say(f"{len(failures)} problem(s); everything else was migrated. See above.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
