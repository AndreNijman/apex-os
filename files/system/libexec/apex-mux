#!/bin/sh
# Build a project's terminal layout in tmux or zellij, multiplexer-neutrally.
#
# The adapter layer for `apex project layout open`, in the same shape and for
# the same reason as apex-project-windows is the adapter for the compositor:
# the multiplexer is the only per-backend part, so keeping it here means one
# program to fake in tests and no tmux or zellij knowledge inside the CLI.
#
#     apex-mux backends                          which are installed, one per line
#     apex-mux kdl    <arr> <plan>               the zellij layout this would send
#     apex-mux has    <mux> <session>            does that session exist
#     apex-mux build  <mux> <session> <arr> <p>  create it, detached
#     apex-mux open   <mux> <session> <arr> <p>  create it if needed, then attach
#
# <arr> is `main-vertical` (one large pane left, the rest stacked right) or
# `tiled`. <p> is a PLAN FILE, and a file rather than stdin on purpose: `open`
# ends by handing the terminal to the multiplexer, so stdin has to still be the
# terminal.
#
# THE PLAN FORMAT
#
# One pane per line, TAB separated:
#
#     <title>	<cwd>	<argv…>
#
# Tabs and not a shell string, for the reason the window layout gives for
# storing argv vectors: every field reaches the multiplexer as a separate
# argument, so nothing in a pane command can be read as a shell metacharacter.
# There is no shell anywhere below. A pane with no argv is a pane running the
# shell the multiplexer would have started anyway.
#
# WHAT THIS DOES NOT DO
#
# It never runs an agent. An agent pane runs `apex agent attach` or `apex agent
# run`, which talk to apex-agentd — the daemon owns every agent PTY, and the
# multiplexer is a viewport onto sessions it owns. So killing the multiplexer,
# or losing the terminal, leaves the agents running.
#
# It also never rebuilds a session that already exists: `build` on a live
# session is a no-op and `open` attaches to it. Reopening a template must land
# you back in your work, not on top of it.

set -eu

TAB="$(printf '\t')"

die() { printf 'apex-mux: %s\n' "$*" >&2; exit 1; }

usage() {
    cat >&2 <<'EOF'
usage: apex-mux backends
       apex-mux has   <tmux|zellij> <session>
       apex-mux build <tmux|zellij> <session> <main-vertical|tiled> <plan-file>
       apex-mux open  <tmux|zellij> <session> <main-vertical|tiled> <plan-file>
EOF
    exit 2
}

# ── tmux ─────────────────────────────────────────────────────────────────────

tmux_has() {
    # `=name` is an EXACT match. Without it tmux matches a prefix, so a session
    # named apex-web would answer for apex-webhooks and the second project would
    # silently attach to the first one's panes.
    tmux has-session -t "=$1" 2>/dev/null
}

tmux_build() {
    session=$1; arrangement=$2; plan=$3
    tmux_has "$session" && return 0

    index=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        # Split on tabs only, with globbing off: a pane command containing `*`
        # is a command, not a pattern to expand against the project directory.
        set -f
        old_ifs=$IFS
        IFS=$TAB
        # shellcheck disable=SC2086  # deliberate: split on TAB, globbing is off
        set -- $line
        IFS=$old_ifs
        set +f

        title=$1
        cwd=$2
        shift 2

        # Every pane is addressed by the %id tmux hands back, never by its
        # index. An index is a POSITION: `split-window` renumbers the panes it
        # pushes along, so addressing by index titles the wrong pane and puts
        # the commands one place out — which is exactly what it did.
        if [ "$index" -eq 0 ]; then
            if [ "$#" -gt 0 ]; then
                pane_id=$(tmux new-session -d -s "$session" -c "$cwd" -n apex \
                    -P -F '#{pane_id}' -- "$@")
            else
                pane_id=$(tmux new-session -d -s "$session" -c "$cwd" -n apex \
                    -P -F '#{pane_id}')
            fi
        elif [ "$#" -gt 0 ]; then
            pane_id=$(tmux split-window -d -t "$pane_id" -c "$cwd" \
                -P -F '#{pane_id}' -- "$@")
        else
            pane_id=$(tmux split-window -d -t "$pane_id" -c "$cwd" -P -F '#{pane_id}')
        fi
        # Splitting the pane just created keeps creation order and pane order
        # the same, which is what `select-layout main-vertical` then reads to
        # decide which pane is the large one on the left.
        tmux select-pane -t "$pane_id" -T "$title"
        index=$((index + 1))
    done < "$plan"

    [ "$index" -gt 0 ] || die "the plan is empty; nothing to build"

    tmux select-layout -t "${session}:0" "$arrangement"
    # A pane whose command finishes would otherwise close, and the layout would
    # reflow around the hole. A template's whole value is that the shape stays
    # put, so a finished command leaves a dead pane you can respawn instead.
    tmux set-option -t "${session}:0" remain-on-exit on
    tmux set-option -t "${session}:0" pane-border-status top
}

tmux_open() {
    tmux_build "$1" "$2" "$3"
    # tmux refuses to attach to a session from inside one, and it is right to:
    # the inner and outer sessions would fight over the same key prefix.
    if [ -n "${TMUX:-}" ]; then
        tmux switch-client -t "=$1"
    else
        exec tmux attach-session -t "=$1"
    fi
}

# ── zellij ───────────────────────────────────────────────────────────────────

zellij_has() {
    # `list-sessions --short` prints one name per line and nothing else, so this
    # needs no parsing of the decorated form. Exited-but-resurrectable sessions
    # are listed too, and that is correct here: attaching to one brings it back,
    # which is what reopening a template should do.
    zellij list-sessions --no-formatting --short 2>/dev/null | grep -qx -- "$1"
}

# KDL string escaping. Only two characters matter inside a quoted KDL string.
kdl_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# One `pane` node. Fields the plan did not give are simply absent rather than
# empty: `command=""` is a pane that tries to run the empty string and dies.
zellij_pane() {
    indent=$1
    title=$2
    cwd=$3
    shift 3
    printf '%s pane cwd="%s" name="%s"' "$indent" "$(kdl_escape "$cwd")" "$(kdl_escape "$title")"
    if [ "$#" -eq 0 ]; then
        printf '\n'
        return 0
    fi
    printf ' command="%s"' "$(kdl_escape "$1")"
    shift
    if [ "$#" -eq 0 ]; then
        printf '\n'
        return 0
    fi
    printf ' {\n%s     args' "$indent"
    for a in "$@"; do
        printf ' "%s"' "$(kdl_escape "$a")"
    done
    printf '\n%s }\n' "$indent"
}

# The plan as a zellij layout. zellij's own format, not a translation of tmux's:
# `main-vertical` is a side-by-side split whose second half stacks the rest, and
# `tiled` is a flat container zellij fills itself.
zellij_kdl() {
    arrangement=$1; plan=$2
    printf 'layout {\n    tab name="apex" {\n'
    if [ "$arrangement" = "main-vertical" ]; then
        printf '        pane split_direction="vertical" {\n'
    else
        printf '        pane {\n'
    fi

    index=0
    opened_stack=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        set -f
        old_ifs=$IFS
        IFS=$TAB
        # shellcheck disable=SC2086  # deliberate: split on TAB, globbing is off
        set -- $line
        IFS=$old_ifs
        set +f

        if [ "$arrangement" = "main-vertical" ] && [ "$index" -eq 1 ]; then
            printf '            pane {\n'
            opened_stack=1
        fi
        if [ "$opened_stack" -eq 1 ]; then
            zellij_pane "               " "$@"
        else
            zellij_pane "           " "$@"
        fi
        index=$((index + 1))
    done < "$plan"

    # An `if` and not `[ … ] && printf`: under `set -e` a failing AND-list is a
    # failing statement, so the tiled arrangement — which never opens a stack —
    # would exit here having written a truncated layout.
    if [ "$opened_stack" -eq 1 ]; then
        printf '            }\n'
    fi
    printf '        }\n    }\n}\n'
}

zellij_build() {
    session=$1; arrangement=$2; plan=$3
    zellij_has "$session" && return 0
    # zellij has no way to start a session with a layout WITHOUT attaching, so
    # this is two steps: create it detached, then add the layout to it as a tab.
    # The cost is one leftover default tab, which is a scratch shell and not a
    # problem; the alternative was a separate code path for `build` and `open`,
    # and only one of them would ever have been tested.
    zellij attach --create-background "$session" >/dev/null 2>&1
    zellij --session "$session" --layout-string "$(zellij_kdl "$arrangement" "$plan")" \
        >/dev/null 2>&1
}

zellij_open() {
    zellij_build "$1" "$2" "$3"
    if [ -n "${ZELLIJ:-}" ]; then
        # zellij refuses to nest, and unlike tmux it has no switch-client.
        printf 'apex-mux: the session is built. detach from this one, then: zellij attach %s\n' "$1"
        return 0
    fi
    exec zellij attach "$1"
}

# ── dispatch ─────────────────────────────────────────────────────────────────

[ "$#" -ge 1 ] || usage
verb=$1
shift

case "$verb" in
    backends)
        for m in tmux zellij; do
            command -v "$m" >/dev/null 2>&1 && printf '%s\n' "$m"
        done
        exit 0
        ;;
    kdl)
        # The generated zellij layout, on stdout and nothing else. Here so the
        # one failure mode a generated format has — a layout zellij's parser
        # rejects — can be handed straight back to that parser, and so anybody
        # debugging an odd pane can see what was actually sent.
        [ "$#" -eq 2 ] || usage
        case "$1" in
            main-vertical|tiled) ;;
            *) die "$1 is not an arrangement (main-vertical or tiled)" ;;
        esac
        [ -r "$2" ] || die "cannot read the plan file $2"
        zellij_kdl "$1" "$2"
        exit 0
        ;;
    has|build|open) ;;
    *) usage ;;
esac

[ "$#" -ge 2 ] || usage
mux=$1
session=$2
shift 2

case "$mux" in
    tmux|zellij) ;;
    *) die "$mux is not a multiplexer this drives (tmux or zellij)" ;;
esac
command -v "$mux" >/dev/null 2>&1 || die "$mux is not installed"

case "$verb" in
    has)
        "${mux}_has" "$session"
        exit $?
        ;;
esac

[ "$#" -eq 2 ] || usage
arrangement=$1
plan=$2
case "$arrangement" in
    main-vertical|tiled) ;;
    *) die "$arrangement is not an arrangement (main-vertical or tiled)" ;;
esac
[ -r "$plan" ] || die "cannot read the plan file $plan"

"${mux}_${verb}" "$session" "$arrangement" "$plan"
