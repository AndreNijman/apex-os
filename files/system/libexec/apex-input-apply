#!/usr/bin/env python3
"""Generate every compositor's input configuration from one APEX model.

This is the input half of what the keybind pipeline already does: one
compositor-neutral description, three generated configs, each validated before
it replaces anything.

    ~/.config/apex-shell/input.json          the model (written by APEX Settings)
              |
              +--> ~/.config/hypr/apex-input.conf      sourced by hyprland.conf
              +--> ~/.config/apex-shell/ApexShellInput.kdl   included by niri
              +--> the <libinput> element inside ~/.config/labwc/rc.xml
              |
          validate -> atomic replace -> reload

## Why labwc is edited in place

Hyprland has `source` and niri has `include` (25.11+; the image ships 26.04), so
both get a generated file they pull in. Neither line is added by this script:
apex-shell-firstrun puts `source =` in the seeded hyprland.conf and appends
`include` to the seeded niri config.kdl, and pre-creates both targets because
both compositors treat a missing one as a fatal config error.

labwc has neither: rc.xml is the only file it reads. So the `<libinput>`
element is replaced inside it, with ElementTree rather than a regex, and the
result is parsed before it is moved into place. Everything else in rc.xml —
keybinds, theme, window rules — is preserved untouched, which a whole-file
regeneration could not promise.

## Option names are verified, not remembered

Every name here was checked against the compositor that consumes it:

  * labwc  — labwc-config(5) and the package's own rc.xml.all. Note `tap`, not
             `tapToClick`: labwc ignores an unknown element in silence, which is
             how `<tapToClick>` shipped doing nothing for months.
  * Hypr   — `Hyprland --verify-config` rejects an unknown option, so
             `--self-test` runs the generated file through it.
  * niri   — `niri validate` likewise.

`--self-test` generates from the defaults and runs all three validators. Run it
after touching any mapping in this file.

usage:
  apex-input-apply [--model PATH] [--dry-run] [--no-reload] [--self-test]
"""
import argparse
import json
import re
import os
import shutil
import subprocess
import sys
import tempfile
import xml.etree.ElementTree as ET

HOME = os.path.expanduser("~")

MODEL_PATH = os.path.join(HOME, ".config/apex-shell/input.json")
HYPR_OUT = os.path.join(HOME, ".config/hypr/apex-input.conf")
NIRI_OUT = os.path.join(HOME, ".config/apex-shell/ApexShellInput.kdl")
LABWC_RC = os.path.join(HOME, ".config/labwc/rc.xml")

GENERATED_BANNER = "Generated by apex-input-apply from APEX Settings. Do not edit."

# Defaults chosen to match what the images already ship, so the FIRST
# generation is a no-op diff against the seeded configs. Changing a default here
# silently changes behaviour for every user who has not overridden it.
DEFAULTS = {
    "touchpad": {
        "natural_scroll": True,       # labwc naturalScroll yes; hypr natural_scroll true
        "tap": True,                  # labwc <tap>yes; hypr tap-to-click true
        "tap_and_drag": True,         # labwc tapAndDrag yes
        "tap_button_map": "lrm",      # one/two/three finger = left/right/middle
        "drag_lock": True,
        "disable_while_typing": True,
        "click_method": "clickfinger",
        "scroll_method": "twofinger",
        "middle_emulation": False,
        "accel_profile": "adaptive",  # labwc accelProfile adaptive
        "speed": 0.0,                 # labwc pointerSpeed / hypr sensitivity
        "scroll_factor": 1.0,
        "left_handed": False,
        "three_finger_drag": False,
    },
    "pointer": {
        # A mouse deliberately does NOT inherit the touchpad's natural scroll:
        # inverting a wheel is not the same gesture as inverting a two-finger
        # swipe, and applying one setting to both is a common annoyance.
        "natural_scroll": False,
        "accel_profile": "adaptive",
        "speed": 0.0,
        "scroll_factor": 1.0,
        "left_handed": False,
        "middle_emulation": False,
    },
    "keyboard": {
        "repeat_rate": 25,
        "repeat_delay": 600,
    },
}

TAP_BUTTON_MAPS = ("lrm", "lmr")
ACCEL_PROFILES = ("adaptive", "flat")
CLICK_METHODS = ("none", "buttonAreas", "clickfinger")
SCROLL_METHODS = ("none", "twofinger", "edge")


# ── model ───────────────────────────────────────────────────────────────────
def load_model(path):
    """The model, with every missing key filled from DEFAULTS."""
    model = {k: dict(v) for k, v in DEFAULTS.items()}
    try:
        with open(path, encoding="utf-8") as fh:
            user = json.load(fh)
    except FileNotFoundError:
        return model, []
    except (json.JSONDecodeError, OSError) as e:
        # A malformed settings file must not leave the user with no input
        # configuration at all; fall back to defaults and say so.
        return model, [f"{path} is not usable ({e}); using defaults"]

    notes = []
    for section in model:
        for key, value in (user.get(section) or {}).items():
            if key not in model[section]:
                notes.append(f"ignoring unknown {section}.{key}")
                continue
            model[section][key] = value

    notes += validate(model)
    return model, notes


def validate(model):
    """Clamp and correct anything unusable, reporting each correction."""
    notes = []

    def fix(section, key, value, reason):
        notes.append(f"{section}.{key}: {reason}, using {value}")
        model[section][key] = value

    for section in ("touchpad", "pointer"):
        s = model[section]
        if not isinstance(s.get("speed"), (int, float)) or not -1.0 <= s["speed"] <= 1.0:
            fix(section, "speed", DEFAULTS[section]["speed"], "must be between -1.0 and 1.0")
        if s.get("accel_profile") not in ACCEL_PROFILES:
            fix(section, "accel_profile", "adaptive", f"must be one of {ACCEL_PROFILES}")
        if not isinstance(s.get("scroll_factor"), (int, float)) or not 0.1 <= s["scroll_factor"] <= 10.0:
            fix(section, "scroll_factor", 1.0, "must be between 0.1 and 10.0")

    t = model["touchpad"]
    if t.get("tap_button_map") not in TAP_BUTTON_MAPS:
        fix("touchpad", "tap_button_map", "lrm", f"must be one of {TAP_BUTTON_MAPS}")
    if t.get("click_method") not in CLICK_METHODS:
        fix("touchpad", "click_method", "clickfinger", f"must be one of {CLICK_METHODS}")
    if t.get("scroll_method") not in SCROLL_METHODS:
        fix("touchpad", "scroll_method", "twofinger", f"must be one of {SCROLL_METHODS}")

    k = model["keyboard"]
    if not isinstance(k.get("repeat_rate"), int) or not 1 <= k["repeat_rate"] <= 100:
        fix("keyboard", "repeat_rate", 25, "must be between 1 and 100")
    if not isinstance(k.get("repeat_delay"), int) or not 100 <= k["repeat_delay"] <= 2000:
        fix("keyboard", "repeat_delay", 600, "must be between 100 and 2000")

    return notes


def yn(value):
    return "yes" if value else "no"


# ── Hyprland ────────────────────────────────────────────────────────────────
def gen_hyprland(model):
    t, p, k = model["touchpad"], model["pointer"], model["keyboard"]
    # Hyprland's touchpad block has no accel_profile or left_handed of its own;
    # those live on the parent input block and apply to both. Only the options
    # Hyprland actually accepts appear here — `Hyprland --verify-config` rejects
    # an unknown one, which --self-test relies on.
    return "\n".join([
        f"# {GENERATED_BANNER}",
        "#",
        "# Sourced by hyprland.conf. Values come from ~/.config/apex-shell/input.json.",
        "",
        "input {",
        f"    sensitivity = {p['speed']}",
        f"    accel_profile = {p['accel_profile']}",
        f"    natural_scroll = {str(p['natural_scroll']).lower()}",
        f"    left_handed = {str(p['left_handed']).lower()}",
        f"    scroll_factor = {p['scroll_factor']}",
        f"    repeat_rate = {k['repeat_rate']}",
        f"    repeat_delay = {k['repeat_delay']}",
        "",
        "    touchpad {",
        f"        natural_scroll = {str(t['natural_scroll']).lower()}",
        f"        tap-to-click = {str(t['tap']).lower()}",
        f"        tap-and-drag = {str(t['tap_and_drag']).lower()}",
        f"        drag_lock = {str(t['drag_lock']).lower()}",
        f"        disable_while_typing = {str(t['disable_while_typing']).lower()}",
        f"        middle_button_emulation = {str(t['middle_emulation']).lower()}",
        f"        clickfinger_behavior = {str(t['click_method'] == 'clickfinger').lower()}",
        f"        tap_button_map = {t['tap_button_map']}",
        f"        scroll_factor = {t['scroll_factor']}",
        "    }",
        "}",
        "",
    ])


# ── niri ────────────────────────────────────────────────────────────────────
def gen_niri(model):
    t, p, k = model["touchpad"], model["pointer"], model["keyboard"]
    # niri spells its flags kebab-case, and a boolean-false option is expressed
    # by OMITTING it rather than by `option false` — `niri validate` is what
    # confirms that per option.
    lines = [
        f"// {GENERATED_BANNER}",
        "//",
        "// Nothing to do by hand: apex-shell-firstrun appends",
        "//",
        f'//     include "{NIRI_OUT}"',
        "//",
        "// to ~/.config/niri/config.kdl, after every other section. niri",
        "// includes are positional and later definitions win, so these values",
        "// override the seeded config above them; niri watches this file and",
        "// live-reloads, so a change applies without a logout.",
        "",
        "input {",
        "    keyboard {",
        f"        repeat-delay {k['repeat_delay']}",
        f"        repeat-rate {k['repeat_rate']}",
        "    }",
        "",
        "    touchpad {",
    ]
    if t["tap"]:
        lines.append("        tap")
    if t["natural_scroll"]:
        lines.append("        natural-scroll")
    if t["disable_while_typing"]:
        lines.append("        dwt")
    if t["middle_emulation"]:
        lines.append("        middle-emulation")
    lines += [
        f"        accel-speed {t['speed']}",
        f'        accel-profile "{t["accel_profile"]}"',
        f'        click-method "{"clickfinger" if t["click_method"] == "clickfinger" else "button-areas"}"',
        f'        tap-button-map "{"left-right-middle" if t["tap_button_map"] == "lrm" else "left-middle-right"}"',
        f"        scroll-factor {t['scroll_factor']}",
        "    }",
        "",
        "    mouse {",
    ]
    if p["natural_scroll"]:
        lines.append("        natural-scroll")
    lines += [
        f"        accel-speed {p['speed']}",
        f'        accel-profile "{p["accel_profile"]}"',
        f"        scroll-factor {p['scroll_factor']}",
        "    }",
        "}",
        "",
    ]
    return "\n".join(lines)


# ── labwc ───────────────────────────────────────────────────────────────────
def libinput_element(model):
    """The <libinput> element, built from the model."""
    t, p = model["touchpad"], model["pointer"]
    root = ET.Element("libinput")

    def device(category, cfg, is_touchpad):
        dev = ET.SubElement(root, "device", {"category": category})

        def sub(tag, text):
            ET.SubElement(dev, tag).text = text

        sub("naturalScroll", yn(cfg["natural_scroll"]))
        sub("leftHanded", yn(cfg["left_handed"]))
        sub("pointerSpeed", str(cfg["speed"]))
        sub("accelProfile", cfg["accel_profile"])
        sub("middleEmulation", yn(cfg["middle_emulation"]))
        sub("scrollFactor", str(cfg["scroll_factor"]))
        if is_touchpad:
            # Touchpad-only elements. `tap` is the real name; `tapToClick` is
            # not a labwc element and is silently ignored.
            sub("tap", yn(cfg["tap"]))
            sub("tapButtonMap", cfg["tap_button_map"])
            sub("tapAndDrag", yn(cfg["tap_and_drag"]))
            sub("dragLock", yn(cfg["drag_lock"]))
            sub("disableWhileTyping", yn(cfg["disable_while_typing"]))
            sub("clickMethod", cfg["click_method"])
            sub("scrollMethod", cfg["scroll_method"])
            if cfg["three_finger_drag"]:
                sub("threeFingerDrag", "yes")

    device("touchpad", t, True)
    device("default", p, False)
    return root


def write_labwc(rc_path, model, dry_run):
    """Replace only the <libinput> span in rc.xml, byte-for-byte elsewhere.

    A span replacement rather than an ElementTree round-trip. Two reasons, both
    learned the hard way:

      * ElementTree discards comments unless the parser is told to keep them,
        and even then it CANNOT represent a comment outside the root element.
        rc.xml opens with a forty-line header explaining every decision in it,
        and a tree rewrite deleted that header silently.
      * A round-trip reindents and requotes regions nobody asked it to touch,
        so the diff a user sees after changing tap-to-click covers the whole
        file.

    So the tree is used only to VALIDATE — before, to refuse an unparseable
    file, and after, to refuse a bad result — while the edit itself is a
    substring swap. Everything outside <libinput> is preserved exactly.
    """
    if not os.path.exists(rc_path):
        return [f"{rc_path} does not exist; skipped"]

    try:
        with open(rc_path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError as e:
        return [f"cannot read {rc_path}: {e}"]

    try:
        ET.fromstring(text)
    except ET.ParseError as e:
        # Never rewrite a file we cannot parse. A broken rc.xml already makes
        # labwc fall back to defaults silently; overwriting it would destroy the
        # user's keybinds along with whatever the real problem was.
        return [f"{rc_path} is not parseable ({e}); refusing to touch it"]

    element = libinput_element(model)
    ET.indent(element, space="  ", level=1)
    block = "  " + ET.tostring(element, encoding="unicode").strip()

    open_at = text.find("<libinput>")
    close_tag = "</libinput>"
    if open_at != -1:
        close_at = text.find(close_tag, open_at)
        if close_at == -1:
            return [f"{rc_path} has an unterminated <libinput>; refusing to touch it"]
        # Swallow the indentation on the opening line so the replacement lands
        # at the same depth rather than doubling it.
        line_start = text.rfind("\n", 0, open_at) + 1
        updated = text[:line_start] + block + text[close_at + len(close_tag):]
    else:
        # No existing block: insert before the closing root tag.
        root_close = text.rfind("</labwc_config>")
        if root_close == -1:
            return [f"{rc_path} has no </labwc_config>; refusing to touch it"]
        updated = text[:root_close] + block + "\n\n" + text[root_close:]

    try:
        ET.fromstring(updated)
    except ET.ParseError as e:
        return [f"the generated rc.xml would not parse ({e}); the original is untouched"]

    if dry_run:
        return []

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(rc_path), prefix=".rc.xml.apex.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(updated)
        shutil.copymode(rc_path, tmp)
        os.replace(tmp, rc_path)
    except OSError as e:
        if os.path.exists(tmp):
            os.unlink(tmp)
        return [f"could not replace {rc_path}: {e}"]
    return []


# ── validation and reload ───────────────────────────────────────────────────
def which(cmd):
    return shutil.which(cmd)


def validate_hyprland(path):
    if not which("Hyprland"):
        return None
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", tempfile.mkdtemp())
    # Hyprland refuses to parse a bare fragment, so wrap it the way
    # hyprland.conf does.
    with tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False) as fh:
        fh.write(f"source = {path}\n")
        wrapper = fh.name
    try:
        out = subprocess.run(
            ["Hyprland", "--i-am-really-stupid", "--verify-config", "--config", wrapper],
            capture_output=True, text=True, env=env, timeout=60,
        )
        return "config ok" in (out.stdout + out.stderr)
    except (OSError, subprocess.SubprocessError):
        return None
    finally:
        os.unlink(wrapper)


def validate_niri(path):
    if not which("niri"):
        return None
    try:
        out = subprocess.run(["niri", "validate", "--config", path],
                             capture_output=True, text=True, timeout=60)
        return out.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return None


def reload_compositor():
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    helper = "/usr/libexec/apex-compositor-reload"
    if os.path.exists(helper):
        subprocess.run([helper], check=False)
        return f"reloaded via apex-compositor-reload ({desktop or 'unknown desktop'})"
    return "no reload helper; the compositor will pick it up on next reload"


def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".apex-input.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)


# ── entry points ────────────────────────────────────────────────────────────
def self_test():
    """Generate from the defaults and run every available validator."""
    model = {k: dict(v) for k, v in DEFAULTS.items()}
    rc = 0

    hypr = gen_hyprland(model)
    niri = gen_niri(model)

    with tempfile.TemporaryDirectory() as d:
        hp = os.path.join(d, "apex-input.conf")
        np_ = os.path.join(d, "input.kdl")
        with open(hp, "w", encoding="utf-8") as fh:
            fh.write(hypr)
        with open(np_, "w", encoding="utf-8") as fh:
            fh.write(niri)

        for name, result in (("Hyprland", validate_hyprland(hp)),
                             ("niri", validate_niri(np_))):
            if result is None:
                print(f"SKIP  {name} not installed; cannot validate its output")
            elif result:
                print(f"PASS  {name} accepts the generated config")
            else:
                print(f"FAIL  {name} rejects the generated config")
                rc = 1

    # labwc has no config validator, so check the XML is well formed and that
    # every element name is one labwc documents.
    el = libinput_element(model)
    try:
        ET.fromstring(ET.tostring(el))
        print("PASS  the labwc <libinput> element is well-formed XML")
    except ET.ParseError as e:
        print(f"FAIL  labwc element is not well-formed: {e}")
        rc = 1

    known = labwc_known_elements()
    if known is None:
        print("SKIP  labwc's rc.xml.all unavailable; cannot check element names")
    else:
        used = {c.tag for d in el for c in d}
        unknown = sorted(used - known)
        if unknown:
            print(f"FAIL  labwc does not implement: {', '.join(unknown)}")
            rc = 1
        else:
            print(f"PASS  all {len(used)} labwc element names are implemented")
    return rc


def labwc_known_elements():
    """Element names labwc implements, read from its own annotated reference.

    Every libinput region is scanned and unioned, not just the first: rc.xml.all
    contains more than one `<libinput>` block and the first is empty, so taking
    `find()` alone produced an empty set and then declared every correct element
    name unimplemented.
    """
    for cand in ("/usr/share/doc/labwc/rc.xml.all",):
        if not os.path.exists(cand):
            continue
        with open(cand, encoding="utf-8") as fh:
            text = fh.read()
        names = set()
        for region in re.findall(r"<libinput>(.*?)</libinput>", text, re.S):
            names |= set(re.findall(r"<([a-zA-Z]+)>", region))
        names -= {"libinput", "device"}
        return names or None
    return None


def main(argv=None):
    ap = argparse.ArgumentParser(description="Generate compositor input configs from the APEX model.")
    ap.add_argument("--model", default=MODEL_PATH)
    ap.add_argument("--dry-run", action="store_true", help="print what would be written")
    ap.add_argument("--no-reload", action="store_true")
    ap.add_argument("--self-test", action="store_true",
                    help="generate from defaults and run every compositor validator")
    args = ap.parse_args(argv)

    if args.self_test:
        return self_test()

    model, notes = load_model(args.model)
    for note in notes:
        print(f"apex-input: {note}", file=sys.stderr)

    hypr = gen_hyprland(model)
    niri = gen_niri(model)

    if args.dry_run:
        print(f"--- {HYPR_OUT} ---\n{hypr}")
        print(f"--- {NIRI_OUT} ---\n{niri}")
        el = libinput_element(model)
        ET.indent(el, space="  ")
        print(f"--- {LABWC_RC} <libinput> ---\n{ET.tostring(el, encoding='unicode')}")
        return 0

    # Validate before replacing anything, per compositor, so one bad value
    # cannot take a session down.
    with tempfile.TemporaryDirectory() as d:
        hp = os.path.join(d, "apex-input.conf")
        with open(hp, "w", encoding="utf-8") as fh:
            fh.write(hypr)
        if validate_hyprland(hp) is False:
            print("apex-input: the generated Hyprland config was rejected; nothing written",
                  file=sys.stderr)
            return 1
        np_ = os.path.join(d, "input.kdl")
        with open(np_, "w", encoding="utf-8") as fh:
            fh.write(niri)
        if validate_niri(np_) is False:
            print("apex-input: the generated niri config was rejected; nothing written",
                  file=sys.stderr)
            return 1

    atomic_write(HYPR_OUT, hypr)
    atomic_write(NIRI_OUT, niri)
    for note in write_labwc(LABWC_RC, model, args.dry_run):
        print(f"apex-input: {note}", file=sys.stderr)

    if not args.no_reload:
        print(f"apex-input: {reload_compositor()}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
