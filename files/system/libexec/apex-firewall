#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  apex-firewall — the exception list in front of APEX's default-drop policy.
#
#  The policy itself is /usr/share/apex/nftables/apex.nft and is not editable
#  from here. This adds and removes named exceptions, and nothing else: a user
#  who wants to open a port opens a *service*, because "5353/udp" is a thing you
#  paste from a forum and "mdns" is a thing you can decide about.
#
#  Exceptions live in /etc/apex/firewall.d/<name>.conf, one file per service, so
#  removing one is removing a file and the set is readable without this tool.
#  They are applied into two named nftables sets rather than by rewriting the
#  ruleset, so a malformed exception can never take the base policy with it.
#
#  They are also applied ONE AT A TIME. The first version built a single
#  `nft add element` per protocol, which meant one typo in one file failed the
#  whole command and closed every other port the user had opened — silently,
#  because the unit runs this with ExecStart=- and it printed "exceptions
#  reapplied" either way. The base policy survived, which was the architectural
#  claim; the user's other exceptions did not, which is the same bug wearing a
#  smaller hat.
#
#  Run as root for anything that changes state. Reading is unprivileged, and
#  says so when it cannot see the live ruleset rather than reporting an empty
#  one — `nft list` needs CAP_NET_ADMIN, and a firewall tool that answers "no
#  rules" to a user who merely lacks permission is the worst possible answer.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

readonly TABLE="inet apex"
readonly CONF_DIR=/etc/apex/firewall.d
readonly CATALOGUE=/usr/share/apex/firewall/services
readonly HOTSPOT_SET=hotspot_ifaces

msg()  { printf 'apex-firewall: %s\n' "$*"; }
warn() { printf 'apex-firewall: warning: %s\n' "$*" >&2; }
die()  { printf 'apex-firewall: error: %s\n' "$*" >&2; exit 1; }

need_root() {
    [ "$(id -u)" = 0 ] || die "$1 needs root; try: sudo apex firewall $1"
}

# The name becomes a path, and `deny` reaches the path before it reaches the
# catalogue. Without this, `apex firewall deny ../../../etc/issue` was an
# `rm -f` outside the exception directory, run as root.
valid_name() {
    case "$1" in
        *[!a-z0-9-]*|"" ) return 1 ;;
        -*)               return 1 ;;
        *)                return 0 ;;
    esac
}

# An interface name, before it becomes an nft element. The kernel's own limit
# is IFNAMSIZ-1 = 15 characters, and the character class is what `ip link` will
# accept; a name that reached `nft add element` unchecked would be a shell word
# in a command built by string concatenation.
valid_ifname() {
    case "$1" in
        ""|-*)             return 1 ;;
        *[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    [ "${#1}" -le 15 ]
}

# tcp or udp, and a port or a port range the set's `flags interval` can hold.
valid_spec() {
    case "$1" in tcp|udp) ;; *) return 1 ;; esac
    case "$2" in
        *[!0-9-]*|"") return 1 ;;
        *-*) [ "${2%%-*}" -ge 1 ] 2>/dev/null && [ "${2##*-}" -le 65535 ] 2>/dev/null ;;
        *)   [ "$2" -ge 1 ] 2>/dev/null && [ "$2" -le 65535 ] 2>/dev/null ;;
    esac
}

# The named services a user may open, as `name proto port description`.
# A catalogue rather than free-form ports: the point of the exception list is
# that a user can read it back later and know what they decided.
catalogue() {
    if [ -r "$CATALOGUE" ]; then
        grep -vE '^\s*(#|$)' "$CATALOGUE"
        return
    fi
    # Built in, so the tool still works if the image's copy is missing.
    cat <<'EOF'
ssh          tcp 22    Remote shell, and how APEX remote agents and `apex host run` reach this machine
http         tcp 80    A web server you are running
https        tcp 443   A web server you are running, over TLS
mdns         udp 5353  Local name discovery, for printers and `apex host`
samba        tcp 445   Windows file sharing
nfs          tcp 2049  NFS file sharing
ipp          tcp 631   Sharing a printer attached to this machine
steam-remote udp 27036 Steam Remote Play from another machine on this network
sunshine     tcp 47989 Sunshine game streaming host
ollama       tcp 11434 A local model server, reachable from other machines
apex-remote  tcp 7717  APEX Remote on this network, so a paired phone reaches this machine directly
syncthing    tcp 22000 Syncthing peer connections
EOF
}

lookup() {
    catalogue | awk -v n="$1" '$1 == n { print $2, $3; found=1 } END { exit !found }'
}

# Is the ruleset actually loaded? Distinguishes "no exceptions" from "cannot
# look", for the same reason the rest of this codebase does.
ruleset_state() {
    if ! command -v nft >/dev/null 2>&1; then
        printf 'absent\n'; return
    fi
    local out rc
    out="$(nft list table $TABLE 2>&1)"; rc=$?
    if [ "$rc" -eq 0 ]; then
        printf 'loaded\n'
    elif printf '%s' "$out" | grep -qiE 'permission denied|operation not permitted'; then
        printf 'unreadable\n'
    else
        printf 'notloaded\n'
    fi
}

cmd_list() {
    printf '%-13s %-5s %-6s %s\n' NAME PROTO PORT DESCRIPTION
    catalogue | while read -r name proto port desc; do
        printf '%-13s %-5s %-6s %s\n' "$name" "$proto" "$port" "$desc"
    done
}

cmd_status() {
    local state; state="$(ruleset_state)"
    case "$state" in
        absent)     msg "nft is not installed; no policy is being enforced" ;;
        notloaded)  msg "policy: NOT LOADED — incoming traffic is not being filtered"
                    msg "  load it with: sudo systemctl start apex-firewall" ;;
        unreadable) msg "policy: cannot read the ruleset; reading it needs root"
                    msg "  try: sudo apex firewall status" ;;
        loaded)     msg "policy: incoming dropped by default, outgoing allowed" ;;
    esac
    echo
    echo "always allowed, and not removable here:"
    echo "  established replies, loopback, ICMP, DHCP, mDNS/LLMNR, ssh"
    echo
    # Named here rather than left to `hotspot list`, because it is the one
    # opening a user did not choose in this file and would not otherwise find.
    # Only when the ruleset can be read: the case above has already said why
    # not, and saying it twice in one screen is how a tool trains people to
    # skim it.
    if [ "$state" = loaded ]; then
        cmd_hotspot list | sed 's/^apex-firewall: /  /'
        echo
    fi
    echo "exceptions you have added:"
    local any=0 f name proto port
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        name="$(basename "$f" .conf)"
        proto=""; port=""
        read -r proto port _ < "$f" 2>/dev/null
        if valid_spec "${proto:-}" "${port:-}"; then
            printf '  %-13s %s %s\n' "$name" "$proto" "$port"
        else
            # Re-checked here rather than remembered from the last reload, so
            # a status run tells the truth even if nothing has reloaded since.
            # Reporting a port as open when the reload rejected it is the one
            # answer this tool must never give.
            printf '  %-13s could not be applied — rejected: %s\n' \
                "$name" "$(printf '%s %s' "${proto:-}" "${port:-}" | sed 's/^ *//;s/ *$//')"
        fi
        any=1
    done
    [ "$any" = 1 ] || echo "  (none)"
}

# One file. Returns non-zero without touching the sets if it cannot be read as
# an exception, so a neighbouring file's typo costs nothing.
apply_one() {
    local f="$1" proto="" port=""
    read -r proto port _ < "$f" 2>/dev/null
    valid_spec "${proto:-}" "${port:-}" || return 1
    nft add element $TABLE "allowed_$proto" "{ $port }" 2>/dev/null
}

apply_sets() {
    local state; state="$(ruleset_state)"
    [ "$state" = loaded ] || { warn "the ruleset is not loaded; the exception is recorded and will apply when it is"; return 0; }
    nft flush set $TABLE allowed_tcp 2>/dev/null
    nft flush set $TABLE allowed_udp 2>/dev/null
    local f rejected=0
    for f in "$CONF_DIR"/*.conf; do
        [ -e "$f" ] || continue
        if ! apply_one "$f"; then
            warn "$(basename "$f") is not a service exception; leaving it out"
            rejected=$((rejected + 1))
        fi
    done
    [ "$rejected" = 0 ]
}

# ── the shared link ─────────────────────────────────────────────────────────
# A hotspot is the one case where this machine answers DHCP and DNS instead of
# asking them, and both arrive inbound on ports the policy shuts. That is not a
# decision the user makes once and keeps — it is true while a `method=shared`
# connection is up and false the moment it goes down — so it is NOT recorded in
# /etc/apex/firewall.d. It lives in a set of interface names that empties with
# the table, and NetworkManager's dispatcher puts it back.
#
# Scoped to the link on purpose. The alternative, a `dns` entry in the service
# catalogue, would open a resolver on the café Wi-Fi as well.

hotspot_ifaces() {  # the shared links NetworkManager has up, one per line
    command -v nmcli >/dev/null 2>&1 || return 1
    local uuid dev
    # `--active` alone, so a saved-but-down hotspot profile is not reopened.
    nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null |
    while IFS=: read -r uuid dev; do
        [ -n "${dev:-}" ] && [ "$dev" != "--" ] || continue
        case "$(nmcli -g ipv4.method connection show uuid "$uuid" 2>/dev/null)" in
            shared) printf '%s\n' "$dev" ;;
        esac
    done
}

hotspot_add() {  # $1 = interface name, already validated
    nft add element $TABLE "$HOTSPOT_SET" "{ $1 }" 2>/dev/null
}

hotspot_remove() {
    # Idempotent: the dispatcher fires `down` for links that were never shared,
    # and deleting an element that is not there is not a failure to report.
    nft delete element $TABLE "$HOTSPOT_SET" "{ $1 }" 2>/dev/null || true
}

# `nft -f apex.nft` deletes and rebuilds the table, so a restart of the unit
# empties this set — and NetworkManager will not re-run its dispatcher for a
# connection that was already up. Without this, restarting the firewall killed
# a running hotspot until the user toggled it off and on. Silent when NM is not
# answering: at boot this runs Before=network-pre.target, where there is no
# NetworkManager yet and no shared link to restore.
reapply_hotspot() {
    local ifname n=0
    while read -r ifname; do
        [ -n "$ifname" ] || continue
        valid_ifname "$ifname" || { warn "NetworkManager named a shared link '$ifname', which is not an interface name"; continue; }
        hotspot_add "$ifname" && n=$((n + 1))
    done < <(hotspot_ifaces)
    [ "$n" = 0 ] || msg "reopened DHCP and DNS on $n shared link$([ "$n" = 1 ] || echo s)"
}

cmd_hotspot() {
    local verb="${1:-}" ifname="${2:-}"
    case "$verb" in
        add|remove) ;;
        list|"")    ;;
        *) die "usage: apex firewall hotspot add|remove <interface>" ;;
    esac

    if [ "$verb" = list ] || [ -z "$verb" ]; then
        case "$(ruleset_state)" in
            absent)     msg "nft is not installed; no policy is being enforced" ;;
            notloaded)  msg "the policy is not loaded, so nothing is being filtered on any link" ;;
            unreadable) msg "cannot read the ruleset; reading it needs root"
                        msg "  try: sudo apex firewall hotspot list" ;;
            loaded)
                # Flattened first, and the quotes taken off. nft prints a set's
                # elements quoted, and wraps them one per line as soon as there
                # is more than one:
                #
                #     elements = { "apexhost",
                #                  "apexhost2" }
                #
                # A line-at-a-time `s/.*elements = { \(.*\) }.*/\1/` matches
                # neither line, so with two shared links it came back EMPTY and
                # this printed "not sharing this machine's connection on any
                # link" while both were open — a firewall tool reporting a shut
                # link as the answer for an open one. With one link it matched
                # and printed the name with nft's quotes still on it. Measured
                # in a namespace against the real `nft list set`, not guessed
                # at; tests/test-device-services-netns.sh keeps it measured.
                local out
                out="$(nft list set $TABLE "$HOTSPOT_SET" 2>/dev/null |
                       tr '\n\t' '  ' |
                       sed -n 's/.*elements = {\([^}]*\)}.*/\1/p' |
                       tr -d '"' | tr -s ' ' | sed 's/^ *//; s/ *$//; s/ *, */, /g')"
                if [ -n "$out" ]; then
                    msg "sharing this machine's connection on: $out"
                    msg "  DHCP and DNS are open on those links only"
                else
                    msg "not sharing this machine's connection on any link"
                fi ;;
        esac
        return 0
    fi

    [ -n "$ifname" ] || die "which interface? usage: apex firewall hotspot $verb <interface>"
    valid_ifname "$ifname" || die "'$ifname' is not an interface name"
    need_root "hotspot $verb"

    if [ "$(ruleset_state)" != loaded ]; then
        # Not an error. Nothing is filtering, so the hotspot already works; the
        # dispatcher calls this on every shared link coming up and a machine
        # with the unit stopped should not collect failures for it.
        msg "the policy is not loaded, so nothing needs opening for '$ifname'"
        return 0
    fi

    if [ "$verb" = add ]; then
        hotspot_add "$ifname" || die "could not open DHCP and DNS on '$ifname'"
        msg "opened DHCP and DNS on '$ifname' while it is shared"
    else
        hotspot_remove "$ifname"
        msg "closed DHCP and DNS on '$ifname'"
    fi
}

cmd_allow() {
    local name="${1:-}"
    [ -n "$name" ] || die "which service? see: apex firewall list"
    valid_name "$name" || die "'$name' is not a service name; see: apex firewall list"
    # Resolve the name BEFORE demanding root. Reading the catalogue needs no
    # privilege, and making someone type a password to be told they misspelled
    # a service is a worse command than one that answers first.
    local spec
    spec="$(lookup "$name")" || die "no service called '$name'; see: apex firewall list"
    need_root allow
    mkdir -p "$CONF_DIR"
    printf '%s %s\n' $spec > "${CONF_DIR}/${name}.conf"
    apply_sets || warn "another exception file could not be applied; see: apex firewall status"
    msg "allowed '$name' ($spec) on every interface"
}

cmd_deny() {
    local name="${1:-}"
    [ -n "$name" ] || die "which service? see: apex firewall status"
    # Before the -e test, not after: the name is about to become a path, and
    # answering "that was never open" for ../../etc/issue would mean this had
    # already gone looking outside the exception directory.
    valid_name "$name" || die "'$name' is not a service name; see: apex firewall list"
    # Same order as allow: say it was never open before asking for a password.
    # /etc/apex/firewall.d is world-readable precisely so this can answer.
    [ -e "${CONF_DIR}/${name}.conf" ] || die "'$name' was not allowed"
    need_root deny
    rm -f "${CONF_DIR}/${name}.conf"
    apply_sets || warn "another exception file could not be applied; see: apex firewall status"
    msg "removed '$name'"
}

# The unit runs this as ExecStart=-, so its exit status is not what keeps the
# machine up — but it is what a person and a test can read, and reporting
# success for a reload that dropped an exception is how a closed port looks
# open.
cmd_reload() {
    need_root reload
    # Before the exception report, because a shared link that is up right now
    # has just lost its rules to the table being rebuilt.
    [ "$(ruleset_state)" = loaded ] && reapply_hotspot
    if apply_sets; then
        msg "exceptions reapplied"
    else
        warn "some exceptions were not applied; see: apex firewall status"
        return 1
    fi
}

usage() {
    cat <<'EOF'
Incoming traffic is dropped by default. This manages the exceptions.

Usage: apex firewall <command>

Commands:
  status          What the policy is, and what you have opened
  list            The services you can open, by name
  allow <name>    Open one, on every interface. Needs root.
  deny <name>     Close one again. Needs root.
  reload          Reapply the recorded exceptions. Needs root.
  hotspot         Which links this machine is sharing its connection on

ssh is always open: APEX remote agents and `apex host run` are ssh, and closing
it would strand you on the machine you were driving from.

Sharing this machine's connection opens DHCP and DNS on that link alone, for as
long as it is shared. NetworkManager's dispatcher does that; `hotspot add` and
`hotspot remove` are how, and are not something to run by hand.
EOF
}

case "${1:-}" in
    status|"")   cmd_status ;;
    list)        cmd_list ;;
    allow)       shift; cmd_allow "$@" ;;
    deny)        shift; cmd_deny "$@" ;;
    hotspot)     shift; cmd_hotspot "$@" ;;
    reload)      cmd_reload ;;
    -h|--help)   usage ;;
    *)           usage >&2; exit 2 ;;
esac
