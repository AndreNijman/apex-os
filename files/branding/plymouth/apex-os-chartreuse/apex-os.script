# APEX-OS boot splash -- "Convergence"
# 4 comets with soft, speed-stretched light trails swoop in, orbit and
# accelerate, spiral into the center (anticipation), flash, and morph into
# the spark (back-out overshoot + rotation settle). Wordmark rises in
# underneath; spark holds with a subtle breathing loop.
#
# Motion design:
#   - each comet drags a tapered ribbon sampled from its own past path,
#     so the streaks curve with the orbit instead of reading as straight dashes
#   - ribbon length stretches with angular velocity (motion-blur feel)
#   - swoop-in entrance: comets ease from 1.5x radius down into the orbit
#   - heads are rotated by the true velocity vector (atan2), staying tangent
#     even during the spiral phase

HI_R = 0.851; HI_G = 0.976; HI_B = 0.616;   # #D9F99D (chartreuse highlight)

PI = 3.14159265;

w = Window.GetWidth();
h = Window.GetHeight();

Window.SetBackgroundTopColor(0.043, 0.055, 0.078);
Window.SetBackgroundBottomColor(0.016, 0.02, 0.031);

mode = Plymouth.GetMode();

cx = w / 2;
cy = h / 2 - h * 0.06;

if (w < h) { base = w * 0.26; } else { base = h * 0.26; }
R0 = base * 0.95;
cw = base * 0.38;

comet_image = Image("comet.png");
glow_image  = Image("glow.png");
spark_image = Image("spark.png");
flash_image = Image("flash.png");

# --- comets + trail ribbons ---
ncomets = 4;
ntrail  = 9;                       # ribbon segments per comet
for (i = 0; i < ncomets; i++) {
  comet[i] = Sprite();
  comet[i].SetOpacity(0);
  for (k = 0; k < ntrail; k++) {
    trail[i * ntrail + k] = Sprite();
    trail[i * ntrail + k].SetOpacity(0);
  }
}

# --- center glow / flash ---
glow = Sprite();
glow.SetOpacity(0);

# --- spark + white energy overlay ---
spark = Sprite();
spark.SetOpacity(0);
flash = Sprite();
flash.SetOpacity(0);

# --- wordmark ---
wm_image = Image.Text("A P E X   O S", 0.85, 0.87, 0.92);
wordmark = Sprite(wm_image);
wordmark.SetOpacity(0);

# --- password prompt sprites (LUKS) ---
prompt_sprite = Sprite();
bullet_sprite = Sprite();
message_sprite = Sprite();
dim = 1;

t = 0;
if (mode == "shutdown") { t = 200; }   # skip intro, static spark

# angular position: quadratic ease-in acceleration
fun orb_theta (tt) {
  return 0.06 * tt + 0.0022 * tt * tt;
}

# radius: constant orbit, accelerating contraction after t=30,
# swoop-in entrance (1.5x radius easing down) before t=10
fun orb_radius (tt) {
  local.R = R0;
  if (tt >= 30) {
    local.p = (tt - 30) / 22; if (local.p > 1) { local.p = 1; }
    local.q = 1 - local.p;
    local.R = R0 * local.q * local.q;
  }
  if (tt < 10) {
    local.e = 1 - tt / 10;
    local.R = local.R * (1 + 0.5 * local.e * local.e);
  }
  return local.R;
}

fun refresh () {
  t++;

  # ===== phase 1+2: accelerating orbit, then spiral in (t 1..54) =====
  if (t <= 54) {
    om = 0.06 + 0.0044 * t;                # angular velocity
    st = om / 0.15;                        # trail stretch with speed
    if (st < 0.8) { st = 0.8; }
    if (st > 2.0) { st = 2.0; }

    if (t < 10)       { cop = t / 10; }
    else if (t > 46)  { cop = (52 - t) / 6; if (cop < 0) { cop = 0; } }
    else              { cop = 1; }

    for (i = 0; i < ncomets; i++) {
      for (k = 0; k <= ntrail; k++) {
        tt = t - k * 0.22 * st; if (tt < 0) { tt = 0; }
        a = orb_theta(tt) + i * PI / 2;
        R = orb_radius(tt);
        x = R * Math.Cos(a);
        y = R * Math.Sin(a);

        # true velocity direction, sampled half a frame apart
        t1 = tt + 0.5;
        t2 = tt - 0.5; if (t2 < 0) { t2 = 0; }
        a1 = orb_theta(t1) + i * PI / 2;
        a2 = orb_theta(t2) + i * PI / 2;
        vx = orb_radius(t1) * Math.Cos(a1) - orb_radius(t2) * Math.Cos(a2);
        vy = orb_radius(t1) * Math.Sin(a1) - orb_radius(t2) * Math.Sin(a2);
        phi = Math.Atan2(vy, vx);

        f = 1 - k / (ntrail + 1);

        if (k == 0) {
          cimg = comet_image.Scale(cw, cw).Rotate(phi);
          comet[i].SetImage(cimg);
          comet[i].SetPosition(cx + x - cimg.GetWidth() / 2,
                               cy + y - cimg.GetHeight() / 2, 10);
          comet[i].SetOpacity(cop * dim);
        } else {
          rop = cop * 0.55 * f * f;        # ribbon fades quadratically
          rsz = cw * 0.30 * (0.25 + 0.75 * f);   # ... and tapers to a point
          rimg = glow_image.Scale(rsz, rsz);
          trail[i * ntrail + k - 1].SetImage(rimg);
          trail[i * ntrail + k - 1].SetPosition(cx + x - rimg.GetWidth() / 2,
                                                cy + y - rimg.GetHeight() / 2, 9);
          trail[i * ntrail + k - 1].SetOpacity(rop * dim);
        }
      }
    }
  } else {
    for (i = 0; i < ncomets; i++) {
      comet[i].SetOpacity(0);
      for (k = 0; k < ntrail; k++) { trail[i * ntrail + k].SetOpacity(0); }
    }
  }

  # ===== glow: gather, then flash outward (t 38..62) =====
  if (t >= 38 && t < 50) {
    gop = (t - 38) / 12 * 0.85;
    gs  = base * (0.3 + 0.3 * (t - 38) / 12);
  } else if (t >= 50 && t <= 62) {
    gop = 1 - (t - 50) / 12;
    gs  = base * (0.6 + 1.4 * (t - 50) / 12);
  } else { gop = 0; gs = 2; }

  if (gop > 0) {
    gimg = glow_image.Scale(gs, gs);
    glow.SetImage(gimg);
    glow.SetPosition(cx - gimg.GetWidth() / 2, cy - gimg.GetHeight() / 2, 8);
  }
  glow.SetOpacity(gop * dim);

  # ===== phase 3: spark morph -- back-out overshoot + rotation settle (t 50..70) =====
  if (t >= 50 && t <= 70) {
    p = (t - 50) / 20; if (p > 1) { p = 1; }
    q = p - 1;
    s   = 1 + 2.70158 * q * q * q + 1.70158 * q * q;   # back-out ease (overshoot ~1.1)
    rot = -2.4 * q * q * q;                            # spin settles to 0
    ss  = base * s; if (ss < 4) { ss = 4; }

    simg = spark_image.Scale(ss, ss).Rotate(rot);
    spark.SetImage(simg);
    spark.SetPosition(cx - simg.GetWidth() / 2, cy - simg.GetHeight() / 2, 11);
    if (p < 0.34) { spark.SetOpacity(p / 0.34 * dim); }
    else          { spark.SetOpacity(1 * dim); }

    fop = (1 - p) * (1 - p);                           # white-hot, cools to brand color
    fimg = flash_image.Scale(ss, ss).Rotate(rot);
    flash.SetImage(fimg);
    flash.SetPosition(cx - fimg.GetWidth() / 2, cy - fimg.GetHeight() / 2, 12);
    flash.SetOpacity(fop * 0.9 * dim);
  }
  if (t > 70) {   # idle breathing: opacity + subtle scale pulse
    bs = base * (1 + 0.02 * Math.Sin((t - 70) / 9));
    simg = spark_image.Scale(bs, bs);
    spark.SetImage(simg);
    spark.SetPosition(cx - simg.GetWidth() / 2, cy - simg.GetHeight() / 2, 11);
    spark.SetOpacity((0.93 + 0.07 * Math.Sin((t - 70) / 9)) * dim);
    flash.SetOpacity(0);
  }

  # ===== phase 4: wordmark rises in (t 62..84) =====
  if (t >= 62 && t <= 84) {
    p = (t - 62) / 22; q = 1 - p;
    wordmark.SetOpacity((1 - q * q) * dim);
    wordmark.SetPosition(cx - wm_image.GetWidth() / 2,
                         cy + base / 2 + h * 0.06 + q * q * h * 0.02, 10);
  } else if (t > 84) {
    wordmark.SetOpacity(1 * dim);
  }
}

fun display_password (prompt, bullets) {
  dim = 0.25;

  pimg = Image.Text(prompt, 0.85, 0.87, 0.92);
  prompt_sprite.SetImage(pimg);
  prompt_sprite.SetPosition(cx - pimg.GetWidth() / 2, cy - base / 8, 20);
  prompt_sprite.SetOpacity(1);

  btxt = "";
  for (i = 0; i < bullets; i++) { btxt = btxt + "* "; }
  bimg = Image.Text(btxt, HI_R, HI_G, HI_B);
  bullet_sprite.SetImage(bimg);
  bullet_sprite.SetPosition(cx - bimg.GetWidth() / 2, cy + base / 8, 20);
  bullet_sprite.SetOpacity(1);
}

fun display_normal () {
  dim = 1;
  prompt_sprite.SetOpacity(0);
  bullet_sprite.SetOpacity(0);
}

# --- messages ---
#
# This used to be an empty function, and an empty message() is not "no
# decoration": it is plymouth accepting `plymouth message --text=...`, calling
# this, and DROPPING IT. Everything the boot has to tell the user went nowhere.
#
# It matters most at exactly one screen. On an encrypted machine the passphrase
# prompt is the last thing between the owner and their data, and it is drawn
# before any filesystem is mounted, so it is the only place that can say which
# keyboard layout is live or that a recovery key is what is wanted now. A user
# who cannot be told any of that, at a prompt that accepts nothing else, is the
# stranding case.
#
# Drawn UNDER the bullets and slightly below them, so it never covers the
# prompt or the characters the user is counting. An empty text clears it,
# which is how plymouth asks for the message to go away.
fun message (text) {
  if (text == "") {
    message_sprite.SetOpacity(0);
    return;
  }
  mimg = Image.Text(text, 0.62, 0.66, 0.72);
  message_sprite.SetImage(mimg);
  message_sprite.SetPosition(cx - mimg.GetWidth() / 2, cy + base / 8 + base / 6, 20);
  message_sprite.SetOpacity(1);
}

Plymouth.SetRefreshFunction(refresh);

# ── The owner's accent (P: plymouth follows matugen, 2026-09-24) ─────────────
#
# Plymouth's script cannot tint an image, so accent/NN/ holds the art pre-rotated
# to 24 hues (make-accent-variants.sh). An initramfs unit (dracut module
# apex-plymouth-accent) reads the owner's published matugen accent once the root
# filesystem is mounted and sends `plymouth update --status=apex-accent-NN`; this
# swaps the three coloured images and the highlight colour for everything drawn
# after it. No message, or one this does not know, leaves the chartreuse.
#
# It has to arrive while the initramfs is still the root: after switch-root the
# theme's files are gone, so an Image() loaded later would fail. The unit is
# ordered before switch-root for exactly that reason.
ACCENT_NAME[0] = "00"; ACCENT_R[0] = 0.976; ACCENT_G[0] = 0.616; ACCENT_B[0] = 0.616;
ACCENT_NAME[1] = "01"; ACCENT_R[1] = 0.976; ACCENT_G[1] = 0.706; ACCENT_B[1] = 0.616;
ACCENT_NAME[2] = "02"; ACCENT_R[2] = 0.976; ACCENT_G[2] = 0.796; ACCENT_B[2] = 0.616;
ACCENT_NAME[3] = "03"; ACCENT_R[3] = 0.976; ACCENT_G[3] = 0.886; ACCENT_B[3] = 0.616;
ACCENT_NAME[4] = "04"; ACCENT_R[4] = 0.976; ACCENT_G[4] = 0.976; ACCENT_B[4] = 0.616;
ACCENT_NAME[5] = "05"; ACCENT_R[5] = 0.886; ACCENT_G[5] = 0.976; ACCENT_B[5] = 0.616;
ACCENT_NAME[6] = "06"; ACCENT_R[6] = 0.796; ACCENT_G[6] = 0.976; ACCENT_B[6] = 0.616;
ACCENT_NAME[7] = "07"; ACCENT_R[7] = 0.706; ACCENT_G[7] = 0.976; ACCENT_B[7] = 0.616;
ACCENT_NAME[8] = "08"; ACCENT_R[8] = 0.616; ACCENT_G[8] = 0.976; ACCENT_B[8] = 0.616;
ACCENT_NAME[9] = "09"; ACCENT_R[9] = 0.616; ACCENT_G[9] = 0.976; ACCENT_B[9] = 0.706;
ACCENT_NAME[10] = "10"; ACCENT_R[10] = 0.616; ACCENT_G[10] = 0.976; ACCENT_B[10] = 0.796;
ACCENT_NAME[11] = "11"; ACCENT_R[11] = 0.616; ACCENT_G[11] = 0.976; ACCENT_B[11] = 0.886;
ACCENT_NAME[12] = "12"; ACCENT_R[12] = 0.616; ACCENT_G[12] = 0.976; ACCENT_B[12] = 0.976;
ACCENT_NAME[13] = "13"; ACCENT_R[13] = 0.616; ACCENT_G[13] = 0.886; ACCENT_B[13] = 0.976;
ACCENT_NAME[14] = "14"; ACCENT_R[14] = 0.616; ACCENT_G[14] = 0.796; ACCENT_B[14] = 0.976;
ACCENT_NAME[15] = "15"; ACCENT_R[15] = 0.616; ACCENT_G[15] = 0.706; ACCENT_B[15] = 0.976;
ACCENT_NAME[16] = "16"; ACCENT_R[16] = 0.616; ACCENT_G[16] = 0.616; ACCENT_B[16] = 0.976;
ACCENT_NAME[17] = "17"; ACCENT_R[17] = 0.706; ACCENT_G[17] = 0.616; ACCENT_B[17] = 0.976;
ACCENT_NAME[18] = "18"; ACCENT_R[18] = 0.796; ACCENT_G[18] = 0.616; ACCENT_B[18] = 0.976;
ACCENT_NAME[19] = "19"; ACCENT_R[19] = 0.886; ACCENT_G[19] = 0.616; ACCENT_B[19] = 0.976;
ACCENT_NAME[20] = "20"; ACCENT_R[20] = 0.976; ACCENT_G[20] = 0.616; ACCENT_B[20] = 0.976;
ACCENT_NAME[21] = "21"; ACCENT_R[21] = 0.976; ACCENT_G[21] = 0.616; ACCENT_B[21] = 0.886;
ACCENT_NAME[22] = "22"; ACCENT_R[22] = 0.976; ACCENT_G[22] = 0.616; ACCENT_B[22] = 0.796;
ACCENT_NAME[23] = "23"; ACCENT_R[23] = 0.976; ACCENT_G[23] = 0.616; ACCENT_B[23] = 0.706;

fun apex_accent_status(status) {
  for (n = 0; n < 24; n++) {
    if (status == "apex-accent-" + ACCENT_NAME[n]) {
      dir = "accent/" + ACCENT_NAME[n] + "/";
      # global.: refresh() reads these every frame, and an assignment inside
      # a function must not be left to whatever the default scope is.
      global.comet_image = Image(dir + "comet.png");
      global.glow_image  = Image(dir + "glow.png");
      global.spark_image = Image(dir + "spark.png");
      global.HI_R = ACCENT_R[n]; global.HI_G = ACCENT_G[n]; global.HI_B = ACCENT_B[n];
    }
  }
}
Plymouth.SetUpdateStatusFunction(apex_accent_status);

Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetMessageFunction(message);
