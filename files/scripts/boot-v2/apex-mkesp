#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  apex-mkesp — author a guest ESP: systemd-boot at APEX-owned paths, UKIs, and
#  the boot-counting tallies systemd-boot decrements.
#
#  ── the layout, and why the UKIs are not under /EFI/APEX ──
#
#  §22 asks for "APEX-owned EFI paths, not Fedora-named paths". The naive read
#  is "put the UKIs in \EFI\APEX", and the naive fear is that doing so breaks
#  systemd-boot's native +N-M boot counting, which §22 also asks for. Both were
#  tested rather than assumed; scenario `entry-layout` in run-scenarios is the
#  measurement, and it found something more specific:
#
#    type #2  /EFI/Linux/apex-<id>+3-0.efi                  counted
#    type #1  .conf with `efi /EFI/APEX/uki/apex-<id>.efi`   NOT counted
#    type #1  .conf with `linux /EFI/APEX/uki/apex-<id>.efi` counted
#
#  So a fully APEX-named UKI path IS available, with the `linux` key. It is not
#  the default here, and the reason is not aesthetics:
#
#    * `apex boot status` reads `bootctl list --json`, and bootctl only reports
#      the tally, the .osrel-derived title and the embedded kernel version for
#      entries it recognises as UKIs. A type #1 `linux` entry pointing at a UKI
#      is reported as a plain type #1 entry, so the state APEX is supposed to
#      surface in Settings would have to be re-derived by parsing PE sections
#      off the ESP — a second implementation of something the bootloader
#      already does.
#    * A type #1 layout needs APEX to author and maintain an entry file per
#      deployment, in the ESP, in addition to the UKI. Two artifacts that must
#      agree is exactly the drift the UKI exists to remove.
#    * `linux` is documented as naming a kernel image, and sd-boot appends the
#      entry's `options` to it. That works with a UKI only because sd-stub
#      ignores a bootloader-supplied command line under Secure Boot. Relying on
#      that is relying on a coincidence.
#
#  What ships, then:
#    /EFI/APEX/systemd-bootx64.efi   the loader, at an APEX-owned path. This is
#                                    the binary an APEX NVRAM entry points at
#                                    ("APEX-OS", not "Fedora").
#    /EFI/BOOT/BOOTX64.EFI           the removable-media fallback. In the lab
#                                    this is what OVMF boots, because creating
#                                    an NVRAM entry would mean efibootmgr and
#                                    AGENTS.md forbids that near a real machine.
#    /EFI/Linux/apex-<id>+N-M.efi    the UKIs. \EFI\Linux is the systemd-boot
#                                    interface — a spec path, not a vendor
#                                    name, unlike the \EFI\fedora that §22 is
#                                    reacting to. APEX owns the FILENAMES,
#                                    which is what the menu, `bootctl list`
#                                    and `apex boot status` display.
#    /loader/entries/apex-<id>+N-M.conf  type #1 entries; --type1/--type1-linux
#                                    only, kept so the alternative stays
#                                    exercised rather than becoming a claim in
#                                    a comment.
#
#  Nothing here can touch a host ESP: the target is always an image file, the
#  FAT filesystem is built with mtools (no loop device, no mount, no root), and
#  the path is refused if it resolves under /boot, /efi or /usr.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail
# shellcheck source=files/scripts/boot-v2/lib.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib.sh"

DISK="" SIZE_MIB=256 SB_KEY="" SB_CERT="" DEFAULT="" TIMEOUT_S=0
declare -a UKIS=() TYPE1=() TYPE1_LINUX=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --disk)     DISK="$2"; shift 2;;
        --size)     SIZE_MIB="$2"; shift 2;;
        --sb-key)   SB_KEY="$2"; shift 2;;
        --sb-cert)  SB_CERT="$2"; shift 2;;
        # id:tries:path — a UKI discovered automatically from /EFI/Linux
        --uki)      UKIS+=("$2"); shift 2;;
        # id:tries:path — the same UKI reached through a type #1 loader entry
        --type1)    TYPE1+=("$2"); shift 2;;
        # As --type1, but reached with the `linux` key instead of `efi`. Only
        # the entry-layout scenario uses this; it exists to tell "type #1 is
        # not counted" apart from "`efi` entries are not counted".
        --type1-linux) TYPE1_LINUX+=("$2"); shift 2;;
        --default)  DEFAULT="$2"; shift 2;;
        --menu-timeout) TIMEOUT_S="$2"; shift 2;;
        *) die "unknown argument: $1";;
    esac
done
[[ -n "$DISK" ]] || die "usage: apex-mkesp --disk DISK.img --uki id:tries:path ... [--type1 id:tries:path]"
(( ${#UKIS[@]} + ${#TYPE1[@]} + ${#TYPE1_LINUX[@]} > 0 )) \
    || die "at least one --uki, --type1 or --type1-linux is required"

case "$(readlink -m "$DISK")" in
    /boot|/boot/*|/efi|/efi/*|/sys/*|/usr|/usr/*|/dev/*)
        die "refusing to author an ESP at $DISK — that is a real boot path or a device" ;;
esac

log "authoring guest ESP $DISK (${SIZE_MIB} MiB)"
esp_disk_create "$DISK" "$SIZE_MIB"
ESP="$DISK.esp"

esp_mkdir_p "$ESP" /EFI
esp_mkdir_p "$ESP" /EFI/APEX
esp_mkdir_p "$ESP" /EFI/BOOT
esp_mkdir_p "$ESP" /EFI/Linux
esp_mkdir_p "$ESP" /loader
esp_mkdir_p "$ESP" /loader/entries

# ── the loader binary ───────────────────────────────────────────────────────
WORK="$(mktemp -d)"; trap 'rm -rf "$WORK"' EXIT
cp "$(sd_boot_efi)" "$WORK/systemd-bootx64.efi"
if [[ -n "$SB_KEY" ]]; then
    [[ -n "$SB_CERT" ]] || die "--sb-key needs --sb-cert"
    sbsign --key "$SB_KEY" --cert "$SB_CERT" \
           --output "$WORK/systemd-bootx64.signed.efi" "$WORK/systemd-bootx64.efi" >&2
    mv "$WORK/systemd-bootx64.signed.efi" "$WORK/systemd-bootx64.efi"
    sbverify --cert "$SB_CERT" "$WORK/systemd-bootx64.efi" >&2 \
        || die "sbverify rejected the loader we just signed"
fi
mcopy -o -i "$ESP" "$WORK/systemd-bootx64.efi" ::/EFI/APEX/systemd-bootx64.efi
mcopy -o -i "$ESP" "$WORK/systemd-bootx64.efi" ::/EFI/BOOT/BOOTX64.EFI

# ── loader.conf ─────────────────────────────────────────────────────────────
# `timeout 0` means the default entry is chosen without waiting, which is what
# makes an unattended five-boot scenario possible. `editor no` is not cosmetic:
# with an editable command line an operator could bypass the signed cmdline,
# and on a machine with TPM-bound unlock that is a key-release bypass.
{
    printf 'timeout %s\n' "$TIMEOUT_S"
    printf 'editor no\n'
    printf 'auto-entries no\n'
    printf 'auto-firmware no\n'
    printf 'console-mode keep\n'
    [[ -n "$DEFAULT" ]] && printf 'default %s\n' "$DEFAULT"
} > "$WORK/loader.conf"
mcopy -o -i "$ESP" "$WORK/loader.conf" ::/loader/loader.conf

# ── entries ─────────────────────────────────────────────────────────────────
# The +N-M suffix IS the boot counter. systemd-boot renames the file on every
# attempt: tries-left goes down, tries-done goes up, and when tries-left
# reaches 0 the entry sorts last and the next-best entry is selected instead.
# APEX uses this rather than a counter of its own because the count has to be
# decremented by something that runs before the kernel does — a userspace
# counter cannot be decremented by a boot that never reaches userspace, which
# is precisely the failure it would need to count.
place_uki() {
    local spec="$1" dir="$2"
    local id tries path
    IFS=: read -r id tries path <<<"$spec"
    [[ -f "$path" ]] || die "no such UKI: $path"
    local name="apex-$id"
    [[ "$tries" != "0" && -n "$tries" ]] && name="apex-$id+$tries-0"
    mcopy -o -i "$ESP" "$path" "::$dir/$name.efi"
    printf '%s\n' "$name"
}

for spec in "${UKIS[@]}"; do
    n="$(place_uki "$spec" /EFI/Linux)"
    info "type #2  /EFI/Linux/$n.efi"
done

place_type1() {
    local spec="$1" key="$2"
    local id tries path conf
    IFS=: read -r id tries path <<<"$spec"
    [[ -f "$path" ]] || die "no such UKI: $path"
    esp_mkdir_p "$ESP" /EFI/APEX/uki
    mcopy -o -i "$ESP" "$path" "::/EFI/APEX/uki/apex-$id.efi"
    conf="apex-$id"
    [[ "$tries" != "0" && -n "$tries" ]] && conf="apex-$id+$tries-0"
    {
        printf 'title APEX-OS (%s)\n' "$id"
        # Either key hands the whole PE to LoadImage, so the firmware verifies
        # it against db exactly as it would a type #2 UKI, and the command line
        # comes from inside the image. No `options` line: sd-stub ignores a
        # bootloader-supplied cmdline under Secure Boot anyway, so writing one
        # here would document a lie.
        printf '%s /EFI/APEX/uki/apex-%s.efi\n' "$key" "$id"
    } > "$WORK/$conf.conf"
    mcopy -o -i "$ESP" "$WORK/$conf.conf" "::/loader/entries/$conf.conf"
    info "type #1 ($key)  /loader/entries/$conf.conf -> /EFI/APEX/uki/apex-$id.efi"
}

for spec in "${TYPE1[@]}";       do place_type1 "$spec" efi;   done
for spec in "${TYPE1_LINUX[@]}"; do place_type1 "$spec" linux; done

esp_disk_flush "$DISK"

# ── postconditions ─────────────────────────────────────────────────────────
# Read the staged filesystem back and require the exact entry count. A run that
# silently produced one entry instead of two would make every "the bootloader
# fell back to the other entry" assertion untestable while still going green.
# `mdir -b` for bare full paths. Without it mdir prints the 8.3 form in
# columns, so /EFI/BOOT/BOOTX64.EFI renders as "BOOTX64  EFI" and a grep for
# the real filename finds nothing — which is how this check first reported a
# missing file that was present.
LIST="$(mdir -i "$ESP" -b -/ ::/ 2>/dev/null)"
grep -qx '::/EFI/BOOT/BOOTX64.EFI' <<<"$LIST" || die "no /EFI/BOOT/BOOTX64.EFI in $DISK:
$LIST"
grep -qx '::/EFI/APEX/systemd-bootx64.efi' <<<"$LIST" \
    || die "no /EFI/APEX/systemd-bootx64.efi in $DISK:
$LIST"
n_uki="$(grep -c '^::/EFI/Linux/.*\.efi$' <<<"$LIST" || true)"
assert_n() { [[ "$1" == "$2" ]] || die "expected $2 $3, staged $1"; }
assert_n "$n_uki" "${#UKIS[@]}" "type #2 UKIs in /EFI/Linux"
n_t1=$(( ${#TYPE1[@]} + ${#TYPE1_LINUX[@]} ))
if (( n_t1 )); then
    n_conf="$(grep -c '^::/loader/entries/.*\.conf$' <<<"$LIST" || true)"
    assert_n "$n_conf" "$n_t1" "type #1 entries in /loader/entries"
fi
info "staged $n_uki type#2 + $n_t1 type#1 entries"
