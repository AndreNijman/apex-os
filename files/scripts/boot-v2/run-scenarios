#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  run-scenarios — the boot v2 VM harness. §22 migration step 2, "prototype
#  composefs/systemd-boot in CI and virtual machines".
#
#  Every scenario boots a real guest under Secure-Boot-enforcing OVMF and
#  asserts on what came out of the guest's serial port and on what the
#  bootloader wrote back into the ESP. Nothing here asserts that a build
#  command exited 0.
#
#  Three rules the assertions follow, each of which this project has been
#  bitten by:
#
#  1. A marker must be read from the SERIAL LOG and nowhere else. The UKI, the
#     staged ESP and the guest init script all contain the marker string, so a
#     grep over the work directory would pass with no guest having run.
#  2. A run counts as a boot only when qemu exited 0 under -no-reboot. Marker
#     present + timeout kill means the guest printed and then hung, which §22
#     refuses to count as a successful update.
#  3. Counts are EXACT. `-ge` once let 20 of 68 dropped bindings pass a test
#     called "it generates every binding it can".
#
#  Usage: run-scenarios [--work DIR] [SCENARIO ...]
#         run-scenarios --list
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=files/scripts/boot-v2/lib.sh
. "$HERE/lib.sh"

WORK="${APEX_BOOTLAB_WORK:-/work/out}"
SCENARIOS=()
LIST=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --work) WORK="$2"; shift 2;;
        --list) LIST=1; shift;;
        --*) die "unknown option $1";;
        *) SCENARIOS+=("$1"); shift;;
    esac
done

ALL=(prereq signed-uki reproducible negative-unsigned negative-foreign
     negative-tampered entry-layout boot-counting)
if (( LIST )); then printf '%s\n' "${ALL[@]}"; exit 0; fi
(( ${#SCENARIOS[@]} )) || SCENARIOS=("${ALL[@]}")

KVER="$(cat /etc/apex-bootlab-kver 2>/dev/null || true)"
[[ -n "$KVER" ]] || die "/etc/apex-bootlab-kver missing — not running inside the boot lab image"
LAB_KERNEL="/usr/lib/modules/$KVER/vmlinuz"
KEYS="$WORK/keys"
CMDLINE_BASE="console=ttyS0,115200 earlyprintk=serial,ttyS0,115200"

mkdir -p "$WORK"

# ── shared fixtures ─────────────────────────────────────────────────────────
fixtures() {
    [[ -d "$KEYS" ]] && return 0
    "$HERE/apex-sb-keys" "$KEYS" >/dev/null
    "$HERE/apex-sb-vars" --cert "$KEYS/sb/cert.der" --output "$WORK/vars-apex.tmpl.fd" >/dev/null
    "$HERE/apex-guest-micro" "$WORK/micro.cpio.gz" >/dev/null
}

# A fresh writable varstore per scenario: EFI variables persist inside the
# file, and a scenario inheriting another's LoaderEntryDefault or BootOrder
# would make the results depend on execution order.
fresh_vars() { cp "$WORK/vars-apex.tmpl.fd" "$1"; }

mkuki() {  # mkuki OUT ENTRY_ID [--unsigned|--foreign|extra args...]
    local out="$1" id="$2"; shift 2
    local -a args=(
        --output "$out"
        --kernel "$LAB_KERNEL" --initrd "$WORK/micro.cpio.gz" --allow-no-ucode
        --cmdline "$CMDLINE_BASE apex.bootlab.entry=$id"
        --deployment "$id" --variant bootlab
    )
    case "${1:-}" in
        --unsigned) shift ;;
        --foreign)  shift; args+=(--sb-key "$KEYS/foreign/key.pem" --sb-cert "$KEYS/foreign/cert.pem") ;;
        *)          args+=(--sb-key "$KEYS/sb/key.pem" --sb-cert "$KEYS/sb/cert.pem") ;;
    esac
    "$HERE/apex-mkuki" "${args[@]}" "$@" >/dev/null
}

# List the type #2 entry filenames the bootloader currently sees, read back out
# of the disk image AFTER the boot rather than from our staging copy.
esp_linux_entries() {
    local disk="$1"
    esp_disk_readback "$disk" "$disk.after"
    mdir -i "$disk.after" -b ::/EFI/Linux 2>/dev/null \
        | sed 's|^::/EFI/Linux/||' | sed 's/\r$//' | grep -i '\.efi$' | sort
}

esp_loader_entries() {
    local disk="$1"
    esp_disk_readback "$disk" "$disk.after"
    mdir -i "$disk.after" -b ::/loader/entries 2>/dev/null \
        | sed 's|^::/loader/entries/||' | sed 's/\r$//' | grep -i '\.conf$' | sort
}

# ── scenarios ───────────────────────────────────────────────────────────────

scenario_prereq() {
    log "prereq: the lab has what every other scenario assumes"
    [[ -f "$LAB_KERNEL" ]] && ok "lab kernel $KVER" || bad "no lab kernel at $LAB_KERNEL"
    local f; f="$(ovmf_code_secboot)";      ok "SB firmware $f"
    f="$(ovmf_vars_template)";              ok "pristine varstore template $f"
    f="$(sd_boot_efi)";                     ok "systemd-boot $f"
    f="$(sd_stub_efi)";                     ok "sd-stub $f"
    # KVM makes the difference between a 6-second boot and a 40-second one, but
    # it is not a hard requirement: qemu falls back to TCG and the assertions
    # are identical. Report which one ran, because "it passed" means different
    # things at different speeds and a CI timeout is the usual symptom.
    if [[ -r /dev/kvm ]]; then ok "acceleration: kvm"; else ok "acceleration: tcg (no /dev/kvm)"; fi
}

scenario_signed_uki() {
    log "signed-uki: an APEX-signed UKI boots under Secure Boot enforcing"
    fixtures
    mkuki "$WORK/uki-good.efi" good
    local disk="$WORK/disk-signed.img" vars="$WORK/vars-signed.fd" ser="$WORK/serial-signed.log"
    "$HERE/apex-mkesp" --disk "$disk" --size 96 \
        --sb-key "$KEYS/sb/key.pem" --sb-cert "$KEYS/sb/cert.pem" \
        --uki "good:0:$WORK/uki-good.efi" --default 'apex-good*' >/dev/null
    fresh_vars "$vars"

    local rc=0
    vm_boot --disk "$disk" --vars "$vars" --name signed --serial "$ser" --timeout 120 || rc=$?
    assert_eq 0 "$rc" "qemu exit status (clean guest poweroff)"
    assert_serial_has "$ser" "APEX-BOOTLAB: userspace-reached"
    assert_serial_has "$ser" "APEX-BOOTLAB: clean-poweroff"
    # The command line inside the signed image is the one the kernel received.
    # This is the property that makes a UKI worth having: on the GRUB/BLS path
    # the cmdline is unsigned and unmeasured.
    assert_serial_has "$ser" "apex.bootlab.entry=good"
    # sd-boot ran and identified itself, so the boot went through the loader we
    # signed rather than the firmware loading the UKI directly.
    assert_serial_has "$ser" "APEX-BOOTLAB: efivar LoaderEntrySelected=apex-good.efi"
    assert_serial_has "$ser" "APEX-BOOTLAB: efivar StubInfo=systemd-stub"
}

scenario_reproducible() {
    log "reproducible: the same inputs and SOURCE_DATE_EPOCH give the same bytes"
    fixtures
    # §22 wants UKIs "produced reproducibly". Two builds, one fixed
    # SOURCE_DATE_EPOCH, byte-identical output — or this reports the difference
    # rather than claiming a property it does not have.
    local a="$WORK/repro-1.efi" b="$WORK/repro-2.efi"
    SOURCE_DATE_EPOCH=1700000000 mkuki "$a" repro
    SOURCE_DATE_EPOCH=1700000000 mkuki "$b" repro
    local ha hb
    ha="$(sha256sum <"$a" | cut -d' ' -f1)"
    hb="$(sha256sum <"$b" | cut -d' ' -f1)"
    assert_eq "$ha" "$hb" "sha256 of two identical UKI builds"

    # And a different epoch must produce different bytes, otherwise the check
    # above would pass even if SOURCE_DATE_EPOCH were being ignored and the
    # timestamp were hardcoded.
    local c="$WORK/repro-3.efi" hc
    SOURCE_DATE_EPOCH=1600000000 mkuki "$c" repro
    hc="$(sha256sum <"$c" | cut -d' ' -f1)"
    if [[ "$ha" == "$hc" ]]; then
        bad "SOURCE_DATE_EPOCH has no effect on the output — reproducibility is not being controlled"
    else
        ok "a different SOURCE_DATE_EPOCH changes the bytes"
    fi
}

# One helper for all three negative controls: the difference between them is
# only how the UKI was (not) signed, and the expected outcome is identical.
negative_boot() {
    local name="$1" uki="$2"
    local disk="$WORK/disk-$name.img" vars="$WORK/vars-$name.fd" ser="$WORK/serial-$name.log"
    "$HERE/apex-mkesp" --disk "$disk" --size 96 \
        --sb-key "$KEYS/sb/key.pem" --sb-cert "$KEYS/sb/cert.pem" \
        --uki "$name:0:$uki" --default "apex-$name*" >/dev/null
    fresh_vars "$vars"
    local rc=0
    # A short timeout: the firmware refusing an image is immediate. sd-boot
    # then has nothing bootable and sits at its menu, so the timeout kill IS
    # the expected outcome here and the marker's absence is the assertion.
    vm_boot --disk "$disk" --vars "$vars" --name "$name" --serial "$ser" --timeout 45 || rc=$?
    assert_serial_lacks "$ser" "APEX-BOOTLAB: userspace-reached"
    if (( rc == 0 )); then
        bad "$name: the guest powered off cleanly, so something booted"
    else
        ok "$name: no guest reached userspace (qemu rc=$rc)"
    fi
}

scenario_negative_unsigned() {
    log "negative-unsigned: an unsigned UKI is refused by the firmware"
    fixtures
    mkuki "$WORK/uki-unsigned.efi" unsigned --unsigned
    # Prove the mutant is really unsigned. A negative control that "passed"
    # because the artifact was never built is a documented failure in this
    # project; so is one that passed because the artifact was accidentally fine.
    if sbverify --cert "$KEYS/sb/cert.pem" "$WORK/uki-unsigned.efi" >/dev/null 2>&1; then
        bad "the 'unsigned' UKI verifies against the APEX certificate — the control is void"
        return
    fi
    ok "the unsigned UKI does not verify against the APEX certificate"
    negative_boot unsigned "$WORK/uki-unsigned.efi"
}

scenario_negative_foreign() {
    log "negative-foreign: a UKI signed by an unenrolled key is refused"
    fixtures
    mkuki "$WORK/uki-foreign.efi" foreign --foreign
    # This control is the stronger one: it proves the firmware is CHECKING the
    # signature against db, not merely checking that a signature exists.
    if ! sbverify --cert "$KEYS/foreign/cert.pem" "$WORK/uki-foreign.efi" >/dev/null 2>&1; then
        bad "the foreign UKI is not signed by the foreign key — the control is void"
        return
    fi
    ok "the foreign UKI is validly signed, by a key that is not in db"
    if sbverify --cert "$KEYS/sb/cert.pem" "$WORK/uki-foreign.efi" >/dev/null 2>&1; then
        bad "the foreign UKI also verifies against the APEX certificate — the control is void"
        return
    fi
    ok "the foreign UKI does not verify against the APEX certificate"
    negative_boot foreign "$WORK/uki-foreign.efi"
}

scenario_negative_tampered() {
    log "negative-tampered: editing the signed command line breaks the boot"
    fixtures
    mkuki "$WORK/uki-tampered.efi" tampered
    local victim="$WORK/uki-tampered.efi"
    # Flip one byte inside .cmdline. This is the attack a UKI exists to stop:
    # on the GRUB/BLS path the command line is a text file anyone with the ESP
    # can edit, and `init=/bin/sh` or a changed composefs digest would be
    # accepted. Here it must invalidate the whole image.
    local off before after
    off="$(python3 - "$victim" <<'PY'
import sys, pefile
pe = pefile.PE(sys.argv[1], fast_load=True)
s = next(x for x in pe.sections if x.Name.rstrip(b'\x00') == b'.cmdline')
print(s.PointerToRawData)
PY
)"
    before="$(sha256sum <"$victim" | cut -d' ' -f1)"
    printf 'X' | dd of="$victim" bs=1 seek="$off" conv=notrunc status=none
    after="$(sha256sum <"$victim" | cut -d' ' -f1)"
    # Verify the mutant exists AND differs before concluding anything was
    # caught. A `dd` that errored, or an offset of 0, would leave the original
    # in place and the scenario would "catch" a UKI that was never mutated.
    if [[ "$before" == "$after" ]]; then
        bad "the tampered UKI is byte-identical to the original — the mutation did not happen"
        return
    fi
    ok "the tampered UKI differs from the signed original (offset $off)"
    if sbverify --cert "$KEYS/sb/cert.pem" "$victim" >/dev/null 2>&1; then
        bad "sbverify still accepts the tampered UKI"
        return
    fi
    ok "sbverify rejects the tampered UKI"
    negative_boot tampered "$victim"
}

scenario_entry_layout() {
    log "entry-layout: which entry types does systemd-boot 258 apply the tally to?"
    fixtures
    # §22 asks for APEX-owned EFI paths; systemd-boot hardcodes \\EFI\\Linux for
    # UKI discovery. This scenario measures whether a type #1 entry pointing at
    # /EFI/APEX/uki/ gets counted too, so the layout decision in apex-mkesp
    # rests on an observation rather than on a reading of the source.
    mkuki "$WORK/uki-t2.efi" t2
    mkuki "$WORK/uki-t1.efi" t1
    local disk="$WORK/disk-layout.img" vars="$WORK/vars-layout.fd"

    # (a) type #2, /EFI/Linux, tally 3
    "$HERE/apex-mkesp" --disk "$disk" --size 96 \
        --sb-key "$KEYS/sb/key.pem" --sb-cert "$KEYS/sb/cert.pem" \
        --uki "t2:3:$WORK/uki-t2.efi" --default 'apex-t2*' >/dev/null
    fresh_vars "$vars"
    vm_boot --disk "$disk" --vars "$vars" --name layout-t2 \
            --serial "$WORK/serial-layout-t2.log" --timeout 120 || true
    local got; got="$(esp_linux_entries "$disk" | tr '\n' ' ')"
    assert_eq "apex-t2+2-1.efi " "$got" "type #2 filename after one boot"

    # (b) type #1, /loader/entries -> /EFI/APEX/uki, tally 3
    "$HERE/apex-mkesp" --disk "$disk" --size 96 \
        --sb-key "$KEYS/sb/key.pem" --sb-cert "$KEYS/sb/cert.pem" \
        --type1 "t1:3:$WORK/uki-t1.efi" --default 'apex-t1*' >/dev/null
    fresh_vars "$vars"
    vm_boot --disk "$disk" --vars "$vars" --name layout-t1 \
            --serial "$WORK/serial-layout-t1.log" --timeout 120 || true
    assert_serial_has "$WORK/serial-layout-t1.log" "apex.bootlab.entry=t1"
    got="$(esp_loader_entries "$disk" | tr '\n' ' ')"
    assert_eq "apex-t1+2-1.conf " "$got" "type #1 filename after one boot"
}

scenario_boot_counting() {
    log "boot-counting: the tally walks down and the loader falls back to the previous entry"
    fixtures
    # The shape of a real APEX rollback:
    #   apex-new   the deployment just installed, tally +3-0. Nothing blesses
    #              it, because the micro guest is not a systemd guest — which
    #              is exactly what a deployment that never finishes booting
    #              looks like to the bootloader.
    #   apex-good  the previous deployment, NO tally. A blessed entry has no
    #              +N-M suffix at all, so it is always eligible.
    # This is the upstream mechanism and not an APEX invention. It has to be:
    # the counter must be decremented by something that runs BEFORE the kernel,
    # since the boots it needs to count are the ones that never reach
    # userspace. Nothing in userspace can count those.
    mkuki "$WORK/uki-new.efi"  new
    mkuki "$WORK/uki-good.efi" good
    local disk="$WORK/disk-count.img" vars="$WORK/vars-count.fd"
    "$HERE/apex-mkesp" --disk "$disk" --size 128 \
        --sb-key "$KEYS/sb/key.pem" --sb-cert "$KEYS/sb/cert.pem" \
        --uki "new:3:$WORK/uki-new.efi" \
        --uki "good:0:$WORK/uki-good.efi" >/dev/null
    fresh_vars "$vars"

    # Exactly two entries. A run that produced one would let every "it fell
    # back to the other entry" assertion pass vacuously.
    local n; n="$(esp_linux_entries "$disk" | wc -l)"
    assert_eq 2 "$n" "entries in /EFI/Linux before any boot"
    assert_eq "apex-good.efi apex-new+3-0.efi " "$(esp_linux_entries "$disk" | tr '\n' ' ')" \
        "staged entry filenames"

    # Walk the tally down. Each step asserts the EXACT filename pair, in both
    # directions: the counted entry decrements and the blessed entry never
    # grows a suffix.
    local -a expect=(
        "apex-good.efi apex-new+2-1.efi "
        "apex-good.efi apex-new+1-2.efi "
        "apex-good.efi apex-new+0-3.efi "
    )
    local -a expect_entry=(new new new)
    local i
    for i in 0 1 2; do
        vm_boot --disk "$disk" --vars "$vars" --name "count-$i" \
                --serial "$WORK/serial-count-$i.log" --timeout 120 || true
        assert_eq "${expect[$i]}" "$(esp_linux_entries "$disk" | tr '\n' ' ')" \
                  "filenames after boot $((i + 1))"
        assert_serial_has "$WORK/serial-count-$i.log" "apex.bootlab.entry=${expect_entry[$i]}"
    done

    # Tally exhausted. The next boot must select the OTHER entry — the previous
    # known-good deployment — and the exhausted entry must keep its +0-3
    # suffix so the state is visible to `apex boot status` afterwards.
    vm_boot --disk "$disk" --vars "$vars" --name count-fallback \
            --serial "$WORK/serial-count-fallback.log" --timeout 120 || true
    assert_serial_has "$WORK/serial-count-fallback.log" "apex.bootlab.entry=good"
    assert_serial_has "$WORK/serial-count-fallback.log" \
        "APEX-BOOTLAB: efivar LoaderEntrySelected=apex-good.efi"
    assert_eq "apex-good.efi apex-new+0-3.efi " "$(esp_linux_entries "$disk" | tr '\n' ' ')" \
        "filenames after the fallback boot"
    # And the fallback must be stable: a machine that alternated between a
    # broken deployment and a good one every other boot would be worse than
    # one that just stayed broken.
    vm_boot --disk "$disk" --vars "$vars" --name count-fallback2 \
            --serial "$WORK/serial-count-fallback2.log" --timeout 120 || true
    assert_serial_has "$WORK/serial-count-fallback2.log" "apex.bootlab.entry=good"
}

# ── run ─────────────────────────────────────────────────────────────────────
for s in "${SCENARIOS[@]}"; do
    fn="scenario_${s//-/_}"
    declare -F "$fn" >/dev/null || die "no such scenario: $s (try --list)"
    "$fn"
done
bootv2_summary "boot-v2 VM harness"
