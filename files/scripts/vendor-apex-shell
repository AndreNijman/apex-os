#!/usr/bin/env bash
set -euo pipefail

ref="${1:?usage: vendor-apex-shell REF [DEST] [STRICT]}"
dest="${2:-/usr/share/apex-shell}"
strict="${3:-0}"
repo="https://github.com/AndreNijman/apex-shell"

[[ "${strict}" = 0 || "${strict}" = 1 ]] || {
    echo "strict must be 0 or 1" >&2
    exit 2
}

rm -rf "${dest}"
if git clone --depth 1 --branch "${ref}" "${repo}" "${dest}" 2>/dev/null; then
    :
else
    rm -rf "${dest}"
    git clone --filter=blob:none "${repo}" "${dest}"
    git -C "${dest}" checkout --detach "${ref}"
fi

sha="$(git -C "${dest}" rev-parse HEAD)"
if [[ "${ref}" =~ ^[0-9a-f]{40}$ ]]; then
    test "${sha}" = "${ref}"
fi
printf '%s\n' "${sha}" > "${dest}/.apex-shell-commit"
test -s "${dest}/shell.qml"
test -d "${dest}/src/services"
test -x "${dest}/src/scripts/screenshot.sh"
bash -n "${dest}/src/scripts/screenshot.sh"
rm -rf "${dest}/.git"

# Redirect the remaining legacy writable/source-tree paths for immutable /usr.
sed -i "s|output_path = '@SRCDIR@/src/config/colors.conf'|output_path = '@HOME@/.config/hypr/apex-shell-hyprlock-colors.conf'|" \
    "${dest}/src/config/matugen.toml.in"
grep -q "output_path = '@HOME@/.config/hypr/apex-shell-hyprlock-colors.conf'" \
    "${dest}/src/config/matugen.toml.in"
sed -i 's|^source = ~/.local/src/apex-shell/src/config/colors.conf|source = ~/.config/hypr/apex-shell-hyprlock-colors.conf|' \
    "${dest}/src/config/hyprlock.conf"
{ grep -rl '~/\.local/src/apex-shell' "${dest}" 2>/dev/null || true; } | while read -r file; do
    sed -i 's|~/\.local/src/apex-shell|/usr/share/apex-shell|g' "${file}"
done
! grep -rn '~/\.local/src/apex-shell' "${dest}" 2>/dev/null
grep -q 'lock_cmd = qs -c /usr/share/apex-shell ipc call lockscreen lock' \
    "${dest}/src/config/hypridle.conf"

# Compatibility for shell revisions predating the image-owned Windows helper.
power="${dest}/src/scripts/PowerControl.sh"
pre_probe=0
if grep -vE '^[[:space:]]*#' "${power}" | grep -q 'caelestia-boot-windows'; then
    pre_probe=1
fi
sed -i '/^[[:space:]]*#/!s|/usr/local/bin/caelestia-boot-windows|/usr/libexec/apex-boot-windows|g' "${power}"
! grep -vE '^[[:space:]]*#' "${power}" | grep -q 'caelestia-boot-windows'
grep -q '/usr/libexec/apex-boot-windows' "${power}"
if ! grep -q 'windows-check' "${power}"; then
    if [[ "${pre_probe}" = 1 && "${strict}" = 0 ]]; then
        echo "WARN: shell predates the windows-check probe; the Windows row will stay hidden"
    else
        echo "FATAL: PowerControl.sh has no windows-check action" >&2
        exit 1
    fi
else
    grep -q 'windows-check' "${dest}/src/services/PowerMenu.qml"
fi
bash -n "${power}"

# PowerControl.sh and DpmsControl.sh SOURCE src/scripts/compositor.sh, and every
# action in both runs through its apex_run(). A tree carrying the source line
# without the file has a power menu where nothing works at all — worse than the
# labwc no-ops the adapter was added to fix, and nothing else here would notice,
# because every check above names PowerControl.sh alone.
#
# Keyed on the source line rather than the words "compositor.sh": both scripts
# discuss the adapter in comments, and a check a comment can satisfy is a check
# this repo has already shipped five times.
adapter="${dest}/src/scripts/compositor.sh"
if grep -qE '^[[:space:]]*\.[[:space:]].*compositor\.sh' "${power}"; then
    test -s "${adapter}" || {
        echo "FATAL: PowerControl.sh sources compositor.sh but the checkout has no such file" >&2
        exit 1
    }
    bash -n "${adapter}"
    grep -qE '^apex_run\(\)' "${adapter}" || {
        echo "FATAL: compositor.sh defines no apex_run; every power-menu action would call an undefined function" >&2
        exit 1
    }
    grep -qE '^[[:space:]]*\.[[:space:]].*compositor\.sh' "${dest}/src/scripts/DpmsControl.sh" || {
        echo "FATAL: DpmsControl.sh does not use the compositor adapter; idle screen-off would be compositor-blind again" >&2
        exit 1
    }
elif [[ "${strict}" = 1 ]]; then
    echo "FATAL: this apex-shell ref predates src/scripts/compositor.sh; labwc has no Log Out and no idle screen-off" >&2
    exit 1
else
    echo "WARN: shell predates src/scripts/compositor.sh; the labwc session has no Log Out and no idle screen-off"
fi

# The image intentionally drops .git; keep the version field functional.
misc="${dest}/src/services/config_tab/pages/MiscPage.qml"
if grep -q 'describe --tags --always 2>/dev/null' "${misc}"; then
    sed -i 's|describe --tags --always 2>/dev/null|describe --tags --always 2>/dev/null \|\| cut -c1-12 $1/.apex-shell-commit 2>/dev/null|' "${misc}"
    awk '/describe --tags/{n=gsub(/"/,"\""); exit (n%2)}' "${misc}"
fi

wallpaper="${dest}/src/services/WallpaperService.qml"
if ! grep -q 'apex-greet-wallpaper' "${wallpaper}"; then
    if [[ "${strict}" = 1 ]]; then
        echo "FATAL: current apex-shell no longer publishes the greeter wallpaper" >&2
        exit 1
    fi
    echo "WARN: pinned shell predates the greeter-wallpaper publisher"
fi

echo "vendored apex-shell ${sha} at ${dest}"
