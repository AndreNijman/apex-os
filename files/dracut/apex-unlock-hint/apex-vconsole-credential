#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
#  apex-vconsole-credential — make a per-machine console keymap reach the disk
#  unlock prompt on a machine whose initramfs is inside a SIGNED UKI.
#
#  ═══ THE PROBLEM THIS EXISTS FOR ═══
#
#  APEX's initramfs is built once, at image build time, `--no-hostonly`. Every
#  machine boots the same one, built before anybody chose a keyboard layout.
#  On an encrypted machine the passphrase prompt is drawn by that initramfs,
#  before any filesystem is mounted, so the layout it uses has to arrive from
#  outside it.
#
#  On the GRUB path that channel is the kernel command line: the installer
#  writes `vconsole.keymap=<name>` as a karg and systemd-vconsole-setup reads
#  it. That keeps working and this script deliberately does nothing when it is
#  present.
#
#  Under systemd-boot with UKIs the command line is INSIDE the signed PE image.
#  An installer cannot add a karg without breaking the signature, and it cannot
#  re-sign. The channel that survives is a systemd credential: sd-boot picks up
#  `\loader\credentials\*.cred` from the ESP and sd-stub hands them to the
#  initrd as system credentials. `systemd-vconsole-setup.service` already
#  carries `ImportCredential=vconsole.*`.
#
#  ═══ WHY THE CREDENTIAL IS NOT ENOUGH ON ITS OWN ═══
#
#  MEASURED, and it is the whole reason this file exists. systemd-vconsole-
#  setup(8): "The matching options in vconsole.conf and on the kernel command
#  line take precedence over these credentials." APEX's image ships
#  /etc/vconsole.conf with KEYMAP=us, dracut's i18n module copies that file
#  INTO the initramfs, and so the credential loses to a baked-in `us` on every
#  machine. A .cred on the ESP with no help is inert.
#
#  So this runs before systemd-vconsole-setup and writes the credential's value
#  into the initramfs's own /etc/vconsole.conf — a tmpfs that exists for the
#  length of the boot. Nothing on any disk is touched; the installed system's
#  /etc/vconsole.conf is a different file and is written by apex-install.
#
#  PRECEDENCE, preserved exactly: kernel command line > vconsole.conf as the
#  admin wrote it > credential. The first line below is what keeps the command
#  line on top.
# ─────────────────────────────────────────────────────────────────────────────

say() {
    printf '<6>apex-vconsole-credential: %s\n' "$*" > /dev/kmsg 2>/dev/null || true
}

# The kernel command line wins, and it wins by RETURNING, not by being ordered
# last. `grep -q` is avoided on purpose: under `pipefail` a matching `grep -q`
# can exit 141 because the writer takes SIGPIPE, which would read here as "no
# such argument" and quietly demote the command line.
for w in $(cat /proc/cmdline 2>/dev/null); do
    case "$w" in
        vconsole.keymap=*|rd.vconsole.keymap=*)
            say "kernel command line already sets $w — leaving it alone"
            exit 0 ;;
    esac
done

# System credentials land here: sd-stub passes them to PID 1, which unpacks
# them under /run/credentials/@system. The per-unit ImportCredential= copy is
# not usable from here, because this is a different unit.
CRED=/run/credentials/@system/vconsole.keymap
if [ ! -r "$CRED" ]; then
    exit 0
fi

KEYMAP=$(tr -d '\r\n' < "$CRED" 2>/dev/null)

# This string becomes an argument to `loadkeys`. It is read from the ESP, which
# on a machine without Secure Boot is writable by anyone who can reach the
# disk, so it is validated rather than trusted: keymap names are letters,
# digits and `-_.` and nothing else. A name that fails this is reported and
# dropped — never passed on, never silently corrected.
case "$KEYMAP" in
    "")                       say "credential is empty — ignored"; exit 0 ;;
    *[!A-Za-z0-9_.-]*)        say "credential '$KEYMAP' has characters a keymap name cannot have — ignored"; exit 0 ;;
    -*)                       say "credential '$KEYMAP' starts with a dash — ignored"; exit 0 ;;
esac

# The initramfs's own /etc, which is a tmpfs. KEYMAP= is replaced if present
# and appended if not, and everything else in the file (FONT=, KEYMAP_TOGGLE=)
# is left exactly as the image built it.
CONF=/etc/vconsole.conf
if [ -f "$CONF" ] && grep -v '^KEYMAP=' "$CONF" > "$CONF.apexnew" 2>/dev/null; then
    :
else
    : > "$CONF.apexnew"
fi
printf 'KEYMAP=%s\n' "$KEYMAP" >> "$CONF.apexnew"
if mv -f "$CONF.apexnew" "$CONF" 2>/dev/null; then
    say "applied credential keymap '$KEYMAP' to the initramfs $CONF"
else
    rm -f "$CONF.apexnew" 2>/dev/null
    say "could not write $CONF — keymap '$KEYMAP' NOT applied"
fi
exit 0
