[Unit]
Description=APEX per-machine console keymap from a systemd credential
Documentation=man:systemd-vconsole-setup.service(8) man:vconsole.conf(5)
DefaultDependencies=no
# BEFORE, and it is the only thing that makes this work: systemd-vconsole-setup
# reads /etc/vconsole.conf when it starts, so a credential applied afterwards
# would be a file nobody reads.
Before=systemd-vconsole-setup.service
Before=sysinit.target
Before=cryptsetup.target
Conflicts=shutdown.target
Before=shutdown.target
# No condition on the credential file: the script's own first job is to check
# whether the kernel command line already decided, and a ConditionPathExists=
# here would make that check unreachable on the machines that need it least
# while costing the same process everywhere else.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/apex-vconsole-credential
StandardOutput=kmsg
StandardError=kmsg

[Install]
WantedBy=sysinit.target
