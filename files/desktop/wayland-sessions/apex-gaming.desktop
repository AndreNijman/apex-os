[Desktop Entry]
Name=APEX Gaming Mode
Comment=Steam Big Picture in gamescope — no desktop, no compositing over the game
Exec=/usr/libexec/apex-gaming-session
# gamescope and Steam are on-demand packages (`apex install gamescope steam`),
# not image content, so this entry must not be offered on a machine that does
# not have them: apex-gaming-session would exit straight back to the greeter.
# TryExec is the desktop-entry spec's own mechanism for that, and apex-greet's
# session enumeration honours it — the entry is invisible until the binary
# exists and appears by itself once it does.
TryExec=/usr/bin/gamescope
Type=Application
DesktopNames=gamescope
Keywords=game;gaming;steam;bigpicture;gamescope;
