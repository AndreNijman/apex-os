[Desktop Entry]
Name=Rime Safe Graphics
Comment=A minimal desktop with software rendering, for when the normal one will not start
# NAME IS A PRODUCT NAME, NOT THE COMPOSITOR'S — the same rule
# rime-labwc.desktop states at length. This session is labwc too, and
# tests/test-rime-greet-sessions.sh fails the build if any shipped session name
# carries an implementation token.
#
# Roadmap P2-018. What makes this a recovery session rather than a second
# desktop is `labwc -C /usr/share/rime/safe-graphics` inside the Exec: a baked
# config directory, so nothing here reads ~/.config/labwc — the file
# rime-input-apply splices into and rime-labwc-keybinds generates into, and
# therefore the file that can be the reason the normal session did not paint.
#
# TryExec, for the reason rime-gaming.desktop gives: the entry must not be
# offered on a machine where it cannot start. Unlike Gaming Mode this one is
# image content and the binary is always there — which is the point of pinning
# it anyway, because an entry that vanished would be the visible symptom of the
# session helper being lost from an image build.
Exec=/usr/libexec/rime-safe-graphics
TryExec=/usr/libexec/rime-safe-graphics
Type=Application
DesktopNames=labwc
Keywords=recovery;safe;rescue;software;rendering;failsafe;
