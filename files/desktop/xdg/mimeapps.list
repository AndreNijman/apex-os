# APEX-OS system-wide default applications.
# Firefox is the only browser baked into the base, and the plan makes it the
# default (Chrome is not shipped on APEX-OS). Setting the handlers here means any
# "open this URL" resolves to Firefox without a per-user round-trip.
[Default Applications]
x-scheme-handler/http=firefox.desktop
x-scheme-handler/https=firefox.desktop
x-scheme-handler/about=firefox.desktop
x-scheme-handler/unknown=firefox.desktop
text/html=firefox.desktop
application/xhtml+xml=firefox.desktop
