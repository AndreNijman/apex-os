<?xml version="1.0" encoding="UTF-8"?>
<!--
  APEX-OS — labwc root menu (seeded per-user by apex-shell-firstrun).

  This is the EMERGENCY menu, not the desktop menu. A plain right-click on the
  desktop opens the APEX QML context menu (see the Root mousebind in rc.xml);
  this one is reached with SUPER+right-click and exists for exactly one case:
  APEX Shell is not running and could not be restarted, so the QML menu cannot
  appear.

  Kept short on purpose. APEX Shell owns the launcher, the settings pages and
  the power menu; every entry here is either a way to get the shell back or a
  way to leave the session.
-->
<openbox_menu>
  <menu id="root-menu" label="APEX">
    <item label="Terminal">
      <action name="Execute" command="alacritty"/>
    </item>
    <item label="App launcher">
      <action name="Execute" command="apex shell launcher"/>
    </item>
    <item label="Settings">
      <action name="Execute" command="apex shell settings"/>
    </item>
    <separator/>
    <item label="Restart APEX Shell">
      <action name="Execute" command="/usr/libexec/apex-shell-autostart"/>
    </item>
    <item label="Reload labwc config">
      <action name="Reconfigure"/>
    </item>
    <separator/>
    <item label="Lock">
      <action name="Execute" command="apex shell lock"/>
    </item>
    <item label="Log out">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
