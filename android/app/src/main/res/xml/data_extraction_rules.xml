<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves this app. The sealed device key is only useful together with
  the keystore key that unseals it, and that one cannot be backed up; a copy of
  the ciphertext elsewhere is therefore all cost and no benefit.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
