# ─────────────────────────────────────────────────────────────────────────────
#  APEX boot lab
#
#  §22's migration sequence step 2 is "prototype composefs/systemd-boot in CI
#  and virtual machines". This is that environment, as a container rather than
#  as packages on a host: `ukify`, `qemu`, `sbsign` and `swtpm` are build-time
#  tooling, and installing them onto an APEX box would be exactly the machine
#  drift AGENTS.md prohibits — most temptingly on the build box, which is a real
#  APEX machine too.
#
#  Everything it produces lands in a bind-mounted work directory. It never sees
#  the host's ESP; see the boot-path rules in AGENTS.md.
#
#  Run it with:
#    podman run --rm --device /dev/kvm -v "$PWD:/work" apex-bootlab <cmd>
#
#  /dev/kvm is a device pass-through, not a privilege: the container stays
#  unprivileged and the guest is a normal qemu process.
# ─────────────────────────────────────────────────────────────────────────────
FROM registry.fedoraproject.org/fedora:43

# Pinned by name here and resolved once per build. The lab is a test harness,
# so a newer qemu arriving is a signal worth seeing rather than a regression to
# hide behind a lockfile — but the image digest is what CI carries forward, so a
# long run cannot pick up a newer toolchain halfway through.
RUN dnf -y install --setopt=install_weak_deps=False \
        qemu-kvm qemu-system-x86-core qemu-img \
        edk2-ovmf \
        systemd-ukify systemd-boot-unsigned systemd-udev \
        sbsigntools efitools openssl \
        dosfstools mtools parted e2fsprogs cryptsetup \
        swtpm swtpm-tools tpm2-tools \
        ostree rpm-ostree \
        python3 python3-pefile \
        jq file findutils procps-ng iproute socat \
        `# ── added for boot v2; every one of these was resolved by probing ──` \
        `# virt-fw-vars authors an OVMF varstore off-line: it is how the APEX` \
        `# certificate becomes PK/KEK/db with SecureBoot=on without an` \
        `# interactive firmware UI. signing/spike-d/enroll-vars.sh already` \
        `# depends on it; it was simply missing from this image.` \
        python3-virt-firmware \
        `# busybox is Fedora's statically linked build, so a cpio containing` \
        `# one file boots as a real userspace. The boot-counting scenarios run` \
        `# five sequential guests; a 386 MB APEX initramfs would make that` \
        `# minutes of I/O to prove a filename rename.` \
        busybox \
        `# cpio/zstd assemble and inspect initramfs images. gzip is in the` \
        `# base image; zstd is what dracut actually emits on Fedora 43.` \
        cpio zstd \
        `# A kernel and dracut so this image can produce a UKI with no APEX` \
        `# machine in reach — GitHub runners have neither an ostree deployment` \
        `# nor 5 GB of patience for an apex-os-core pull. The APEX-image path` \
        `# (apex-mkuki --from-root) stays the primary one and is what the` \
        `# katana runs; this is the CI stand-in, and docs/boot-v2.md says so.` \
        kernel-core dracut \
    && dnf clean all

# The guest firmware paths differ between Fedora releases often enough that
# discovering them at run time beats hardcoding: a missing OVMF is a clear
# failure here rather than a confusing qemu error later.
RUN set -eux; \
    test -f /usr/share/edk2/ovmf/OVMF_CODE.fd || \
    test -f /usr/share/edk2/ovmf/OVMF_CODE_4M.fd; \
    command -v ukify; \
    command -v sbsign; \
    command -v swtpm; \
    command -v qemu-system-x86_64; \
    \
    : '── Measured boot needs the 4 MB OVMF, and only the 4 MB OVMF ──'; \
    : 'Measured 2026-09-03: the 2 MB OVMF_CODE.secboot.fd does Secure Boot'; \
    : 'but has no TCG2 protocol, so sd-stub cannot measure, PCR 11 stays at'; \
    : '64 zeros and every TPM-bound unlock fails for a reason that reads as'; \
    : 'a broken PCR policy. F43 ships only qcow2 for the 4 MB layout, and'; \
    : 'virt-fw-vars edits raw varstores, so lib.sh converts both once.'; \
    test -f /usr/share/edk2/ovmf/OVMF_CODE_4M.secboot.qcow2; \
    test -f /usr/share/edk2/ovmf/OVMF_VARS_4M.qcow2; \
    command -v qemu-img; \
    \
    : '── the boot-v2 additions, asserted rather than assumed present ──'; \
    command -v virt-fw-vars; \
    command -v busybox; \
    command -v cpio; \
    command -v dracut; \
    test -x /usr/lib/systemd/systemd-measure; \
    test -x /usr/bin/systemd-cryptenroll; \
    test -f /usr/lib/systemd/boot/efi/systemd-bootx64.efi; \
    test -f /usr/lib/systemd/boot/efi/linuxx64.efi.stub; \
    \
    : '── exactly one kernel, and record which one. A second kernel would'; \
    : 'make "the kernel under test" ambiguous for every scenario below.'; \
    test "$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 1; \
    find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n' \
        > /etc/apex-bootlab-kver; \
    test -s /etc/apex-bootlab-kver; \
    test -f "/usr/lib/modules/$(cat /etc/apex-bootlab-kver)/vmlinuz"

WORKDIR /work
ENTRYPOINT ["/bin/bash"]
