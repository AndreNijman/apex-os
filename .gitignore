# Compiled / generated
*.qmlc
target/
node_modules/

# Build artifacts — disk and installer images (large, never versioned)
*.img
*.iso

# Signing material — PRIVATE KEYS NEVER IN REPO (see signing/README.md)
*.key
*.priv
*.pem
*.p12

# OS cruft
.DS_Store

# agent worktrees (transient)
.claude/
output/

# Byte-compiled artefacts. check-labwc-keybinds is run with py_compile during
# development; its cache must never ship in the image build context.
__pycache__/
*.pyc
