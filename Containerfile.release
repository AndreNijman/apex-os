# Fast final composition layer. Slow package, driver, akmod, Mesa and initramfs
# work lives in the platform image and is reused byte-for-byte.
ARG PLATFORM=ghcr.io/andrenijman/rime-os:platform-daily
FROM ${PLATFORM}

ARG RIME_SHELL_REF
ARG RIME_SHELL_STRICT=0

COPY --chmod=0644 files/scripts/vendor-rime-shell /tmp/vendor-rime-shell
RUN set -eux; \
    bash /tmp/vendor-rime-shell \
        "${RIME_SHELL_REF}" /usr/share/rime-shell "${RIME_SHELL_STRICT}"; \
    rm -f /tmp/vendor-rime-shell

RUN set -eux; \
    test -s /usr/share/rime-shell/shell.qml; \
    test "$(cat /usr/share/rime-shell/.rime-shell-commit)" = "${RIME_SHELL_REF}"; \
    grep -q '^VARIANT_ID=' /usr/lib/os-release; \
    test -s "/usr/lib/modules/$(cat /usr/lib/rime-kver)/initramfs.img"; \
    test "$(cat /usr/share/rime-os/secureboot/kernel-signed)" = signed; \
    bootc container lint || true

# The fast shell-only path does not compute a release ID (build-image.yml
# does, files/scripts/next-release-id), so it stamps "dev": its images carry a
# release.json with no notes URL, and Rime Shell opens no "what's new" page for
# them. Announce a release through build-image.yml.
ARG RIME_REVISION=dev
COPY --chmod=0755 files/scripts/stamp-release /tmp/stamp-release
RUN set -eux; \
    bash /tmp/stamp-release dev "${RIME_REVISION}" /; \
    rm -f /tmp/stamp-release

LABEL org.opencontainers.image.revision="${RIME_REVISION}" \
      org.rimeos.rime-shell.ref="${RIME_SHELL_REF}" \
      org.rimeos.release.kind="shell"
