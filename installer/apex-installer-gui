    # ── 7. run ───────────────────────────────────────────────────────────────
    def begin(self):
        self.go("run")

    def p_run(self):
        # A retry after failure re-enters here with the previous, dead process
        # still in self.proc — pulse() would see poll() != None and stop the
        # bar before the new engine even spawned. Reset first.
        self.proc = None
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        self.bar = Gtk.ProgressBar(show_text=False)
        self.bar.set_pulse_step(0.06)
        body.append(self.bar)
        self.run_state = lbl("Preparing…", "apex-mono")
        body.append(self.run_state)

        self.logview = Gtk.TextView(editable=False, cursor_visible=False,
                                    monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.logbuf = self.logview.get_buffer()
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.add_css_class("apex-card")
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.logview)
        self.logscroll = sc
        body.append(sc)
        body.append(lbl("Do not power off. Full log: /var/log/apex-install.log",
                        "apex-dim"))

        page = self.frame("INSTALLING", "Installing APEX-OS",
                          self.target if self.answers["mode"] == "partition" else self.disk,
                          body, [])
        GLib.idle_add(self.spawn_engine)
        GLib.timeout_add(120, self.pulse)
        return page

    def pulse(self):
        if self.stack.get_visible_child_name() != "run":
            return False  # left the run page (e.g. spawn failed) — stop the timer
        if self.proc is None or self.proc.poll() is None:
            self.bar.pulse()
            return True
        return False

    def append_log(self, text):
        end = self.logbuf.get_end_iter()
        self.logbuf.insert(end, text)
        mark = self.logbuf.create_mark(None, self.logbuf.get_end_iter(), False)
        self.logview.scroll_mark_onscreen(mark)
        self.logbuf.delete_mark(mark)

    def spawn_engine(self):
        """Hand the answers to the ONE install engine. The password goes via a
        0600 file, never argv — argv is world-readable in /proc."""
        a = dict(self.answers)
        a["disk"] = self.disk
        if a["mode"] == "partition":
            a["target"] = self.target
            a["esp"] = self.esp

        try:
            fd, path = tempfile.mkstemp(prefix="apex-answers-", dir="/run")
        except OSError as e:
            self.finish(False, f"Could not create the answers file in /run: {e}")
            return False
        self._answers_path = path  # set before writing so finish() cleans up
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w") as f:
                # mokpw is empty (or absent) when the user skipped enrolment or
                # Secure Boot is off — the get() guard omits it and the engine
                # skips the MOK step with an explanation.
                for k in ("mode", "disk", "target", "esp", "username", "password",
                          "hostname", "rootfs", "mokpw"):
                    if a.get(k):
                        f.write(f"{k}={a[k]}\n")
        except OSError as e:
            self.finish(False, f"Could not write the answers file: {e}")
            return False

        try:
            self.proc = subprocess.Popen(
                [ENGINE, "--headless", path],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                text=True, bufsize=1)
        except OSError as e:
            self.finish(False, f"Could not start the install engine: {e}")
            return False

        GLib.io_add_watch(self.proc.stdout, GLib.IO_IN | GLib.IO_HUP, self.on_output)
        return False

    def on_output(self, src, cond):
        line = src.readline()
        if line:
            self.append_log(line)
            s = line.strip()
            if s and not s.startswith("+"):
                self.run_state.set_text(s[:110])
            if "APEX-INSTALL-FAILED" in s:
                self.finish(False, s.split("APEX-INSTALL-FAILED:", 1)[-1].strip())
                return False
        if cond & GLib.IO_HUP or (self.proc and self.proc.poll() is not None):
            rc = self.proc.wait() if self.proc else 1
            # Drain anything buffered after HUP so a failure reason is never lost.
            try:
                for rest in src:
                    self.append_log(rest)
            except (ValueError, OSError):
                pass
            self.finish(rc == 0, "" if rc == 0 else f"The installer exited with status {rc}.")
            return False
        return True

    def finish(self, ok, err):
        # If the engine is somehow still alive (failure banner printed but the
        # process hung), stop it — "Try again" must never race a dying engine.
        if self.proc is not None and self.proc.poll() is None:
            try:
                self.proc.terminate()
            except OSError:
                pass
        # The answers file carries the password — remove it whatever happened.
        p = getattr(self, "_answers_path", None)
        if p:
            try:
                os.unlink(p)
            except OSError:
                pass
            self._answers_path = None
        self.ok, self.err = ok, err
        self.go("done")

    def _log_tail(self, lines=40):
        """Last lines of the install log: the live buffer from the run page
        when it has content, else /var/log/apex-install.log. Never raises."""
        text = ""
        buf = getattr(self, "logbuf", None)
        if buf is not None:
            text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        if not text.strip():
            try:
                with open("/var/log/apex-install.log", errors="replace") as f:
                    text = f.read()
            except OSError:
                return ""
        return "\n".join(text.splitlines()[-lines:])

    # ── 8. done ──────────────────────────────────────────────────────────────
    def p_done(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 3)
        ok = getattr(self, "ok", False)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        card.add_css_class("apex-card" if ok else "apex-warn")
        i = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=SP * 2)
        i.set_margin_top(SP * 5); i.set_margin_bottom(SP * 5)
        i.set_margin_start(SP * 5); i.set_margin_end(SP * 5)

        if ok:
            i.append(lbl("APEX-OS is installed.", "apex-accent"))
            if self.answers["mode"] == "partition":
                i.append(lbl(f"Installed into {self.target}. The other partitions "
                             f"on {self.disk} were not touched.", "apex-dim"))
            else:
                i.append(lbl(f"Installed on {self.disk}.", "apex-dim"))
            i.append(lbl(f"Log in as  {self.answers['username']}   ·   "
                         f"hostname  {self.answers['hostname']}", "apex-mono"))
            try:
                n = len([f for f in os.listdir("/etc/NetworkManager/system-connections")
                         if f.endswith(".nmconnection")])
            except OSError:
                n = 0
            if n:
                i.append(lbl(f"{n} saved network(s) carried over — Wi-Fi should "
                             f"work on first boot.", "apex-dim"))
        else:
            i.append(lbl("Installation failed.", "apex-danger"))
            i.append(lbl(getattr(self, "err", "") or "See the log for details.",
                         "apex-dim", sel=True))
            i.append(lbl("Nothing further will be written. The full log is at "
                         "/var/log/apex-install.log — switch to a shell with "
                         "Ctrl+Alt+F2 (root / apex) to read it.", "apex-dim"))
        card.append(i)
        body.append(card)

        if not ok:
            # Put the evidence on screen — do not make a stranded user go
            # hunting for a shell just to learn why it failed.
            tail = self._log_tail()
            if tail:
                view = Gtk.TextView(editable=False, cursor_visible=False,
                                    monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR)
                view.get_buffer().set_text(tail)
                sc = Gtk.ScrolledWindow(vexpand=True)
                sc.add_css_class("apex-card")
                sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
                sc.set_child(view)
                body.append(sc)

        acts = []
        if ok:
            acts.append((self.btn("Reboot now", "apex-go",
                                  lambda *_: run(["systemctl", "reboot"], timeout=30)), True))
            acts.insert(0, (self.btn("Stay in the installer", "apex-ghost",
                                     lambda *_: self.go("welcome")), False))
        else:
            acts.append((self.btn("Quit", "apex-ghost", lambda *_: self.quit()), False))
            acts.append((self.btn("Try again", "apex-go", lambda *_: self.go("welcome")), True))

        return self.frame("DONE" if ok else "FAILED",
                          "Installation complete" if ok else "Installation failed",
                          None, body, acts)


if __name__ == "__main__":
    Installer().run(None)
