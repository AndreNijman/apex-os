    # ── 5b. secure boot — shown only when the firmware has it enabled ────────
    def sb_enabled(self):
        """True when the firmware reports Secure Boot enabled. mokutil missing,
        failing or timing out means we cannot know — treat as off and never
        block the flow on it. Cached: firmware state cannot change while the
        installer is running."""
        if not hasattr(self, "_sb_state"):
            rc, txt = run(["mokutil", "--sb-state"], timeout=10)
            self._sb_state = "enabled" in txt.lower()
        return self._sb_state

