        def nxt(_b):
            u = self.e_user.get_text().strip()
            h = self.e_host.get_text().strip()
            p1, p2 = self.e_pw1.get_text(), self.e_pw2.get_text()
            if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", u):
                self.acct_err.set_text(
                    "Username must be lowercase letters, digits, - or _, start with "
                    "a letter or _, and be at most 32 characters.")
                return
            if u in RESERVED or u.startswith("systemd-"):
                self.acct_err.set_text(f"'{u}' is a reserved system account.")
                return
            if not p1:
                self.acct_err.set_text("Password cannot be empty.")
                return
            if p1 != p2:
                self.acct_err.set_text("The two passwords do not match.")
                return
            if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9-]{0,62}", h):
                self.acct_err.set_text(
                    "Computer name must be letters, digits and hyphens only.")
                return
