SP = 4  # base spacing unit; every gap below is a multiple


def lbl(text, css=None, xalign=0.0, wrap=True, sel=False):
    w = Gtk.Label(label=text, xalign=xalign, wrap=wrap, selectable=sel)
    w.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if css:
        for c in css.split():
            w.add_css_class(c)
    return w


class Installer(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.apexos.Installer",
                         flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.connect("activate", self.startup)
        self.ed = edition()
        self.accent = ACCENTS.get(self.ed, ACCENTS["daily"])
        self.answers = {"mode": "disk", "rootfs": "btrfs"}
        self.disk = None
        self.target = None
        self.esp = ""
        self.proc = None

    # ── shell ────────────────────────────────────────────────────────────────
    def startup(self, _app):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.format(bg=BG, surface=SURFACE, raised=RAISED,
                                       text=TEXT, accent=self.accent,
                                       danger=DANGER).encode())
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        # ── Text scale on high-density panels ────────────────────────────────
        # cage does no output scaling, so on a 13" 3840x2160 laptop panel every
        # control renders at a quarter of its intended size. That is not a
        # crash, so nothing else catches it, and the person in front of it
        # cannot read the installer well enough to use it.
        #
        # This has to happen HERE, in-process, and not via GDK_SCALE in the
        # launcher. Measured on the exact GTK this image ships (4.20.4):
        # GDK_SCALE is honoured on the X11 backend and IGNORED on Wayland,
        # where the scale comes from the compositor — and we run on Wayland
        # under cage. gtk-xft-dpi is a GtkSettings property, so it applies on
        # any backend; it scales text, which is the part that has to be
        # legible. The launcher measures the panel and passes the width; the
        # decision lives here so it can act on it.

        # ── Short panels ─────────────────────────────────────────────────────
        # 1024x600 netbooks and 800x600 firmware fallback modes are real, and on
        # them this installer's generous vertical rhythm stops being generous
        # and starts hiding things. Measured on the confirm page at 1024x600:
        # GTK could not fit its 611px minimum, so it squashed the partition
        # inventory to about two rows and the ERASED row — the partition being
        # destroyed — fell below the fold. That is the exact failure this page
        # was written to prevent whiptail from committing, reappearing in a
        # different form.
        #
        # So measure the panel and tighten the layout when it is short, rather
        # than letting GTK silently decide what to squash.
        try:
            pw = int(os.environ.get("APEX_PANEL_WIDTH", "0"))
        except ValueError:
            pw = 0
        if pw >= 2560:
            st = Gtk.Settings.get_default()
            if st is not None:
                # gtk-xft-dpi is in 1024ths of a point; 96*1024 is the default.
                st.set_property("gtk-xft-dpi", 96 * 1024 * 2)

        self.win = Adw.ApplicationWindow(application=self)
        self.win.set_title("APEX-OS Installer")
        self.win.set_default_size(1024, 700)
        self.win.fullscreen()
        self.win.add_css_class("apex-bg")

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE,
                               transition_duration=200)
        self.win.set_content(self.stack)

        for name, build in (("welcome", self.p_welcome), ("wifi", self.p_wifi),
                            ("disk", self.p_disk), ("mode", self.p_mode),
                            ("part", self.p_part), ("account", self.p_account),
                            ("secureboot", self.p_secureboot),
                            ("confirm", self.p_confirm), ("run", self.p_run),
                            ("done", self.p_done)):
            self.stack.add_named(Gtk.Box(), name)
        self.builders = {"welcome": self.p_welcome, "wifi": self.p_wifi,
                         "disk": self.p_disk, "mode": self.p_mode,
                         "part": self.p_part, "account": self.p_account,
                         "secureboot": self.p_secureboot,
                         "confirm": self.p_confirm, "run": self.p_run,
                         "done": self.p_done}
        # Test affordance: jump straight to a page for screenshotting. Only
        # reachable by setting the env var explicitly; harmless in production.
        start = os.environ.get("APEX_GUI_PAGE", "welcome")
        if start != "welcome":
            self.disk = os.environ.get("APEX_GUI_DISK", "")
            self.target = os.environ.get("APEX_GUI_TARGET", "") or None
            self.esp = os.environ.get("APEX_GUI_ESP", "")
            self.answers.setdefault("username", "andre")
            self.answers.setdefault("hostname", "apex")
            self.answers["mode"] = os.environ.get("APEX_GUI_MODE", "disk")
            self.ok = os.environ.get("APEX_GUI_OK", "") == "1"
        self.go(start)
        self.win.present()

    def go(self, name):
        """Rebuild on entry — every page reflects state chosen on earlier pages."""
        page = self.builders[name]()
        old = self.stack.get_child_by_name(name)
        if old:
            self.stack.remove(old)
        self.stack.add_named(page, name)
        self.stack.set_visible_child_name(name)

    def is_compact(self):
        """True on a panel too short for the full vertical rhythm.

        Asked per page rather than once at startup: probing the monitor list in
        `activate` returned nothing under a headless compositor, so a
        startup-time flag silently stayed False and the tightening never
        happened. By the time a page is built the window is mapped and
        fullscreened, so its own allocated height is the reliable number, with
        the monitor geometry only as a fallback for the very first page.
        """
        try:
            h = self.win.get_height()
            if h > 0:
                return h < 700
        except Exception:
            pass
        try:
            mons = Gdk.Display.get_default().get_monitors()
            hs = [mons.get_item(i).get_geometry().height
                  for i in range(mons.get_n_items())]
            if hs:
                return min(hs) < 700
        except Exception:
            pass
        return False

    def scrolled(self, body):
        """Wrap a page body so it can never push the action row off-screen.

        The action row is the only way forward, so a page that overflows the
        panel is a stranded user — and there is no text installer to escape to
        any more. Pages with a list already bring their own scroller; this is
        for the FORM pages, whose fixed content is tall enough to overflow a
        1024x600 netbook or an 800x600 firmware fallback mode. Measured: the
        account page lands around 700px and the Secure Boot page (three
        paragraphs, two entries, a three-button row) was trimmed to fit exactly
        720px, so both clip below that.

        Do not wrap a body that already contains a ScrolledWindow — a scroller
        inside a scroller gets unbounded natural height and the inner list
        grows forever instead of scrolling.
        """
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_propagate_natural_height(True)
        sc.set_child(body)
        return sc

    def frame(self, step, title, subtitle, body, actions):
        """Every page: step marker, title, subtitle, body, action row.
        Consistent structure is what makes an installer feel trustworthy."""
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.add_css_class("apex-bg")
        clamp = Adw.Clamp(maximum_size=780, tightening_threshold=680)
        # Vertical chrome is the first thing to give on a short panel: the
        # generous top margin is presentation, the action row is function.
        _tight = self.is_compact()
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                      spacing=SP * (2 if _tight else 4))
        col.set_margin_top(SP * (4 if _tight else 14))
        col.set_margin_bottom(SP * (3 if _tight else 8))
        col.set_margin_start(SP * 6); col.set_margin_end(SP * 6)
        col.set_valign(Gtk.Align.FILL)

        ed_name = {"daily": "DAILY", "gaming-nvidia": "GAMING",
                   "gaming-mesa": "GAMING"}.get(self.ed, self.ed.upper())
        col.append(lbl(f"APEX-OS  {ed_name}   ·   {step}", "apex-step"))
        col.append(lbl(title, "apex-title"))
        if subtitle:
            col.append(lbl(subtitle, "apex-sub"))

        body.set_vexpand(True)
        body.set_margin_top(SP * (1 if _tight else 3))
        col.append(body)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=SP * 3)
        row.set_margin_top(SP * 4)
        row.set_halign(Gtk.Align.FILL)
        for w, end in actions:
            if end:
                w.set_hexpand(False)
                spacer = Gtk.Box(hexpand=True)
                if not any(getattr(c, "_spacer", False) for c in row):
                    spacer._spacer = True
                    row.append(spacer)
            row.append(w)
        col.append(row)
        clamp.set_child(col)
