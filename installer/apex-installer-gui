        i.append(lbl("APEX-OS ships its own kernel. Microsoft does not sign it — "
                     "it is signed with the APEX key. Until your firmware is told "
                     "to trust that key, it will refuse to boot the installed "
                     "system.", "apex-dim"))
        i.append(lbl("Enrolling the key happens once. Choose a password now. On "
                     "the next boot a blue \"MOK management\" screen appears — "
                     "choose \"Enroll MOK\" and type this password. That screen "
                     "is the firmware checking a person is physically present. "
                     "After that the password is never needed again.", "apex-dim"))
        card.append(i)
        body.append(card)

        # Placeholder-only entries (the wifi page's pattern) — with the
        # explanation card above, captioned rows push the action row off a
