        self.e_mok1 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_mok2 = Gtk.PasswordEntry(show_peek_icon=True)
        self.e_mok1.set_property("placeholder-text", "One-time enrolment password")
        self.e_mok2.set_property("placeholder-text", "Repeat password")
        body.append(self.e_mok1)
        body.append(self.e_mok2)
        self.mok_err = lbl("", "apex-danger")
        body.append(self.mok_err)
        body.append(lbl("If you skip, the installed system will not boot until "
                        "you turn Secure Boot off in firmware setup.", "apex-dim"))

        def nxt(_b):
            p1, p2 = self.e_mok1.get_text(), self.e_mok2.get_text()
            if not p1:
                self.mok_err.set_text(
                    "Choose a password, or skip if you will turn Secure Boot "
