#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  apex-install — APEX-OS guided installer
#
#  A deliberately small, transparent alternative to Anaconda. Runs in the live
#  environment and installs the embedded APEX-OS image to a disk YOU choose,
#  using `bootc install to-disk` (bootupd static bootloader — NOT grub2-mkconfig,
#  which is what silently killed the Anaconda install; see apex-logs 40).
#
#  Design rules:
#   1. It can NEVER fail silently. Every step logs to the screen and to
#      /var/log/apex-install.log; on ANY error it shows the exact message + the
#      log path and refuses to report success.
#   2. It NEVER writes a disk you didn't explicitly choose and confirm. The live
#      boot device is excluded; you pick the target, review it, and type ERASE.
#   3. Three screens: disk → account → confirm. Then a live progress view.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

LOG=/var/log/apex-install.log
: > "$LOG" 2>/dev/null || LOG=/tmp/apex-install.log
BT="APEX-OS Installer"
# The image to install. The live env preloads it into podman storage as this ref
# (see the ISO build); override with APEX_IMAGE=... for testing.
IMAGE="${APEX_IMAGE:-localhost/apex-os:daily}"
ROOTFS_TYPE="${APEX_ROOTFS:-btrfs}"

log()  { printf '%s %s\n' "$(date +%T)" "$*" >>"$LOG"; }
have() { command -v "$1" >/dev/null 2>&1; }
UI=whiptail; have whiptail || UI=dialog

msg()  { $UI --backtitle "$BT" --title "$1" --msgbox "$2" "${3:-16}" "${4:-72}"; }
yn()   { $UI --backtitle "$BT" --title "$1" --yesno "$2" "${3:-16}" "${4:-72}"; }

# fail-loud: show the exact reason + log path, then drop to a shell option.
die() {
  log "FATAL: $1"
  $UI --backtitle "$BT" --title "✗ Installation failed" --msgbox \
"$1

Nothing further was written. The full log is at:
  $LOG

Press OK, then choose a shell to inspect (Ctrl+Alt+F2), or power off and retry.
Your other disks were not touched." 20 74
  exit 1
}
trap 'die "Unexpected error on line $LINENO (see log). This is a bug in the installer, not a silent failure."' ERR

# ── preflight ────────────────────────────────────────────────────────────────
[ "$(id -u)" = 0 ] || die "apex-install must run as root."
have podman || die "podman is missing from the live environment."
if ! podman image exists "$IMAGE" 2>/dev/null && [ ! -e /run/install/repo/container ]; then
  die "The APEX-OS image ($IMAGE) is not present in the live environment."
fi

yn "Welcome to APEX-OS" \
"This installs APEX-OS to a disk you choose.

Steps: pick the target disk → create your account → confirm.
Nothing is erased until you confirm. Your account is created for you (no
locked-out first boot).

Continue?" 16 70 || { clear; echo "Installer cancelled."; exit 0; }

# ── 1. target disk (guarded) ─────────────────────────────────────────────────
# Identify the live/boot device so we never offer it as a target.
live_src=$(findmnt -no SOURCE / 2>/dev/null || true)          # e.g. /dev/mapper/live-rw or overlay
boot_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /run/initramfs/live 2>/dev/null)" 2>/dev/null | head -1)
usb_boot=$(lsblk -o NAME,MOUNTPOINT,RM -rn 2>/dev/null | awk '$2 ~ /live|install|ISO/ {print $1}' | head -1)

menu=(); count=0
while read -r name size model tran rm; do
  [ -z "$name" ] && continue
  dev="/dev/$name"
  # Exclude the disk we booted from.
  if [ -n "$boot_disk" ] && [ "$name" = "$boot_disk" ]; then continue; fi
  case " $usb_boot " in *" $name "*) continue;; esac
  label="$size  ${model:-disk}  [${tran:-?}$([ "$rm" = 1 ] && echo ,removable)]"
  menu+=("$dev" "$label"); count=$((count+1))
done < <(lsblk -dn -o NAME,SIZE,MODEL,TRAN,RM -e 7,11 2>/dev/null)

[ "$count" -gt 0 ] || die "No eligible target disks were found (the live/boot device is excluded)."

DISK=$($UI --backtitle "$BT" --title "Select the target disk" --menu \
"Choose the disk to install APEX-OS on. EVERYTHING on it will be erased.
(The disk you booted from is not listed.)" 20 74 "$count" "${menu[@]}" 3>&1 1>&2 2>&3) \
  || { clear; echo "Cancelled."; exit 0; }

# Hard guard: refuse anything that isn't a whole block device, or that backs a mount now.
[ -b "$DISK" ] || die "$DISK is not a block device."
if findmnt -rno SOURCE | grep -q "^$DISK"; then die "$DISK (or a partition of it) is currently mounted — refusing."; fi

# ── 2. account ───────────────────────────────────────────────────────────────
USERNAME=$($UI --backtitle "$BT" --title "Create your account" --inputbox \
"Username (lowercase, no spaces):" 10 60 "andre" 3>&1 1>&2 2>&3) || exit 0
USERNAME=$(echo "$USERNAME" | tr -d '[:space:]')
[ -n "$USERNAME" ] || die "Username cannot be empty."

while :; do
  P1=$($UI --backtitle "$BT" --title "Password" --passwordbox "Password for $USERNAME:" 10 60 3>&1 1>&2 2>&3) || exit 0
  P2=$($UI --backtitle "$BT" --title "Password" --passwordbox "Confirm password:" 10 60 3>&1 1>&2 2>&3) || exit 0
  [ -n "$P1" ] || { msg "Password" "Password cannot be empty."; continue; }
  [ "$P1" = "$P2" ] || { msg "Password" "Passwords did not match — try again."; continue; }
  break
done

HOSTNAME=$($UI --backtitle "$BT" --title "Hostname" --inputbox "Computer name:" 10 60 "apex" 3>&1 1>&2 2>&3) || exit 0
HOSTNAME=$(echo "$HOSTNAME" | tr -d '[:space:]'); [ -n "$HOSTNAME" ] || HOSTNAME=apex

# ── 3. confirm (show what will be destroyed; require typed ERASE) ─────────────
disk_info=$(lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT "$DISK" 2>/dev/null)
yn "⚠  Final confirmation" \
"About to ERASE and install to:

$disk_info

User:     $USERNAME   (administrator)
Hostname: $HOSTNAME
Filesystem: $ROOTFS_TYPE

ALL DATA ON $DISK WILL BE PERMANENTLY LOST.
Proceed?" 20 74 || { clear; echo "Cancelled — nothing was written."; exit 0; }

TYPED=$($UI --backtitle "$BT" --title "Type to confirm" --inputbox \
"To confirm erasing $DISK, type:  ERASE" 10 60 "" 3>&1 1>&2 2>&3) || exit 0
[ "$TYPED" = "ERASE" ] || die "Confirmation text did not match ERASE — aborted before writing anything."

# ── 4. install (bootc install to-disk via the embedded image; stream to log) ──
clear
echo "Installing APEX-OS to $DISK … (full log: $LOG)"; echo
log "install start: DISK=$DISK USER=$USERNAME HOST=$HOSTNAME IMAGE=$IMAGE FS=$ROOTFS_TYPE"

set +e
podman run --rm --privileged --pid=host --security-opt label=disable \
  -v /var/lib/containers:/var/lib/containers -v /dev:/dev \
  "$IMAGE" \
  bootc install to-disk --wipe --filesystem "$ROOTFS_TYPE" \
    --karg quiet --karg splash "$DISK" 2>&1 | tee -a "$LOG"
rc=${PIPESTATUS[0]}
set -e
[ "$rc" = 0 ] || die "bootc install exited $rc. The exact error is above and in $LOG (search for 'error:'). No boot config was left half-written by grub2-mkconfig — bootc uses bootupd."

# ── 5. create the account in the freshly installed system ─────────────────────
echo; echo "Creating your account …"; log "post-install: create user $USERNAME"
MNT=$(mktemp -d)
part=$(lsblk -rno NAME "$DISK" | tail -1); root_part="/dev/$part"
mount "$root_part" "$MNT" 2>>"$LOG" || die "Could not mount the new root ($root_part) to create your account."
# ostree layout: the deployed root is the newest dir under ostree/deploy/*/deploy/*.0
deploy=$(ls -d "$MNT"/ostree/deploy/*/deploy/*.0 2>/dev/null | head -1)
[ -n "$deploy" ] || { umount "$MNT"; die "Installed ostree deployment not found under $root_part."; }
# useradd/chpasswd against the deployment's /etc; homes live in /var/home (bootc).
mkdir -p "$MNT"/deploy_var 2>/dev/null || true
chroot_root="$deploy"
useradd --root "$chroot_root" -m -G wheel -s /bin/bash "$USERNAME" 2>>"$LOG" \
  || die "useradd failed for $USERNAME (see $LOG)."
echo "$USERNAME:$P1" | chpasswd --root "$chroot_root" 2>>"$LOG" \
  || die "Setting the password failed (see $LOG)."
echo "$HOSTNAME" > "$chroot_root/etc/hostname" 2>>"$LOG" || true
sync; umount "$MNT" 2>/dev/null; rmdir "$MNT" 2>/dev/null || true
log "post-install: user $USERNAME created, hostname=$HOSTNAME"

# ── 6. done ──────────────────────────────────────────────────────────────────
msg "✓ Installation complete" \
"APEX-OS is installed on $DISK.

Log in as: $USERNAME
Hostname:  $HOSTNAME

Remove the USB stick and reboot. On first login the shell finishes setting
itself up (needs network the first time).

Full log: $LOG" 18 74
clear
echo "APEX-OS installed. Remove the USB and reboot."
