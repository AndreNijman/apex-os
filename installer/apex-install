#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  apex-install — the APEX-OS install ENGINE
#
#  A deliberately small, transparent alternative to Anaconda. Runs in the live
#  environment and installs the embedded APEX-OS image to the disk the user
#  chose, using `bootc install to-disk` (bootupd static bootloader — NOT
#  grub2-mkconfig, which is what silently killed the Anaconda install; see
#  apex-logs 40).
#
#  This file is an ENGINE, not a user interface. It used to double as a
#  whiptail text UI, reached as a fallback whenever the graphical installer
#  failed to start — and that fallback is exactly where real users kept getting
#  stranded, so the text UI was deleted outright (not hidden behind a flag;
#  a hidden path nobody tests is how the stranding happened). There are exactly
#  two ways to run this engine:
#
#    apex-install --headless ANSWERS   driven by the graphical front end
#                                      (apex-installer-gui, started via
#                                      apex-installer-launch). The GUI collects
#                                      the answers, then reads this engine's
#                                      stdout line by line as status text.
#                                      Final-line protocol: `APEX-INSTALL-OK`
#                                      on total success, `APEX-INSTALL-FAILED:
#                                      <reason>` on any failure.
#    apex.unattended (kernel cmdline)  TEST/CI only — see the marker-file gate
#                                      below.
#
#  Run with no arguments it refuses (exit 2) and points at the graphical
#  installer. It never prompts for anything.
#
#  Design rules:
#   1. It can NEVER fail silently. Every step goes to stdout and to
#      /var/log/apex-install.log; on ANY error it emits the exact message + the
#      log path and refuses to report success.
#   2. It NEVER writes a disk the user didn't explicitly choose and confirm in
#      the front end — and it does not trust the front end: every disk guard
#      (live/boot device mounted, LVM/LUKS/RAID membership, ESP checks) is
#      re-validated here before anything is written.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

LOG=/var/log/apex-install.log
: > "$LOG" 2>/dev/null || LOG=/tmp/apex-install.log
# Which edition this ISO carries. build-live-iso.sh stamps it; a missing stamp
# means an old ISO, so fall back to daily.
#
# This MUST drive TARGET_IMAGE. It is not cosmetic: TARGET_IMAGE is written into
# the installed system as its `bootc upgrade` origin. A Gaming ISO that recorded
# the daily origin would install correctly and then SILENTLY convert itself to
# Daily on the first upgrade — dropping the NVIDIA driver on a machine that
# needs it to display anything. Caught before the first Katana flash.
EDITION="${APEX_EDITION:-$(cat /usr/lib/apex-installer/edition 2>/dev/null || echo daily)}"
# The image to install. The live env preloads it into podman storage as this ref
# (see the ISO build); override with APEX_IMAGE=... for testing.
IMAGE="${APEX_IMAGE:-localhost/apex-os:${EDITION}}"
# Update origin recorded in the INSTALLED system (so `bootc upgrade` works).
TARGET_IMAGE="${APEX_TARGET_IMAGE:-ghcr.io/andrenijman/apex-os:${EDITION}}"
ROOTFS_TYPE="${APEX_ROOTFS:-btrfs}"

# NETWORK INSTALL. The full ISO embeds the OS image twice (an OCI dir on the ISO
# and a copy in the live env's container storage) so an install needs no network
# at all — but that is what makes it 12 GB, which is too big to publish anywhere
# convenient and far too big to download casually. The netinstall ISO ships the
# live environment only, about a tenth of the size, and pulls the OS from the
# public registry while the user watches. build-live-iso.sh writes this marker
# when it builds one.
NETINSTALL=0
[ -f /usr/lib/apex-installer/netinstall ] && NETINSTALL=1

# On the live ISO the image is ALSO present as an OCI directory (ISO /container,
# mounted at /run/initramfs/live/container). Prefer it as the bootc install
# source: the oci transport streams blobs straight off the read-only ISO,
# whereas containers-storage re-tars every layer into the container's /var/tmp
# — which lives in the RAM-backed live overlay and overflows on 4G machines.
# Absent (e.g. plain-host testing) we fall back to the embedded storage image.
OCI_DIR="${APEX_OCI_DIR:-/run/initramfs/live/container}"
SRC_VOL=(); SRC_ARGS=()
if [ -d "$OCI_DIR" ]; then
  SRC_VOL=(-v "$OCI_DIR":/run/apex-oci:ro)
  # --target-imgref is what the INSTALLED system records as its update origin.
  # It must be the real registry, not the live env's local tag: with
  # `localhost/apex-os:daily` baked in, `bootc upgrade` fails permanently on the
  # installed machine (nothing to pull from).
  SRC_ARGS=(--source-imgref "oci:/run/apex-oci" --target-imgref "$TARGET_IMAGE")
fi

# `|| true`: a full RAM disk (or an unwritable log) must never trip the ERR trap
# and turn a fine install into a reported failure.
log()  { printf '%s %s\n' "$(date +%T)" "$*" >>"$LOG" 2>/dev/null || true; }
have() { command -v "$1" >/dev/null 2>&1; }

# note(): the engine's ONE user-facing output primitive — stdout plus the log.
# stdout is read line by line by the graphical front end (which shows the last
# line as its status text), or lands on the serial console in CI, so everything
# worth telling the user goes through here. This replaced the whiptail
# msg()/yn() dialogs when the text UI was deleted; newt/whiptail is no longer
# in the installer image, so any surviving dialog call would be a
# command-not-found (127) — under the ERR trap, a reported FAILURE on a machine
# that may in fact be installed fine.
# `|| true` on the printf: note() MUST NOT propagate a non-zero status. A
# closed stdout (front end died mid-run) is not an install failure, and note()
# is used as a non-final command in contexts the ERR trap does not exempt —
# the same crash class msg() once shipped ("Unexpected error on line 223").
# SECRETS: note() logs its argument verbatim — never pass it (or log) P1/MOKPW.
note() { printf '%s\n' "$*" || true; log "$*"; }

# Progress state — die() uses these to tell the TRUTH about what happened to the
# disk. Before this, die() always claimed "nothing further was written", even
# when called AFTER `bootc install --wipe` had already erased the target.
WROTE_DISK=0      # 1 once bootc install has begun writing
INSTALLED_OK=0    # 1 once bootc install returned success

# Kernel cmdline, read EARLY: it carries the CI-only apex.unattended flag and
# the apex.* keys that mode installs from.
CMD=$(cat /proc/cmdline 2>/dev/null || true)
kv()    { echo "$CMD" | tr ' ' '\n' | sed -n "s/^$1=//p" | head -1; }
kvall() { echo "$CMD" | tr ' ' '\n' | sed -n "s/^$1=//p"; }
UNATTENDED=0
# Unattended install is a TEST/CI-only feature. It requires BOTH the kernel flag
# AND a marker file baked ONLY into test builds. On the production USB the marker
# is absent, so `apex.unattended` (even hand-added at the boot menu) is IGNORED
# and the engine, run without --headless, refuses to start at all — no
# accidental disk wipe.
if echo "$CMD" | grep -qw apex.unattended && [ -f /usr/share/apex-installer/allow-unattended ]; then
  UNATTENDED=1
fi

# ── Console quieting ────────────────────────────────────────────────────────
# Historically this existed because the whiptail UI drew directly on the
# console and kernel printk landed ON TOP of it — reproduced on an Acer Aspire,
# where audit records and serial-getty churn scribbled over the welcome box.
# The text UI is gone, but the quieting is kept on purpose: on the
# catastrophic-failure path (front end dead, engine output landing on the
# console) printk churn would bury the failure text the user needs to read.
#
# The kernel cmdline carries loglevel=3 audit=0, but relying on that alone means
# one wrong karg silently makes the failure text unreadable again. Belt and
# braces: drop the console log level while the engine runs, and put it back on
# every exit path so a post-mortem or a dropped shell still shows kernel output.
PRINTK_SAVED=""
quiet_console() {
  [ -w /proc/sys/kernel/printk ] || return 0
  PRINTK_SAVED="$(cat /proc/sys/kernel/printk 2>/dev/null || true)"
  # 1 = KERN_ALERT and above only; panics still reach the screen.
  echo 1 > /proc/sys/kernel/printk 2>/dev/null || true
  return 0
}
restore_console() {
  [ -n "$PRINTK_SAVED" ] || return 0
  [ -w /proc/sys/kernel/printk ] || return 0
  printf '%s\n' "$PRINTK_SAVED" > /proc/sys/kernel/printk 2>/dev/null || true
  return 0
}

# Release anything WE mounted. Without this, a failure or Ctrl+C left
# /run/apex-target — and the shared ESP mounted under it — in place, so the next
# run refused with "currently mounted", stranding the user on a half-installed
# disk with no way forward. Deepest mount first. Safe to call at any time.
TROOT=/run/apex-target
unmount_target() {
  umount "$TROOT/boot/efi" 2>/dev/null || true
  umount "$TROOT"          2>/dev/null || true
  [ -n "${MNT:-}" ] && { umount "$MNT/boot/efi" 2>/dev/null || true; umount "$MNT" 2>/dev/null || true; }
  return 0
}

# fail-loud: the exact reason, the TRUE state of the disk, the last log lines,
# and how to get a shell. Never claims "nothing was written" once it has been.
die() {
  restore_console
  log "FATAL: $1"
  # Always release our own mounts first: leaving /run/apex-target (and the shared
  # ESP under it) mounted makes the very next run refuse with "currently
  # mounted", stranding the user on a half-installed disk.
  unmount_target
  local tail_txt state what others
  tail_txt=$(tail -n 15 "$LOG" 2>/dev/null || true)
  # Describe what WE actually targeted. Hard-coding $DISK told a partition-mode
  # user "/dev/nvme0n1 WAS already erased" — i.e. that their whole disk (and the
  # other OS on it) was gone — directly contradicting the specific message above
  # it, and in the more frightening direction.
  what="${TARGET_DESC:-${DISK:-the target disk}}"
  if [ "${INSTALL_MODE:-disk}" = partition ]; then
    others="The other partitions on ${DISK:-the disk} were not erased by the installer."
  else
    others="Your other disks were not touched."
  fi
  if [ "$INSTALLED_OK" = 1 ]; then
    state="IMPORTANT: $what WAS written and APEX-OS IS installed there, but the
step above did not finish. Your account was probably NOT created — do not reboot
expecting to log in. Start the installer again from the boot menu, or fix it
from the rescue shell.
$others"
  elif [ "$WROTE_DISK" = 1 ]; then
    state="IMPORTANT: $what may already have been erased and left INCOMPLETE
(the exact message above says how far it got). If it was, it will not boot.
Start the installer again from the boot menu to try again.
$others"
  else
    state="Nothing was written. $others"
  fi
  # The full truth goes to stderr: that is where the console, the QEMU/CI
  # serial capture and the front end's log collection see it, without
  # disturbing the stdout status protocol.
  {
    echo "APEX-INSTALL-FAILED: $1"
    echo
    echo "$state"
    echo
    echo "Last log lines:"
    echo "$tail_txt"
    echo
    echo "Full log: $LOG  (also copied to the USB's APEXEFI partition if possible)"
    echo "For a shell: Ctrl+Alt+F2, log in as  root  /  apex"
  } >&2
  save_log_to_esp
  # The stdout copy goes LAST: it is the machine-readable failure sentinel the
  # graphical front end and the QEMU/CI serial capture key on. Nothing may be
  # printed to stdout after it.
  echo "APEX-INSTALL-FAILED: $1"
  exit 1
}

# The live log lives in a RAM-backed filesystem and dies with the reboot — the
# user literally could not retrieve it to report a failure. Best-effort copy to
# the ISO's writable APEXEFI (ESP) partition so it survives.
save_log_to_esp() {
  local esp dst
  esp=$(blkid -L APEXEFI 2>/dev/null || true)
  [ -n "$esp" ] || return 0
  dst=$(mktemp -d 2>/dev/null) || return 0
  if mount "$esp" "$dst" 2>/dev/null; then
    cp -f "$LOG" "$dst/apex-install.log" 2>/dev/null || true
    sync 2>/dev/null || true
    umount "$dst" 2>/dev/null || true
  fi
  rmdir "$dst" 2>/dev/null || true
  return 0
}

# Ctrl+C / SIGTERM during the install previously killed the installer with ZERO
# output — leaving a half-wiped disk and no explanation.
on_signal() {
  trap - INT TERM HUP ERR
  restore_console
  echo
  echo "Interrupted by signal."
  die "Interrupted (Ctrl+C or shutdown signal)."
}
# Ignore SIGPIPE. If the graphical front end dies mid-install, our next write to
# the pipe it was reading would otherwise kill this engine outright with signal
# 13 — measured: bash dies on a closed pipe and a trailing `|| true` never runs,
# so there would be no die(), no APEX-INSTALL-FAILED line, no save_log_to_esp
# and no console message, on a machine whose disk is half-rewritten. With
# SIGPIPE ignored the write returns EPIPE instead, which the `|| true` on every
# log() and note() already absorbs, and the install carries on to a clean
# finish. The comment above about a closed stdout not being an install failure
# only becomes TRUE with this line present.
trap '' PIPE

trap on_signal INT TERM HUP
trap 'die "Unexpected error on line $LINENO (see log). This is a bug in the installer, not a silent failure."' ERR

# Quiet the console now that the traps that restore it are in place.
quiet_console

# ── preflight ────────────────────────────────────────────────────────────────
[ "$(id -u)" = 0 ] || die "apex-install must run as root."
# Clear any mounts left behind by a previous aborted run, so a retry is not
# blocked by its own leftovers ("currently mounted — refusing").
unmount_target
have podman || die "podman is missing from the live environment."
if [ "$NETINSTALL" = 1 ]; then
  # Deliberately NOT a network check here. Preflight runs before the user has
  # even seen the Wi-Fi page, so failing now for being offline would refuse an
  # install that is about to become perfectly possible. The real check, and the
  # pull, happen at the install step — before anything is written to the disk.
  IMAGE="$TARGET_IMAGE"
  note "Network install: APEX-OS will be downloaded from $TARGET_IMAGE."
elif ! podman image exists "$IMAGE" 2>/dev/null && [ ! -e /run/install/repo/container ]; then
  die "The APEX-OS image ($IMAGE) is not present in the live environment."
fi

# ── shared post-install: create the admin account inside the new system ──────
# useradd/chpasswd via --root against the ostree deployment's /etc. The stateroot
# var is bind-mounted over the deployment's /var first, so the home dir (through
# the /home -> var/home symlink) is created where the booted system really has
# its /var. Afterwards the SELinux labels shadow-utils lost are restored with
# the TARGET's own setfiles+policy (the live env runs selinux=0, so every file
# (re)written here has no label — and the installed system enforces policy:
# greetd/polkitd get denied on an unlabeled /etc/passwd and login breaks).
# ── shared post-install: carry the live session's network config into the target
# Whatever wifi the user joined in the installer should just work on first boot —
# otherwise the freshly installed machine comes up with no network, which is
# exactly when it needs one (the first-login provisioner clones APEX Shell over
# the network, and a failed clone leaves the desktop unprovisioned).
#
# NetworkManager is strict about these files and fails CLOSED and SILENTLY:
# anything not 0600 root:root is ignored with no visible error, and on an
# SELinux target a wrong label has the same effect. Both are set explicitly —
# this exact mistake cost a whole debugging session on p5.
copy_network_to() {  # $1=deploy dir
  local deploy="$1" src=/etc/NetworkManager/system-connections dst n=0
  [ -d "$src" ] || return 0
  dst="$deploy/etc/NetworkManager/system-connections"
  mkdir -p "$dst" 2>/dev/null || return 0
  for f in "$src"/*.nmconnection; do
    [ -e "$f" ] || continue
    cp -a "$f" "$dst/" 2>/dev/null || continue
    n=$((n+1))
  done
  [ "$n" -gt 0 ] || { log "network: no saved connections to carry over"; return 0; }
  chown root:root "$dst"/*.nmconnection 2>/dev/null || true
  chmod 0600      "$dst"/*.nmconnection 2>/dev/null || true
  # Label with the TARGET's policy, not the live env's. Best effort: a missing
  # policy must not fail the install, but a wrong label means no network.
  if have setfiles && [ -f "$deploy/etc/selinux/targeted/contexts/files/file_contexts" ]; then
    setfiles -r "$deploy" "$deploy/etc/selinux/targeted/contexts/files/file_contexts" \
      "$dst" >>"$LOG" 2>&1 || true
  fi
  log "network: carried $n connection(s) into the installed system"
  return 0
}

create_user_in() {  # $1=deploy dir  $2=user  $3=pass  $4=hostname  $5=err-prefix
  local deploy=$1 user=$2 pass=$3 host=$4 pfx=$5 statevar setype spec f
  statevar=$(dirname "$(dirname "$deploy")")/var
  mount --bind "$statevar" "$deploy/var" 2>>"$LOG" \
    || die "$pfx: bind-mounting the stateroot var failed."
  # zsh is the APEX default shell (with starship, seeded at first login). Fall
  # back to bash if the image somehow lacks zsh — a user with a nonexistent
  # login shell cannot log in at all, which is a far worse failure than bash.
  # Written as an `if` for legibility and to avoid the `||`/`&&` precedence trap
  # (both operators are left-associative, so the bare form parses as
  # `(A || B) && x=y` — correct here, but only by accident).
  #
  # NOTE: the bare form does NOT trip this script's ERR trap, contrary to what
  # you might expect from the header notes. Measured: with both tests failing,
  # bash exempts every command in a `&&`/`||` list except the one after the
  # final operator, and that assignment never runs. Recorded so nobody "fixes"
  # a non-problem here later.
  ushell=/bin/bash
  if [ -x "$deploy/bin/zsh" ] || [ -x "$deploy/usr/bin/zsh" ]; then
    ushell=/bin/zsh
  fi
  log "creating $user with login shell $ushell"
  useradd --root "$deploy" -m -G wheel -s "$ushell" "$user" 2>>"$LOG" \
    || { umount "$deploy/var" 2>/dev/null; die "$pfx: useradd failed for $user (see $LOG)."; }
  echo "$user:$pass" | chpasswd --root "$deploy" 2>>"$LOG" \
    || { umount "$deploy/var" 2>/dev/null; die "$pfx: setting the password failed (see $LOG)."; }
  echo "$host" > "$deploy/etc/hostname" 2>>"$LOG" || true
  setype=$(sed -n 's/^SELINUXTYPE=//p' "$deploy/etc/selinux/config" 2>/dev/null | head -1)
  spec="/etc/selinux/${setype:-targeted}/contexts/files/file_contexts"
  # If the relabel tooling is missing we must NOT silently continue and then
  # claim success: unlabeled /etc/passwd means greetd/polkitd get AVC-denied and
  # the user cannot log in — an unusable system reported as a clean install.
  if [ ! -x "$deploy/usr/sbin/setfiles" ] || [ ! -f "$deploy$spec" ]; then
    umount "$deploy/var" 2>/dev/null || true
    die "$pfx: cannot SELinux-relabel the new account files (setfiles or the policy file_contexts is missing in the installed system). Without the relabel, login would be denied. The OS is installed on $DISK but the account is not usable."
  fi
  if true; then
    local paths=(/etc/hostname /var/home)
    for f in passwd passwd- shadow shadow- group group- gshadow gshadow- subuid subgid .pwd.lock; do
      [ -e "$deploy/etc/$f" ] && paths+=("/etc/$f")
    done
    chroot "$deploy" /usr/sbin/setfiles -F "$spec" "${paths[@]}" 2>&1 | tee -a "$LOG" \
      || { umount "$deploy/var" 2>/dev/null; die "$pfx: SELinux relabel of the account files failed (see $LOG)."; }
  fi
  umount "$deploy/var" 2>>"$LOG" || true
}

# ── unattended mode (automation / QEMU boot-test) ────────────────────────────
# If the kernel cmdline has `apex.unattended` (and the test-build marker file —
# see the gate above), install with no front end at all, using
# apex.disk=/dev/X apex.user=NAME apex.pass=PW apex.host=NAME. Repeatable
# apex.karg=... adds extra kernel args to the installed system (e.g. a serial
# console for the QEMU boot-test); apex.poweroff powers off on success. Same
# engine code path as a GUI-driven install, so a green run validates the flow.
if [ "$UNATTENDED" = 1 ]; then
  # Everything to the kernel console (ttyS0 in the QEMU test) so the run is
  # observable on serial, not stuck on tty1.
  [ -w /dev/console ] && exec >/dev/console 2>&1
  DISK=$(kv apex.disk); USERNAME=$(kv apex.user); P1=$(kv apex.pass); HOSTNAME=$(kv apex.host)
  : "${USERNAME:=andre}"; : "${HOSTNAME:=apex}"; : "${P1:=apex}"
  [ -b "$DISK" ] || die "unattended: apex.disk=$DISK is not a block device."
  log "UNATTENDED install: DISK=$DISK USER=$USERNAME HOST=$HOSTNAME"
  echo "APEX-OS unattended install to $DISK …"
  WROTE_DISK=1
  EXTRA_KARGS=()
  for k in $(kvall apex.karg); do EXTRA_KARGS+=(--karg "$k"); done
  # Disarm the ERR trap around the install (it fires even under `set +e`, and a
  # failing `podman … | tee` pipeline would pre-empt the rc check below).
  trap - ERR
  set +e
  # --net=host: no netavark needed in the live env; bootc install is offline.
  podman run --rm --privileged --pid=host --net=host --security-opt label=disable \
    -v /var/lib/containers:/var/lib/containers -v /dev:/dev \
    ${SRC_VOL[@]+"${SRC_VOL[@]}"} "$IMAGE" \
    bootc install to-disk --wipe --filesystem "$ROOTFS_TYPE" \
      --karg quiet --karg splash ${EXTRA_KARGS[@]+"${EXTRA_KARGS[@]}"} \
      ${SRC_ARGS[@]+"${SRC_ARGS[@]}"} \
      "$DISK" 2>&1 | tee -a "$LOG"
  rc=${PIPESTATUS[0]}
  trap 'die "Unexpected error on line $LINENO (see log). This is a bug in the installer, not a silent failure."' ERR
  [ "$rc" = 0 ] || die "unattended: bootc install exited $rc (see $LOG)."
  INSTALLED_OK=1
  MNT=$(mktemp -d)
  udevadm settle --timeout=30 2>>"$LOG" || true
  partprobe "$DISK" 2>>"$LOG" || true
  udevadm settle --timeout=30 2>>"$LOG" || true
  root_part=""
  for p in $(lsblk -rno NAME,TYPE "$DISK" 2>/dev/null | awk '$2=="part"{print $1}'); do
    if mount -o ro "/dev/$p" "$MNT" 2>/dev/null; then
      if [ -d "$MNT/ostree/deploy" ]; then umount "$MNT" 2>/dev/null || true; root_part="/dev/$p"; break; fi
      umount "$MNT" 2>/dev/null || true
    fi
  done
  [ -n "$root_part" ] || die "unattended: installed root filesystem not found on $DISK."
  mount "$root_part" "$MNT" || die "unattended: mount of new root failed."
  deploy=$(ls -d "$MNT"/ostree/deploy/*/deploy/*.0 2>/dev/null | head -1 || true)
  [ -n "$deploy" ] || { umount "$MNT" 2>/dev/null || true; die "unattended: deployment not found."; }
  create_user_in "$deploy" "$USERNAME" "$P1" "$HOSTNAME" "unattended"
  copy_network_to "$deploy"
  sync || true; umount "$MNT" 2>/dev/null || true; rmdir "$MNT" 2>/dev/null || true
  echo "APEX-INSTALL-UNATTENDED-OK"; log "unattended install complete"
  if echo "$CMD" | grep -qw apex.poweroff; then sync; poweroff; fi
  exit 0
fi

# ── HEADLESS / GUI MODE — the only non-CI way to run this engine ─────────────
# The graphical installer (apex-installer-gui) is a FRONT END only. It collects
# answers and hands them here; every disk guard, ESP check, LVM/LUKS refusal,
# bootc invocation, account creation, SELinux relabel and Secure Boot step
# lives in this one engine. This file used to also carry a whiptail UI of its
# own, reached as a fallback whenever the GUI failed to start — the exact place
# real users kept getting stranded — so that UI was deleted entirely rather
# than kept "just in case".
#
#   apex-install --headless ANSWERS        install from a key=value answers file
#
# Run with no arguments the engine REFUSES (exit 2) instead of guessing what to
# do: an engine that quietly grows an interactive mode is how the stranding
# fallback came to exist in the first place.
#
# The GUI enumerates disks itself (a front end presenting choices) and this
# engine independently re-validates whatever comes back. That is deliberate
# defence in depth: the live USB, for instance, is excluded by the GUI for UX
# AND refused here by the "currently mounted" guard, so a front-end bug cannot
# turn into a wiped boot stick.
#
# The answers file is written 0600 by the GUI and removed by it afterwards; it
# carries the account password (and, optionally, the MOK enrolment password),
# so it must never be world-readable or logged.
case "${1:-}" in
  --headless) ANSWERS="${2:-}" ;;
  "")
    # Not an install path — refuse loudly, start nothing, prompt for nothing.
    restore_console
    echo "apex-install is the install engine, not a user interface." >&2
    echo "Run the graphical installer (apex-installer-launch), or pass --headless ANSWERS." >&2
    exit 2
    ;;
  *)          die "unknown argument: $1 (expected --headless ANSWERS)" ;;
esac

[ -f "$ANSWERS" ] || die "answers file not found: $ANSWERS"
# Only ever accept a fixed key set — never `source` an attacker-writable file.
# Read WHOLE LINES and split them ourselves. Two separate measured bugs make
# this the only safe shape:
#
#  1. `|| [ -n "$line" ]` — `read` returns non-zero at EOF without a trailing
#     newline, and a plain `while read` DISCARDS that last line. Measured: a
#     file ending `hostname=apex` with no final newline parsed every key except
#     hostname. A silently dropped key is the worst shape of bug here — a lost
#     `mokpw` skips Secure Boot enrolment without a word.
#
#  2. NOT `IFS='=' read -r k v`. That form eats a single TRAILING '=' from the
#     value, because read strips one trailing IFS delimiter when filling the
#     last variable. Measured, on the real loop:
#         password=a=b=c  -> a=b=c   (fine)
#         password=abc==  -> abc==   (fine)
#         password=abc=   -> abc     (WRONG — one character silently gone)
#     A trailing '=' is the canonical shape of a base64 password out of a
#     password manager. chpasswd would then set a password DIFFERENT from the
#     one the user typed, the install would print APEX-INSTALL-OK, and first
#     login would fail with no error recorded anywhere — a locked-out system
#     reported as a success. `${line#*=}` has no such behaviour.
# Clear every answer variable before parsing, so "missing" means missing.
#
# This is not tidiness. **bash pre-populates $HOSTNAME** with the machine's own
# hostname — measured, it is `apex` on this box and `apex-installer` in the live
# ISO. So the "hostname missing" check could never fire, in this version OR in
# the original `: "${HOSTNAME:?…}"` form. An answers file without a `hostname=`
# line would sail through validation and install a system silently named after
# the LIVE ENVIRONMENT instead of failing.
#
# Found the hard way: a test case that omitted hostname was expected to be
# rejected, and instead ran all the way to `bootc install to-disk --wipe` on a
# real USB stick. Nothing else stood between a missing key and a wiped disk.
# ROOTFS_TYPE is deliberately NOT cleared — it has a real default (btrfs).
INSTALL_MODE=""; DISK=""; TARGET=""; ESP_DEV=""
USERNAME=""; P1=""; HOSTNAME=""; MOKPW=""

while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    ''|'#'*) continue ;;
    *'='*)   k=${line%%=*}; v=${line#*=} ;;
    *)       die "malformed line in answers file (no '='): $line" ;;
  esac
  case "$k" in
    mode)      INSTALL_MODE="$v" ;;
    disk)      DISK="$v" ;;
    target)    TARGET="$v" ;;
    esp)       ESP_DEV="$v" ;;
    username)  USERNAME="$v" ;;
    password)  P1="$v" ;;
    hostname)  HOSTNAME="$v" ;;
    rootfs)    ROOTFS_TYPE="$v" ;;
    mokpw)     MOKPW="$v" ;;
    *)         die "unknown key in answers file: $k" ;;
  esac
done < "$ANSWERS"

# `|| die`, NOT `: "${VAR:?...}"`. Measured: the `:?` form writes to stderr and
# exits 1 WITHOUT running the ERR trap, so nothing ever emits the
# `APEX-INSTALL-FAILED:` line the GUI watches for. The front end then shows the
# reasonless "The installer exited with status 1", and save_log_to_esp never
# runs, so the one artefact that could explain it is lost with the RAM disk.
# Every failure in this engine must speak the same protocol.
[ -n "${INSTALL_MODE:-}" ] || die "answers: mode missing"
[ -n "${DISK:-}" ]         || die "answers: disk missing"
[ -n "${USERNAME:-}" ]     || die "answers: username missing"
[ -n "${HOSTNAME:-}" ]     || die "answers: hostname missing"
[ -n "${P1:-}" ] || die "answers: password missing"
case "$INSTALL_MODE" in disk|partition) : ;; *) die "answers: bad mode '$INSTALL_MODE'" ;; esac

# ── Validate the account NOW, before anything is erased ──────────────────────
# These three checks lived only in the deleted text UI, and deleting it took
# them with it. They have to be here, not only in the GUI, and they have to run
# BEFORE the disk is touched — that ordering is the whole point.
#
# The failure they prevent is the worst one this installer can produce: an
# invalid username is not rejected by anything until `useradd` runs, and
# `useradd` runs AFTER `bootc install --wipe` has already erased the target. The
# result is a fully installed system with NO account on it — unbootable-into,
# nothing to log in as, and the user's old OS gone. The original text UI
# validated here for exactly this reason and its comment said so.
#
# A front end validating is not a substitute. The engine takes a file it did not
# write, and it is the last thing between that file and an erased disk.
printf '%s' "$USERNAME" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$' \
  || die "Invalid username '$USERNAME'. Use lowercase letters, digits, - and _ ; it must start with a letter or _ and be at most 32 characters. Nothing has been erased."
# The reserved list must cover names that ALREADY EXIST in the image being
# installed, not just the famous ones. `lp`, `mail`, `games`, `ftp` and `sync`
# ship in Fedora's `setup` package on every install, and `greetd` is created by
# the greetd RPM this desktop depends on — the deleted text UI listed greetd for
# exactly that reason and the rewrite dropped it. Any of these passes the regex
# above, so without this list the disk is wiped and `useradd` then fails on a
# name that was always going to collide.
case "$USERNAME" in
  root|bin|daemon|adm|sys|sync|shutdown|halt|mail|operator|games|ftp|lp|news|uucp|man|proxy|backup|list|irc|gnats|nobody|systemd*|dbus|polkitd|sshd|chrony|tss|sssd|greetd|gdm|sddm|lightdm|colord|geoclue|rtkit|pipewire|flatpak|avahi|apex|apexd)
    die "'$USERNAME' is a reserved system account name — pick another. Nothing has been erased." ;;
esac
printf '%s' "$HOSTNAME" | grep -Eq '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$' \
  || die "Invalid hostname '$HOSTNAME'. Use letters, digits and hyphens only, starting and ending with a letter or digit (max 63 characters). Nothing has been erased."

# Re-run the engine's full guard set on the answers. The GUI is not trusted to
# have done it: a front end must never be the only thing standing between a
# typo and a wiped disk.
[ -b "$DISK" ] || die "$DISK is not a block device."
# A block device is not necessarily a DISK. The deleted text UI built its menu
# from `lsblk -dn … '$3=="disk"'`, so DISK was structurally a whole disk and
# nothing downstream had to think about it. Headless takes whatever the answers
# file says, and `bootc install to-disk --wipe /dev/sda3` happily writes a GPT
# *inside a partition* — destroying that partition and yielding something no
# firmware will boot, while the neighbouring OS's entries rot.
_dtype=$(lsblk -dno TYPE "$DISK" 2>/dev/null | tr -d ' ' || true)
[ "$_dtype" = disk ] \
  || die "$DISK is a '${_dtype:-unknown}', not a whole disk. Refusing — installing onto anything else produces a system that will not boot. Nothing has been erased."
if findmnt -rno SOURCE | grep -qE "^${DISK}([0-9p]|$)"; then
  die "$DISK (or a partition of it) is currently mounted — refusing."
fi

# Refuse a target that cannot possibly hold the image, BEFORE erasing it. The
# text UI warned below 16 GB; there was no check at all in headless mode, so a
# too-small stick was wiped and the install then failed on space several minutes
# later — destructive and pointless, when the size is knowable up front.
_min_bytes=$((16 * 1000 * 1000 * 1000))
_sz=$(lsblk -bdno SIZE "$DISK" 2>/dev/null | tr -d ' ' || true)
case "$_sz" in
  ''|*[!0-9]*) log "size check: could not read the size of $DISK — continuing" ;;
  *) [ "$_sz" -ge "$_min_bytes" ] \
       || die "$DISK is only $((_sz / 1000000000)) GB. APEX-OS needs at least 16 GB. Nothing has been erased." ;;
esac

# Validate the filesystem choice for BOTH modes, here, before the mode split.
# It used to be checked only in the partition branch, so in whole-disk mode a
# typo reached `bootc install to-disk --filesystem` — which rejects it only
# after WROTE_DISK=1 has been set, making die() report that the disk "may
# already have been erased and left INCOMPLETE" about a disk it never touched.
# This file's rule is that it must never lie in the frightening direction.
case "$ROOTFS_TYPE" in
  btrfs)     MKFS_FORCE="-f" ;;
  ext4|ext3) MKFS_FORCE="-F" ;;
  xfs)       MKFS_FORCE="-f" ;;
  *)         die "Unsupported root filesystem '$ROOTFS_TYPE'. Nothing has been erased." ;;
esac
if [ "$INSTALL_MODE" = partition ]; then
  [ -n "${TARGET:-}" ] || die "answers: target partition missing for partition mode"
  [ -b "$TARGET" ] || die "$TARGET is not a block device."
  [ -n "${ESP_DEV:-}" ] || die "answers: esp missing for partition mode"
  [ -b "$ESP_DEV" ] || die "$ESP_DEV is not a block device."
  # Formatting the ESP as the root filesystem destroys the boot partition of
  # EVERY OS on the machine, including the one being installed, and produces a
  # disk that boots nothing at all. The GUI presents them as two separate
  # choices and will not offer the same device twice, but the engine must
  # refuse it independently — this is the single most destructive thing a
  # malformed answers file could ask for.
  [ "$TARGET" != "$ESP_DEV" ] \
    || die "The root partition and the EFI System Partition are the same device ($TARGET). Formatting the ESP would leave the machine unable to boot anything. Nothing has been erased."
  # The target must be a PARTITION, and it must live on the disk we were told
  # about. Both halves matter and the first one was missing.
  #
  # The earlier version of this guard read `[ -z "$_tdisk" ] || …`, which let an
  # EMPTY parent through. Measured: `lsblk -no PKNAME /dev/sdb` is empty exactly
  # when the device is a WHOLE DISK — precisely the case this guard exists to
  # refuse. So `mode=partition, disk=/dev/sda, target=/dev/sdb` passed every
  # check and would have run mkfs over the whole of /dev/sdb, a disk the user
  # never named as the target, and then reported the outcome as if it had
  # happened on /dev/sda. Empty must FAIL, not pass; the text UI had it that way
  # and the rewrite inverted it.
  #
  # Checking TYPE as well as PKNAME closes the related case of a device-mapper
  # node sitting directly on the disk, which reports the disk as its parent and
  # would otherwise satisfy the comparison.
  _ttype=$(lsblk -dno TYPE "$TARGET" 2>/dev/null | tr -d ' ' || true)
  [ "$_ttype" = part ] \
    || die "$TARGET is a '${_ttype:-unknown}', not a partition. In partition mode the target must be a partition. Nothing has been erased."
  _tdisk=$(lsblk -dno PKNAME "$TARGET" 2>/dev/null | head -1 | tr -d ' ' || true)
  [ -n "$_tdisk" ] \
    || die "Could not determine which disk $TARGET belongs to. Refusing to format it. Nothing has been erased."
  [ "$_tdisk" = "$(basename "$DISK")" ] \
    || die "$TARGET is not a partition of $DISK (it belongs to /dev/$_tdisk). Refusing to act on two disks at once. Nothing has been erased."
  # The ESP has to be on that same disk too, and it has to actually BE an ESP.
  # Without the type check, an `esp=` pointing at a Windows data partition or a
  # FAT photo partition passes `-b` and "mountable with 40MB free", and bootupd
  # then writes an \EFI\ tree into it: the firmware never finds APEX, and a
  # partition the user cares about gets boot files scribbled into it. The text
  # UI located the ESP by GPT type GUID and explicitly refused to treat plain
  # vfat as evidence.
  _esp_disk=$(lsblk -dno PKNAME "$ESP_DEV" 2>/dev/null | head -1 | tr -d ' ' || true)
  [ "$_esp_disk" = "$(basename "$DISK")" ] \
    || die "The EFI System Partition $ESP_DEV is not on $DISK (it is on /dev/${_esp_disk:-unknown}). Nothing has been erased."
  _esp_type=$(lsblk -dno PARTTYPE "$ESP_DEV" 2>/dev/null | tr -d ' ' | tr 'A-Z' 'a-z' || true)
  case "$_esp_type" in
    c12a7328-f81f-11d2-ba4b-00a0c93ec93b|0xef) : ;;
    *) die "$ESP_DEV is not an EFI System Partition (partition type '${_esp_type:-none}'). Writing boot files there would not make the machine boot, and would damage whatever is on it. Nothing has been erased." ;;
  esac
  # Container-member refusal: mkfs on an LVM PV / LUKS header silently destroys
  # everything inside it, and the live env may not even have the tooling to
  # notice it is mounted.
  tfs=$(lsblk -dno FSTYPE "$TARGET" 2>/dev/null | tr -d ' ' || true)
  case "$tfs" in
    LVM2_member|crypto_LUKS|linux_raid_member|ddf_raid_member|isw_raid_member|zfs_member|bcache)
      die "$TARGET is a $tfs container member — refusing to format it." ;;
  esac
  # MKFS_FORCE is set above, for both modes. Only the TOOLING check is
  # partition-specific: whole-disk mode hands the filesystem name to bootc,
  # which brings its own mkfs, whereas partition mode runs ours.
  have "mkfs.$ROOTFS_TYPE" || die "mkfs.$ROOTFS_TYPE is not available in this installer.
Only filesystems with tooling present can be used (btrfs is the default)."

  # Fedora-family neighbour check. APEX installs its bootloader under
  # \EFI\fedora\ — the SAME directory an existing Fedora/RHEL-family install
  # uses. bootupd rewrites \EFI\fedora\bootuuid.cfg to point at OUR new root,
  # and the neighbour's unchanged grub.cfg resolves its prefix from that file.
  # Net effect: the neighbour's data survives untouched, but its existing
  # firmware entry starts booting APEX. Detect it here so the install step
  # backs the originals up to \EFI\fedora\apex-backup\, and say so plainly
  # instead of claiming "your existing OS entries stay".
  ESP_SHARED_FEDORA=0
  _probe=$(mktemp -d 2>/dev/null || echo /tmp/apex-esp-probe); mkdir -p "$_probe"
  if mount -o ro "$ESP_DEV" "$_probe" 2>/dev/null; then
    if [ -e "$_probe/EFI/fedora/bootuuid.cfg" ] || [ -e "$_probe/EFI/fedora/grub.cfg" ]; then
      ESP_SHARED_FEDORA=1
      note "A Fedora-family install already uses \\EFI\\fedora on this ESP.
APEX uses that same directory. Its boot files will be UPDATED to point at
APEX, so the existing \"Fedora\" entry in your firmware menu will boot
APEX-OS after this. The other install's DATA is not touched, but you will
need to re-add a boot entry for it (its files stay in place, and the
originals are backed up to \\EFI\\fedora\\apex-backup\\)."
    fi
    umount "$_probe" 2>/dev/null || true
  fi
  rmdir "$_probe" 2>/dev/null || true

  TARGET_DESC="$TARGET (partition of $DISK)"
else
  TARGET="$DISK"
  TARGET_DESC="$DISK (entire disk)"
fi
log "headless: MODE=$INSTALL_MODE TARGET=$TARGET ESP=${ESP_DEV:-n/a} USER=$USERNAME HOST=$HOSTNAME"

# ── 4. install (via the embedded image; stream to log) ───────────────────────
note "Installing APEX-OS to $TARGET_DESC … (full log: $LOG)"
# ── Network install: fetch the OS BEFORE touching the disk ──────────────────
# Ordering matters. If the download fails — no network, registry down, a typo in
# the ref — the disk must still be untouched and the user must get a reason they
# can act on. Doing this after the wipe would leave a machine with no OS and no
# way back.
if [ "$NETINSTALL" = 1 ]; then
  note "Downloading APEX-OS from $TARGET_IMAGE — this is the slow part, and nothing has been erased yet."
  if podman image exists "$TARGET_IMAGE" 2>/dev/null; then
    note "Already downloaded."
  else
    pull_ok=0
    for attempt in 1 2 3; do
      [ "$attempt" = 1 ] || note "Download failed — retrying ($attempt of 3)…"
      if podman pull "$TARGET_IMAGE" 2>&1 | tee -a "$LOG"; then pull_ok=1; break; fi
    done
    [ "$pull_ok" = 1 ] || die "Could not download APEX-OS from $TARGET_IMAGE after 3 attempts.

Nothing has been erased — your disks are untouched.

The usual cause is no network: go Back to the network step and connect, then try
again. If you are online, the registry may be temporarily unavailable."
  fi
  note "Download complete."
fi

note "Do not power off — $TARGET is being erased and rewritten from here on."

# ── Dry-run stop: the last line before anything is destroyed ─────────────────
# APEX_DRY_RUN=1 runs the ENTIRE validation path for real — every guard, on the
# real devices named — and then stops here, immediately before the first
# destructive command. It exists because the test suite must be able to feed
# this engine real device names without any possibility of erasing them.
#
# It is not paranoia. While testing the guards, one case that should have been
# rejected was not (bash pre-sets $HOSTNAME, see the parser), and the engine ran
# `bootc install to-disk --wipe` against a USB stick that was plugged in. The
# guards are the primary defence; this is the one that does not depend on the
# guards being right.
#
# Deliberately NOT reachable from the kernel cmdline or the answers file — only
# from the environment, which the GUI never sets.
if [ "${APEX_DRY_RUN:-0}" = 1 ]; then
  note "APEX-DRY-RUN: validation complete, stopping before the first destructive write."
  note "  would install: MODE=$INSTALL_MODE TARGET=$TARGET DISK=$DISK ESP=${ESP_DEV:-n/a} FS=$ROOTFS_TYPE USER=$USERNAME HOST=$HOSTNAME"
  restore_console
  echo "APEX-INSTALL-DRYRUN-OK"
  exit 0
fi
# NOTE: WROTE_DISK is deliberately NOT set here. In partition mode the ESP
# free-space check runs first and can fail with everything still intact; claiming
# destruction at that point is a lie in the frightening direction. Each branch
# sets it at the exact moment data actually starts being destroyed.
log "install start: MODE=$INSTALL_MODE TARGET=$TARGET DISK=$DISK ESP=${ESP_DEV:-n/a} USER=$USERNAME HOST=$HOSTNAME FS=$ROOTFS_TYPE"

# Disarm the ERR trap around the install: the trap fires even under `set +e`, and
# with pipefail a failing `podman … | tee` pipeline would hit it BEFORE we can
# read rc — reporting a useless "unexpected error on line N" instead of the real
# bootc error. We check rc explicitly and re-arm immediately after.
trap - ERR
set +e
if [ "$INSTALL_MODE" = partition ]; then
  # ── partition mode: prepare the filesystem ourselves, then to-filesystem ──
  # Proven on a loopback multi-OS disk: the other partitions and the existing
  # /EFI/Microsoft entry survive; APEX is added under /EFI/fedora alongside them.
  mkdir -p "$TROOT"
  # Check the ESP has room BEFORE destroying the target. bootupd writes ~20-30 MB
  # (shim, grub, fallback); running out mid-write left a TRUNCATED BOOTX64.EFI
  # with the working original already gone — i.e. an unbootable machine, after we
  # had also erased the target. Verify first, fail while everything is intact.
  if mount -o ro "$ESP_DEV" "$TROOT" >>"$LOG" 2>&1; then
    esp_free=$(df -Pk "$TROOT" 2>/dev/null | awk 'NR==2{print $4}' || true)
    umount "$TROOT" 2>/dev/null || true
    case "$esp_free" in ''|*[!0-9]*) esp_free=0 ;; esac
    if [ "$esp_free" -lt 40960 ]; then
      rc=93
      echo "ESP $ESP_DEV has only ${esp_free}KB free; need ~40MB" | tee -a "$LOG"
    fi
  else
    rc=92; echo "could not read the ESP $ESP_DEV" | tee -a "$LOG"
  fi
  if [ "${rc:-0}" = 0 ]; then
    WROTE_DISK=1   # mkfs starts here — the target's contents are now going away
    mkfs."$ROOTFS_TYPE" $MKFS_FORCE -L apex-root "$TARGET" >>"$LOG" 2>&1 \
      || { rc=90; echo "mkfs.$ROOTFS_TYPE failed on $TARGET" | tee -a "$LOG"; }
  fi
  if [ "${rc:-0}" = 0 ]; then
    mount "$TARGET" "$TROOT" >>"$LOG" 2>&1 || { rc=91; echo "mounting $TARGET failed" | tee -a "$LOG"; }
  fi
  if [ "${rc:-0}" = 0 ]; then
    mkdir -p "$TROOT/boot/efi"
    mount "$ESP_DEV" "$TROOT/boot/efi" >>"$LOG" 2>&1 \
      || { rc=92; echo "mounting the ESP $ESP_DEV failed" | tee -a "$LOG"; }
  fi
  if [ "${rc:-0}" = 0 ]; then
    # Record what the ESP looked like BEFORE, so a bootloader problem afterwards
    # is diagnosable rather than mysterious.
    { echo "--- ESP $ESP_DEV before install ---"; find "$TROOT/boot/efi" -maxdepth 3; } >>"$LOG" 2>&1 || true
    # Back up the neighbour's \EFI\fedora boot files: bootupd is about to rewrite
    # bootuuid.cfg (and may touch grub.cfg), which redirects the existing
    # "Fedora" firmware entry at APEX. Keeping the originals makes that
    # recoverable instead of permanent.
    if [ "${ESP_SHARED_FEDORA:-0}" = 1 ] && [ -d "$TROOT/boot/efi/EFI/fedora" ]; then
      mkdir -p "$TROOT/boot/efi/EFI/fedora/apex-backup" 2>/dev/null || true
      for f in bootuuid.cfg grub.cfg BOOTX64.CSV; do
        [ -e "$TROOT/boot/efi/EFI/fedora/$f" ] \
          && cp -n "$TROOT/boot/efi/EFI/fedora/$f" "$TROOT/boot/efi/EFI/fedora/apex-backup/$f" 2>/dev/null
      done
      cp -n "$TROOT/boot/efi/EFI/BOOT/BOOTX64.EFI" "$TROOT/boot/efi/EFI/fedora/apex-backup/BOOTX64.EFI.orig" 2>/dev/null || true
      { echo "--- backed up neighbour EFI files to EFI/fedora/apex-backup ---"
        ls -l "$TROOT/boot/efi/EFI/fedora/apex-backup" 2>/dev/null; } >>"$LOG" 2>&1 || true
    fi
    podman run --rm --privileged --pid=host --net=host --security-opt label=disable \
      -v /var/lib/containers:/var/lib/containers -v /dev:/dev \
      -v "$TROOT":"$TROOT":rshared \
      ${SRC_VOL[@]+"${SRC_VOL[@]}"} "$IMAGE" \
      bootc install to-filesystem \
        --skip-fetch-check --acknowledge-destructive \
        --karg quiet --karg splash ${SRC_ARGS[@]+"${SRC_ARGS[@]}"} \
        "$TROOT" 2>&1 | tee -a "$LOG"
    rc=${PIPESTATUS[0]}
    { echo "--- ESP $ESP_DEV after install ---"; find "$TROOT/boot/efi" -maxdepth 3; } >>"$LOG" 2>&1 || true
  fi
  umount "$TROOT/boot/efi" 2>/dev/null || true
  umount "$TROOT" 2>/dev/null || true
else
  # --net=host: no netavark needed in the live env; bootc install is offline.
  # Set BEFORE the call: `--wipe` destroys the disk immediately, so a Ctrl+C one
  # second later must NOT be reported as "nothing was written".
  WROTE_DISK=1
  podman run --rm --privileged --pid=host --net=host --security-opt label=disable \
    -v /var/lib/containers:/var/lib/containers -v /dev:/dev \
    ${SRC_VOL[@]+"${SRC_VOL[@]}"} "$IMAGE" \
    bootc install to-disk --wipe --filesystem "$ROOTFS_TYPE" \
      --karg quiet --karg splash ${SRC_ARGS[@]+"${SRC_ARGS[@]}"} \
      "$DISK" 2>&1 | tee -a "$LOG"
  rc=${PIPESTATUS[0]}
fi
trap 'die "Unexpected error on line $LINENO (see log). This is a bug in the installer, not a silent failure."' ERR
# Distinguish OUR pre-install preparation failures from a real bootc failure —
# reporting "bootc install exited 90" when mkfs was the thing that failed sends
# you looking in the wrong place.
case "$rc" in
  0)  : ;;
  90) die "Could not format $TARGET as $ROOTFS_TYPE (mkfs failed — see $LOG). The partition was NOT changed; your other partitions are untouched." ;;
  91) die "Could not mount the freshly formatted $TARGET (see $LOG). $TARGET was reformatted and is now empty; your other partitions are untouched." ;;
  92) die "Could not read/mount the EFI System Partition $ESP_DEV (see $LOG). Nothing was formatted; $TARGET and your other partitions are untouched." ;;
  93) die "The EFI System Partition $ESP_DEV does not have enough free space (~40MB needed) for the APEX boot files.

Nothing was formatted — $TARGET and your other partitions are untouched.
Free up space on the ESP (old distro directories under \\EFI\\ are the usual culprit) and try again." ;;
  *)  die "bootc install exited $rc. The exact error is above and in $LOG (search for 'error:'). No boot config was left half-written by grub2-mkconfig — bootc uses bootupd." ;;
esac
INSTALLED_OK=1   # the OS is on the disk; only account setup remains

# ── 5. create the account in the freshly installed system ─────────────────────
note "Creating your account …"; log "post-install: create user $USERNAME"
MNT=$(mktemp -d)
# Find the root partition by WHAT IT IS, not by position. `lsblk … | tail -1` was
# wrong: it can return the whole disk (no partitions yet visible) or a non-root
# partition, producing a false FAILURE after a perfectly good install. Settle
# udev first — the partition table was just rewritten.
udevadm settle --timeout=30 2>>"$LOG" || true
if [ "$INSTALL_MODE" = partition ]; then
  # We formatted and installed into this exact partition — no searching, and
  # crucially NO partprobe (the partition table was not modified in this mode;
  # re-reading it needlessly on a disk holding another live OS is pointless risk).
  root_part="$TARGET"
else
  partprobe "$DISK" 2>>"$LOG" || true
  udevadm settle --timeout=30 2>>"$LOG" || true
  root_part=""
  for p in $(lsblk -rno NAME,TYPE "$DISK" 2>/dev/null | awk '$2=="part"{print $1}'); do
    if mount -o ro "/dev/$p" "$MNT" 2>/dev/null; then
      if [ -d "$MNT/ostree/deploy" ]; then umount "$MNT" 2>/dev/null || true; root_part="/dev/$p"; break; fi
      umount "$MNT" 2>/dev/null || true
    fi
  done
fi
[ -n "$root_part" ] || die "Installed root filesystem not found on $DISK after bootc reported success. The OS is installed but the account could not be created."
mount "$root_part" "$MNT" 2>>"$LOG" || die "Could not mount the new root ($root_part) to create your account."
# ostree layout: the deployed root is the newest dir under ostree/deploy/*/deploy/*.0
# `|| true`: no glob match makes the pipeline non-zero → ERR trap. The explicit
# emptiness check on the next line is what should report the problem.
deploy=$(ls -d "$MNT"/ostree/deploy/*/deploy/*.0 2>/dev/null | head -1 || true)
[ -n "$deploy" ] || { umount "$MNT" 2>/dev/null || true; die "Installed ostree deployment not found under $root_part."; }
create_user_in "$deploy" "$USERNAME" "$P1" "$HOSTNAME" "post-install"
copy_network_to "$deploy"
# Never let cleanup failures trip the ERR trap AFTER a successful install — that
# would report failure on a system that is actually installed fine.
sync || true; umount "$MNT" 2>/dev/null || true; rmdir "$MNT" 2>/dev/null || true
log "post-install: user $USERNAME created, hostname=$HOSTNAME"

# ── 5b. Secure Boot: enrol the APEX key so the installed kernel will boot ────
# The CachyOS kernel is signed with the APEX MOK (see Containerfile.base). With
# Secure Boot ON, shim will only accept it once that key is enrolled — a one-time
# step that REQUIRES physical presence at the MokManager screen (by design; it
# cannot be automated away).
#
# NON-INTERACTIVE by construction: the graphical front end asks the user up
# front and passes their chosen MokManager password as `mokpw` in the answers
# file; an empty or absent mokpw means the user declined. Nothing here may
# prompt — a prompt at the engine's end has nobody to answer it, and would hang
# a machine that is already fully installed.
#
# SECRET: MOKPW must never reach stdout or the log — note() logs its argument,
# so no note()/log() line may interpolate it. It goes ONLY to mokutil's stdin.
SB_STATE="unknown"
if have mokutil; then SB_STATE=$(mokutil --sb-state 2>/dev/null | tr -d '\n' || true); fi
sb_on=0
case "$SB_STATE" in *[Ee]nabled*) sb_on=1 ;; esac
cert="$deploy/usr/share/apex-os/secureboot/apex-mok.der"
kstate=$(cat "$deploy/usr/share/apex-os/secureboot/kernel-signed" 2>/dev/null || echo unknown)
# Enrol whenever a password was supplied and the kernel is signed — NOT only
# when Secure Boot is already on. `mokutil --import` writes MokNew/MokAuth to
# UEFI NVRAM, which is firmware state belonging to the MACHINE, not to the OS on
# the disk. So a key queued here from the live environment is picked up by shim
# on the next boot regardless, and the request persists in NVRAM until it is
# processed — queueing it with Secure Boot off is safe and it is still waiting
# if the user switches Secure Boot on afterwards.
#
# Gating this on sb_on was wrong and made the feature nearly unreachable: most
# machines ship with Secure Boot off, so the front end never offered enrolment,
# so the only route to a Secure Boot system was install, boot, run mokutil by
# hand, reboot, then toggle the firmware. The whole point of doing it here is
# that the user is already sitting in front of the machine.
if [ -n "${MOKPW:-}" ] || [ "$sb_on" = 1 ]; then
  if [ "$kstate" = signed ] && [ -f "$cert" ] && have mokutil; then
    if [ -n "${MOKPW:-}" ]; then
      if printf '%s\n%s\n' "$MOKPW" "$MOKPW" | mokutil --import "$cert" >>"$LOG" 2>&1; then
        log "secureboot: MOK enrolment queued"
        if [ "$sb_on" = 1 ]; then
          note "Secure Boot: enrolment queued. On the next boot, a blue 'MOK management' screen appears:

  Enroll MOK  →  Continue  →  Yes  →  enter that password  →  Reboot

After that APEX-OS boots normally with Secure Boot ON."
        else
          note "Secure Boot: the APEX key is queued for enrolment. On the next boot, a blue 'MOK management' screen appears:

  Enroll MOK  →  Continue  →  Yes  →  enter that password  →  Reboot

Secure Boot is currently OFF, so nothing about this install depends on it — but
once the key is enrolled you can turn Secure Boot on in your firmware whenever
you like and APEX-OS will boot. No second install, no mokutil by hand.

If the blue screen does not appear because Secure Boot is off, the request stays
queued in firmware and will be offered the first time you enable it."
        fi
      else
        note "Secure Boot: mokutil could not queue the key (see $LOG).

APEX-OS is installed. To boot it, either turn Secure Boot off in firmware, or
run this from a live session later:
  mokutil --import /usr/share/apex-os/secureboot/apex-mok.der"
      fi
    else
      note "No MOK enrolment password was supplied — the APEX key was NOT enrolled. (Secure Boot is currently ${SB_STATE:-unknown}.)

APEX-OS uses a custom (CachyOS) kernel, which Microsoft does not sign. It is
signed with APEX's own key instead — that key has to be enrolled once, or the
machine will refuse to boot APEX.

Declining is fine — you can either enrol later with
  mokutil --import /usr/share/apex-os/secureboot/apex-mok.der
or turn Secure Boot off in firmware."
    fi
  else
    note "Secure Boot is ON — action needed.

Secure Boot is enabled, but this build's kernel is not signed with an APEX key
(state: $kstate).

APEX-OS is installed, but it will NOT boot until you turn Secure Boot OFF in
your firmware settings. Everything else about the install is complete."
  fi
fi

# ── 6. done ──────────────────────────────────────────────────────────────────
if [ "$INSTALL_MODE" = partition ]; then
  done_extra="Installed into $TARGET; the other partitions on $DISK were not touched.

Your firmware boot menu should now list APEX-OS alongside your other OS.
If it does not appear, pick it from the one-time boot menu (F12 on ThinkPads).
Your previous OS entry is still there."
else
  done_extra="Installed on $DISK (whole disk)."
fi
note "APEX-OS is installed.

$done_extra

Log in as: $USERNAME
Hostname:  $HOSTNAME

Remove the USB stick and reboot. On first login the shell finishes setting
itself up (needs network the first time).

Full log: $LOG"
log "install complete"
# The machine-readable success sentinel. It MUST be the very last line on
# stdout: the graphical front end declares victory on exactly this string, the
# same way it declares defeat on the APEX-INSTALL-FAILED: line die() emits.
# Print NOTHING to stdout after it.
echo "APEX-INSTALL-OK"
