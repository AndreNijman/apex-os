# APEX-OS installer live-environment rootfs.
#
# A small Fedora rootfs (NOT the APEX image) that boots as a live ISO and runs
# the apex-install TUI. The APEX-OS image to install is embedded in this env's
# container storage so the install works fully offline via
#   podman run localhost/apex-os:daily bootc install to-disk …
#
# NOTE: the APEX image is NOT embedded here. `skopeo copy … containers-storage:`
# cannot run inside a podman build (the build container's fs is overlayfs and
# containers/storage refuses overlay-on-overlay). build-live-iso.sh injects the
# store into the exported rootfs on the HOST instead (step 3 there).
#
# Plain fedora base (not fedora-bootc) so the rootfs is a simple mutable tree.
# Built into a live ISO by build-live-iso.sh.
FROM registry.fedoraproject.org/fedora:43

# ── Firmware: its OWN transaction, with weak deps ENABLED on purpose ─────────
# The live env shipped with /lib/firmware absent entirely, so i915/amdgpu could
# not initialise, KMS failed, and the installer black-screened on an Acer Aspire
# that only booted with nomodeset (apex-logs 48).
#
# The first fix — adding `linux-firmware` to the big install below — did NOT
# work, and the failure was silent: `linux-firmware` is a METAPACKAGE whose GPU
# and wifi content lives in subpackages (amd-gpu-firmware, intel-gpu-firmware,
# nvidia-gpu-firmware, atheros-, brcmfmac-, mt7xxx-, realtek-, …) that it pulls
# as RECOMMENDS. install_weak_deps=False strips all thirteen, leaving 649 files
# and zero i915. Measured, not assumed.
#
# So firmware gets its own transaction with weak deps left ON. Naming the
# subpackages individually would work today and rot the first time Fedora adds
# one; this keeps working.
# EVERY firmware package Fedora ships, not a hand-picked list. This ISO has to
# boot and connect on hardware nobody working on it owns, so enumerating the
# adapters we happen to have is the wrong shape: it silently excludes everyone
# else, and it rots the moment Fedora adds a package.
#
# linux-firmware alone is not enough twice over. Its GPU and wifi content lives
# in subpackages it only RECOMMENDS (see above), and Intel wifi, legacy Intel
# wifi, Marvell, Atmel, ZyDAS, Qualcomm and the Intel camera controller are
# packaged entirely separately and recommended by nothing at all.
#
# Excluded: gnome-firmware (a GUI updater) and python3-virt-firmware (a library)
# — neither ships hardware blobs.
#
# The assertions are the point. Every previous attempt at this failed SILENTLY
# and shipped a black screen; a build that cannot prove it has GPU and wifi
# firmware must not produce an ISO.
RUN set -eux; \
    pkgs="$(dnf -q repoquery --qf '%{name}\n' '*-firmware' 2>/dev/null \
            | grep -vE '^(gnome-firmware|python3-virt-firmware)$' \
            | sort -u | tr '\n' ' ')"; \
    echo "installing firmware packages: $pkgs"; \
    dnf -y install --skip-unavailable $pkgs; \
    dnf clean all; \
    n=$(find /lib/firmware -type f | wc -l); \
    echo "firmware files: $n"; \
    [ "$n" -gt 2500 ] || { echo "FATAL: only $n firmware files"; exit 1; }; \
    for d in i915 amdgpu nvidia; do \
        c=$(find /lib/firmware -path "*/$d/*" -type f | wc -l); \
        [ "$c" -gt 0 ] || { echo "FATAL: no $d firmware"; exit 1; }; \
        echo "  $d: $c files"; \
    done; \
    [ "$(find /lib/firmware -iname 'iwlwifi*' | wc -l)" -gt 0 ] \
        || { echo "FATAL: no Intel wifi firmware"; exit 1; }

# Live-env + installer toolchain. kernel + dracut(+live) make it bootable as a
# squashfs live image; newt=whiptail; podman/skopeo run the install; btrfs-progs/
# dosfstools/util-linux for the target disk; shadow-utils for useradd/chpasswd
# into the installed tree; device-mapper for the dmsquash-live snapshot root;
# grub2-tools-extra/-efi-x64-modules so build-live-iso.sh can produce the ISO's
# UEFI grub binary with this same container (host may lack grub2-mkstandalone);
# NetworkManager-wifi / wpa_supplicant / wireless-regdb / iw are listed
# EXPLICITLY for the same reason linux-firmware is: they are WEAK dependencies of
# NetworkManager and install_weak_deps=False silently drops them. Without
# NetworkManager-wifi, NM has no wifi device support whatsoever — `nmcli device`
# shows no wlan at all — so the installer could never offer to join a network.
# (Third instance of this trap in one day: linux-firmware, hyprland-qtutils, and
# now this. Anything only pulled in as a Recommends must be named here.)
# The wifi firmware itself comes from linux-firmware, added above.
# linux-firmware is listed EXPLICITLY because install_weak_deps=False is set
# below: firmware is only a *weak* dependency of the kernel, so it was silently
# excluded and the live environment shipped with /lib/firmware absent entirely
# (0 files). Without GPU firmware i915/amdgpu cannot initialise, KMS fails, and
# the installer black-screens on real hardware — reproduced on an Acer Aspire,
# which only booted with nomodeset. QEMU never caught it because its virtio/bochs
# GPU needs no firmware, and the ThinkPad install was done from a running system
# rather than this ISO, so this path was never exercised on metal.
# It costs ~1 GB of ISO, which is the correct trade for an installer that has to
# boot on unknown hardware. The INSTALLED image already has firmware; this gap
# was only ever in the live environment.
RUN dnf -y install --setopt=install_weak_deps=False \
        kernel systemd systemd-udev dracut dracut-live device-mapper \
        podman skopeo \
        newt ncurses util-linux coreutils bash shadow-utils \
        btrfs-progs dosfstools e2fsprogs xfsprogs gdisk parted \
        lvm2 cryptsetup mdadm \
        NetworkManager NetworkManager-wifi wpa_supplicant wireless-regdb iw \
        iproute iputils \
        plymouth kbd \
        cage gtk4 libadwaita python3-gobject \
        mesa-dri-drivers mesa-vulkan-drivers \
        adwaita-icon-theme jetbrains-mono-fonts google-noto-sans-fonts \
        abattis-cantarell-fonts \
        grub2-tools-extra grub2-efi-x64-modules \
        shim-x64 grub2-efi-x64 mokutil efibootmgr \
    && dnf clean all

# The installer TUI.
# The install ENGINE (also the text-mode UI), the graphical front end, and the
# launcher that picks between them. One engine, two front ends: apex-installer-gui
# collects answers and drives `apex-install --headless`, so every disk guard and
# safety check lives in exactly one place.
COPY apex-install         /usr/bin/apex-install
COPY apex-installer-gui   /usr/bin/apex-installer-gui
COPY apex-installer-launch /usr/bin/apex-installer-launch
RUN chmod 0755 /usr/bin/apex-install /usr/bin/apex-installer-gui \
                /usr/bin/apex-installer-launch

# Unattended-install marker. apex-install only honours `apex.unattended` when
# this file exists — baked ONLY for test/CI builds (ALLOW_UNATTENDED=1). The
# PRODUCTION build (default 0) omits it, so the flashed USB has no unattended
# path at all. build-live-iso.sh also drops the unattended boot-menu entry in
# production.
ARG ALLOW_UNATTENDED=0
RUN if [ "$ALLOW_UNATTENDED" = 1 ]; then \
        install -Dm644 /dev/null /usr/share/apex-installer/allow-unattended; \
        echo "installer image: UNATTENDED TEST MODE ENABLED"; \
    else echo "installer image: production build (no unattended)"; fi

# Auto-launch the installer on tty1; boot to multi-user (no GUI needed).
COPY apex-installer.service /usr/lib/systemd/system/apex-installer.service
RUN systemctl set-default multi-user.target \
    && systemctl enable apex-installer.service \
    && systemctl enable NetworkManager.service \
    && systemctl mask getty@tty1.service \
    && systemctl mask serial-getty@ttyS0.service

# Live-env-only root login (tty2 / serial) for rescue & debugging. This is the
# throwaway live session, not the installed system.
RUN echo 'root:apex' | chpasswd

# A friendly hostname in the live env.
RUN echo apex-installer > /etc/hostname
