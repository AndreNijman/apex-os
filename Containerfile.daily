# ─────────────────────────────────────────────────────────────────────────
# APEX-OS — Daily edition (chartreuse)
#
#   FROM apex-base → stamp VARIANT=Daily + laptop/battery skeleton.
#
# The heavy lifting (CachyOS kernel, desktop/greeter stack, scx, Bazaar) is all
# in the base. The Daily edition is intentionally thin for M1: it stamps the
# edition (which drives apex-greet's chartreuse branding via os-release
# VARIANT_ID) and lays the groundwork for the laptop power story. The full §10
# battery stack (charge thresholds, ASPM/ABM/APST, sysctl/udev tuning,
# AC/battery auto-switching) is owned by apexd at M3 — only the placeholder is
# here.
# ─────────────────────────────────────────────────────────────────────────
ARG BASE=localhost/apex-base:latest
FROM ${BASE}

ARG APEX_REVISION=dev
LABEL org.opencontainers.image.title="APEX-OS Daily" \
      org.opencontainers.image.description="APEX-OS Daily edition (chartreuse) — general-purpose daily driver" \
      org.opencontainers.image.source="https://github.com/AndreNijman/apex-os" \
      org.opencontainers.image.revision="${APEX_REVISION}" \
      org.opencontainers.image.version="daily" \
      org.opencontainers.image.vendor="APEX-OS"

# ── Edition stamp ──────────────────────────────────────────────────────────
# os-release VARIANT_ID=daily is what apex-greet reads to pick the chartreuse
# spark + accent. /etc/os-release is a symlink into /usr/lib/os-release, so
# append there. (The base deliberately leaves this unset.)
RUN set -eux; \
    printf 'VARIANT="Daily"\nVARIANT_ID=daily\n' >> /usr/lib/os-release

# ── Laptop / battery skeleton ──────────────────────────────────────────────
# power-profiles-daemon (NOT tlp — tlp conflicts with PPD on Fedora and fights
# the platform profile driver; the plan standardises on PPD + apexd's own
# sysctl/udev layer). Own dnf transaction, `dnf5 clean all`.
#
# amd-debug-tools (the s2idle "doctor" for `apex doctor suspend`) is NOT yet
# packaged for F43 — install it here once it lands; for now it is a documented
# gap. The rest of the §10 battery stack (charge thresholds 75-80 with the
# udev-race fix, DYTC lapmode, ASPM/ABM/APST, RyzenAdj-under-lockdown via a
# signed ryzen_smu akmod) is apexd's job at M3 and is intentionally absent here.
RUN set -eux; \
    dnf5 -y install power-profiles-daemon; \
    systemctl enable power-profiles-daemon.service; \
    dnf5 clean all

# ── §4c mesa leg: codec-enabled VA drivers on STABLE mesa ──────────────────
# The base bakes the codec userland (full ffmpeg + gstreamer) but leaves the
# mesa VA/VDPAU drivers per-edition, because §4c pins Daily to Fedora's *stable*
# mesa and Gaming to a fresher mesa. Here on Daily we keep stable mesa and only
# swap Fedora's crippled VA/VDPAU drivers for RPMFusion's freeworld builds (they
# conflict, hence --allowerasing), which unlocks H.264/H.265 hardware decode on
# the AMD 780M's RADV stack — the whole point of the mpv.conf `hwdec=auto-safe`
# the base ships. RPMFusion is already enabled (base Stage 5a-codecs). Own dnf
# transaction, `dnf5 clean all`.
RUN set -eux; \
    dnf5 -y install --allowerasing \
        mesa-va-drivers-freeworld mesa-vdpau-drivers-freeworld; \
    dnf5 clean all

# ═══════════════════════════════════════════════════════════════════════════
# M2 — edition branding (Plymouth). The shared M2 concerns (APEX Shell first-boot
# provisioner, greeter session curation) + M3 (apexd) all live in the BASE now,
# so each flavor only sets its edition-specific Plymouth theme + kargs.
# ═══════════════════════════════════════════════════════════════════════════

# ── Plymouth boot splash: apex-os-chartreuse (Daily) ───────────────────────
# The VARIANT_ID=daily edition boots the chartreuse spark. Copy the theme, set
# it as the Plymouth default, then rebuild the CachyOS initramfs so the theme
# is actually present in the initrd bootc boots from (/usr/lib/modules/<kver>/
# initramfs.img). `plymouth-set-default-theme` WITHOUT -R only sets the default;
# we run dracut ourselves (mirroring the base's Stage-1 flags) because on bootc
# the initramfs is regenerated in-image, not by the tool's -R host path. The
# theme uses `ModuleName=script`, so the script plugin (plymouth-plugin-script)
# is required. Own dnf transaction, `dnf5 clean all` at the end.
COPY files/branding/plymouth/apex-os-chartreuse \
     /usr/share/plymouth/themes/apex-os-chartreuse
RUN set -eux; \
    dnf5 -y install plymouth plymouth-scripts plymouth-plugin-script; \
    plymouth-set-default-theme apex-os-chartreuse; \
    KVER="$(cat /usr/lib/apex-cachyos-kver)"; \
    dracut --force --no-hostonly --reproducible --zstd \
        --add plymouth --kver "${KVER}" \
        "/usr/lib/modules/${KVER}/initramfs.img"; \
    test -s "/usr/lib/modules/${KVER}/initramfs.img"; \
    dnf5 clean all
# Kernel args for the graphical splash. `quiet splash` per the theme's own
# README (files/branding/plymouth/README.md). NOTE: `quiet` raises the console
# loglevel, so it trims the verbose serial output the base's 10-apex-serial.toml
# enabled for CI/QEMU observability (warnings/errors still print). Drop `quiet`
# here if noisier boot logs are wanted. bootc merges all kargs.d files.
RUN set -eux; \
    mkdir -p /usr/lib/bootc/kargs.d; \
    printf 'kargs = ["quiet", "splash"]\n' \
        > /usr/lib/bootc/kargs.d/20-apex-plymouth.toml

# Informational lint.
RUN bootc container lint || true
