#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  bootc-install-lab — the ONLY supported way to run
#  `bootc install to-disk --via-loopback` on a developer machine.
#
#  ═══ WHICH LAYER IS PREVENTION, AND WHICH IS DETECTION ═══
#
#  Say this plainly, because the first version of this file did not and the
#  machine paid for it the same night.
#
#  PREVENTION — `bootc install --generic-image`. bootc's own help: "Changes to
#  the system firmware will be skipped." It is the only thing here that stops
#  the write. This script puts it in the argv itself and REFUSES TO LAUNCH
#  without it (assertion `generic-image-present`, exit 7).
#
#  DETECTION — tests/lab/nvram-guard, which every run below goes through. It
#  reads `efibootmgr -v` and the efivarfs `Boot*` digests before and after and
#  fails the run if they moved. It cannot prevent anything. It is also the only
#  layer that has ever actually caught this defect, and it has caught it twice.
#
#  DEFENCE IN DEPTH, AND INERT AGAINST bootc — the `--tmpfs` over
#  /sys/firmware/efi/efivars, and the refusals of a caller mount at that path
#  or any parent of it. Keep them; they bound a process that stays inside the
#  container. bootc is not such a process (see below). Do not call them the
#  protection.
#
#  HYGIENE, NOT FIRMWARE SAFETY — the block-device and tmpfs target refusals.
#  They keep the lab off real disks and out of RAM. Neither is about NVRAM.
#
#  ═══ WHY THE MASK CANNOT BE THE GUARD ═══
#
#  `bootc install` needs `--pid=host` and RE-ENTERS THE HOST'S MOUNT NAMESPACE
#  for the bootloader step. Measured on the L16, 2026-09-20, not deduced:
#
#      * `strings /usr/bin/bootc` (1.16.10 on the host, 1.16.13 in the image)
#        carries `nsenter`, `/proc/1/ns/mnt` and `/proc/1/root`;
#      * an UNMASKED `--privileged --pid=host` container shows ZERO entries
#        under /sys/firmware/efi/efivars and zero efivars mounts in its own
#        /proc/self/mountinfo. The host's efivarfs was never in the container's
#        view, so a tmpfs over an empty path changes nothing.
#
#  A tmpfs mounted INSIDE the container is therefore irrelevant to an operation
#  that deliberately leaves the container. Proven the expensive way on
#  2026-09-20: an install launched at 21:53:26 with the mask applied printed
#      Loopback target: this machine's UEFI boot entries are masked off and
#      will not be touched.
#  and moved `Boot0000` off the real ESP four log lines later. nvram-guard
#  caught it when the command returned, and the exact bytes were restored from
#  its own before-snapshot.
#  /var/lab-scratch/apex-luks-live.ZAGaYm/engine-stdout.txt
#
#  ═══ THE TWO INCIDENTS, AS THEY ACTUALLY HAPPENED ═══
#
#  Neither was a `--via-loopback` command, and this matters: the repository
#  scan in tests/test-bootc-install-guard.sh keys on that literal string and
#  would not have caught either one. Both were `installer/apex-install` doing
#  `bootc install to-filesystem` against a LOOP DEVICE the test suite had
#  already attached, inside `localhost/apex-os:daily`.
#
#    09:02:17 AWST  bootupd ran `efibootmgr -b 0000 -B` and then `--create
#                   --disk /dev/loop1 --part 1`, replacing Boot0000 with
#                   PARTUUID ee26313c-… — the ESP inside the image file being
#                   built, which exists on no physical disk. Found at the next
#                   power-on. Repaired from a live USB.
#                   /var/lab-scratch/apex-luks-live.oRDxu4/engine-stdout.txt
#                   is that run's log. BOOT-BREAKAGE-2026-09-20.md.
#    21:53:26       the same write, with the efivars mask in place and its
#                   promise printed, four hours after the mask landed as "the
#                   fix"; NVRAM had moved by 22:12:15. Caught by nvram-guard on
#                   return; restored from its before-snapshot; never booted
#                   broken. apex-luks-live.ZAGaYm/engine-stdout.txt
#
#  What a caller must now pass: nothing. `--generic-image` is not an option on
#  this script and cannot be switched off. What happens if the line is removed
#  from this file: `generic-image-present` fails, exit 7, and podman is never
#  invoked — tests/test-bootc-install-guard.sh proves that by deleting the line
#  from a copy and watching the refusal.
#
#  ═══ WHAT THIS DOES NOT COVER ═══
#
#  Real installs onto real hardware (`installer/apex-install`, the live ISO)
#  MUST write the host's NVRAM — that is the entire point of installing an
#  operating system. This wrapper is loopback-only and refuses a block device
#  target, so the two paths cannot be confused for one another.
#
#  Usage:
#      tests/lab/bootc-install-lab [options] IMAGE TARGET.img [-- BOOTC_ARG...]
#
#      --dry-run           run every refusal and the mask assertion, print the
#                          argv that WOULD run, launch nothing
#      --size SIZE         create TARGET.img at this size if absent (default 20G)
#      --filesystem FS     bootc --filesystem (default ext4)
#      --bootloader NAME   bootc --bootloader (omitted by default, so bootc
#                          picks it). Rule 5 USED to say "GRUB stays the
#                          default"; since Andre's 2026-09-20 decision it says
#                          APEX moves to systemd-boot on every machine, and
#                          that only works on --composefs-backend — on the
#                          ostree backend `--bootloader systemd` is refused
#                          outright. So this flag is passed through, not
#                          defaulted, and rule 5 is not an argument for either
#                          value here.
#      --podman-arg ARG    extra podman argument, repeatable, still refused if
#                          it touches /sys
#      --out DIR           keep the nvram-guard snapshot pair here
#
#  Run it under sudo; `podman` is taken from PATH so the suite can intercept.
#
#  Exit codes: 0 ok · 2 usage · 5 refused by name · 6 efivars-mask-present ·
#              7 generic-image-present (THE one that prevents) ·
#              plus nvram-guard's 3 (nvram-changed) and 4 (could-not-snapshot).
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NVRAM_GUARD="$HERE/nvram-guard"

DRY_RUN=0
SIZE=20G
FILESYSTEM=ext4
BOOTLOADER=""
OUT=""
EXTRA_PODMAN=()
EXTRA_BOOTC=()
POSITIONAL=()

die()     { printf '\n!!! bootc-install-lab: %s\n' "$*" >&2; exit 2; }
refuse()  { printf '\n!!! bootc-install-lab REFUSED [%s]\n' "$1" >&2; shift
            printf '    %s\n' "$@" >&2
            printf '\n    See BOOT-BREAKAGE-2026-09-20.md and AGENTS.md "Touching a machine'"'"'s boot path".\n' >&2
            exit 5; }
info()    { printf '    %s\n' "$*" >&2; }

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)     DRY_RUN=1; shift ;;
        --size)        SIZE="${2:?--size needs a value}"; shift 2 ;;
        --filesystem)  FILESYSTEM="${2:?--filesystem needs a value}"; shift 2 ;;
        --bootloader)  BOOTLOADER="${2:?--bootloader needs a value}"; shift 2 ;;
        --out)         OUT="${2:?--out needs a directory}"; shift 2 ;;
        --podman-arg)  EXTRA_PODMAN+=("${2:?--podman-arg needs a value}"); shift 2 ;;
        --)            shift; EXTRA_BOOTC=("$@"); break ;;
        -h|--help)     sed -n '2,110p' "$0"; exit 0 ;;
        -*)            die "unknown option $1" ;;
        *)             POSITIONAL+=("$1"); shift ;;
    esac
done

[ "${#POSITIONAL[@]}" -eq 2 ] || die "need exactly IMAGE and TARGET.img; got ${#POSITIONAL[@]} positional argument(s)"
IMAGE="${POSITIONAL[0]}"
TARGET="${POSITIONAL[1]}"

# ═════════════════════════════════════════════════════════════════════════════
#  Refusals. Every one of these runs before anything is created or launched,
#  and before both argv assertions, so a refusal can never be mistaken for one.
# ═════════════════════════════════════════════════════════════════════════════

# ── the target must be a FILE, never a disk ─────────────────────────────────
# `--via-loopback` means "install into an image file". A block device here is
# either a typo or the real installer's job, and neither belongs in the lab.
case "$TARGET" in
    /dev/*) refuse "target-is-a-device" \
        "TARGET is $TARGET, which is under /dev." \
        "This wrapper runs loopback installs into IMAGE FILES only." \
        "Installing onto real hardware is installer/apex-install's job, from the live ISO." ;;
esac
if [ -b "$TARGET" ]; then
    refuse "target-is-a-device" \
        "TARGET $TARGET is a block device." \
        "This wrapper runs loopback installs into IMAGE FILES only."
fi

# ── never in RAM ────────────────────────────────────────────────────────────
# /tmp on these machines is a 15 GB tmpfs on 29 GB of RAM. The sdboot lab's own
# first runs put 20 GiB disk images there and cost the machine its memory
# headroom before it was noticed (ROADMAP/evidence/sdboot-image-20260920-lab.md).
TARGET_DIR="$(cd "$(dirname "$TARGET")" 2>/dev/null && pwd || true)"
[ -n "$TARGET_DIR" ] || die "the directory holding $TARGET does not exist"
case "$TARGET_DIR" in
    /tmp|/tmp/*|/dev/shm|/dev/shm/*)
        refuse "target-is-in-ram" \
            "TARGET lives under $TARGET_DIR, which is a tmpfs — the image would be held in RAM." \
            "Put it on real disk: /var/lab-scratch/." ;;
esac
if command -v stat >/dev/null 2>&1; then
    fstype="$(stat -f -c %T "$TARGET_DIR" 2>/dev/null || echo unknown)"
    if [ "$fstype" = tmpfs ] || [ "$fstype" = ramfs ]; then
        refuse "target-is-in-ram" \
            "TARGET lives on a $fstype at $TARGET_DIR — the image would be held in RAM." \
            "Put it on real disk: /var/lab-scratch/."
    fi
fi

# ── a caller-supplied mount must not re-expose the host's firmware ──────────
# A tmpfs over /sys/firmware/efi/efivars is undone by ANY bind of an ancestor,
# so the ancestors are refused too. `-v /sys:/sys` is the realistic one: it
# looks harmless and hands the container the real efivarfs.
EFIVARS_PARENTS="/sys /sys/firmware /sys/firmware/efi /sys/firmware/efi/efivars"

# The destination field differs per flag and getting it wrong is how a check
# like this passes everything: `-v SRC:DST[:opts]`, `--tmpfs DST[:opts]`,
# `--mount type=...,target=DST`.
spec_destination() {   # $1 = volume|tmpfs|mount, $2 = the spec
    local kind="$1" spec="$2" dst=""
    case "$kind" in
        tmpfs)  dst="${spec%%:*}" ;;
        mount)  case "$spec" in
                    *target=*)      dst="${spec##*target=}";      dst="${dst%%,*}" ;;
                    *destination=*) dst="${spec##*destination=}"; dst="${dst%%,*}" ;;
                esac ;;
        volume) case "$spec" in
                    *:*) dst="${spec#*:}"; dst="${dst%%:*}" ;;
                    *)   dst="$spec" ;;
                esac ;;
    esac
    printf '%s' "$dst"
}

check_not_firmware() {   # $1 = a destination path
    local dst="${1%/}" p
    [ -n "$dst" ] || return 0
    for p in $EFIVARS_PARENTS; do
        [ "$dst" = "$p" ] || continue
        refuse "caller-unmasks-efivars" \
            "a --podman-arg mounts something at $dst." \
            "That is /sys/firmware/efi/efivars or an ancestor of it, so the host's real" \
            "EFI variables would be visible inside a --privileged container — which is" \
            "exactly what deleted Boot0000 on 2026-09-20. A tmpfs over the leaf is undone" \
            "by a bind of any parent, so the parents are refused too." \
            "If you need something from /sys, mount it at a path that is not a parent" \
            "of /sys/firmware/efi/efivars."
    done
}

# podman takes the destination as the NEXT argument for the bare forms, so the
# scan is a two-state machine rather than a per-argument test.
expect_kind=""
for a in ${EXTRA_PODMAN[@]+"${EXTRA_PODMAN[@]}"}; do
    if [ -n "$expect_kind" ]; then
        check_not_firmware "$(spec_destination "$expect_kind" "$a")"
        expect_kind=""
        continue
    fi
    case "$a" in
        -v|--volume) expect_kind=volume ;;
        --tmpfs)     expect_kind=tmpfs ;;
        --mount)     expect_kind=mount ;;
        --volume=*)  check_not_firmware "$(spec_destination volume "${a#--volume=}")" ;;
        --tmpfs=*)   check_not_firmware "$(spec_destination tmpfs  "${a#--tmpfs=}")" ;;
        --mount=*)   check_not_firmware "$(spec_destination mount  "${a#--mount=}")" ;;
        # One --podman-arg holding the whole thing, e.g. "-v /sys:/sys". These
        # must come BEFORE -v?* or that pattern swallows them and reads the
        # source path as the destination.
        "-v "*|"--volume "*) check_not_firmware "$(spec_destination volume "${a#* }")" ;;
        "--tmpfs "*)         check_not_firmware "$(spec_destination tmpfs  "${a#* }")" ;;
        "--mount "*)         check_not_firmware "$(spec_destination mount  "${a#* }")" ;;
        -v?*)        check_not_firmware "$(spec_destination volume "${a#-v}")" ;;
    esac
done
[ -z "$expect_kind" ] || die "--podman-arg $expect_kind was given with no destination after it"

# ═════════════════════════════════════════════════════════════════════════════
#  The argv. Built here so that no caller can leave a piece of it out.
# ═════════════════════════════════════════════════════════════════════════════
PODMAN_ARGS=(run --rm --privileged --pid=host
             --security-opt label=type:unconfined_t
             -v /var/lib/containers:/var/lib/containers
             -v /dev:/dev)

# ── THE MASK. Kept as defence in depth against a process that stays inside
# ── the container, and INERT against bootc, which nsenters into the host's
# ── mount namespace for the bootloader step — see the header. It is not the
# ── protection; `--generic-image` below is. Removing this line is still
# ── mutated by tests/test-bootc-install-guard.sh, and `efivars-mask-present`
# ── is what must go red when it does.
PODMAN_ARGS+=(--tmpfs /sys/firmware/efi/efivars)   # efivars-mask

PODMAN_ARGS+=(-v "$TARGET_DIR:/work")
PODMAN_ARGS+=(${EXTRA_PODMAN[@]+"${EXTRA_PODMAN[@]}"})
PODMAN_ARGS+=("$IMAGE" bootc install to-disk --via-loopback --wipe
              --filesystem "$FILESYSTEM")

# ── THE PREVENTION. bootc: "Changes to the system firmware will be skipped."
# ── A loopback image is never this machine's firmware's business. Removing
# ── this line is what tests/test-bootc-install-guard.sh mutates, and
# ── `generic-image-present` below is what must go red when it does.
PODMAN_ARGS+=(--generic-image)   # generic-image
[ -n "$BOOTLOADER" ] && PODMAN_ARGS+=(--bootloader "$BOOTLOADER")
PODMAN_ARGS+=(${EXTRA_BOOTC[@]+"${EXTRA_BOOTC[@]}"})
PODMAN_ARGS+=("/work/$(basename "$TARGET")")

# ═════════════════════════════════════════════════════════════════════════════
#  efivars-mask-present — the named assertion.
#
#  It reads the ASSEMBLED ARGV, not a variable that was set and never used, and
#  it compares against the literal path written right here rather than against
#  the constant used to build the argv, so a mutation of either one is caught.
# ═════════════════════════════════════════════════════════════════════════════
assert_efivars_mask_present() {
    local i v found=0
    for (( i = 0; i < ${#PODMAN_ARGS[@]}; i++ )); do
        v=""
        case "${PODMAN_ARGS[i]}" in
            --tmpfs)   v="${PODMAN_ARGS[i+1]:-}" ;;
            --tmpfs=*) v="${PODMAN_ARGS[i]#--tmpfs=}" ;;
            *)         continue ;;
        esac
        v="${v%%:*}"; v="${v%/}"
        [ "$v" = "/sys/firmware/efi/efivars" ] && found=1
    done
    if [ "$found" != 1 ]; then
        printf '\n!!! bootc-install-lab ASSERTION FAILED [efivars-mask-present]\n' >&2
        printf '    The podman argv about to run carries no tmpfs over\n' >&2
        printf '    /sys/firmware/efi/efivars, so a --privileged container would see this\n' >&2
        printf '    machine'"'"'s real UEFI boot variables read-write.\n' >&2
        printf '    Nothing was launched. This is the 2026-09-20 breakage, refused.\n' >&2
        printf '    argv: %s\n' "${PODMAN_ARGS[*]}" >&2
        exit 6
    fi
}
assert_efivars_mask_present

# ═════════════════════════════════════════════════════════════════════════════
#  generic-image-present - the assertion that actually prevents the 2026-09-20
#  write, and the reason this script exists in its second form.
#
#  Scanned only AFTER the `bootc install` token, so that a --podman-arg
#  containing the literal string cannot satisfy it: podman would treat it as
#  one of its own arguments and bootc would never see it. Compared against the
#  literal written here rather than against the array element used to build the
#  argv, so mutating either one is caught.
# ═════════════════════════════════════════════════════════════════════════════
assert_generic_image_present() {
    local i bootc_at=-1 found=0
    for (( i = 0; i + 1 < ${#PODMAN_ARGS[@]}; i++ )); do
        if [ "${PODMAN_ARGS[i]}" = bootc ] && [ "${PODMAN_ARGS[i+1]}" = install ]; then
            bootc_at=$i; break
        fi
    done
    if [ "$bootc_at" -lt 0 ]; then
        printf '\n!!! bootc-install-lab ASSERTION FAILED [generic-image-present]\n' >&2
        printf '    The assembled argv contains no `bootc install` at all, so this check\n' >&2
        printf '    would have inspected nothing. That is the defect this repository pays\n' >&2
        printf '    for most often, and it fails here rather than passing quietly.\n' >&2
        printf '    argv: %s\n' "${PODMAN_ARGS[*]}" >&2
        exit 7
    fi
    for (( i = bootc_at + 2; i < ${#PODMAN_ARGS[@]}; i++ )); do
        [ "${PODMAN_ARGS[i]}" = "--generic-image" ] && found=1
    done
    if [ "$found" != 1 ]; then
        printf '\n!!! bootc-install-lab ASSERTION FAILED [generic-image-present]\n' >&2
        printf '    The bootc command about to run carries no --generic-image, so bootc\n' >&2
        printf '    would perform its firmware step: bootupd would run efibootmgr against\n' >&2
        printf '    THIS MACHINE and point Boot0000 at an ESP inside the image file.\n' >&2
        printf '    Nothing was launched. This is the 2026-09-20 breakage, refused.\n' >&2
        printf '    The efivars tmpfs does NOT cover this: bootc nsenters into the host\n' >&2
        printf '    mount namespace for that step. See this file'"'"'s header.\n' >&2
        printf '    argv: %s\n' "${PODMAN_ARGS[*]}" >&2
        exit 7
    fi
}
assert_generic_image_present

# ═════════════════════════════════════════════════════════════════════════════
#  Launch
# ═════════════════════════════════════════════════════════════════════════════
GUARD=("$NVRAM_GUARD" --label "bootc-install-lab:$(basename "$TARGET")")
[ -n "$OUT" ] && GUARD+=(--out "$OUT")
GUARD+=(--)

if [ "$DRY_RUN" = 1 ]; then
    printf 'bootc-install-lab --dry-run: nothing was launched. The command is:\n\n'
    printf '%q ' "${GUARD[@]}" podman "${PODMAN_ARGS[@]}"
    printf '\n\ngeneric-image-present: ok  - PREVENTION: bootc skips the firmware step\n'
    printf 'efivars-mask-present:  ok  - defence in depth only; inert against bootc,\n'
    printf '                              which nsenters into the host mount namespace\n'
    exit 0
fi

if [ ! -e "$TARGET" ]; then
    info "creating $TARGET ($SIZE)"
    truncate -s "$SIZE" "$TARGET"
fi

[ -x "$NVRAM_GUARD" ] || die "$NVRAM_GUARD is missing or not executable — the second layer is not optional"

info "image:  $IMAGE"
info "target: $TARGET"
info "podman run ${PODMAN_ARGS[*]:1}"
exec "${GUARD[@]}" podman "${PODMAN_ARGS[@]}"
