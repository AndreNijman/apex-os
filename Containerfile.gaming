# ─────────────────────────────────────────────────────────────────────────
# APEX-OS — Gaming edition (gold)
#
#   FROM apex-base → stamp VARIANT=Gaming + GPU split.
#
#   ARG GPU=nvidia  →  RPMFusion + DIY NVIDIA akmod built against the base's
#                      CachyOS kernel, in its OWN stage, HARD-FAIL on failure.
#   ARG GPU=mesa    →  no akmod (mesa is already in the base via the desktop
#                      stack) — an all-AMD/Intel gaming image.
#
# GPU/akmod split: the NVIDIA akmod builds in the pipeline against the shared
# CachyOS kernel (HARD-FAIL if it does not build/resolve — a Gaming image whose
# NVIDIA module is missing must never ship). v2.8 adds the gaming userspace on
# top: nvidia driver libs + CUDA, the §4c fresher mesa leg (Terra, freeworld
# fallback), Steam (baked), gamescope/MangoHud/gamemode, and best-effort
# peripheral tools. Still to land in a later pass: Proton-GE, WiVRn/Monado,
# Sunshine, OBS, and the xone/xpadneo controller akmods (need a CachyOS-matched
# akmod source — see the userspace stage note).
# ─────────────────────────────────────────────────────────────────────────
ARG BASE=localhost/apex-base:latest
FROM ${BASE}

ARG APEX_REVISION=dev
ARG GPU=nvidia
LABEL org.opencontainers.image.title="APEX-OS Gaming" \
      org.opencontainers.image.description="APEX-OS Gaming edition (gold) — performance-tuned desktop; GPU=nvidia|mesa" \
      org.opencontainers.image.source="https://github.com/AndreNijman/apex-os" \
      org.opencontainers.image.revision="${APEX_REVISION}" \
      org.opencontainers.image.version="gaming" \
      org.opencontainers.image.vendor="APEX-OS" \
      org.apex-os.gpu="${GPU}"

# ── Edition stamp ──────────────────────────────────────────────────────────
# VARIANT_ID=gaming drives apex-greet's gold spark + accent.
RUN set -eux; \
    printf 'VARIANT="Gaming"\nVARIANT_ID=gaming\n' >> /usr/lib/os-release

# ── GPU stage: DIY NVIDIA akmod (own stage, HARD-FAIL) ─────────────────────
# nvidia: enable RPMFusion, install the akmods framework + akmod-nvidia source,
# compile the module against the base's CachyOS kernel (kver stamped at
# /usr/lib/apex-cachyos-kver by the base; -devel-matched headers already present
# at /usr/src/kernels/<kver>), install the produced kmod RPM, and VERIFY that
# `modinfo` resolves nvidia against that exact kernel. `set -e` means any
# failure — akmods rc!=0, no kmod RPM produced, or modinfo unresolved — aborts
# the whole build. RPMFusion is left enabled so the gaming userspace driver +
# apps can be layered from it later.
#
# mesa: nothing to do — mesa ships in the base. This keeps a single Containerfile
# serving both matrix legs (GPU=nvidia and GPU=mesa).
RUN set -eux; \
    if [ "${GPU}" = "nvidia" ]; then \
        KVER="$(cat /usr/lib/apex-cachyos-kver)"; \
        echo "Building NVIDIA akmod against CachyOS kver: ${KVER}"; \
        dnf5 -y install \
            "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm" \
            "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm"; \
        dnf5 -y install akmods akmod-nvidia kmodtool gcc make; \
        test -d "/usr/src/kernels/${KVER}" \
            || { echo "FATAL: kernel-devel headers missing for ${KVER}"; exit 1; }; \
        akmods --force --kernels "${KVER}" --kmod nvidia; \
        RPM="$(ls /var/cache/akmods/nvidia/kmod-nvidia-*.rpm 2>/dev/null | head -1)"; \
        test -n "${RPM}" && test -f "${RPM}" \
            || { echo "FATAL: NVIDIA akmod did not produce a kmod RPM"; \
                 cat /var/cache/akmods/nvidia/*.failed.log 2>/dev/null || true; exit 1; }; \
        echo "Built kmod RPM: ${RPM}"; \
        dnf5 -y install "${RPM}"; \
        depmod -a "${KVER}"; \
        modinfo -k "${KVER}" nvidia > /tmp/modinfo-nvidia.txt \
            || { echo "FATAL: modinfo nvidia unresolved for ${KVER}"; exit 1; }; \
        NVIDIA_VER="$(rpm -q --qf '%{VERSION}' akmod-nvidia)"; \
        printf 'PASS driver=%s kver=%s\n' "${NVIDIA_VER}" "${KVER}" \
            > /usr/lib/apex-nvidia-akmod-status; \
        echo "=== modinfo nvidia (kver ${KVER}) ==="; head -8 /tmp/modinfo-nvidia.txt; \
    elif [ "${GPU}" = "mesa" ]; then \
        echo "GPU=mesa: no akmod needed (mesa is in the base)"; \
        printf 'MESA no-akmod\n' > /usr/lib/apex-nvidia-akmod-status; \
    else \
        echo "FATAL: unknown GPU='${GPU}' (expected nvidia|mesa)"; exit 1; \
    fi; \
    dnf5 clean all

# ── GPU userspace: nvidia driver libs + CUDA (nvidia leg only) ─────────────
# The akmod stage above built and verified the kernel MODULE. A working Gaming-
# nvidia system also needs the USERSPACE driver (libGL/libnvidia-*) and — per the
# v2.8 plan — the CUDA toolkit runtime on the nvidia edition. The VA-API↔NVDEC
# bridge (RPMFusion renamed it nvidia-vaapi-driver → libva-nvidia-driver) gives
# the base's codec userland HW decode on nvidia too; best-effort (--skip-
# unavailable, both names) so a rename can never abort the critical driver + CUDA
# install. RPMFusion is already enabled (base + the akmod stage). mesa leg: nothing
# here (mesa userspace comes from the base / the mesa-git stage below). Own dnf
# transaction, `dnf5 clean all`.
RUN set -eux; \
    if [ "${GPU}" = "nvidia" ]; then \
        dnf5 -y install xorg-x11-drv-nvidia xorg-x11-drv-nvidia-cuda; \
        dnf5 -y install --skip-unavailable libva-nvidia-driver nvidia-vaapi-driver; \
        echo "nvidia userspace + CUDA installed"; \
    else \
        echo "GPU=mesa: no nvidia userspace"; \
    fi; \
    dnf5 clean all

# ── §4c mesa leg: mesa-git (Gaming) ────────────────────────────────────────
# §4c pins Gaming to mesa-*git* (main-branch RADV): per-release FPS/stutter fixes
# ahead of the fc43-pinned base, for native-Linux titles + the compositor (Proton
# titles also benefit via the pressure-vessel runtime). Andre ruled this with the
# guardrail dropped — mesa-git's weekly regression risk is covered by bootc
# rollback + `apex pin`, and mesa flavor is an M7 bench variable. mesa-git is
# built from source so it is inherently codec-enabled (H.264/H.265 HW decode).
#
# The COPR is enabled only for the bake and disabled after (bootc: the image is
# immutable and rebuilt weekly by CI, which is how it stays current — a volatile
# git COPR left enabled at runtime is the wrong update path). Layered fallback for
# CI determinism: mesa-git COPR → Terra latest-stable → Fedora-stable + freeworld
# VA. Codecs work in every leg; only "how fresh" degrades. Own dnf transaction.
RUN set -eux; \
    if dnf5 -y copr enable xxmitsu/mesa-git \
       && dnf5 -y distro-sync "mesa*"; then \
        dnf5 -y copr disable xxmitsu/mesa-git; \
        echo "gaming mesa: mesa-git (xxmitsu COPR, main-branch RADV)" > /usr/lib/apex-mesa-leg; \
    elif dnf5 -y install --nogpgcheck \
            --repofrompath "terra,https://repos.fyralabs.com/terra\$releasever" \
            terra-release \
         && dnf5 -y distro-sync "mesa*"; then \
        dnf5 -y remove terra-release || true; \
        echo "gaming mesa: Terra latest-stable (mesa-git COPR fallback)" > /usr/lib/apex-mesa-leg; \
    else \
        echo "mesa-git + Terra unavailable — Fedora-stable + RPMFusion freeworld VA"; \
        dnf5 -y install --allowerasing \
            mesa-va-drivers-freeworld mesa-vdpau-drivers-freeworld; \
        echo "gaming mesa: Fedora-stable + freeworld VA (last-resort fallback)" > /usr/lib/apex-mesa-leg; \
    fi; \
    rm -f /etc/yum.repos.d/terra*.repo /etc/yum.repos.d/*terra*.repo; \
    cat /usr/lib/apex-mesa-leg; \
    dnf5 clean all

# ── Gaming userspace: Steam + tooling + peripherals ────────────────────────
# Steam is BAKED into the Gaming edition (v2.7). steam-devices ships the
# controller/HMD udev rules (the reliable, kernel-build-free half of the
# controller stack). gamescope/mangohud/gamemode/vulkan-tools are the core
# gaming runtime. dualsensectl + openrgb are peripheral tools installed
# best-effort (`--skip-unavailable`) so a missing package never breaks the build.
#
# NOTE — controller akmods (xone/xpadneo) are DEFERRED, not forgotten: they are
# out-of-tree kernel modules that must be rebuilt against the CachyOS COPR kernel
# (same class as the nvidia akmod), and no akmod source is currently published
# that matches this kernel — a prebuilt kmod would be for the wrong kernel. Xbox
# pads work via in-kernel xpad and DualSense via in-kernel hid-playstation today;
# xpadneo/xone (rumble, battery, dongle) land once a matched akmod source exists.
RUN set -eux; \
    dnf5 -y install \
        steam steam-devices \
        gamescope mangohud gamemode vulkan-tools; \
    dnf5 -y install --skip-unavailable dualsensectl openrgb; \
    dnf5 clean all

# ═══════════════════════════════════════════════════════════════════════════
# M2 — edition branding (Plymouth). Shared M2 (provisioner, session curation) +
# M3 (apexd) live in the BASE; this flavor only sets its gold Plymouth theme.
# Placed AFTER the GPU stage so the Plymouth initramfs rebuild is the one shipped.
# ═══════════════════════════════════════════════════════════════════════════

# ── Plymouth boot splash: apex-os-gold (Gaming) ────────────────────────────
# VARIANT_ID=gaming boots the gold spark. Copy the theme, set it as the Plymouth
# default, then rebuild the CachyOS initramfs (the initrd bootc boots from,
# /usr/lib/modules/<kver>/initramfs.img) so the theme is present in it. Uses the
# same dracut flags as the base's Stage 1; `--add plymouth` pulls in the daemon
# + the default (gold) theme, which uses `ModuleName=script` (plymouth-plugin-
# script). Own dnf transaction, `dnf5 clean all` at the end. This is the LAST
# initramfs regeneration in the gaming build.
COPY files/branding/plymouth/apex-os-gold \
     /usr/share/plymouth/themes/apex-os-gold
RUN set -eux; \
    dnf5 -y install plymouth plymouth-scripts plymouth-plugin-script; \
    plymouth-set-default-theme apex-os-gold; \
    KVER="$(cat /usr/lib/apex-cachyos-kver)"; \
    dracut --force --no-hostonly --reproducible --zstd \
        --add plymouth --kver "${KVER}" \
        "/usr/lib/modules/${KVER}/initramfs.img"; \
    test -s "/usr/lib/modules/${KVER}/initramfs.img"; \
    dnf5 clean all
# Kernel args for the graphical splash. `quiet splash` per the theme's own
# README (files/branding/plymouth/README.md). NOTE: `quiet` raises the console
# loglevel, so it trims the verbose serial output the base's 10-apex-serial.toml
# enabled for CI/QEMU observability (warnings/errors still print). Drop `quiet`
# here if noisier boot logs are wanted. bootc merges all kargs.d files.
RUN set -eux; \
    mkdir -p /usr/lib/bootc/kargs.d; \
    printf 'kargs = ["quiet", "splash"]\n' \
        > /usr/lib/bootc/kargs.d/20-apex-plymouth.toml

RUN bootc container lint || true
