# ─────────────────────────────────────────────────────────────────────────
# APEX-OS — base image (thin, fast-moving tier)
#
#   FROM apex-os-core@<digest>
#     → apexd + apex CLI (compiled here)
#     → sysprofiles, D-Bus policy, polkit rules, systemd units
#     → every COPY out of files/**  (branding, dotfile templates, greeter,
#       provisioner, helpers, sudoers rules)
#     → the vendored APEX Shell + its read-only-/usr path rewrites
#
# ═══ WHY THE SPLIT: this tier is the one that changes ═══
#
# `apex update` used to re-download the entire OS on every push. The base job's
# path filter fires on files/**, apexd/** and config/** — almost every commit —
# and a cacheless rebuild gives every layer a new digest even when the content
# is identical, so bootc could reuse nothing. Measured on the author's L16 the
# published daily image was 155 layers / 5.07 GiB compressed, and essentially
# all of it moved every time.
#
# So the ~95% that does not change per commit now lives in Containerfile.core
# and is consumed here by DIGEST. A digest-pinned FROM reuses those layer
# descriptors verbatim: bootc already holds the blobs and fetches none of them.
# What is left in this file is the volatile remainder — a handful of COPY layers
# and two small binaries, tens of MiB rather than gigabytes.
#
# ── The rule for anything added here ──
# If it runs `dnf`, downloads, or compiles a third-party program, it belongs in
# Containerfile.core. This tier may only COPY repo content, compile apexd, and
# assert against those. A RUN that needs both must be split across the two
# files — see the zsh verification, the Windows-boot helper and the Hyprland
# template guards below, each of which is the base half of a pair.
#
# ── CORE must be pinned by digest ──
# CI passes --build-arg CORE=ghcr.io/andrenijman/apex-os-core@sha256:… . The
# `:latest` default exists only so a local `podman build -f Containerfile.base .`
# works; a tag would defeat the whole point in CI, because a tag that moves
# gives no reuse guarantee at all.
# ─────────────────────────────────────────────────────────────────────────
ARG CORE=ghcr.io/andrenijman/apex-os:core

# ═══ apexd builder ═══════════════════════════════════════════════════════
# Built FROM the core image rather than a bare fedora-bootc, on purpose: core
# already carries rust + cargo (the baked dev toolchain), so this stage installs
# nothing and starts compiling immediately. It also guarantees the compiler that
# builds apexd is exactly the one shipped to users.
#
# apexd + apex are the workspace under apexd/; they embed config/sysprofiles/*.toml
# via include_str!, so config/ must sit at ../../../config relative to the crate —
# hence both apexd/ and config/ are copied under /build/.
FROM ${CORE} AS apex-builder
# /root is special in bootc images (symlink → /var/roothome), so cargo's default
# $HOME/.cargo fails ("File exists" on mkdir). Point CARGO_HOME at the build tree.
ENV CARGO_HOME=/build/.cargo
COPY apexd/ /build/apexd/
COPY config/ /build/config/
RUN set -eux; cd /build/apexd; cargo build --release --locked; \
    install -Dm755 target/release/apexd       /out/usr/bin/apexd; \
    install -Dm755 target/release/apex        /out/usr/bin/apex; \
    install -Dm755 target/release/apex-agentd /out/usr/bin/apex-agentd; \
    install -Dm755 target/release/apex-aid    /out/usr/bin/apex-aid

# ─────────────────────────────────────────────────────────────────────────
FROM ${CORE}

# OCI provenance. The git SHA is injected by CI (--build-arg APEX_REVISION=…)
# so every image is traceable back to the exact source commit — the plan's
# "image carries git SHA" rule (org.opencontainers.image.revision).
# ── apexd + apex CLI + apex-agentd: static payload only ─────────────────────
# The BINARIES are deliberately NOT copied here. They are the most volatile
# content in the image — every apexd commit changes them — and this is layer 1
# of roughly eighty, so copying them here made any `apexd/` change invalidate
# the entire base image.
#
# That is not theoretical: the build after the agent-runtime merge rebuilt and
# re-pushed every layer below this point and was killed at GitHub's six-hour job
# limit, having reached step 76 of 83. The previous successful build took 3h16m.
# `podman build --cache-to` pushes each intermediate layer to the registry
# separately, so a cache miss here costs ~80 rebuilds AND ~80 registry pushes.
#
# The binaries now land at the very END of this file, after everything static.
# An apexd-only change therefore rebuilds the last two layers instead of eighty.
# Everything below that needs them at build time was moved down with them.
#
# What stays here is the static payload: unit files, D-Bus policy, polkit rules
# and the sysprofiles. Those are repository files that change rarely, so they
# keep their cheap early position.
COPY config/sysprofiles/ /usr/share/apexos/sysprofiles/
COPY apexd/apexd/apexd.service /usr/lib/systemd/system/apexd.service
COPY files/system/dbus-1/system-services/org.apexos.Apexd1.service \
     /usr/share/dbus-1/system-services/org.apexos.Apexd1.service
COPY files/system/dbus-1/system.d/org.apexos.Apexd1.conf \
     /usr/share/dbus-1/system.d/org.apexos.Apexd1.conf
COPY files/system/polkit-1/actions/org.apexos.apexd.policy \
     /usr/share/polkit-1/actions/org.apexos.apexd.policy
COPY files/system/polkit-1/rules.d/49-apex-singbox.rules \
     /usr/share/polkit-1/rules.d/49-apex-singbox.rules
COPY files/system/units/sing-box.service /usr/lib/systemd/system/sing-box.service

# ── MT7925 Wi-Fi: survive a suspend ──────────────────────────────────────────
# The L16's mt7925e comes back from s2idle with its receive path wedged. The
# link looks healthy and is not: -45 dBm signal, tx negotiated at 156 Mbit/s,
# rx pinned to VHT-MCS 0 (7.2 Mbit/s), and two thirds of packets to the local
# gateway lost. TCP connects and then stalls, so it reads as "the internet is
# slow" rather than as a driver fault, and the standing workaround was to
# reboot.
#
# Measured on the machine, in order of increasing violence:
#   power save off      66% loss -> 50%
#   re-associate        50% loss -> 33%, rx still MCS 0
#   reload mt7925e      0% loss, rx 144 Mbit/s
#
# So both ship. The sleep hook is CONDITIONAL — it pings the gateway and only
# reloads when the link is actually failing — because an unconditional reload
# would add ~15 s of no network to every lid-open, and most of them are fine.
# It also refuses to act unless the driver really is mt7925e: these images run
# on more than one machine, and cycling the radio on hardware without this fault
# would be a regression invented by a fix for someone else's laptop.
COPY files/system/NetworkManager/20-apex-wifi-powersave.conf \
     /etc/NetworkManager/conf.d/20-apex-wifi-powersave.conf
COPY --chmod=0755 files/system/system-sleep/apex-wifi-resume \
     /usr/lib/systemd/system-sleep/apex-wifi-resume
RUN set -eux; \
    test -x /usr/lib/systemd/system-sleep/apex-wifi-resume; \
    bash -n /usr/lib/systemd/system-sleep/apex-wifi-resume; \
    # A hook that fires on the wrong phase, or on the wrong hardware, is worse
    # than no hook: it would cycle the radio of every APEX machine on every
    # resume. Both guards are asserted here rather than assumed.
    grep -qF '= "post" ]' /usr/lib/systemd/system-sleep/apex-wifi-resume; \
    grep -qF 'mt7925e' /usr/lib/systemd/system-sleep/apex-wifi-resume; \
    grep -qF 'wifi.powersave = 2' /etc/NetworkManager/conf.d/20-apex-wifi-powersave.conf
RUN systemctl enable apexd.service

# ── agent runtime (apex-agentd) ─────────────────────────────────────────────
# A USER unit, and deliberately NOT `systemctl --global enable`d: a per-user
# daemon holding PTYs should not start for people who never run an agent. The
# CLI prints the enable command when the socket is absent.
COPY files/system/units/apex-agentd.service /usr/lib/systemd/user/apex-agentd.service

# ── local inference service (apex-aid, §14) ─────────────────────────────────
# A USER unit, and — exactly like apex-agentd — deliberately NOT
# `systemctl --global enable`d. A per-user daemon that will hold gigabytes of
# VRAM must not start for people who never ask for local inference; `apex ai`
# prints the enable command when the socket is absent.
#
# NO INFERENCE RUNTIME IS INSTALLED HERE, AND NONE MAY BE.
# llama.cpp with CUDA is gigabytes, and Fedora's own `llama-cpp` links hipblas
# and rocblas (checked: `dnf5 repoquery --requires llama-cpp` on f43 lists
# libamdhip64.so.6, libhipblas.so.2 and librocblas.so.4). Adding either to
# Containerfile.core — the only tier where a package transaction is allowed —
# would cost the whole fleet a multi-gigabyte update. P1 already built the two
# mechanisms that serve this properly and AGENTS.md forbids a third:
#   sudo apex install llama-cpp        a system extension overlaid on /usr
#   apex env create cuda               a capsule with the driver passed through
# `apex ai status` prints whichever of those applies. Nothing in apexd-core,
# apex or apex-aid downloads a runtime.
COPY files/system/units/apex-aid.service /usr/lib/systemd/user/apex-aid.service
COPY config/ai/catalogue.toml /usr/share/apexos/ai/catalogue.toml
RUN set -eux; \
    test -s /usr/lib/systemd/user/apex-aid.service; \
    grep -q '^ExecStart=/usr/bin/apex-aid$' /usr/lib/systemd/user/apex-aid.service; \
    # Opt-in by design, asserted the same way the agent runtime's is.
    test ! -e /usr/lib/systemd/user/default.target.wants/apex-aid.service; \
    # The store must never be writable by the service or anything it starts.
    # The 0444 blobs are the first reason; this directive is the second, and a
    # unit that lost it would leave the inference process — which loads
    # untrusted weights and speaks HTTP — able to rewrite every user's models.
    grep -q '^ReadOnlyPaths=/var/lib/apex/ai$' /usr/lib/systemd/user/apex-aid.service; \
    # THE security invariant of §14, asserted on the shipped unit rather than
    # trusted: no polkit action, no system-bus name, no system unit. AGENTS.md
    # forbids all three, and a `WantedBy=multi-user.target` slipped in here is
    # exactly how a per-user daemon becomes a system one by accident.
    ! grep -q 'multi-user.target' /usr/lib/systemd/user/apex-aid.service; \
    test ! -e /usr/lib/systemd/system/apex-aid.service; \
    test ! -e /usr/share/polkit-1/actions/org.apexos.apex-aid.policy; \
    test ! -e /usr/share/dbus-1/system.d/org.apexos.ApexAid1.conf; \
    # The shared model store. Root-owned, world-readable, created on first boot
    # because /var is machine-local and empty in the image. Staging is 0700: a
    # partially written blob must not be readable by the account that will use
    # it, and it is where `apex ai pull` verifies a digest before the atomic
    # rename into blobs/.
    printf '%s\n' \
        'd /var/lib/apex 0755 root root -' \
        'd /var/lib/apex/ai 0755 root root -' \
        'd /var/lib/apex/ai/models 0755 root root -' \
        'd /var/lib/apex/ai/models/blobs 0755 root root -' \
        'd /var/lib/apex/ai/models/manifests 0755 root root -' \
        'd /var/lib/apex/ai/staging 0700 root root -' \
        > /usr/lib/tmpfiles.d/apex-ai.conf; \
    # systemd-tmpfiles applies the policy's default context for each path, and
    # on a real APEX host that is `var_lib_t` for all of these — checked with
    # `matchpathcon /var/lib/apex/ai/models/blobs` on the katana with SELinux
    # enforcing. So no new type and no policy module: the store is ordinary
    # var_lib_t content read by an unconfined user process. Assert the rules
    # parse, because a malformed line is skipped silently at boot and the
    # symptom is a store that does not exist.
    systemd-tmpfiles --dry-run --create /usr/lib/tmpfiles.d/apex-ai.conf; \
    # The catalogue is the ONLY place a model name becomes a digest, and it is
    # image content precisely so that its integrity is the image's. A build that
    # shipped an unparseable one would leave `apex ai pull <name>` refusing
    # every model on every machine.
    test -s /usr/share/apexos/ai/catalogue.toml; \
    python3 -c 'import sys,tomllib; tomllib.load(open(sys.argv[1],"rb"))' \
        /usr/share/apexos/ai/catalogue.toml; \
    echo "apex-aid: user unit present and opt-in, store rules valid, no system surface"

# bubblewrap is the agent sandbox. It is already in the image as a flatpak
# dependency, so it is NOT added to Containerfile.core: a package transaction
# there rebuilds core and costs the whole fleet a multi-gigabyte update to
# install something that is already present.
#
# What that trades away is an explicit dependency, so this asserts the result
# instead. If flatpak ever stops pulling bubblewrap in, the build fails here
# rather than shipping an image where every confined `apex agent run` refuses
# to start. Same reasoning as the kernel/akmod postconditions above: tolerate
# the indirect source, then hard-gate on the artifact.
# Everything here is independent of the apexd binaries, so it keeps its cheap
# early position. The binary-dependent half of these assertions moved to the end
# of the file, next to the COPY that provides them.
RUN set -eux; \
    test -x /usr/bin/bwrap; \
    rpm -q bubblewrap; \
    # --version, not a real sandbox. Executing bwrap needs to create a mount
    # namespace, and an image build runs under --isolation=chroot where that is
    # legitimately denied ("Can't mount tmpfs on /newroot/dev"). So the build
    # asserts what a build can actually know — the binary is present, owned by
    # the expected package, and runs far enough to report itself, which is what
    # catches a broken dynamic link against core.
    #
    # Whether confinement genuinely WORKS is a runtime property and is checked
    # where it can be: sandbox::preflight() refuses to start a confined session
    # if bwrap is unusable, and the apex-agent-core tests assert the argv and
    # the measured properties on a real kernel.
    /usr/bin/bwrap --version; \
    test -s /usr/lib/systemd/user/apex-agentd.service; \
    grep -q '^ExecStart=/usr/bin/apex-agentd$' /usr/lib/systemd/user/apex-agentd.service; \
    # Opt-in by design: a per-user daemon holding PTYs must not be enabled for
    # users who never run an agent. Assert it is NOT wired into any target.
    test ! -e /usr/lib/systemd/user/default.target.wants/apex-agentd.service; \
    echo "agent sandbox: bwrap functional; agentd unit present and opt-in"

# Default browser (system-wide XDG): Firefox is the only baked browser, but set
# the http/https/html handlers explicitly so any "open link" honours it without
# a per-user round-trip. /etc/xdg/mimeapps.list is the system default layer.
COPY files/desktop/xdg/mimeapps.list /etc/xdg/mimeapps.list
# mpv config (HW decode via VA-API; safe fallback on any GPU vendor).
COPY files/desktop/mpv/mpv.conf /etc/mpv/mpv.conf

# ── System config drop-ins: dark mode, default terminal, fastfetch, Firefox ──
# Dark mode (apex-logs 28): GTK3/4 prefer-dark, qt6ct dark palette, and the dconf
# default color-scheme=prefer-dark that the freedesktop appearance portal reads
# (so Flatpaks/GTK4 follow). Default terminal = Alacritty (apex-logs 31).
# fastfetch greeting config + logo (apex-logs 33). Firefox dark defaults.
COPY files/system/gtk/gtk-3.0-settings.ini /etc/gtk-3.0/settings.ini
COPY files/system/gtk/gtk-4.0-settings.ini /etc/gtk-4.0/settings.ini
COPY files/system/qt6ct/qt6ct.conf /etc/xdg/qt6ct/qt6ct.conf
COPY files/system/dconf/00-apex-dark /etc/dconf/db/local.d/00-apex-dark
COPY files/system/dconf/profile-user /etc/dconf/profile/user
COPY files/system/firefox/policies.json /etc/firefox/policies/policies.json
# Firefox default prefs, overriding Fedora's. `zz-` is load-bearing: files in
# browser/defaults/preferences are read in SORTED order and later ones win, and
# Fedora's is firefox-redhat-default-prefs.js. See the file's own header for what
# it fixes (every new profile opened on a literal
# `data:text/plain,browser.startup.homepage=https://start.fedoraproject.org/`).
COPY files/system/firefox/apex-default-prefs.js \
     /usr/lib64/firefox/browser/defaults/preferences/zz-apex-default-prefs.js
COPY files/system/xdg/xdg-terminals.list /etc/xdg/xdg-terminals.list
# XKB defaults generator: exports XKB_DEFAULT_LAYOUT/VARIANT/MODEL/OPTIONS from
# the system keymap into the systemd manager environment, so greetd — and the
# sway/labwc greeter host it spawns — use the layout the machine is actually
# configured for instead of a hardcoded `us`. See the file's own header; it is
# a no-op when no keymap has been set.
COPY --chmod=0755 files/system/systemd/apex-keymap-env \
     /usr/lib/systemd/system-environment-generators/50-apex-keymap
COPY files/system/fastfetch/config.jsonc /etc/fastfetch/config.jsonc
COPY files/system/fastfetch/apex-logo.txt /etc/fastfetch/apex-logo.txt

# Distro logo icon for os-release LOGO=apex-os-logo (replaces fedora-logo-icon).
# Anything that resolves LOGO through the icon theme (GNOME About, Bazaar,
# fastfetch's icon lookups) then gets the APEX spark instead of the Fedora F.
COPY files/branding/logos/chartreuse/apex-spark-chartreuse-16.png  /usr/share/icons/hicolor/16x16/apps/apex-os-logo.png
COPY files/branding/logos/chartreuse/apex-spark-chartreuse-32.png  /usr/share/icons/hicolor/32x32/apps/apex-os-logo.png
COPY files/branding/logos/chartreuse/apex-spark-chartreuse-64.png  /usr/share/icons/hicolor/64x64/apps/apex-os-logo.png
COPY files/branding/logos/chartreuse/apex-spark-chartreuse-128.png /usr/share/icons/hicolor/128x128/apps/apex-os-logo.png
COPY files/branding/logos/chartreuse/apex-spark-chartreuse-256.png /usr/share/icons/hicolor/256x256/apps/apex-os-logo.png
COPY files/branding/logos/chartreuse/apex-spark-chartreuse-512.png /usr/share/icons/hicolor/512x512/apps/apex-os-logo.png
COPY files/branding/logos/chartreuse/apex-spark-chartreuse.svg     /usr/share/icons/hicolor/scalable/apps/apex-os-logo.svg

# Rebuild the caches that the two COPY blocks above seeded. Both HAVE to run
# after the copies, which is why they are not in core's hardening layer:
#   - gtk-update-icon-cache: os-release says LOGO=apex-os-logo, and that name
#     only resolves once the spark PNGs/SVG are in the hicolor theme.
#   - dconf update: compiles /etc/dconf/db/local.d/00-apex-dark (prefer-dark)
#     into the local database the freedesktop appearance portal reads.
RUN set -eux; \
    gtk-update-icon-cache -qf /usr/share/icons/hicolor 2>/dev/null || true; \
    dconf update; \
    # ── Firefox: prove the Fedora homepage override is actually overridden ────
    # This is asserted rather than assumed because the whole fix rests on load
    # ORDER, and a rename on either side silently restores the bug — a browser
    # that opens on `data:text/plain,browser.startup.homepage=...` on a distro
    # that is not Fedora.
    D=/usr/lib64/firefox/browser/defaults/preferences; \
    test -f "$D/zz-apex-default-prefs.js"; \
    # Ours must sort LAST in that directory, which is what makes it win.
    last="$(ls -1 "$D" | LC_ALL=C sort | tail -n1)"; \
    [ "$last" = "zz-apex-default-prefs.js" ] \
        || { echo "FATAL: $last sorts after zz-apex-default-prefs.js; the Fedora homepage would win"; exit 1; }; \
    # And it must actually set the pref it exists to set.
    grep -q '^pref("browser.startup.homepage", "about:home");' \
        "$D/zz-apex-default-prefs.js"; \
    # If Fedora ever stops shipping the bad pref, this override becomes dead
    # weight — warn rather than fail, so a fixed upstream does not break builds.
    grep -q 'start.fedoraproject.org' "$D/firefox-redhat-default-prefs.js" \
        || echo "NOTE: Fedora no longer sets a start.fedoraproject.org homepage — zz-apex-default-prefs.js may be redundant"; \
    # policies.json is parsed by Firefox at startup; invalid JSON is ignored
    # SILENTLY, taking the dark-theme defaults down with it.
    python3 -c "import json,sys; json.load(open('/etc/firefox/policies/policies.json'))"; \
    python3 -c "import json; p=json.load(open('/etc/firefox/policies/policies.json'))['policies']['Preferences']; assert p['browser.startup.homepage']['Value']=='about:home', p"; \
    echo "firefox: APEX prefs sort last; homepage override verified"

# Templates seeded per-user by the provisioner (NOT /etc/skel: the provisioner
# has to substitute the edition accent, and skel cannot).
COPY files/desktop/zsh/zshrc            /usr/share/apex/zsh/zshrc
COPY files/desktop/starship/starship.toml /usr/share/apex/starship/starship.toml

# starship in bash too (apex-logs 14). zsh is the default login shell and gets its
# prompt from the seeded ~/.zshrc, but bash was left with the stock prompt, so any
# bash — root, a TTY, a nested shell, `podman exec` — looked nothing like the rest
# of the OS. A profile.d drop-in is image-managed, so unlike a dotfile it keeps
# working and keeps improving across updates.
COPY files/desktop/bash/apex-starship.sh /etc/profile.d/apex-starship.sh

# The fastfetch greeting, sourced by /etc/bashrc AND by the seeded ~/.zshrc, so the
# two can never drift. Image-managed for the same reason as the prompt above.
COPY files/desktop/shell/apex-greeting.sh /usr/share/apex/shell/greeting.sh

# The agent shortcuts (`a`, `aa`, `al`, `ad`, `aw`, `ap`) and completion, shared
# between bash and zsh the same way the greeting is. The zsh side is sourced
# from the seeded ~/.zshrc; the bash side is appended to /etc/bashrc here rather
# than in core, because a core edit rebuilds the whole image tier.
COPY files/desktop/shell/agent.sh /usr/share/apex/shell/agent.sh
RUN set -eux; \
    printf '\n# APEX-OS agent shortcuts. One file shared with zsh (see the seeded\n# ~/.zshrc), so bash and zsh can never drift. Guarded so a partial image\n# cannot break bash, and skippable with APEX_NO_AGENT_ALIASES=1.\n[ -r /usr/share/apex/shell/agent.sh ] && . /usr/share/apex/shell/agent.sh\n' >> /etc/bashrc

# Verify everything the three COPYs above just seeded, plus the pieces of the
# shell story that core is responsible for. zsh being the default login shell,
# and the starship binary itself, are set in Containerfile.core — this is the
# half of that pair which can only run once the templates exist, and it
# re-asserts core's side so a bad core can never reach a user unnoticed.
RUN set -eux; \
    grep -q '^SHELL=/bin/zsh' /etc/default/useradd; \
    grep -q '^/bin/zsh$' /etc/shells; \
    test -x /usr/bin/starship; \
    # The rest of the terminal-developer row, re-asserted here for the same
    # reason zsh is: core installs it, and a bad core must not reach a user
    # unnoticed. Binaries first — `nu` is nushell's, and zellij comes from a
    # pinned upstream tarball rather than a package, so `test -x` is the only
    # check that covers both sources.
    test -x /usr/bin/fish; \
    test -x /usr/bin/nu; \
    test -x /usr/bin/tmux; \
    test -x /usr/bin/zellij; \
    # ...then the half that decides whether a user can actually adopt one:
    # chsh rejects a shell missing from /etc/shells.
    grep -qx /usr/bin/fish /etc/shells; \
    grep -qx /usr/bin/nu /etc/shells; \
    test -s /usr/share/apex/zsh/zshrc; \
    test -s /usr/share/apex/starship/starship.toml; \
    zsh -n /usr/share/apex/zsh/zshrc; \
    bash -n /etc/profile.d/apex-starship.sh; \
    test -s /etc/profile.d/apex-starship.sh; \
    grep -q 'starship init bash' /etc/profile.d/apex-starship.sh; \
    grep -q 'BASH_VERSION' /etc/profile.d/apex-starship.sh; \
    grep -q 'starship init zsh' /usr/share/apex/zsh/zshrc; \
    grep -q '@ACCENT@' /usr/share/apex/starship/starship.toml; \
    grep -q 'zmodload zsh/complist' /usr/share/apex/zsh/zshrc; \
    grep -q 'bindkey -M menuselect' /usr/share/apex/zsh/zshrc; \
    zsh -fc 'zmodload zsh/complist && bindkey -M menuselect >/dev/null'; \
    test -s /usr/share/apex/shell/greeting.sh; \
    sh -n   /usr/share/apex/shell/greeting.sh; \
    bash -n /usr/share/apex/shell/greeting.sh; \
    zsh -n  /usr/share/apex/shell/greeting.sh; \
    # agent.sh is sourced by EVERY login shell, so a syntax error in it is a
    # broken shell for every user. It carries both a bash and a zsh completion
    # block, each guarded at runtime, so all three parsers must accept the whole
    # file — not just the one whose block is live.
    test -s /usr/share/apex/shell/agent.sh; \
    sh -n   /usr/share/apex/shell/agent.sh; \
    bash -n /usr/share/apex/shell/agent.sh; \
    zsh -n  /usr/share/apex/shell/agent.sh; \
    grep -q 'agent.sh' /etc/bashrc; \
    grep -q 'agent.sh' /usr/share/apex/zsh/zshrc; \
    grep -q 'APEX_NO_AGENT_ALIASES' /usr/share/apex/shell/agent.sh; \
    # Sourcing it and asserting `a` is defined happens in the apexd stage at the
    # end of this file, NOT here: agent.sh opens with
    # `command -v apex >/dev/null || return 0`, so with the binaries not yet
    # copied in it correctly defines nothing and the check would fail for the
    # wrong reason.

    ! grep -q '\[\[' /usr/share/apex/shell/greeting.sh; \
    grep -q 'greeting.sh' /etc/bashrc; \
    grep -q 'greeting.sh' /usr/share/apex/zsh/zshrc; \
    grep -q 'fastfetch' /usr/share/apex/shell/greeting.sh; \
    # LIVE lines only. This guard's job is "no fastfetch INVOCATION survives in
    # /etc/bashrc" — the inline block must be gone and only the shared file
    # sourced. Grepping the whole file failed the build on the first attempt,
    # because the replacement comment explaining the change says the word
    # "fastfetch" itself. Third instance of a guard tripping over a legitimate
    # mention in a comment (see also the (unset) postcondition and this file's
    # bash-only-test-syntax check), hence comment-stripping here too.
    ! grep -vE '^[[:space:]]*#' /etc/bashrc | grep -q 'fastfetch'

# ── Stage 5b2: APEX Shell, VENDORED INTO THE IMAGE ──────────────────────────
# APEX Shell now ships INSIDE the image at /usr/share/apex-shell instead of being
# cloned into every user's $HOME on first login.
#
# WHY THE CHANGE (apex-logs 56)
# The old model gave APEX-OS *two independent update channels* with no version
# coupling: the OS moved via `apex update` (bootc), and the shell moved via its own
# in-app `git pull` of ~/.local/src/apex-shell behind a login-time popup. A machine
# could sit on a new OS with an old shell or the reverse, and nothing detected the
# mismatch. It also meant the shell — the entire user interface — was fetched over
# the network at first login, unsigned, outside the image's atomic/rollback story.
#
# Vendoring it here fixes all of that AND kills a whole bug class structurally:
#   * ONE update channel. `apex update` moves the OS and the UI together, atomically,
#     with `apex rollback` covering both.
#   * The clone race (apex-logs 51) becomes IMPOSSIBLE, not merely mitigated. The
#     shell is present before the compositor is ever exec'd, so the autostart
#     cannot fire against a directory that does not exist yet.
#   * No network needed at first login. Provisioning is now pure local file seeding.
#   * The shell is covered by the image's cosign signature and by ostree integrity.
#   * One copy on disk instead of one per user.
#
# The cost: users can no longer `git pull` the shell in place. That is the point —
# it is the second channel we are deliberately removing. Local hacking is still
# possible by pointing the autostart at your own checkout.
#
# APEX_SHELL_REF pins what gets vendored (default: main). CI can pass a tag/SHA for
# a reproducible release build. The resolved SHA is written to
# /usr/share/apex-shell/.apex-shell-commit and stamped as an OCI label so
# `apex changelog` / `skopeo inspect` can report exactly which shell shipped.
ARG APEX_SHELL_REF=main
ARG APEX_SHELL_STRICT=0
RUN set -eux; \
    rm -rf /usr/share/apex-shell; \
    # `--branch` accepts a branch or tag but NOT a bare SHA, so try it first and
    # fall back to clone-then-fetch for a pinned commit. The rm -rf between the two
    # matters: a failed clone can leave a partial directory behind, and the second
    # clone would then fail on "destination path already exists" — turning a
    # recoverable case into a hard build failure.
    if git clone --depth 1 --branch "${APEX_SHELL_REF}" \
         https://github.com/AndreNijman/apex-shell /usr/share/apex-shell 2>/dev/null; then \
        echo "cloned apex-shell at ref ${APEX_SHELL_REF}"; \
    else \
        rm -rf /usr/share/apex-shell; \
        git clone https://github.com/AndreNijman/apex-shell /usr/share/apex-shell; \
        git -C /usr/share/apex-shell checkout --detach "${APEX_SHELL_REF}"; \
        echo "cloned apex-shell and checked out ${APEX_SHELL_REF}"; \
    fi; \
    SHA="$(git -C /usr/share/apex-shell rev-parse HEAD)"; \
    printf '%s\n' "${SHA}" > /usr/share/apex-shell/.apex-shell-commit; \
    # HARD-VERIFY the entrypoint exists before we throw away the git metadata —
    # a silently-empty /usr/share/apex-shell would mean no UI on every machine.
    test -s /usr/share/apex-shell/shell.qml; \
    test -d /usr/share/apex-shell/src/services; \
    # ── THE CROSS-REPO MERGE ORDER, ASSERTED HERE AND NOT 60 LAYERS LATER ────
    # `apex plugin` gets every verdict from this file — it deliberately
    # reimplements none of the plugin rules — so an apex-shell ref without the
    # §16 platform produces an image whose plugin CLI cannot answer anything.
    # The apex-plugin layer near the bottom of this file checks the same
    # condition, but that is ~60 layers and several hours in, and this
    # repository has already lost a six-hour build at step 76 of 83. Same
    # assertion, minutes in, and it reads as the merge-order rule it is:
    # apex-shell lands before or with the OS.
    test -f /usr/share/apex-shell/src/services/plugins/manifest.js \
        || { echo "FATAL: apex-shell ref ${APEX_SHELL_REF} has no src/services/plugins/manifest.js."; \
             echo "The §16 plugin platform is not in this ref, so \`apex plugin\` would ship unable"; \
             echo "to give any verdict. apex-shell must land before or with the OS — check that"; \
             echo "PR #9 (branch p1/plugin-platform) is merged to apex-shell main."; \
             exit 1; }; \
    # Drop .git: this is no longer a live checkout, and its presence would invite
    # the in-app updater to try to fetch into a read-only /usr.
    rm -rf /usr/share/apex-shell/.git; \
    echo "vendored apex-shell ${SHA}"
LABEL org.apexos.apex-shell.ref="${APEX_SHELL_REF}"

# ── Stage 5b3: the two paths that assumed a WRITABLE shell tree ─────────────
# /usr is a read-only ostree/composefs mount, so anything the shell writes inside
# its own tree must be redirected into $HOME. An audit of the whole checkout found
# exactly ONE such write, plus one stale reader:
#
#  1. src/config/matugen.toml.in wrote its hyprlock palette to
#     '@SRCDIR@/src/config/colors.conf' — i.e. back into the source tree. On a
#     read-only tree matugen would fail that one output. The call site guards with
#     `|| true`, so it would fail SILENTLY, which is worse than loudly.
#  2. src/config/hyprlock.conf sourced that file by a HARDCODED
#     ~/.local/src/apex-shell path (not even @SRCDIR@-substituted), so it was
#     already broken for any non-default install location.
#
# Both are redirected to ~/.config/hypr/apex-shell-hyprlock-colors.conf. Note that
# hyprlock is currently DEAD CODE upstream — src/windows/Lockscreen.qml is a native
# Wayland session lock that "replaces hyprlock", and the hyprlock invocation in
# src/scripts/PowerControl.sh is commented out as an emergency fallback. These are
# fixed anyway so the fallback works if it is ever re-enabled, and so nothing in
# the image attempts a doomed write.
#
# THESE PATCHES BELONG UPSTREAM in apex-shell; doing them here is drift. Tracked in
# apex-logs 56. The matugen one is hard-verified because it is the only functional
# change — if upstream reworks that file, this build must fail loudly rather than
# quietly ship a shell that cannot theme the lock screen.
RUN set -eux; \
    S=/usr/share/apex-shell; \
    # (a) matugen's in-tree write -> $HOME. The ONLY genuine write into the tree.
    sed -i "s|output_path = '@SRCDIR@/src/config/colors.conf'|output_path = '@HOME@/.config/hypr/apex-shell-hyprlock-colors.conf'|" \
        "$S/src/config/matugen.toml.in"; \
    grep -q "output_path = '@HOME@/.config/hypr/apex-shell-hyprlock-colors.conf'" \
        "$S/src/config/matugen.toml.in"; \
    ! grep -q "output_path = '@SRCDIR@" "$S/src/config/matugen.toml.in"; \
    # (b) hyprlock's reader of that file -> the same $HOME path. Must run BEFORE
    #     the generic rewrite in (c), or (c) would turn it into a /usr path that
    #     can never be written to.
    sed -i 's|^source = ~/.local/src/apex-shell/src/config/colors.conf|source = ~/.config/hypr/apex-shell-hyprlock-colors.conf|' \
        "$S/src/config/hyprlock.conf"; \
    # (c) EVERY remaining hardcoded ~/.local/src/apex-shell -> the image path.
    #     These are not cosmetic. src/config/hypridle.conf alone carries FOUR
    #     functional ones, and all four fail silently once the shell moves:
    #       lock_cmd         = qs -c ~/.local/src/apex-shell ipc call lockscreen lock
    #       after_sleep_cmd  = ~/.local/src/apex-shell/src/scripts/DpmsControl.sh on
    #       on-timeout       = ~/.local/src/apex-shell/src/scripts/DpmsControl.sh off
    #       on-resume        = ~/.local/src/apex-shell/src/scripts/DpmsControl.sh on
    #     lock_cmd is the idle LOCK SCREEN. A broken lock_cmd means the machine
    #     stops locking on idle and nothing says so — a security regression, not a
    #     cosmetic one. Rewritten generically rather than line-by-line so a future
    #     upstream addition of another such path is caught by the guard below.
    grep -rl '~/\.local/src/apex-shell' "$S" 2>/dev/null | while read -r f; do \
        sed -i 's|~/\.local/src/apex-shell|/usr/share/apex-shell|g' "$f"; \
    done; \
    # (d) HARD GUARD: nothing may still point at the old per-user clone path, and
    #     nothing may still target an unwritable in-tree output. If upstream adds
    #     one, this build fails loudly instead of shipping a silent regression.
    if grep -rn '~/\.local/src/apex-shell' "$S" 2>/dev/null; then \
        echo "FATAL: stale per-user clone path survived the rewrite (above)"; exit 1; \
    fi; \
    grep -q '^lock_cmd\|lock_cmd = qs -c /usr/share/apex-shell' "$S/src/config/hypridle.conf"; \
    grep -q 'lock_cmd = qs -c /usr/share/apex-shell ipc call lockscreen lock' \
        "$S/src/config/hypridle.conf"; \
    echo "shell paths rewritten to /usr/share/apex-shell; lock_cmd + DPMS verified"

# ── Stage 5b3: make the power menu's "Boot into Windows" button work ─────────
# It never has, on any machine. PowerControl.sh called
# /usr/local/bin/caelestia-boot-windows — a path inherited from the project
# apex-shell was forked from, which APEX-OS has never shipped and CANNOT ship:
# /usr is read-only on bootc, so /usr/local is redirected to ../var/usrlocal
# (writable per-machine state) earlier in this file. No image can put a file
# there. The button logged "no Windows boot helper installed" to a log nobody
# reads. Its comment also claimed a dedicated NOPASSWD sudoers rule existed;
# none was ever shipped either. Both halves are fixed here (apex-logs 15).
#
# efibootmgr is an EXPLICIT dependency, installed in Containerfile.core (it is a
# dnf transaction, so it cannot live in this tier). It was only ever present
# transitively via the shim/grub2-efi chain, and the button is useless without
# it, so its presence is re-asserted here — where the feature actually lives —
# rather than trusted.
# ── §22 boot v2: the health gate, the recovery notice, and NOTHING ELSE ────
#
# What ships here is the OS-side half of §22's migration step 4 — the
# definition of "this boot worked", plus the notice a rollback leaves behind.
#
# What does NOT ship, deliberately:
#
#   * No bootloader installation. Nothing in this image runs `bootctl install`,
#     `bootctl update`, `bootupctl` or `efibootmgr -c`. GRUB stays the default
#     for daily, gaming-mesa and gaming-nvidia in this generation (AGENTS.md
#     boot-path rule 5; §22's own recommendation is to keep it while the
#     OSTree/bootc install path depends on it, and to keep it for legacy BIOS
#     regardless). Enrolling a machine on the systemd-boot path is a
#     documented, user-initiated procedure in docs/boot-v2.md, not a script —
#     there is no rollback for an ESP a script overwrote.
#   * No systemd-boot binary and no ukify. Both would be dnf transactions and
#     therefore belong in Containerfile.core, and neither is needed by the two
#     units below: boot counting is decremented by the bootloader in the ESP
#     and blessed by systemd-bless-boot, which is already in the systemd
#     package this image has. `apex boot status` reads `bootctl list`, which
#     ships in systemd-udev — asserted below rather than assumed.
#
# Both units carry ConditionPathExists on systemd-boot's LoaderBootCountPath
# EFI variable, which is the same switch systemd-bless-boot-generator uses. On
# a GRUB machine that variable does not exist, so neither unit starts, and a
# failed condition counts as a skip rather than a failure — enabling them here
# cannot affect a GRUB boot. tests/test-boot-v2.sh asserts that condition is
# present on every unit this block enables, because an enabled unit without it
# would be the exact way "opt-in" silently becomes "default".
COPY files/system/libexec/apex-boot-health /usr/libexec/apex-boot-health
COPY files/system/units/apex-boot-health.service \
     /usr/lib/systemd/system/apex-boot-health.service
COPY files/system/units/apex-boot-notice.service \
     /usr/lib/systemd/system/apex-boot-notice.service
COPY docs/boot-v2.md /usr/share/doc/apex/boot-v2.md
RUN set -eux; \
    chmod 0755 /usr/libexec/apex-boot-health; \
    bash -n /usr/libexec/apex-boot-health; \
    \
    : '── the upstream mechanism must actually be in this image ──'; \
    : 'systemd-bless-boot is what strips the +N-M suffix. Without it the'; \
    : 'health gate would gate nothing and a deployment would never be'; \
    : 'blessed, so every systemd-boot boot would eventually roll back.'; \
    test -f /usr/lib/systemd/system/systemd-bless-boot.service; \
    test -f /usr/lib/systemd/system/boot-complete.target; \
    test -x /usr/lib/systemd/systemd-bless-boot; \
    test -x /usr/lib/systemd/system-generators/systemd-bless-boot-generator; \
    : 'apex boot status shells out to bootctl for the entry tally.'; \
    test -x /usr/bin/bootctl; \
    \
    : '── /var/lib/apex/boot is machine-local state, so tmpfiles owns it ──'; \
    : '/var is not part of the ostree deployment; a directory created at'; \
    : 'build time would not exist on an installed machine.'; \
    printf 'd /var/lib/apex/boot 0755 root root -\n' \
        > /usr/lib/tmpfiles.d/apex-boot.conf; \
    systemd-tmpfiles --dry-run --create /usr/lib/tmpfiles.d/apex-boot.conf; \
    \
    systemctl enable apex-boot-health.service; \
    systemctl enable apex-boot-notice.service; \
    \
    : '── postconditions on the enablement, not just on the enable command ──'; \
    : 'RequiredBy vs WantedBy is the difference between "a failed health'; \
    : 'check blocks the blessing" and "a failed health check is a warning",'; \
    : 'so the symlink systemctl actually created is what gets checked.'; \
    test -L /etc/systemd/system/boot-complete.target.requires/apex-boot-health.service; \
    test -L /etc/systemd/system/boot-complete.target.wants/apex-boot-notice.service; \
    : 'And each enabled unit must be inert without systemd-boot counting.'; \
    for u in apex-boot-health apex-boot-notice; do \
        grep -q '^ConditionPathExists=/sys/firmware/efi/efivars/LoaderBootCountPath-' \
            "/usr/lib/systemd/system/$u.service"; \
    done; \
    : 'Nothing in the shipped payload may touch a real boot path. Matched on'; \
    : 'the executable lines only: a comment naming the command it refuses to'; \
    : 'run must not fail this, and the units and helper both contain such'; \
    : 'comments on purpose.'; \
    ! grep -nE '^[^#]*\b(bootctl[[:space:]]+(install|update)|bootupctl|grub2-install|efibootmgr[[:space:]]+-[cBo])' \
        /usr/libexec/apex-boot-health \
        /usr/lib/systemd/system/apex-boot-health.service \
        /usr/lib/systemd/system/apex-boot-notice.service

COPY files/system/libexec/apex-boot-windows /usr/libexec/apex-boot-windows
COPY files/system/sudoers/apex-boot-windows /etc/sudoers.d/020-apex-boot-windows
RUN set -eux; \
    test -x /usr/sbin/efibootmgr -o -x /usr/bin/efibootmgr; \
    chmod 0755 /usr/libexec/apex-boot-windows; \
    bash -n /usr/libexec/apex-boot-windows; \
    # sudoers files are parsed by a setuid binary: wrong mode or a syntax error is
    # refused at RUNTIME, which would mean a password prompt no compositor-spawned
    # script can answer. visudo -c turns that into a build failure instead.
    chown root:root /etc/sudoers.d/020-apex-boot-windows; \
    chmod 0440 /etc/sudoers.d/020-apex-boot-windows; \
    visudo -cf /etc/sudoers.d/020-apex-boot-windows; \
    # apex-shell main now calls /usr/libexec/apex-boot-windows itself (upstream
    # 412d5b2), so this sed is a BACKWARD-COMPAT SHIM, not the fix: it only does
    # anything when APEX_SHELL_REF pins a shell older than that commit. Kept so
    # pinning an old ref still produces a working button rather than a dead one.
    # LIVE lines only, for both the rewrite and the check — the fourth time this
    # pattern has bitten in this repo (see the (unset) postcondition, the
    # bash-only-test-syntax check and the fastfetch guard). Rewriting comments made
    # the sed edit upstream's own explanation of the bug into a false statement, and
    # checking them made a correctly-fixed upstream file fail the guard.
    P=/usr/share/apex-shell/src/scripts/PowerControl.sh; \
    # Record whether this is a PRE-probe shell before rewriting, so the guard below
    # can tell "someone pinned an old release" apart from "main regressed".
    PRE_PROBE=0; \
    if grep -vE '^[[:space:]]*#' "$P" | grep -q 'caelestia-boot-windows'; then PRE_PROBE=1; fi; \
    sed -i '/^[[:space:]]*#/!s|/usr/local/bin/caelestia-boot-windows|/usr/libexec/apex-boot-windows|g' "$P"; \
    if grep -vE '^[[:space:]]*#' "$P" | grep -q 'caelestia-boot-windows'; then \
        echo "FATAL: PowerControl.sh still calls the dead /usr/local helper path"; exit 1; \
    fi; \
    grep -q '/usr/libexec/apex-boot-windows' "$P"; \
    # The probe action PowerMenu uses to decide whether to show the Windows row. If
    # an upstream refactor drops it the probe fails, the row is hidden, and the
    # button silently disappears for everyone — indistinguishable from "you have no
    # Windows", which is the exact silent-regression class this file exists to catch.
    #
    # But a shell pinned from BEFORE the probe existed legitimately does not have it,
    # and APEX_SHELL_REF exists precisely so an old release can be rebuilt
    # reproducibly. Failing that build would be obstructive and wrong — the button
    # was already dead in those refs. So: hard failure only when this is a
    # post-fix shell that LOST the probe; a warning when an old ref was pinned.
    if ! grep -q 'windows-check' "$P"; then \
        if [ "$PRE_PROBE" = 1 ]; then \
            echo "WARN: pinned apex-shell predates the windows-check probe — the Windows row will stay hidden in this image"; \
        else \
            echo "FATAL: PowerControl.sh has no windows-check action — PowerMenu would hide the Windows row on every machine"; exit 1; \
        fi; \
    else \
        grep -q 'windows-check' /usr/share/apex-shell/src/services/PowerMenu.qml; \
    fi; \
    bash -n "$P"; \
    # ── the shell scripts' compositor adapter must arrive with them ─────────
    # PowerControl.sh and DpmsControl.sh SOURCE src/scripts/compositor.sh, and
    # every action in both runs through its apex_run(). A tree that carries the
    # source line without the file has a power menu where NOTHING works —
    # strictly worse than the three labwc no-ops the adapter was added to fix,
    # and invisible to every check above, which only ever named PowerControl.sh.
    #
    # Keyed on the source line, not on the words "compositor.sh": both scripts
    # discuss the adapter in comments, and a check a comment can satisfy is a
    # check this repo has already shipped five times.
    #
    # A ref pinned from before the adapter simply has no source line and is left
    # alone with a warning — APEX_SHELL_REF exists so an old release can be
    # rebuilt, and labwc's logout and idle screen-off were already dead there.
    if grep -qE '^[[:space:]]*\.[[:space:]].*compositor\.sh' "$P"; then \
        C="${P%/*}/compositor.sh"; \
        test -s "$C" \
            || { echo "FATAL: PowerControl.sh sources compositor.sh but the vendored tree has no such file"; exit 1; }; \
        bash -n "$C"; \
        grep -qE '^apex_run\(\)' "$C" \
            || { echo "FATAL: vendored compositor.sh defines no apex_run; every power-menu action would call an undefined function"; exit 1; }; \
        grep -qE '^[[:space:]]*\.[[:space:]].*compositor\.sh' "${P%/*}/DpmsControl.sh" \
            || { echo "FATAL: DpmsControl.sh does not use the compositor adapter; idle screen-off would be compositor-blind again"; exit 1; }; \
        echo "shell-script compositor adapter vendored and sourced by both consumers"; \
    else \
        echo "WARN: pinned apex-shell predates src/scripts/compositor.sh — the labwc session has no working Log Out and no idle screen-off in this image"; \
    fi; \
    echo "windows boot helper installed; PowerControl.sh + PowerMenu probe verified"

# The config UI shows the shell version via `git -C <shellDir> describe`, which
# returns nothing now that .git is gone (the field would read "…" forever). Fall
# back to the commit file written above. Cosmetic, so a non-matching upstream
# refactor warns instead of failing the build.
RUN set -eux; \
    F=/usr/share/apex-shell/src/services/config_tab/pages/MiscPage.qml; \
    if grep -q 'describe --tags --always 2>/dev/null' "$F"; then \
        sed -i 's|describe --tags --always 2>/dev/null|describe --tags --always 2>/dev/null \|\| cut -c1-12 $1/.apex-shell-commit 2>/dev/null|' "$F"; \
        # $1 is left UNQUOTED on purpose: the replacement is spliced into a QML
        # string literal, and adding quotes here would need QML-level escaping
        # (\") -- getting that wrong is a syntax error that takes out the whole
        # config page. shellDir is an image-controlled path with no spaces.
        # Verified by loading a patched read-only tree in quickshell.
        awk '/describe --tags/{n=gsub(/"/,"\""); exit (n%2)}' "$F"; \
        echo "MiscPage version falls back to .apex-shell-commit"; \
    else \
        echo "WARN: MiscPage version command changed upstream — version display may read '…'"; \
    fi

# ── Stage 5c: APEX Shell per-user provisioner ──────────────────────────────
# Seeds each user's config on login. No longer clones anything: the shell itself
# lives in /usr/share/apex-shell (Stage 5b2 above), so this is pure local file
# seeding — no network, no marker, no race. Enabled globally so it runs for every
# user.
COPY files/system/units/apex-shell-firstrun.service \
     /usr/lib/systemd/user/apex-shell-firstrun.service
COPY files/system/libexec/apex-shell-firstrun /usr/libexec/apex-shell-firstrun
# Idempotent launcher for hypridle + quickshell. Kept after vendoring because it
# still owns two things: preferring the user's own ~/.config/hypr/hypridle.conf
# over the image copy, and refusing to start a second instance (which is what lets
# the provisioner safely re-invoke it to repair a live session).
COPY --chmod=0755 files/system/libexec/apex-shell-autostart \
     /usr/libexec/apex-shell-autostart

# Desktop context-menu helpers. The menu itself is one QML surface shared by all
# three sessions; these three scripts are where the per-compositor differences
# live, so the QML never has to know which compositor it is running under.
#
#   apex-desktop-menu      right-click entry point; restarts a dead shell rather
#                          than leaving the user with no menu at all
#   apex-compositor-reload labwc --reconfigure / hyprctl reload / niri validate
#   apex-session-logout    loginctl first, compositor exit verb as the fallback
COPY --chmod=0755 files/system/libexec/apex-desktop-menu \
     /usr/libexec/apex-desktop-menu
COPY --chmod=0755 files/system/libexec/apex-compositor-reload \
     /usr/libexec/apex-compositor-reload
COPY --chmod=0755 files/system/libexec/apex-session-logout \
     /usr/libexec/apex-session-logout

# Settings generators. Each takes ONE APEX model and writes whatever the three
# compositors need, so a settings page never has to know which one is running.
#
#   apex-input-apply    -> Hyprland conf + niri KDL + the <libinput> element
#                          inside labwc's rc.xml. labwc has no include
#                          mechanism, which is why its half is an in-place span
#                          replacement rather than a generated file.
#   apex-display-apply  -> Hyprland monitor conf + a kanshi profile, applied
#                          live through hyprctl or wlr-randr. Two actions on
#                          purpose: `save` writes persistence only, `apply`
#                          also reaches the RUNNING compositor. Only `apply`
#                          touches hardware.
#   apex-labwc-keybinds -> the <keybind> region of labwc's rc.xml, generated
#                          from the same model the shell writes Hyprland .conf
#                          and niri .kdl from. Before it, a labwc user could
#                          rebind a shortcut, watch the UI confirm it, and get
#                          nothing: the three files the shell writes are all
#                          read by compositors labwc is not.
COPY --chmod=0755 files/system/libexec/apex-input-apply \
     /usr/libexec/apex-input-apply
COPY --chmod=0755 files/system/libexec/apex-display-apply \
     /usr/libexec/apex-display-apply
COPY --chmod=0755 files/system/libexec/apex-labwc-keybinds \
     /usr/libexec/apex-labwc-keybinds

# Agent Center helpers. Both exist so APEX Shell never has to know which
# compositor is running (§6's adapter-layer rule) and never has to decide
# anything about privilege (§4).
#
#   apex-agent-focus   session id -> the terminal attached to it, focused.
#                      Resolved through the process tree, because a session has
#                      no window: agentd owns the PTY and a terminal merely
#                      attaches. Opens one when there is none.
#   apex-agent-review  opens a terminal on one privilege request. Approving
#                      performs the operation with the reviewing human's own
#                      root, so it must happen where sudo can authenticate and
#                      the whole prompt is visible — never behind a button.
COPY --chmod=0755 files/system/libexec/apex-agent-focus \
     /usr/libexec/apex-agent-focus
COPY --chmod=0755 files/system/libexec/apex-agent-review \
     /usr/libexec/apex-agent-review

# Project window layouts (§6). The only compositor-specific input to
# `apex project layout`, which is why it is a separate program: replacing it is
# how the layout suite becomes deterministic and runnable with no compositor.
COPY --chmod=0755 files/system/libexec/apex-project-windows \
     /usr/libexec/apex-project-windows
# Only what exists at this point in the build. The cross-checks against
# /usr/share/apex/labwc/rc.xml live in the labwc section that populates it —
# asserting a path before its COPY is a build failure, and this block did
# exactly that until it was caught by reading the layer order.
RUN set -eux; \
    for h in apex-desktop-menu apex-compositor-reload apex-session-logout; do \
        test -x "/usr/libexec/$h"; \
        bash -n "/usr/libexec/$h"; \
    done; \
    for g in apex-input-apply apex-display-apply apex-labwc-keybinds; do \
        test -x "/usr/libexec/$g"; \
        python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "/usr/libexec/$g"; \
    done; \
    # The input generator's self-test runs every installed compositor's own
    # validator over its output. Names are verified rather than remembered
    # because labwc ignores an unknown element in silence — which is how
    # <tapToClick> shipped doing nothing at all.
    /usr/libexec/apex-input-apply --self-test; \
    # The display generators are pure functions of the model, so this asserts
    # the emitted syntax without needing outputs. APEX_DISPLAY_NO_LIVE is
    # belt-and-braces: there is no compositor in a build container, but `apply`
    # must never be reachable from a build even by accident.
    APEX_DISPLAY_NO_LIVE=1 /usr/libexec/apex-display-apply --self-test; \
    # Every verb the helpers dispatch to has to exist in the image.
    command -v labwc >/dev/null; \
    command -v niri >/dev/null; \
    command -v loginctl >/dev/null; \
    # apex-display-apply dispatches to these for the two wlroots sessions.
    command -v wlr-randr >/dev/null; \
    command -v kanshi >/dev/null; \
    # Agent Center helpers.
    test -x /usr/libexec/apex-agent-focus; \
    python3 -c 'import ast,sys; ast.parse(open("/usr/libexec/apex-agent-focus").read())'; \
    test -x /usr/libexec/apex-agent-review; \
    bash -n /usr/libexec/apex-agent-review; \
    # Both refuse a bad argument rather than guessing, and the usage text is
    # what a caller sees when the shell passes something wrong.
    ! /usr/libexec/apex-agent-focus 2>/dev/null; \
    ! /usr/libexec/apex-agent-review not-a-number 2>/dev/null; \
    # `ps` is how apex-agent-focus maps a session to a process; without it the
    # helper silently never finds a terminal and always opens a new one.
    command -v ps >/dev/null; \
    # Project window layouts.
    test -x /usr/libexec/apex-project-windows; \
    python3 -c 'import ast,sys; ast.parse(open("/usr/libexec/apex-project-windows").read())'; \
    # `list` must emit valid JSON even where the compositor cannot be queried —
    # there is no compositor in a build container, which is exactly that case.
    # The caller parses stdout, so a bare error message there would be a parse
    # failure rather than an empty layout.
    /usr/libexec/apex-project-windows list 2>/dev/null | python3 -c \
        'import json,sys; assert json.load(sys.stdin) == [], "expected an empty list"'; \
    /usr/libexec/apex-project-windows compositor >/dev/null; \
    ! /usr/libexec/apex-project-windows nonsense-action 2>/dev/null; \
    echo "context menu + settings generators + agent helpers: installed and self-tested"
RUN systemctl --global enable apex-shell-firstrun.service

# ── Stage 5d: user packages, WITHOUT breaking OS updates ────────────────────
# The supported way to add software to a bootc system used to be `rpm-ostree
# install`, and it has one property that makes it unusable as the answer for a
# daily driver: a single layered package puts the deployment into "local
# modifications" state, and from then on
#
#   bootc upgrade  ->  error: Deployment contains local rpm-ostree modifications
#
# i.e. installing one CLI tool silently stops the OS from ever updating again.
# Worse, `--apply-live` layers are transient: a reboot threw the package away and
# the user was left with neither the tool nor a working update path.
#
# `apex install` instead builds a systemd SYSTEM EXTENSION — a squashfs image (or
# plain tree) in /var/lib/extensions that systemd overlays onto /usr. The bootc
# deployment is never touched, so updates keep working, while binaries, .desktop
# files, icons, man pages, systemd units and udev rules all land at the real /usr
# paths the rest of the OS already searches. Fedora, RPM Fusion, and explicitly
# enabled COPRs are the repository sources, so there is no APEX registry to run,
# sign or keep online; a path to a local .rpm installs that file through the same
# pipeline, with its dependencies still resolved from the repositories.
#
# The extension records the OS version it was built for and systemd refuses to
# merge a mismatched one; apex-sysext-rebuild.service turns that refusal into an
# automatic rebuild after an OS upgrade instead of vanished packages.
COPY --chmod=0755 files/system/libexec/apex-pkg /usr/libexec/apex-pkg
COPY files/system/units/apex-sysext-rebuild.service \
     /usr/lib/systemd/system/apex-sysext-rebuild.service
RUN set -eux; \
    bash -n /usr/libexec/apex-pkg; \
    # Every external tool the engine drives. These are asserted rather than
    # trusted because a missing one turns `apex install` into a confusing
    # runtime failure on the user's machine instead of a failed build here.
    for t in rpm rpmkeys dnf5 curl jq setfiles systemd-sysext \
             systemd-sysusers systemd-tmpfiles ldconfig od readlink sha256sum; do \
        command -v "$t" >/dev/null || { echo "FATAL: apex-pkg needs $t"; exit 1; }; \
    done; \
    dnf5 copr --help >/dev/null; \
    # Installing a local .rpm resolves its dependencies by asking libdnf5 which
    # requirements the running image already satisfies. That subcommand is a hard
    # dependency of the local-file path, and losing it would break only that
    # path — silently, on the user's machine — so it is asserted here.
    dnf5 repoquery --help >/dev/null; \
    # mksquashfs is preferred but genuinely optional: it reaches this image only
    # as a weak dependency of dracut-squash, so the engine falls back to a
    # directory extension. Note it rather than failing the build, and note it
    # LOUDLY so the fallback is a decision and not a surprise.
    if command -v mksquashfs >/dev/null; then \
        echo "apex-pkg: squashfs extensions available"; \
    else \
        echo "NOTE: mksquashfs absent — apex-pkg will build uncompressed directory extensions"; \
    fi; \
    # /var is machine-local and empty in the image; the engine's state and the
    # directory systemd scans for extensions have to be created on first boot.
    printf '%s\n' \
        'd /var/lib/extensions 0755 root root -' \
        'd /var/lib/apex 0755 root root -' \
        'd /var/lib/apex/pkg 0700 root root -' \
        'd /var/lib/apex/pkg/local 0700 root root -' \
        > /usr/lib/tmpfiles.d/apex-pkg.conf; \
    # systemd-sysext.service is what merges the extension at boot. It is enabled
    # by preset today, which is exactly the kind of upstream default that can
    # change under us and would silently un-install every user package.
    systemctl enable systemd-sysext.service; \
    systemctl enable apex-sysext-rebuild.service; \
    test -L /etc/systemd/system/multi-user.target.wants/apex-sysext-rebuild.service

# ── APEX Capsules (§8) ──────────────────────────────────────────────────────
# The other half of "how does software get onto this machine". The extension
# engine above serves the system: one signed set of RPMs overlaid onto /usr,
# rolled back as a unit. It cannot serve a development ecosystem, because
# `pip install --user`, `npm -g`, `cargo install` and a vendor's ./install.sh
# all expect a mutable userspace that a bootc host deliberately does not have.
#
# apex-env gives each ecosystem its own rootless podman container through
# distrobox, with the user's home, terminal and devices — and APEX's own
# policy on top: named images, device profiles for CUDA/ROCm/hardware work,
# and a record of what each capsule was built from.
#
# NO STATE UNDER /var. Capsules belong to the user, so the records live under
# ${XDG_DATA_HOME}/apex/env and the container storage under ~/.local/share/
# containers, which is why this needs no tmpfiles.d entry and no unit.
COPY --chmod=0755 files/system/libexec/apex-env /usr/libexec/apex-env
RUN set -eux; \
    bash -n /usr/libexec/apex-env; \
    # Every external tool the engine drives, asserted here rather than trusted,
    # because a missing one turns `apex env create` into a confusing runtime
    # failure on the user's machine instead of a failed build.
    for t in podman distrobox distrobox-export jq find comm date grep sed; do \
        command -v "$t" >/dev/null || { echo "FATAL: apex-env needs $t"; exit 1; }; \
    done; \
    # §8's GUI export. `distrobox-export` runs INSIDE a capsule and reaches
    # back through /run/host to write the .desktop file, so `apex env export`
    # can only ever drive it through `distrobox enter`. All three flags are
    # what the three verbs ARE — losing one turns `apex env export` into a
    # runtime failure on the user's machine, which is the class of bug this
    # whole block exists to convert into a failed build.
    distrobox-export --help 2>&1 | grep -q -- '--app'; \
    distrobox-export --help 2>&1 | grep -q -- '--delete'; \
    distrobox-export --help 2>&1 | grep -q -- '--list-apps'; \
    # The two distrobox flags the device profiles are built out of. Both are
    # what the profiles ARE, so an upstream rename would silently produce
    # capsules with no GPU access — a bug that reads as a driver problem. The
    # help text is the only place a shipped distrobox states them.
    distrobox create --help 2>&1 | grep -q -- '--nvidia'; \
    distrobox create --help 2>&1 | grep -q -- '--additional-flags'; \
    # `enter --no-tty` is the same class of dependency: `apex env exec` and
    # `apex install --source capsule` both run through it, and both are meant
    # for scripts and agents with no terminal. Losing the flag would make them
    # allocate a TTY and hang instead of returning.
    distrobox enter --help 2>&1 | grep -q -- '--no-tty'; \
    # The alias table has to resolve on THIS release: the fedora and python
    # aliases derive their tag from /usr/lib/os-release, so a missing or
    # renamed VERSION_ID would produce `fedora-toolbox:` with nothing after it.
    /usr/libexec/apex-env images | grep -qE 'fedora-toolbox:[0-9]+'; \
    /usr/libexec/apex-env images | grep -q 'ubuntu:24.04'; \
    # `apex env` is unprivileged and must stay that way, so the helper is not
    # setuid, has no polkit action and gets no unit. Asserted because "capsules
    # are per-user" is a security claim, not a preference.
    test ! -u /usr/libexec/apex-env; \
    test ! -g /usr/libexec/apex-env; \
    # §9's resolver offers a capsule as a package source and execs this exact
    # path. The engine holds it as a constant rather than an overridable
    # variable — `apex install` runs as root, and a caller-controlled variable
    # naming a program a root process executes is a hole — so the two files
    # agree only by both being right. Checked here, where being wrong is a
    # failed build rather than an `apex install --source capsule` that reports
    # "no capsule engine" on a machine that has one.
    grep -q '^readonly ENV_ENGINE=/usr/libexec/apex-env$' /usr/libexec/apex-pkg; \
    /usr/libexec/apex-pkg --help | grep -q -- '--source rpm|flatpak|capsule'

# ── Disposable environments (§19) ───────────────────────────────────────────
# A MODE of the capsule engine above, not a second environment mechanism: every
# disposable environment is an ordinary capsule created through
# /usr/libexec/apex-env with a throwaway home, so `apex env list` and
# `podman ps` both see it and AGENTS.md's "do not create another package/
# environment mechanism" holds.
#
# The assertions below are the safety claims, checked here so that being wrong
# is a failed build rather than a recursive delete on a user's machine.
COPY --chmod=0755 files/system/libexec/apex-disposable /usr/libexec/apex-disposable
RUN set -eux; \
    bash -n /usr/libexec/apex-disposable; \
    # It drives the capsule engine by an absolute path that must exist. A
    # disposable environment with no engine behind it is a verb that fails at
    # the moment the user needs it.
    grep -q '^ENV_ENGINE="${APEX_DISPOSABLE_ENV_ENGINE:-/usr/libexec/apex-env}"$' \
        /usr/libexec/apex-disposable; \
    test -x /usr/libexec/apex-env; \
    # Teardown is a recursive removal driven by a name, so the four fences that
    # make it safe are build-time facts. Each `grep` is anchored to an
    # EXECUTABLE line (`^[^#]*`), because this file's comments discuss every
    # one of these checks at length and a check its own comments can satisfy is
    # a check that proves nothing — this repository has shipped five of those.
    grep -qE '^[^#]*\[\[ "\$1" =~ \^disp-\[a-z0-9\]\{1,24\}\$ \]\]' /usr/libexec/apex-disposable; \
    grep -qE '^[^#]*\[ -L "\$dir" \]' /usr/libexec/apex-disposable; \
    grep -qE '^[^#]*realpath -e -- "\$dir"' /usr/libexec/apex-disposable; \
    grep -qE '^[^#]*\[ "\$real" = "\$\{root_real\}/\$\{name\}" \]' /usr/libexec/apex-disposable; \
    # --home is what makes an environment disposable. Without it a capsule
    # shares the user's real home and the teardown would be deleting that.
    grep -qE '^[^#]*--home=' /usr/libexec/apex-disposable; \
    # Unprivileged, like `apex env`, and asserted because "disposable
    # environments are per-user" is a security claim rather than a preference.
    test ! -u /usr/libexec/apex-disposable; \
    test ! -g /usr/libexec/apex-disposable; \
    # The CLI's own constant is checked in the `apex` binary block near the end
    # of this file, because the binary is not copied in until then.
    /usr/libexec/apex-disposable --help | grep -q 'not a security boundary'; \
    /usr/libexec/apex-disposable --help | grep -q -- '--copy-out'

# ── The plugin CLI (§16) ────────────────────────────────────────────────────
# apex-shell's plugin platform ships the manifest, the permission model and the
# loader; this is the OS-side CLI it deliberately left out.
#
# IT OWNS NO PLUGIN RULES. Every verdict comes from the shell's own
# src/services/plugins/manifest.js, `require`d by the node shim below — the
# same file the QML engine imports and the same file apex-shell's own tests
# load. Two implementations of a permission model drift, and the failure mode
# is a CLI that tells a user their plugin is fine while the shell refuses it.
#
# That makes three things build dependencies rather than runtime hopes, which
# is why they are asserted here: node, the vendored shell tree, and the exact
# functions the shim calls out of manifest.js. A missing one turns `apex
# plugin` into a confusing runtime failure on the user's machine instead of a
# failed build.
COPY --chmod=0755 files/system/libexec/apex-plugin /usr/libexec/apex-plugin
COPY --chmod=0755 files/system/libexec/apex-plugin-verdict.js /usr/libexec/apex-plugin-verdict.js
RUN set -eux; \
    bash -n /usr/libexec/apex-plugin; \
    for t in node jq find awk; do \
        command -v "$t" >/dev/null || { echo "FATAL: apex-plugin needs $t"; exit 1; }; \
    done; \
    node --check /usr/libexec/apex-plugin-verdict.js; \
    # The shell's validator has to BE there, at the path the CLI defaults to.
    MJS=/usr/share/apex-shell/src/services/plugins/manifest.js; \
    test -f "$MJS"; \
    # …and it has to still export what the shim calls. Checked by running the
    # SHIPPED shim rather than a copy of its export list here: the shim already
    # refuses with exit 2 if manifest.js has lost any of the four functions,
    # and an upstream rename would otherwise surface as "undefined is not a
    # function" halfway through a verdict — which reads as a broken CLI rather
    # than a broken coupling.
    /usr/libexec/apex-plugin-verdict.js validid "$MJS" apex-worldclock; \
    ! /usr/libexec/apex-plugin-verdict.js validid "$MJS" ../escape; \
    # End to end, in the image, against the shell's OWN example plugin. This is
    # the only place the coupling is exercised for real: CI vendors apex-shell
    # from remote main and cannot know what the finished image contains.
    P=/tmp/apex-plugin-verify; \
    mkdir -p "$P/.config/apex-shell/plugins"; \
    cp -r /usr/share/apex-shell/plugins/apex-worldclock \
          "$P/.config/apex-shell/plugins/apex-worldclock"; \
    HOME="$P" /usr/libexec/apex-plugin list 2>&1 | tee /tmp/apex-plugin-list.txt; \
    grep -q 'apex-worldclock' /tmp/apex-plugin-list.txt; \
    grep -qE 'apex-worldclock +enabled +yes' /tmp/apex-plugin-list.txt; \
    HOME="$P" /usr/libexec/apex-plugin info apex-worldclock | grep -q 'bar-widget'; \
    # The disable/enable round trip, on a throwaway HOME, asserting the file
    # count is preserved in both directions.
    HOME="$P" /usr/libexec/apex-plugin disable apex-worldclock; \
    test ! -e "$P/.config/apex-shell/plugins/apex-worldclock"; \
    test -d "$P/.config/apex-shell/plugins-disabled/apex-worldclock"; \
    HOME="$P" /usr/libexec/apex-plugin enable apex-worldclock; \
    test -d "$P/.config/apex-shell/plugins/apex-worldclock"; \
    test ! -e "$P/.config/apex-shell/plugins-disabled/apex-worldclock"; \
    rm -rf "$P" /tmp/apex-plugin-list.txt; \
    # Unprivileged, and it must stay that way: every path it touches is under
    # the invoking user's ~/.config/apex-shell, which is the directory the
    # shell itself reads. Asserted because "plugins are per-user" is a security
    # claim, not a preference.
    test ! -u /usr/libexec/apex-plugin; \
    test ! -g /usr/libexec/apex-plugin; \
    # The permission model must never read as stronger than it is. QML plugins
    # run in-process with the shell's full authority; apex-shell fails its own
    # CI if that paragraph is deleted, and so does this image.
    /usr/libexec/apex-plugin --help | grep -q 'neither one confines hostile code'; \
    echo "apex-plugin verified against the vendored shell validator"

# ── Console setup must not be able to report the machine as broken ──────────
# systemd-vconsole-setup runs loadkeys/setfont with whatever /etc/vconsole.conf
# names. If that keymap or font is not installed the tool exits non-zero, the
# unit FAILS, and systemd puts the machine into "degraded" state — which is what
# the user is then told about every time they open a terminal, over a virtual
# console setting that has no effect on their graphical session.
#
# /etc/vconsole.conf is machine-local, so it survives every image update: once a
# machine has a bad value it stays broken forever and no OS update can fix it.
# The guard repairs the file in place at boot instead (falling back to `us`,
# keeping the original beside it), which is the only layer that CAN fix it.
COPY --chmod=0755 files/system/libexec/apex-vconsole-guard \
     /usr/libexec/apex-vconsole-guard
COPY files/system/units/10-apex-vconsole-guard.conf \
     /usr/lib/systemd/system/systemd-vconsole-setup.service.d/10-apex-vconsole-guard.conf
# Same class of problem, different unit: rpm-ostree's weekly "Count Me"
# telemetry pings the Fedora mirrors, and if the machine is offline when that
# timer fires the unit fails and the system reads as degraded for up to a week.
# Anonymous statistics are allowed to fail; they are not allowed to report the
# machine as broken. See the drop-in for why ExecStart is reset and re-added.
COPY files/system/units/10-apex-countme-nonfatal.conf \
     /usr/lib/systemd/system/rpm-ostree-countme.service.d/10-apex-countme-nonfatal.conf
RUN set -eux; \
    bash -n /usr/libexec/apex-vconsole-guard; \
    # The fallback keymap the guard relies on has to exist in THIS image, or the
    # repair would swap one unloadable keymap for another.
    find /usr/lib/kbd/keymaps -name 'us.map.gz' -print -quit | grep -q .; \
    cp /etc/vconsole.conf /tmp/vconsole.orig; \
    # A bad keymap must be repaired and the original preserved...
    printf 'KEYMAP=definitely-not-a-keymap\nFONT=definitely-not-a-font\n' > /etc/vconsole.conf; \
    /usr/libexec/apex-vconsole-guard; \
    grep -qx 'KEYMAP=us' /etc/vconsole.conf; \
    ! grep -q '^FONT=' /etc/vconsole.conf; \
    test -s /etc/vconsole.conf.apex-invalid; \
    rm -f /etc/vconsole.conf.apex-invalid; \
    # ...and a good one must be left completely alone, because this runs on
    # every boot and must never churn a working machine's configuration.
    printf 'KEYMAP=us\n' > /etc/vconsole.conf; \
    /usr/libexec/apex-vconsole-guard; \
    grep -qx 'KEYMAP=us' /etc/vconsole.conf; \
    test ! -e /etc/vconsole.conf.apex-invalid; \
    cp /tmp/vconsole.orig /etc/vconsole.conf; \
    rm -f /tmp/vconsole.orig; \
    echo "vconsole guard verified (bad config repaired, good config untouched)"

# One-shot de-branding migration for systems installed from a PRE-branding image.
# The BLS entry titles, the EFI NVRAM label and a hand-written /etc/os-release
# all live OUTSIDE the ostree deployment, so `bootc upgrade` never replaces them.
# Dry-run by default; needs --apply. See docs/branding.md.
COPY --chmod=0755 files/scripts/apex-debrand-runtime.sh \
     /usr/libexec/apex-debrand-runtime

# Default APEX Hyprland config template, seeded per-user by the provisioner
# (@HOME@ substituted at seed time). Ships the APEX keybinds + $terminal=alacritty
# etc. so a fresh login is the intended APEX session, not the stock hyprland
# example (which binds dolphin/wofi that aren't installed). apex-logs 16.
COPY files/desktop/hypr/hyprland.conf /usr/share/apex/hypr/hyprland.conf

# Guards for the seeded Hyprland template (apex-logs 14):
#   1. the autostart must be the libexec launcher. The retired
#      ~/.local/bin/apex-shell-autostart shim is deleted by the provisioner, so a
#      template still naming it seeds a dead exec-once and the session comes up
#      with no bar at all.
#   2. the template must NOT contain the value localectl prints for an unset
#      keymap. apex-shell-firstrun greps seeded configs for it, so shipping it —
#      even inside a comment — made a correct, brand-new install fail its own
#      provisioning check. The check strips comments now; this keeps the string
#      out of the file so neither half of the bug can return.
#   3. parse the seeded form with the Hyprland version in this image. Hyprland
#      regularly removes config directives, and a valid old template otherwise
#      turns an image update into a login-blocking compositor failure.
RUN set -eux; \
    grep -q '^exec-once = /usr/libexec/apex-shell-autostart' /usr/share/apex/hypr/hyprland.conf; \
    ! grep -q 'local/bin/apex-shell-autostart' /usr/share/apex/hypr/hyprland.conf; \
    ! grep -q '(unset)' /usr/share/apex/hypr/hyprland.conf; \
    grep -q '@KB_LAYOUT@' /usr/share/apex/hypr/hyprland.conf; \
    grep -q '@HOME@' /usr/share/apex/hypr/hyprland.conf; \
    # Each generated file the template sources must actually be sourced — a
    # generator whose output nothing reads is worse than no generator, because
    # the settings page appears to work.
    grep -q '^source = @HOME@/.config/hypr/apex-input.conf$' /usr/share/apex/hypr/hyprland.conf; \
    grep -q '^source = @HOME@/.config/hypr/apex-display.conf$' /usr/share/apex/hypr/hyprland.conf; \
    grep -q '^source = @HOME@/.config/apex-shell/ApexShellKeybinds.conf$' /usr/share/apex/hypr/hyprland.conf; \
    # Every generated file needs a path that EXISTS for the verify run. Hyprland
    # treats a `source=` with no match as a FATAL config error, so one left
    # pointing at an unwritten user path fails the whole verification for a
    # reason that has nothing to do with the template being tested.
    #
    # Stubbing is generic rather than one sed per file, and then asserted: the
    # named-file version fell behind the template the first time a second source
    # line was added, and this cannot. They can share one empty stub — sourcing
    # nothing twice is fine.
    config="$(mktemp)"; stub="$(mktemp)"; runtime="$(mktemp -d)"; \
    chmod 0700 "$runtime"; \
    sed -e "s|^source = @HOME@/.*$|source = ${stub}|" \
        -e 's|@HOME@|/tmp/apex-home|g' \
        -e 's|@KB_LAYOUT@|us|g' \
        -e 's|@KB_VARIANT@||g' \
        /usr/share/apex/hypr/hyprland.conf > "$config"; \
    # The stubbing kept up: no per-user source line survived into the file being
    # verified. This is what makes the guard self-maintaining.
    ! grep -qE '^source = (@HOME@|/tmp/apex-home)' "$config"; \
    XDG_RUNTIME_DIR="$runtime" Hyprland --i-am-really-stupid \
        --verify-config --config "$config" | grep -q 'config ok'; \
    rm -rf "$config" "$stub" "$runtime"

# The same guard for niri, which had none because it has no APEX template to
# grep: niri's config is seeded from niri's OWN default and the APEX additions
# are appended by the per-login provisioner, so that is where the include lines
# live and that is what gets checked here.
#
# This exists because the niri half was missing entirely. apex-input-apply wrote
# ApexShellInput.kdl and the shell wrote ApexShellKeybinds.kdl, and nothing ever
# read either one — the generator emitted a COMMENT telling the user to add the
# include by hand. A generated file nothing reads is worse than no generator,
# because the Settings page reports success and the setting does not apply.
RUN set -eux; \
    f=/usr/libexec/apex-shell-firstrun; \
    grep -q 'include "${CFG_DIR}/ApexShellInput.kdl"' "$f"; \
    grep -q 'include "${CFG_DIR}/ApexShellKeybinds.kdl"' "$f"; \
    # Both include targets must be pre-created before that append runs. niri
    # treats an include it cannot read as a fatal parse error and refuses the
    # WHOLE config, so a line without a matching pre-create costs a niri user
    # every binding and window rule on boot #1 — the same failure Hyprland's
    # `source=` had, one compositor along.
    grep -q '^\[ -f "${CFG_DIR}/ApexShellInput.kdl" \]' "$f"; \
    grep -q 'ApexShellKeybinds.${_variant}' "$f"; \
    # `include` is a niri 25.11+ feature. Ask THIS image's niri rather than
    # trusting a version string: if the package is ever pinned back, the build
    # fails here instead of the desktop failing at login.
    d="$(mktemp -d)"; \
    printf 'input {\n    touchpad {\n        tap\n    }\n}\n' > "$d/inc.kdl"; \
    printf 'include "%s/inc.kdl"\n' "$d" > "$d/config.kdl"; \
    niri validate --config "$d/config.kdl"; \
    # And the pre-create is load-bearing, not defensive: with the target gone,
    # the identical config must be REFUSED. If a future niri downgrades this to
    # a warning this line fails — read the pre-create rationale in the
    # provisioner before deleting it, because `include optional=true` (26.04+)
    # is then the better shape.
    rm -f "$d/inc.kdl"; \
    ! niri validate --config "$d/config.kdl"; \
    rm -rf "$d"

# Greeter session picker: offer Hyprland + niri only. sway/labwc are the greeter
# HOST compositor, not user sessions — strip their wayland-session files so they
# are never offered as logins. apex-greet enumerates /usr/share/wayland-sessions.
#
# Also remove hyprland-uwsm.desktop (hyprland pulls in hyprland-uwsm, whose session
# Exec is `uwsm start -- hyprland.desktop`).
#
# WHY, honestly stated (apex-logs 25/39, corrected in 43): a fresh install with this
# entry present bounce-looped at login on real hardware, and a diagnostic wrapper did
# record a bare `uwsm` (empty args, ppid `greetd --session-worker`) being executed.
# Those OBSERVATIONS stand. The mechanism previously recorded here — "the greeter
# launches only the FIRST Exec token" — is WRONG: GreetContext.qml::launch() runs the
# session as `["sh","-lc", cmd]`, i.e. the full Exec string through a shell. That form
# dates to 6d3060e (2026-07-21), two days BEFORE the wrapper evidence, git history
# shows no split-on-space version ever existed, and the greeter installed on the system
# that produced the evidence is cmp-identical to this tree. So where the bare `uwsm`
# came from is UNEXPLAINED — it was not the greeter dropping Exec tokens.
#
# The removal stays regardless, on a mechanism-independent ground: hyprland-uwsm.desktop
# sorts BEFORE hyprland.desktop, so it becomes the default session on every fresh
# install, and shipping an entry that empirically bounce-looped AS THE DEFAULT locks
# users out. Plain `hyprland.desktop` is known-good.
#
# uwsm the PACKAGE stays installed, so restoring the entry is a one-line experiment for
# whoever chases the real cause. Do not re-add it as the sort-first default without
# first reproducing a clean login on hardware.
COPY files/desktop/wayland-sessions/niri.desktop \
     /usr/share/wayland-sessions/niri.desktop
RUN set -eux; \
    rm -f /usr/share/wayland-sessions/sway.desktop \
          /usr/share/wayland-sessions/labwc.desktop \
          /usr/share/wayland-sessions/hyprland-uwsm.desktop; \
    [ -f /usr/share/wayland-sessions/hyprland.desktop ] || \
      printf '[Desktop Entry]\nName=Hyprland\nComment=Dynamic tiling Wayland compositor\nExec=Hyprland\nType=Application\nDesktopNames=Hyprland\n' \
        > /usr/share/wayland-sessions/hyprland.desktop

# labwc as a THIRD user session, offered alongside Hyprland and niri.
#
# It is copied AFTER the rm above, and named apex-labwc.desktop rather than
# labwc.desktop, for two reasons that must not be collapsed: the stock
# labwc.desktop launches labwc bare (no APEX Shell, no config) and has to stay
# deleted, and labwc is simultaneously the greeter's fallback HOST compositor, so
# the stock entry existing at all is a login hazard.
#
# The config templates are installed read-only and seeded per-user by
# apex-shell-firstrun, matching how the Hyprland config is handled.
# Portal backends for the labwc session. See the file for why the packaged
# `default=wlr;*` is not good enough. /etc overrides /usr/share per
# portals.conf(5) without conflicting with the labwc package on upgrade.
COPY files/system/xdg-desktop-portal/labwc-portals.conf \
     /etc/xdg-desktop-portal/labwc-portals.conf
RUN set -eux; \
    test -s /etc/xdg-desktop-portal/labwc-portals.conf; \
    # The backends this config names must actually be installed, or the session
    # silently loses screen sharing and file dialogs. A portal that is merely
    # *configured* is not a portal that answers.
    test -f /usr/share/xdg-desktop-portal/portals/wlr.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    test -x /usr/libexec/xdg-desktop-portal-wlr; \
    test -x /usr/libexec/xdg-desktop-portal-gtk; \
    # wlr genuinely implements the two capture interfaces we point at it.
    grep -q 'org.freedesktop.impl.portal.ScreenCast' /usr/share/xdg-desktop-portal/portals/wlr.portal; \
    grep -q 'org.freedesktop.impl.portal.Screenshot' /usr/share/xdg-desktop-portal/portals/wlr.portal; \
    # ...and gtk implements the one that the wildcard used to leave to chance.
    grep -q 'org.freedesktop.impl.portal.FileChooser' /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    # No wildcard survives: that is the whole point of overriding the packaged
    # file, so a regression that reintroduces it must fail the build.
    ! grep -qE '^\s*default=.*\*' /etc/xdg-desktop-portal/labwc-portals.conf; \
    grep -qE '^default=gtk$' /etc/xdg-desktop-portal/labwc-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.ScreenCast=wlr$' /etc/xdg-desktop-portal/labwc-portals.conf; \
    echo "portals: labwc pinned to wlr capture + gtk desktop interfaces"

# Portal backends for the niri session. Same reason as labwc's, a different
# defect: the niri package DOES ship a config (so this is not the wildcard case),
# but its `default=gnome;gtk` hands FileChooser, AppChooser, Print and Settings
# to xdg-desktop-portal-gnome, so "Open File" is a GNOME dialog on niri and a GTK
# one on the other two sessions this image offers. §24 asks niri for parity with
# Hyprland, and a different file chooser is not parity. See the file.
#
# The filename is load-bearing: portals.conf(5) resolves
# xdg-desktop-portal/<desktop>-portals.conf for each name in XDG_CURRENT_DESKTOP,
# lower-cased. niri sets XDG_CURRENT_DESKTOP=niri in `--session` mode (and
# niri.desktop carries DesktopNames=niri), which is the same premise on which the
# niri package ships its own niri-portals.conf. /etc beats /usr/share by
# DIRECTORY precedence, so this file wins over the packaged one without
# conflicting with it on upgrade.
COPY files/system/xdg-desktop-portal/niri-portals.conf \
     /etc/xdg-desktop-portal/niri-portals.conf
RUN set -eux; \
    test -s /etc/xdg-desktop-portal/niri-portals.conf; \
    # The session this config is named for must exist, and must still announce
    # the desktop name the filename depends on. A rename on either side makes
    # this file silently inert — xdg-desktop-portal would fall back to the
    # packaged config and nothing would report it.
    test -f /usr/share/wayland-sessions/niri.desktop; \
    grep -q '^DesktopNames=niri$' /usr/share/wayland-sessions/niri.desktop; \
    # The backends this config names must actually be installed. gnome is not
    # optional here: niri implements the Mutter ScreenCast API, not
    # wlr-screencopy-backed portal capture, so without xdg-desktop-portal-gnome
    # a niri session has no screen sharing at all.
    test -f /usr/share/xdg-desktop-portal/portals/gnome.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    test -f /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal; \
    test -x /usr/libexec/xdg-desktop-portal-gnome; \
    test -x /usr/libexec/xdg-desktop-portal-gtk; \
    # ...and each named backend genuinely implements what it is pointed at.
    grep -q 'org.freedesktop.impl.portal.ScreenCast' /usr/share/xdg-desktop-portal/portals/gnome.portal; \
    grep -q 'org.freedesktop.impl.portal.Screenshot' /usr/share/xdg-desktop-portal/portals/gnome.portal; \
    grep -q 'org.freedesktop.impl.portal.FileChooser' /usr/share/xdg-desktop-portal/portals/gtk.portal; \
    grep -q 'org.freedesktop.impl.portal.Secret' /usr/share/xdg-desktop-portal/portals/gnome-keyring.portal; \
    # No wildcard, and gtk leads the default list — that ordering IS the fix, so
    # a regression back to `default=gnome;gtk` must fail the build.
    ! grep -qE '^\s*default=.*\*' /etc/xdg-desktop-portal/niri-portals.conf; \
    grep -qE '^default=gtk;gnome$' /etc/xdg-desktop-portal/niri-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.ScreenCast=gnome$' /etc/xdg-desktop-portal/niri-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.Screenshot=gnome$' /etc/xdg-desktop-portal/niri-portals.conf; \
    grep -qE '^org\.freedesktop\.impl\.portal\.Secret=gnome-keyring$' /etc/xdg-desktop-portal/niri-portals.conf; \
    # ── Every desktop session this image offers, BY NAME ────────────────────
    # Enumerated, never counted: niri went three releases with no APEX portal
    # configuration at all while labwc's was build-verified, and no assertion
    # here could see it, because nothing asked "and what about the other
    # sessions". A `-ge 2` would pass with one of these missing.
    #
    # For each, the desktop name that portals.conf(5) will look up must resolve
    # to a config SOMEWHERE — /etc for the two APEX pins, /usr/share for
    # Hyprland, whose packaged `default=hyprland;gtk` already reaches gtk for the
    # desktop interfaces because hyprland.portal implements only capture and
    # shortcuts — and none of them may resolve through a wildcard.
    #
    # apex-gaming (DesktopNames=gamescope) is deliberately NOT in this list:
    # it is Steam Big Picture inside gamescope with no desktop session, no
    # Flatpak file dialogs and no portal story. Named as excluded rather than
    # silently absent, because "absent" is what this whole block exists to
    # catch. It is also a Gaming-flavor file and does not exist in base.
    for d in hyprland niri labwc; do \
        c=""; \
        for p in "/etc/xdg-desktop-portal/${d}-portals.conf" "/usr/share/xdg-desktop-portal/${d}-portals.conf"; do \
            if [ -s "$p" ]; then c="$p"; break; fi; \
        done; \
        [ -n "$c" ] || { echo "FATAL: no portals.conf resolves for XDG_CURRENT_DESKTOP=${d}"; exit 1; }; \
        if grep -qE '^\s*default=.*\*' "$c"; then \
            echo "FATAL: ${c} resolves backends through a wildcard"; exit 1; \
        fi; \
        echo "portals: ${d} -> ${c}"; \
    done; \
    echo "portals: niri pinned to gnome capture + gtk desktop interfaces"

COPY files/desktop/wayland-sessions/apex-labwc.desktop \
     /usr/share/wayland-sessions/apex-labwc.desktop
COPY files/desktop/labwc/ /usr/share/apex/labwc/
RUN set -eux; \
    test -f /usr/share/wayland-sessions/apex-labwc.desktop; \
    test ! -f /usr/share/wayland-sessions/labwc.desktop; \
    command -v labwc >/dev/null; \
    # Idle screen-off. The shipped hypridle.conf's 6-minute listener calls
    # apex-shell's DpmsControl.sh, which resolves to `wlopm --off '*'` on labwc
    # — the only route there is, because labwc publishes no IPC socket and
    # zwlr-output-power-management-v1 is the protocol it implements for this.
    # Without the binary the listener fires, reports a missing program, and the
    # display stays lit; asserting it here is what keeps that from regressing to
    # the silent version it used to be.
    command -v wlopm >/dev/null; \
    for f in rc.xml menu.xml autostart environment themerc-override; do \
        test -s "/usr/share/apex/labwc/$f"; \
    done; \
    # labwc has no --verify-config, so the XML is validated structurally at build
    # time instead. A malformed rc.xml makes labwc fall back to defaults
    # SILENTLY: the session would still start, but with no keybinds and no APEX
    # Shell, which is a far worse failure than a build error.
    xmllint --noout /usr/share/apex/labwc/rc.xml; \
    xmllint --noout /usr/share/apex/labwc/menu.xml; \
    # The shell's compositor detection depends on this being set, and labwc
    # publishes no socket or signature variable of its own.
    grep -q '^XDG_CURRENT_DESKTOP=labwc' /usr/share/apex/labwc/environment; \
    # The session is worthless if the shell never starts.
    grep -q 'apex-shell-autostart' /usr/share/apex/labwc/autostart; \
    # The keybinds invoke `apex shell`. That the VERB exists is asserted at the
    # end of this file, where the binaries are copied in; here we only check the
    # configs reference it, which is all this layer can see.
    grep -q 'apex shell' /usr/share/apex/labwc/rc.xml; \
    grep -q 'apex shell' /usr/share/apex/labwc/menu.xml; \
    # Desktop right-click must reach the APEX menu, and menu.xml must survive as
    # the modifier-reachable emergency path. Checked here rather than beside the
    # helper COPYs, because rc.xml does not exist until this layer.
    grep -q '/usr/libexec/apex-desktop-menu' /usr/share/apex/labwc/rc.xml; \
    grep -q 'ShowMenu' /usr/share/apex/labwc/rc.xml; \
    test -s /usr/share/apex/labwc/menu.xml; \
    # `qs` is what `apex shell` actually calls; without it the wrapper is inert.
    command -v qs >/dev/null; \
    # ── APEX Floating window chrome ─────────────────────────────────────────
    # labwc IGNORES an unrecognised theme key in silence, so a typo does not
    # break a session, it just leaves that element on the built-in grey — the
    # Openbox-fallback look this theme exists to remove. Assert the shape here
    # and the key names in tests/test-apex-firstrun.sh, which has labwc-theme(5)
    # available.
    grep -q '@ACCENT@' /usr/share/apex/labwc/themerc-override; \
    grep -qE '^window\.titlebar\.padding\.height: 11$' /usr/share/apex/labwc/themerc-override; \
    grep -qE '^window\.button\.width: 30$' /usr/share/apex/labwc/themerc-override; \
    grep -qE '^border\.width: 1$' /usr/share/apex/labwc/themerc-override; \
    # Window chrome must use a PROPORTIONAL face, and the font it names must
    # actually be installed: fontconfig silently substitutes a missing family,
    # so naming a font the image does not ship is invisible until someone looks
    # at a titlebar. Noto Sans comes from google-noto-sans-fonts in core.
    grep -q '<name>Noto Sans</name>' /usr/share/apex/labwc/rc.xml; \
    ! grep -qE '<name>[^<]*Mono[^<]*</name>' /usr/share/apex/labwc/rc.xml; \
    fc-match --format='%{family}\n' 'Noto Sans' | grep -qi 'noto sans'; \
    grep -qE '<cornerRadius>1[0-2]</cornerRadius>' /usr/share/apex/labwc/rc.xml; \
    grep -q '<dropShadows>yes</dropShadows>' /usr/share/apex/labwc/rc.xml; \
    grep -q 'style="thumbnail"' /usr/share/apex/labwc/rc.xml; \
    echo "APEX Floating: chrome theme, proportional font and thumbnail switcher verified"

# The labwc bindings are maintained by hand — the shell's keybind editor emits
# Hyprland .conf/.lua and niri .kdl, and labwc has neither an IPC to push
# bindings over nor an include mechanism to append a generated file to. So they
# can drift from what the other two sessions do, and drift is invisible until
# someone presses a key and nothing happens.
#
# They DID drift: the launcher shipped as SUPER+SPACE when every other session
# used ALT+SPACE, plus two more wrong combos and eleven missing bindings. This is
# the gate that would have caught it. Both trees exist at this point in the
# build, so the comparison is exact rather than assumed.
#
# They are GENERATED now — /usr/libexec/apex-labwc-keybinds owns the marked
# region of rc.xml — so this no longer compares two hand-written lists. It
# asserts the seeded file is byte-for-byte what the generator produces from the
# shell's defaults, which is a stronger statement and one that cannot be
# satisfied by editing the config alone.
COPY --chmod=0755 files/scripts/check-labwc-keybinds /tmp/check-labwc-keybinds
RUN /tmp/check-labwc-keybinds /usr/share/apex-shell /usr/share/apex/labwc/rc.xml \
    && rm -f /tmp/check-labwc-keybinds

# ── Stage 6: flathub remote (first-boot) + greeter payload + config ────────
# Flathub CANNOT reliably be added at build time on bootc: `flatpak remote-add
# --system` writes to /var/lib/flatpak, and bootc treats /var as machine-local
# state that is only seeded once and never updated — a build-time remote is
# fragile across upgrades. So ship an idempotent first-boot oneshot (the uBlue
# pattern) that adds Flathub on the running system. `flatpak remote-add
# --if-not-exists` makes it safe to run repeatedly; a stamp keeps it quiet after
# the first success. Flatseal is then installable from Flathub as a first-run
# app (documented in the flavor images / README) — it cannot be preinstalled
# because flatpak install needs a running system.
COPY files/system/flatpak/flathub.flatpakrepo /etc/flatpak/flathub.flatpakrepo
COPY files/system/units/apex-flathub-setup.service \
     /usr/lib/systemd/system/apex-flathub-setup.service

# ── Zen Browser, shipped but not imposed ────────────────────────────────────
# Zen is a Firefox fork with an opinionated interface. Every image gets it, and
# it tracks latest stable for free: `apex update` already runs
# `flatpak update --system`, so there is no APEX-specific updater to write.
#
# It cannot be installed at build time — `flatpak install` needs a running
# system, the same constraint that makes the Flathub remote a first-boot unit —
# so it is a first-boot oneshot that runs after the remote exists.
#
# FIREFOX REMAINS THE DEFAULT BROWSER. That is a decision, not an oversight:
# someone who dislikes Zen should not have to undo a choice the image made for
# them. The assertion below is the part that matters — a Flatpak's exported
# .desktop can win the http/https handler depending on XDG data directory
# ordering, which would make Zen the default by accident on every machine.
# SUPER+W opens the DEFAULT browser, not a named one. `$browser = firefox` in
# hyprland.conf meant the keybind contradicted the user's own setting the moment
# a second browser existed — which shipping Zen guarantees. The helper resolves
# the http/https handler at press time, so it follows the user to any browser,
# including ones APEX has never heard of.
COPY --chmod=0755 files/system/libexec/apex-open-browser \
     /usr/libexec/apex-open-browser
COPY files/system/units/apex-flatpak-preinstall.service \
     /usr/lib/systemd/system/apex-flatpak-preinstall.service
RUN set -eux; \
    systemctl enable apex-flatpak-preinstall.service; \
    # The unit must name the app and must not run before the remote exists;
    # both are the difference between installing Zen and failing quietly.
    grep -q 'app.zen_browser.zen' /usr/lib/systemd/system/apex-flatpak-preinstall.service; \
    grep -q 'After=.*apex-flathub-setup.service' /usr/lib/systemd/system/apex-flatpak-preinstall.service; \
    grep -q 'Requires=apex-flathub-setup.service' /usr/lib/systemd/system/apex-flatpak-preinstall.service; \
    # FIREFOX, NOT ZEN, owns the web handlers in the shipped defaults. If this
    # ever fails, an image has silently changed every user's default browser —
    # which is the one thing shipping a second browser must not do.
    grep -q '^x-scheme-handler/http=firefox.desktop$'  /etc/xdg/mimeapps.list; \
    grep -q '^x-scheme-handler/https=firefox.desktop$' /etc/xdg/mimeapps.list; \
    # And Zen must not be shipped a second time as a system .desktop, which
    # would put it in the handler race at build time rather than at install.
    test ! -e /usr/share/applications/app.zen_browser.zen.desktop; \
    # The browser keybind must name no browser. A regression here is invisible
    # until someone changes their default and wonders why SUPER+W ignores it.
    test -x /usr/libexec/apex-open-browser; \
    bash -n /usr/libexec/apex-open-browser; \
    grep -q '^\$browser     = /usr/libexec/apex-open-browser$' \
        /usr/share/apex/hypr/hyprland.conf \
        || grep -q 'browser.*= /usr/libexec/apex-open-browser' \
           /usr/share/apex/hypr/hyprland.conf; \
    ! grep -qE '^\$browser\s*=\s*(firefox|zen)' /usr/share/apex/hypr/hyprland.conf; \
    echo "zen: first-boot flatpak; firefox keeps the web handlers; SUPER+W follows the default"

# The whole apex-greet tree lands at /usr/share/apex-greet so the QML's
# Qt.resolvedUrl("assets/…") resolves in place; the wallpaper is dropped where
# GreetSurface.qml expects it; greetd-config.toml becomes the live greetd
# config; sway-greet.conf is the layer-shell-capable host config it launches.
COPY files/desktop/apex-greet /usr/share/apex-greet
COPY files/branding/wallpapers/apex-wallpaper-default.jpg \
     /usr/share/backgrounds/apex/default.jpg
COPY files/desktop/apex-greet/greetd-config.toml /etc/greetd/config.toml

# ── Greeter wallpaper: the user's own, not the shipped default ─────────────
# THE BUG: change your wallpaper in APEX Shell and the login/lock screen kept
# showing the factory image forever. GreetSurface.qml hardcoded
# file:///usr/share/backgrounds/apex/default.jpg, and nothing could ever have
# changed that — /usr is a read-only ostree mount, so there was no writable
# path for the greeter to read a per-user choice from.
#
# It cannot simply read ~/.curr_wall either: the greeter runs as the `greetd`
# system user, long before (and after) any session exists, and home directories
# are mode 0700. greetd has no business being able to read them.
#
# So the shell PUBLISHES its choice to a greeter-readable location, through a
# root helper reached by a narrow NOPASSWD sudoers rule — the same pattern the
# Windows-boot button uses above. The helper takes no caller-supplied path: it
# resolves the caller from SUDO_UID, and reads that user's wallpaper WITH THE
# CALLER'S OWN PRIVILEGES (setpriv --reuid), so it cannot be talked into
# copying /etc/shadow into a world-readable directory. It then validates the
# bytes really are a JPEG/PNG/WebP before publishing them. See the helper's
# own header for the full threat model.
#
# Unlike the Windows helper this rule is ALL rather than %wheel: setting your
# desktop wallpaper is not an administrative action, and a non-wheel user would
# otherwise get a login screen that silently refuses to follow their choice.
COPY files/system/libexec/apex-greet-wallpaper /usr/libexec/apex-greet-wallpaper
COPY files/system/sudoers/apex-greet-wallpaper /etc/sudoers.d/030-apex-greet-wallpaper
RUN set -eux; \
    chmod 0755 /usr/libexec/apex-greet-wallpaper; \
    bash -n /usr/libexec/apex-greet-wallpaper; \
    chown root:root /etc/sudoers.d/030-apex-greet-wallpaper; \
    chmod 0440 /etc/sudoers.d/030-apex-greet-wallpaper; \
    # A syntax error or wrong mode makes sudo refuse the file at RUNTIME, which
    # would mean a password prompt no compositor-spawned script can answer.
    # visudo -c turns that into a build failure instead.
    visudo -cf /etc/sudoers.d/030-apex-greet-wallpaper; \
    # setpriv is what drops privileges for the read. It comes from util-linux
    # (always present), but assert it: without setpriv the helper would have to
    # read as root, which is exactly the escalation this design avoids.
    command -v setpriv >/dev/null; \
    # The greeter must actually consult the published copy. If an upstream edit
    # ever reverts GreetSurface/GreetContext to the hardcoded default, this
    # build fails instead of shipping the original bug back.
    grep -q 'apex-greet/wallpapers' /usr/share/apex-greet/GreetContext.qml; \
    grep -q 'ctx.wallpaper' /usr/share/apex-greet/GreetSurface.qml; \
    # A returning user must land in the PASSWORD field, not the username one.
    # That depends on re-applying focus when last-user resolves asynchronously;
    # if the guard disappears, the greeter silently regresses to eating the
    # first thing the user types into the wrong box.
    grep -q 'initialFocusApplied' /usr/share/apex-greet/GreetSurface.qml; \
    grep -q 'onTextEdited' /usr/share/apex-greet/GreetSurface.qml; \
    # The publisher is invoked from the session launcher (image content, so this
    # is always a hard failure) AND from the shell's wallpaper pipeline.
    grep -q 'apex-greet-wallpaper' /usr/libexec/apex-shell-autostart; \
    # The shell half lives in a DIFFERENT repository. On the default ref this
    # must hold — a main that lost the call is a regression and shipping it
    # would quietly restore the original bug. But APEX_SHELL_REF exists so an
    # older release can be rebuilt reproducibly, and those refs legitimately
    # predate the feature; failing that build would be obstructive. Same posture
    # as the windows-check probe above.
    if ! grep -q 'apex-greet-wallpaper' \
            /usr/share/apex-shell/src/services/WallpaperService.qml; then \
        if [ "${APEX_SHELL_STRICT}" = 1 ]; then \
            echo "FATAL: apex-shell main no longer publishes the greeter wallpaper"; exit 1; \
        else \
            echo "WARN: pinned apex-shell (${APEX_SHELL_REF}) predates the greeter-wallpaper publisher — the login screen will only follow the wallpaper after the next login, not immediately"; \
        fi; \
    fi; \
    echo "greeter wallpaper publisher installed and wired"

# System wiring, one layer (no dnf):
#   - Writable state dir for apex-greet's last-user/last-session memory, owned
#     by the greetd session user (Fedora's greetd package provisions the
#     `greetd` user via sysusers.d — there is NO `greeter` user); tmpfiles
#     creates it at boot after systemd-sysusers has run.
#   - Published-wallpaper dir underneath it, root-owned 0755: only the root
#     helper writes there, everyone (including greetd) may read. It is a
#     separate tmpfiles line rather than a subdirectory of the greetd-owned one
#     because greetd must NOT be able to replace the files it renders.
#   - Enable the flathub first-boot oneshot.
#   - greetd as the display manager (enabling it creates the
#     display-manager.service alias; graphical.target Wants it), so a graphical
#     boot starts greetd → sway → the apex-greet greeter on tty1.
#   - graphical.target as default.
# NOTE: VARIANT is deliberately NOT stamped here — the flavor images
# (Containerfile.daily / .gaming) own the os-release VARIANT/VARIANT_ID stamp,
# which is what drives apex-greet's edition (gold/chartreuse) branding.
RUN set -eux; \
    printf 'd /var/lib/apex-greet 0755 greetd greetd -\nd /var/lib/apex-greet/wallpapers 0755 root root -\n' \
        > /usr/lib/tmpfiles.d/apex-greet.conf; \
    systemctl enable apex-flathub-setup.service; \
    systemctl enable greetd.service; \
    systemctl set-default graphical.target

# ── Stage 6z: apexd, apex and apex-agentd ───────────────────────────────────
# LAST, and deliberately so. These are the most volatile artefacts in the image
# — every apexd commit changes them — and `podman build --cache-to` pushes each
# intermediate layer to the registry separately, so a cache miss high in this
# file costs both a rebuild AND a registry push for every layer beneath it.
#
# They used to be layer 1 of about eighty. The build after the agent-runtime
# merge therefore rebuilt and re-pushed the whole image and was killed at
# GitHub's six-hour job ceiling at step 76 of 83; the previous successful build
# took 3h16m. Down here, an apexd-only change invalidates these two layers and
# nothing else.
#
# Same reasoning the git-SHA labels below already follow: volatile content last.
#
# awww/matugen/yazi are NOT here — slow-moving third-party tools ship in core.
COPY --from=apex-builder /out/usr/bin/ /usr/bin/

# Every assertion that needs one of those binaries to exist, gathered here so
# the binaries have exactly one dependent layer.
RUN set -eux; \
    test -x /usr/bin/apexd; \
    test -x /usr/bin/apex; \
    test -x /usr/bin/apex-agentd; \
    test -x /usr/bin/apex-aid; \
    # The CLI must actually run in the image it ships in, not merely be present:
    # a dynamic-link or glibc mismatch against core is exactly the failure that
    # a file-existence check misses.
    /usr/bin/apex --help >/dev/null; \
    /usr/bin/apex agent --help >/dev/null; \
    /usr/bin/apex project --help >/dev/null; \
    /usr/bin/apex ai --help >/dev/null; \
    # Every §14 verb, by name. `apex ai --help` passing proves the subcommand
    # exists; it does not prove `run` was not renamed, and a renamed verb is a
    # silent no-op in every script and shell integration that calls it.
    for v in models pull rm run unload status serve; do \
        /usr/bin/apex ai "$v" --help >/dev/null || { echo "FATAL: apex ai $v is gone"; exit 1; }; \
    done; \
    # §19. Same rule, same reason: a renamed verb is a silent no-op in every
    # script, keybind and settings page that calls it.
    for v in status repair reset; do \
        /usr/bin/apex recover "$v" --help >/dev/null \
            || { echo "FATAL: apex recover $v is gone"; exit 1; }; \
    done; \
    for v in plan run list rm purge; do \
        /usr/bin/apex disposable "$v" --help >/dev/null \
            || { echo "FATAL: apex disposable $v is gone"; exit 1; }; \
    done; \
    # The CLI holds the disposable engine's path as a constant, exactly as
    # `apex install --source capsule` holds the capsule engine's, and for the
    # same reason: a caller-controlled variable naming a program is a hole. The
    # two files agree only by both being right, so the built binary is checked
    # against the path that was actually installed.
    grep -qa '/usr/libexec/apex-disposable' /usr/bin/apex; \
    test -x /usr/libexec/apex-disposable; \
    # §19's "expose apex doctor results graphically" is this flag and nothing
    # else on the OS side. Losing it silently turns the settings page into a
    # screen that renders no diagnostics.
    /usr/bin/apex doctor --help | grep -q -- '--json'; \
    # `reset` refuses to run as root. Root's home is not the user's, so a
    # `sudo apex recover reset` would reset root's desktop and leave the user's
    # exactly as it is — while reporting success. This build runs as root, so
    # the refusal is checkable directly, and it is checked for the REASON as
    # well as the exit status: "it refused" has been true here while "it
    # refused for the reason under test" was false.
    ! /usr/bin/apex recover reset --scope desktop >/dev/null 2>&1; \
    /usr/bin/apex recover reset --scope desktop 2>&1 | grep -q 'must not run as root'; \
    # `reset` is a dry run without --commit. This is the single most important
    # runtime property in §19, so it is proven against the shipped binary
    # rather than reasoned about: a throwaway HOME owned by an ordinary uid, a
    # file the plan names, and that file still present afterwards.
    command -v setpriv >/dev/null; \
    APEX_RESET_PROBE="$(mktemp -d)"; \
    mkdir -p "$APEX_RESET_PROBE/.config/apex-shell"; \
    echo '{}' > "$APEX_RESET_PROBE/.config/apex-shell/input.json"; \
    chown -R 1000:1000 "$APEX_RESET_PROBE"; \
    setpriv --reuid=1000 --regid=1000 --clear-groups \
        env HOME="$APEX_RESET_PROBE" /usr/bin/apex recover reset --scope desktop >/dev/null; \
    test -f "$APEX_RESET_PROBE/.config/apex-shell/input.json" \
        || { echo "FATAL: apex recover reset deleted a file without --commit"; exit 1; }; \
    # And --commit without --confirm must also change nothing.
    ! setpriv --reuid=1000 --regid=1000 --clear-groups \
        env HOME="$APEX_RESET_PROBE" /usr/bin/apex recover reset --scope desktop --commit \
        >/dev/null 2>&1; \
    test -f "$APEX_RESET_PROBE/.config/apex-shell/input.json" \
        || { echo "FATAL: apex recover reset deleted a file without --confirm"; exit 1; }; \
    rm -rf "$APEX_RESET_PROBE"; \
    # The daemon must RUN in the image it ships in, not merely exist: a dynamic
    # link or glibc mismatch against core is exactly what a file-existence check
    # misses. `--help` is a pure print and binds no socket.
    /usr/bin/apex-aid --help >/dev/null; \
    # And the refusal that carries §14's central security decision has to be
    # live in the shipped binary, not just in the source. Asserted on both the
    # daemon and the CLI, because each has its own argument parser.
    ! /usr/bin/apex-aid --listen 127.0.0.1:11434 >/dev/null 2>&1; \
    /usr/bin/apex-aid --listen 127.0.0.1:11434 2>&1 | grep -q SO_PEERCRED; \
    /usr/bin/apex ai serve --listen 127.0.0.1:11434 2>&1 | grep -q SO_PEERCRED; \
    # The compositor keybinds and the labwc root-menu replacement both invoke
    # `apex shell <verb>`; a renamed verb makes every one of them a silent
    # no-op, which is why the verb table is asserted and not just the binary.
    /usr/bin/apex shell list >/dev/null; \
    /usr/bin/apex shell list | grep -qw menu; \
    # The shell integration gates itself on `apex` being on PATH, so this is the
    # first point in the build where sourcing it can define anything. Checked in
    # both shells because the file carries a bash and a zsh completion block.
    bash -c 'set -e; . /usr/share/apex/shell/agent.sh; [ "$(type -t a)" = function ]'; \
    zsh -fc 'set -e; . /usr/share/apex/shell/agent.sh; [ "$(whence -w al)" = "al: function" ]'; \
    echo "apexd/apex/apex-agentd/apex-aid installed and runnable; shell verbs and `a` intact"

# ── Stage 7: bootc container sanity lint (informational) ───────────────────
RUN bootc container lint || true

# Volatile provenance belongs last so a new git SHA does not invalidate every
# otherwise-cacheable payload layer above it.
ARG APEX_REVISION=dev
ARG APEX_VERSION=43
LABEL org.opencontainers.image.title="APEX-OS base" \
      org.opencontainers.image.description="APEX-OS shared base: apex-os-core + apexd/apex + APEX Shell + greeter payload" \
      org.opencontainers.image.source="https://github.com/AndreNijman/apex-os" \
      org.opencontainers.image.revision="${APEX_REVISION}" \
      org.opencontainers.image.version="${APEX_VERSION}" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="APEX-OS"
